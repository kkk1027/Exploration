#!/usr/bin/env python3
"""explore_watchdog —— 探索期的"长时间静止"看门狗（方案：P1-2）。

为什么需要（2026-10-23 实测）：
  车端在前向净空 < 0.45 m 时会 publish_zero_velocity 并进入 safety_stop /
  blocked_waiting_clearance，nav2 那边**不会失败**，于是整轮就"看起来在导航、其实一动不动"，
  直到 escape_supervisor 累计受阻 40 s 才放弃 —— 用户看到的就是"窄道内无征兆的长时静止"。

本节点把这种静默状态变成 5 s 级、可诊断、可自愈的事件：
  1) 检测：有活跃导航目标 + 位移 < disp_eps 持续 >= stall_sec；
  2) 归因：区分"指令本来就是 0（车端安全闸/manager 让停）"与"有指令但车不走"；
  3) 处置：把当前位置作为受阻区上报给 frontier_arbiter（/escape_blocked_zone），
     并 cancel 当前 NavigateToPose 目标 —— 让仲裁立刻换一个候选，而不是干等 40~90 s；
  4) 取证：JSONL 记录 pose / cmd / 前向净空 / mode / last_error。

不碰 /scan、/map、/cmd_vel，只读 + 一次 cancel，可整节点关掉（enabled=false）。
"""
import json
import math
import time

import rclpy
from action_msgs.msg import GoalInfo, GoalStatusArray
from action_msgs.srv import CancelGoal
from geometry_msgs.msg import PoseStamped, Twist
from nav_msgs.msg import Odometry
from sensor_msgs.msg import LaserScan
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from rcl_interfaces.msg import Parameter, ParameterType
from rcl_interfaces.srv import SetParameters
from std_msgs.msg import Bool, String

ACTIVE = (1, 2, 3)          # ACCEPTED / EXECUTING / CANCELING


class ExploreWatchdog(Node):
    def __init__(self):
        super().__init__('explore_watchdog')
        d = self.declare_parameter
        d('enabled', True)
        d('stall_sec', 5.0)
        d('disp_eps', 0.03)
        d('cooldown_sec', 8.0)
        d('zone_radius_log', 1.0)
        # 返航期兜底（P0-1）：manager 有时会卡在"等活跃目标取消""再开始返航，
        # 表现为 nav_state 已进入 return 但车不动、也无新目标。这里主动 cancel-all 解锁。
        d('return_stall_sec', 8.0)
        d('return_cancel_max', 3)
        # P0-戊：受控小步倒车的"四向无净空"联合判定（用户批准口径）。
        # 只有当四个扇区的最小测距**都**小于 backstep_gate_m 时才允许车端 R1b 背退，
        # 否则动态把 exploration_retreat_enabled 置 false —— 这样"背退"严格限定在楔死场景。
        d('backstep_gate', True)
        d('backstep_gate_m', 0.50)
        d('scan_topic', '/scan')
        d('escape_assist_topic', '/escape_assist_active')
        # P0-甲：脱困单元正在执行时，看门狗不得取消目标（否则和 supervisor 抢）
        d('defer_to_escape', True)
        d('escape_request_topic', '/escape_request')
        d('odom_topic', '/odom_combined')
        d('cmd_topic', '/cmd_vel')
        d('nav_state_topic', '/stemm_cartographer/nav_state')
        d('status_topic', '/navigate_to_pose/_action/status')
        d('zone_topic', '/escape_blocked_zone')
        d('log_path', '')
        g = self.get_parameter
        self.enabled = bool(g('enabled').value)
        self.stall_sec = float(g('stall_sec').value)
        self.disp_eps = float(g('disp_eps').value)
        self.cooldown = float(g('cooldown_sec').value)
        self.log_path = str(g('log_path').value or '')
        self.return_stall_sec = float(g('return_stall_sec').value)
        self.return_cancel_max = int(g('return_cancel_max').value)
        self._return_since = None
        self._return_cancels = 0
        self.backstep_gate = bool(g('backstep_gate').value)
        self.backstep_gate_m = float(g('backstep_gate_m').value)
        self.defer_to_escape = bool(g('defer_to_escape').value)
        self.sect = None                 # (front, left, right, rear) 扇区最小测距
        self.escape_active = False
        self._gate_state = None          # 上一次写入的 exploration_retreat_enabled
        self._gate_last = 0.0
        self._gate_stats = {'allow': 0, 'deny': 0}

        self.pose = None
        self.cmd = (0.0, 0.0)
        self.goals = {}              # goal_id(hex) -> status
        self.nav = {}
        self.ref = None              # (t, x, y) 位移参考点
        self.last_fire = 0.0
        self.stalls = 0
        self.places = []             # [(x,y,t)] 近期卡死点

        self.create_subscription(Odometry, g('odom_topic').value, self.on_odom, 20)
        self.create_subscription(Twist, g('cmd_topic').value, self.on_cmd, 20)
        self.create_subscription(GoalStatusArray, g('status_topic').value, self.on_status, 10)
        self.create_subscription(String, g('nav_state_topic').value, self.on_nav, 10)
        self.pub_zone = self.create_publisher(PoseStamped, g('zone_topic').value, 10)
        self.cancel_cli = self.create_client(
            CancelGoal, g('status_topic').value.rsplit('/_action', 1)[0] + '/_action/cancel_goal')
        self.create_subscription(LaserScan, g('scan_topic').value, self.on_scan,
                                 qos_profile_sensor_data)
        self.create_subscription(Bool, g('escape_assist_topic').value,
                                 self.on_escape_active, 10)
        # P0-甲：静止时主动请求逃逸（supervisor 会做"旋转+前进/受控小步倒车"）
        self.pub_escape_req = self.create_publisher(Bool, g('escape_request_topic').value, 10)
        self.mgr_param_cli = self.create_client(
            SetParameters, '/stemm_cartographer_nav2_manager/set_parameters')
        self.create_timer(1.0, self.tick)
        self.get_logger().info(
            'explore_watchdog up: stall>=%.1fs disp<%.2fm cooldown=%.0fs enabled=%s'
            % (self.stall_sec, self.disp_eps, self.cooldown, self.enabled))

    # ---------- 输入 ----------
    def on_odom(self, m):
        p = m.pose.pose.position
        self.pose = (p.x, p.y)

    def on_cmd(self, m):
        self.cmd = (m.linear.x, m.angular.z)

    def on_status(self, m):
        self.goals = {bytes(g.goal_info.goal_id.uuid).hex(): g.status for g in m.status_list}

    def on_scan(self, m):
        """把一圈按 4 个扇区取最小测距（front/left/right/rear）。"""
        if not m.ranges:
            return
        n = len(m.ranges)
        inc = m.angle_increment
        a0 = m.angle_min

        def sector_min(lo_deg, hi_deg):
            lo = math.radians(lo_deg); hi = math.radians(hi_deg)
            best = float('inf')
            for i, r in enumerate(m.ranges):
                a = a0 + i * inc
                a = math.atan2(math.sin(a), math.cos(a))
                if not (lo <= a <= hi):
                    continue
                if not math.isfinite(r) or r <= 0.02:
                    continue
                if r < best:
                    best = r
            return best if math.isfinite(best) else 99.0

        self.sect = (sector_min(-30, 30), sector_min(30, 120),
                     sector_min(-120, -30), sector_min(150, 210))

    def on_escape_active(self, m):
        self.escape_active = bool(m.data)

    def backstep_gate_tick(self, now):
        """P0-戊：四向都贴脸才允许背退；否则禁止。"""
        if not self.backstep_gate or self.sect is None or now - self._gate_last < 3.0:
            return
        self._gate_last = now
        # 真机雷达后方是盲区（仿真用 scan_deadzone_relay 复刻），rear 会返回"无数据"。
        # 所以闸门只看**前/左/右**三向；后方由车端 R1b 自己的 /map 条带复核（rear_margin=0.25）兜底。
        front, left, right, rear = self.sect
        all_narrow = max(front, left, right) < self.backstep_gate_m
        want = all_narrow
        if want == self._gate_state:
            return
        if not self.mgr_param_cli.service_is_ready():
            if not self.mgr_param_cli.wait_for_service(timeout_sec=0.5):
                return
        req = SetParameters.Request()
        p = Parameter()
        p.name = 'exploration_retreat_enabled'
        p.value.type = ParameterType.PARAMETER_BOOL
        p.value.bool_value = want
        req.parameters = [p]
        self.mgr_param_cli.call_async(req)
        self._gate_state = want
        self._gate_stats['allow' if want else 'deny'] += 1
        self.get_logger().info(
            '背退闸：%s（前 %.2f / 左 %.2f / 右 %.2f m < 阈值 %.2f；后方 %.2f 由车端 /map 条带复核）'
            % ('放行' if want else '禁止', front, left, right, self.backstep_gate_m, rear))

    def on_nav(self, m):
        try:
            self.nav = json.loads(m.data or '{}')
        except Exception:               # noqa: BLE001 - 车端偶发非 JSON
            self.nav = {}

    # ---------- 判据 ----------
    def active_goals(self):
        return [k for k, v in self.goals.items() if v in ACTIVE]

    def record(self, row):
        if not self.log_path:
            return
        try:
            with open(self.log_path, 'a', encoding='utf-8') as f:
                f.write(json.dumps(row, ensure_ascii=False) + '\n')
        except Exception:               # noqa: BLE001
            pass

    def in_return(self):
        nav = self.nav or {}
        state = str(nav.get('navigation_state') or '')
        mode = str(nav.get('mode') or '')
        return (bool(nav.get('pending_home_goal'))
                or 'return_home' in state or 'return_home' in mode
                or mode in ('returning_home', 'finalizing_map'))

    def return_fallback(self, now):
        """P0-1：返航期"卡在等取消/等 TF"时的兜底（保守版，2026-10-24）。"""
        if not self.in_return():
            self._return_since = None
            self._return_cancels = 0
            return False
        # 终点 0.6 m 内属于"settle + 姿态宽限"阶段，取消目标只会破坏 manager 的终态判定
        dist_home = math.hypot(self.pose[0], self.pose[1]) if self.pose else 99.0
        if dist_home <= 0.6:
            self._return_since = now
            self._return_cancels = 0
            return True
        if self._return_since is None:
            self._return_since = now
            return False
        if now - self._return_since < self.return_stall_sec:
            return False
        state = str((self.nav or {}).get('navigation_state') or '')
        goals = self.active_goals()
        # 关键修正：只有"等取消/等 TF"这类**等待态**才主动取消；
        # returning_home+executing 是在正常导航，取消它会让 manager 判失败（实测返航失败 75%）。
        if 'waiting' not in state:
            if goals and now - getattr(self, '_last_ret_log', 0.0) > 10.0:
                self._last_ret_log = now
                self.get_logger().warn(
                    '返航中无进展 %.0fs @(%.2f,%.2f)（state=%s，距原点 %.2f m）—— 不取消目标，'
                    '交由 manager/脱困处理'
                    % (now - self._return_since, self.pose[0], self.pose[1], state, dist_home))
                self.record({'type': 'return_no_progress', 'state': state,
                             'dist_home': round(dist_home, 3),
                             'pos': [round(self.pose[0], 3), round(self.pose[1], 3)],
                             't': round(time.time(), 3)})
            self._return_since = now
            return True
        if goals:
            if self._return_cancels >= self.return_cancel_max:
                return True
            self._return_cancels += 1
            nav = self.nav or {}
            self.get_logger().warn(
                '返航兜底第 %d/%d 次：%d 个活跃目标未取消（state=%s mode=%s）→ 主动 cancel-all'
                % (self._return_cancels, self.return_cancel_max, len(goals),
                   nav.get('navigation_state'), nav.get('mode')))
            self.record({'type': 'return_cancel', 'attempt': self._return_cancels,
                         'active': len(goals), 'pos': [round(self.pose[0], 3), round(self.pose[1], 3)],
                         'state': nav.get('navigation_state'), 'mode': nav.get('mode'),
                         't': round(time.time(), 3)})
            self.cancel_active(goals)
        else:
            nav = self.nav or {}
            self.get_logger().warn(
                '返航待机但无活跃目标（state=%s mode=%s last_error=%s）—— 该分支 sim 侧无法解锁，'
                '已记录，等待 manager 自行推进'
                % (nav.get('navigation_state'), nav.get('mode'), nav.get('last_error')))
            self.record({'type': 'return_no_goal', 'state': nav.get('navigation_state'),
                         'mode': nav.get('mode'), 't': round(time.time(), 3)})
            self._return_since = now          # 避免刷屏
        self._return_since = now
        return True

    def tick(self):
        if not self.enabled or self.pose is None:
            return
        self.backstep_gate_tick(time.monotonic())
        # 返航期一律由返航兜底接管：此时"不动"既可能是等精确终态、也可能是真卡住，
        # 但**普通 5 s 静止取消在这里是有害的**（会把 manager 等待终态的目标提前取消，
        # 实测直接把返航从 0/2 失败推到 6/8 失败）。
        if self.in_return():
            self.return_fallback(time.monotonic())
            self.ref = None
            return
        goals = self.active_goals()
        if not goals:
            self.ref = None
            return
        now = time.monotonic()
        if self.ref is None:
            self.ref = (now, self.pose[0], self.pose[1])
            return
        t0, x0, y0 = self.ref
        moved = math.hypot(self.pose[0] - x0, self.pose[1] - y0)
        if moved >= self.disp_eps:
            self.ref = (now, self.pose[0], self.pose[1])
            return
        if now - t0 < self.stall_sec or now - self.last_fire < self.cooldown:
            return

        if self.defer_to_escape and self.escape_active:
            # P0-甲：supervisor 正在执行脱困单元（旋转+前进/受控小步倒车），此时取消目标只会打断它
            self.get_logger().info('静止 %.0fs 但脱困单元在跑 → 让位给 escape_supervisor'
                                   % (now - t0))
            self.record({'type': 'stall_deferred', 'stall_sec': round(now - t0, 2),
                         'pos': [round(self.pose[0], 3), round(self.pose[1], 3)],
                         't': round(time.time(), 3)})
            self.ref = (now, self.pose[0], self.pose[1])
            return
        cmd_zero = abs(self.cmd[0]) < 0.02 and abs(self.cmd[1]) < 0.05
        why = ('指令为 0（车端安全闸/manager 让停）' if cmd_zero
               else '有指令但车不动（轮子打滑/被压住）')
        front = self.nav.get('front_min_range')
        mode = self.nav.get('mode')
        state = self.nav.get('navigation_state')
        err = self.nav.get('last_error') or ''
        self.stalls += 1
        self.last_fire = now
        self.ref = (now, self.pose[0], self.pose[1])
        try:
            self.pub_escape_req.publish(Bool(data=True))
        except Exception:               # noqa: BLE001
            pass
        self.get_logger().warn(
            '静止超时 %.1fs @(%.2f,%.2f)：%s；cmd=(%.2f,%.2f) 前向=%.2fm mode=%s state=%s err=%s'
            % (now - t0, self.pose[0], self.pose[1], why, self.cmd[0], self.cmd[1],
               front if front is not None else -1.0, mode, state, err))
        self.record({'type': 'stall', 't': round(time.time(), 3),
                     'stall_sec': round(now - t0, 2), 'pos': [round(self.pose[0], 3),
                     round(self.pose[1], 3)], 'why': why,
                     'cmd': list(self.cmd), 'front_min_range': front,
                     'mode': mode, 'navigation_state': state, 'last_error': err})

        # 同一处反复卡死 → 记一次"顽固点"，供后续更长时间拉黑
        same = [p for p in self.places
                if math.hypot(p[0] - self.pose[0], p[1] - self.pose[1]) < 1.0
                and time.monotonic() - p[2] < 120.0]
        self.places.append((self.pose[0], self.pose[1], time.monotonic()))
        if same:
            self.get_logger().warn(
                '同一处 120 s 内第 %d 次静止：建议把 (%.2f,%.2f) 附近更长时间拉黑'
                % (len(same) + 1, self.pose[0], self.pose[1]))

        # 上报受阻区（frontier_arbiter 已在订阅）
        zone = PoseStamped()
        zone.header.frame_id = 'map'
        zone.header.stamp = self.get_clock().now().to_msg()
        zone.pose.position.x = float(self.pose[0])
        zone.pose.position.y = float(self.pose[1])
        zone.pose.orientation.w = 1.0
        self.pub_zone.publish(zone)

        # 取消当前目标 → 让仲裁立刻换候选（而不是干等 40 s）
        self.cancel_active(goals)

    def cancel_active(self, goals):
        """取消当前所有活跃目标。

        action_msgs/srv/CancelGoal 的约定：goal_info.goal_id.uuid 全 0 且 stamp 全 0
        ⇒ 取消该 action server 上的全部目标。这里就用这个最稳的写法。
        """
        if not self.cancel_cli.service_is_ready():
            self.get_logger().warn('cancel_goal 服务未就绪，本轮只上报受阻区')
            return
        req = CancelGoal.Request()
        req.goal_info = GoalInfo()          # 全零 = 取消全部
        fut = self.cancel_cli.call_async(req)

        def _done(f):
            try:
                res = f.result()
                n = len(res.goals_canceling)
            except Exception:               # noqa: BLE001
                n = -1
            self.get_logger().info(
                '静止自愈：已请求取消活跃目标（活跃 %d，服务回报取消 %d）' % (len(goals), n))
        fut.add_done_callback(_done)


def main():
    rclpy.init()
    node = ExploreWatchdog()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, Exception):
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
