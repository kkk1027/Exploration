#!/usr/bin/env python3
"""session_driver —— 仿真里的"小程序替身"。

职责（严格对齐实机口径）：
  1. 等探索真正开跑：以"收到第一个前沿目标 /assigned_frontier_goal"为起点开始计时。
  2. 到 explore_sec 秒后，调用与实机完全相同的那条服务
     `/stemm_cartographer/set_mapping_done`（std_srvs/SetBool data=True），
     它会让 cartographer_manager 进入 returning_home 并 shutdown_after_return_home。
  3. 跟踪返航：记录开始时刻、机器人相对 map 原点的距离，判到位（<0.25 m）或
     超过 self.hard_warn_sec（默认 300 s，仅告警不干预，同实机"无限时"）。
  4. 结束时（返航到位或进程收尾前）用 nav2_map_server 的 map_saver 存图到 map_out，
     只保留最新一份。
  5. 全程把关键时间点打到日志：探索用时 / 返航用时 / 结果。
"""
import math
import subprocess
import sys
import time

import rclpy
from geometry_msgs.msg import PoseStamped
from std_msgs.msg import String
from nav_msgs.msg import OccupancyGrid, Odometry
from rclpy.node import Node
from action_msgs.msg import GoalInfo
from action_msgs.srv import CancelGoal
from std_srvs.srv import SetBool
from nav2_msgs.action import NavigateToPose
from rclpy.action import ActionClient

MAP_FRAME = 'map'
HOME_RADIUS = 0.25
HARD_WARN_SEC = 300.0


class SessionDriver(Node):
    def __init__(self):
        super().__init__('sim_session_driver')
        self.explore_sec = float(self.declare_parameter('explore_sec', 180.0).value)
        self.map_out = self.declare_parameter(
            'map_out', '~/stemm_sim_ws/maps/explore_latest').value
        self.hard_warn = float(self.declare_parameter('hard_warn_sec', HARD_WARN_SEC).value)

        self.t_boot = time.monotonic()   # 栈启动时刻（看门狗基准）
        self.t_first_goal = None      # 探索起点
        self.t_done_called = None     # 调 set_mapping_done 的时刻
        self.return_home_ok = None
        self.last_goal_at = None
        self.done_sent = False
        self.finished = False

        self.create_subscription(PoseStamped, '/assigned_frontier_goal',
                                 self._on_goal, 10)
        self.create_subscription(Odometry, '/odom_combined', self._on_odom, 20)
        # 车端 manager 的返航完成信号（含"姿态超时后按位置完成"的兜底路径）
        self.create_subscription(String, '/stemm_cartographer/nav_state',
                                 self._on_nav_state, 10)
        # /map 是 RELIABLE+TRANSIENT_LOCAL（2 s/帧）；自己缓存最后一帧，结束时不依赖 map_saver 时机
        from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
        qos_map = QoSProfile(depth=1, reliability=ReliabilityPolicy.RELIABLE,
                             durability=DurabilityPolicy.TRANSIENT_LOCAL)
        self.map_msg = None
        self.create_subscription(OccupancyGrid, '/map', self._on_map, qos_map)
        self.cli = self.create_client(SetBool, '/stemm_cartographer/set_mapping_done')
        # P0-1：返航卡在"等活跃目标取消"时主动 cancel-all（零 UUID = 取消全部）
        self.cancel_cli = self.create_client(
            CancelGoal, '/navigate_to_pose/_action/cancel_goal')
        self._cancel_sent = 0
        self.pose_xy = None
        # ===== 返航前"挪一步"兜底（2026-10-24）=====
        # 实测最主要的残余失败模式：探索时间到时车停在贴障位置，车端 manager 以
        # "current pose is too close to occupied /map cells" / "front obstacle
        # too close" 拒绝派返航，且只重试 3 次 × 2 s（6 秒耗尽）、不会先挪开。
        # 272 轮历史里这条消息命中 21 轮（7.7%）。
        # 做法：结束建图**之前**判断"是否停得太贴障"，是就先派一个 ≤0.6 m 的
        # 接管点（朝地图净空最大的方向）让车挪开，到位/超时后再结束建图。
        # 放在 set_mapping_done 之前是关键——这样不消耗 manager 的返航重试预算。
        self.standoff_enabled = bool(self.declare_parameter('standoff_enabled', True).value)
        # 与车端自身的安全门限对齐：车端是 front < 0.45 m 就 publish_zero_velocity /
        # safety_stop，"停得太贴"的判定用同一个量级才不会漏（日志实测 0.28 m / 0.56 m 两档）
        self.standoff_trigger = float(self.declare_parameter('standoff_trigger_m', 0.45).value)
        self.standoff_goal = float(self.declare_parameter('standoff_goal_m', 0.60).value)
        self.standoff_timeout = float(
            self.declare_parameter('standoff_timeout_sec', 8.0).value)
        self.standoff_max = int(self.declare_parameter('standoff_max', 2).value)
        self._standoff_pending = False
        self._standoff_target = None
        self._standoff_deadline = 0.0
        self._standoff_started = 0.0
        self._standoff_count = 0
        self.nav_cli = ActionClient(self, NavigateToPose, 'navigate_to_pose')
        self._start_clock_resampler_for_return()   # 栈启动即启用（滞后插值，不会超前引擎时间）
        self.create_timer(1.0, self._tick)
        self.get_logger().info(
            f'session_driver 就绪：探索限时 {self.explore_sec:.0f}s（从收到第一个探索目标算起）；'
            f'返航不限时（>{self.hard_warn:.0f}s 仅告警）；地图输出 {self.map_out}')


    # ---- 运行时 use_sim_time 补丁 -----------------------------------------
    # 车端 launch 里有若干节点（已确认：mapping_tf_guard）没有把 use_sim_time 传下去，
    # 它们在仿真里会用墙钟 now() 去比较仿真的 TF 时间戳，于是判定 TF"永不新鲜"。
    # 这里在探索栈起来后补一次运行时参数（rclcpp 支持运行时切换），不改车端源码。
    SIM_TIME_TARGETS = [
        'stemm_cartographer_mapping_tf_guard',
        'stemm_cartographer_nav2_manager',
    ]

    def _patch_sim_time(self):
        import os
        env = dict(os.environ)
        env['ROS_DOMAIN_ID'] = os.environ.get('ROS_DOMAIN_ID', '42')
        src = ('source /opt/ros/humble/setup.bash && '
               'source /home/kbf/stemm_sim_ws/install/setup.bash && '
               'source /home/kbf/stemm_explore_ws/install/setup.bash')
        done = []
        for name in self.SIM_TIME_TARGETS:
            for attempt in range(3):
                r = subprocess.run(['bash', '-c', f'{src} && ros2 param set /{name} use_sim_time true'],
                                   capture_output=True, text=True, env=env, timeout=20)
                out = (r.stdout or '').strip() or (r.stderr or '').strip()
                if r.returncode == 0 and 'True' in out:
                    done.append(name)
                    break
                time.sleep(1.0)
        self.get_logger().info(f'use_sim_time 运行时补丁：成功 {done}；目标 {self.SIM_TIME_TARGETS}')

    # ---- 回调 -----------------------------------------------------------
    def _on_goal(self, _msg):
        now = time.monotonic()
        self.last_goal_at = now
        if self.t_first_goal is None:
            self.t_first_goal = now
            self.get_logger().info('=== 自主探索开始计时（收到第一个前沿目标）===')

    def _on_nav_state(self, msg):
        txt = (msg.data or '').lower()
        # 严格判定：finalizing_* / returning_home 只是"准备返航"，不能算完成。
        # 只有明确的完成态，或"位置达成"类措辞才算。
        is_done = ('return_home_complete' in txt
                   or 'home_reached' in txt
                   or ('complete' in txt and 'finalizing' not in txt
                       and 'returning' not in txt and 'pending' not in txt))
        if self.return_home_ok is None and is_done:
            d = None
            if self.pose_xy is not None:
                d = math.hypot(self.pose_xy[0], self.pose_xy[1])
            self.return_home_ok = True
            self.get_logger().info(
                f'=== 返航完成（manager 状态：{msg.data[:40]}），'
                f'距 map 原点 {d if d is None else round(d, 3)} m ===' if d is not None
                else f'=== 返航完成（manager 状态：{msg.data[:40]}），距原点未测到 ===')
            self._finish()

    def _on_map(self, msg):
        self.map_msg = msg

    def _on_odom(self, msg):
        self.pose_xy = (msg.pose.pose.position.x, msg.pose.pose.position.y)
        # P0-返航兜底过度：记录最近若干秒的位置序列，用来判断"车是不是真没动"。
        # 背景：下面那段"返航未启动→重发 set_mapping_done→cancel-all"的兜底，
        # 原判据只有 return_home_ok is None —— 它不知道 manager 其实已经派出返航
        # 目标、车正在往回开，于是每轮都无条件打 3 次 cancel-all，把 manager 的
        # 3 次返航重试预算全部吃掉（实测 V0/V1/V2 **每一轮**都是 3/3 用满）。
        # 预算一满就零容错：只要再有一次干扰（如 front obstacle 重试）就整轮返航失败。
        hist = getattr(self, '_pose_hist', None)
        if hist is None:
            hist = self._pose_hist = []
        hist.append((time.monotonic(), self.pose_xy[0], self.pose_xy[1]))
        if len(hist) > 200:                  # 里程计 ~20 Hz，200 条≈10 s
            del hist[:len(hist) - 200]

    # ---- 返航前"挪一步" ---------------------------------------------
    def _grid_params(self):
        """(data, res, w, h, ox, oy) 或 None。"""
        m = self.map_msg
        if m is None:
            return None
        try:
            info = m.info
            res = float(info.resolution)
            if res <= 0:
                return None
            return (m.data, res, int(info.width), int(info.height),
                    float(info.origin.position.x), float(info.origin.position.y))
        except Exception:                              # noqa: BLE001
            return None

    def _cell(self, g, i, j):
        data, _res, w, h, _ox, _oy = g
        if not (0 <= i < w and 0 <= j < h):
            return 100                                 # 图外当障碍
        try:
            return int(data[j * w + i])
        except Exception:                              # noqa: BLE001
            return 100

    def map_clearance(self, x, y, scan_m=1.20):
        """车所在格到最近占据格的距离（m）；图不在/无数据返回 None。

        只关心"占据"（>=50）；未知格不算障碍——manager 的拒派判据也是看 occupied。
        """
        g = self._grid_params()
        if g is None:
            return None
        _data, res, w, h, ox, oy = g
        ci, cj = int((x - ox) / res), int((y - oy) / res)
        rmax = max(1, int(scan_m / res))
        best = None
        for r in range(0, rmax + 1):
            hit = False
            for dj in range(-r, r + 1):
                for di in range(-r, r + 1):
                    if max(abs(di), abs(dj)) != r:
                        continue
                    if self._cell(g, ci + di, cj + dj) >= 50:
                        hit = True
                        break
                if hit:
                    break
            if hit:
                best = r * res
                break
        # 扫描半径内没有占据格 = 很开阔（返回扫描半径，而不是 None）——
        # 返回 None 会被上层当成"没有地图"，那是两回事。
        return scan_m if best is None else best

    def pick_standoff(self, x, y, max_len=0.60, need_m=0.45, margin=0.85):
        """在地图里找一个"能站得住"的接管点：朝净空最大的方向走 max_len。

        判定：该方向上连续所有格都必须已知自由（0<=v<50），且落点半径 need_m 内
        没有占据格。找不到就返回 None（宁可不挪）。
        """
        g = self._grid_params()
        if g is None:
            return None
        _data, res, w, h, ox, oy = g
        ci, cj = int((x - ox) / res), int((y - oy) / res)
        best_len, best = 0.0, None
        for k in range(24):
            ang = 2.0 * math.pi * k / 24.0
            ca, sa = math.cos(ang), math.sin(ang)
            reach = 0.0
            step = res
            while reach + step <= max_len + 1e-9:
                reach += step
                i = ci + int(round(ca * reach / res))
                j = cj + int(round(sa * reach / res))
                if not (0 <= self._cell(g, i, j) < 50):
                    break
            if reach < need_m:
                continue
            r = reach * margin
            i = ci + int(round(ca * r / res))
            j = cj + int(round(sa * r / res))
            cx, cy = ox + (i + 0.5) * res, oy + (j + 0.5) * res
            if self.map_clearance(cx, cy, scan_m=need_m) is not None \
                    and self.map_clearance(cx, cy, scan_m=need_m) < need_m * 0.85:
                continue
            if reach > best_len:
                best_len, best = reach, (cx, cy)
        return best

    def _pick_standoff_if_tight(self):
        if not self.standoff_enabled or self.pose_xy is None:
            return None
        if self._standoff_count >= self.standoff_max:
            return None
        clr = self.map_clearance(self.pose_xy[0], self.pose_xy[1])
        if clr is None or clr >= self.standoff_trigger:
            return None
        goal = self.pick_standoff(self.pose_xy[0], self.pose_xy[1], self.standoff_goal)
        if goal is None:
            return None
        self.get_logger().warn(
            '探索结束时车停得太贴障（地图净空 %.2f m < %.2f m）→ 先挪到接管点 '
            '(%.2f,%.2f) 再结束建图' % (clr, self.standoff_trigger, goal[0], goal[1]))
        return goal

    def _send_standoff(self, goal):
        if not self.nav_cli.wait_for_server(timeout_sec=2.0):
            self.get_logger().warn('接管点：navigate_to_pose 不可用，跳过（直接结束建图）')
            return False
        msg = NavigateToPose.Goal()
        msg.pose.header.frame_id = MAP_FRAME
        msg.pose.header.stamp = self.get_clock().now().to_msg()
        msg.pose.pose.position.x = float(goal[0])
        msg.pose.pose.position.y = float(goal[1])
        msg.pose.pose.orientation.w = 1.0
        try:
            self.nav_cli.send_goal_async(msg)
        except Exception as exc:                       # noqa: BLE001
            self.get_logger().warn(f'接管点派发失败（忽略）：{exc}')
            return False
        self._standoff_count += 1
        return True

    def _moved_recently(self, win_sec=4.0, thr_m=0.06):
        """最近 win_sec 内位移是否超过 thr_m（True=还在动）。"""
        hist = getattr(self, '_pose_hist', None)
        if not hist:
            return False
        now = time.monotonic()
        old = [h for h in hist if now - h[0] >= win_sec]
        if not old:
            return False
        t0, x0, y0 = old[-1]
        return math.hypot(self.pose_xy[0] - x0, self.pose_xy[1] - y0) >= thr_m

    # ---- 主循环 ---------------------------------------------------------
    def _tick(self):
        if self.finished:
            return
        now = time.monotonic()

        # 阶段1：等探索开始（带看门狗：60 s 无第一个前沿目标 → 记异常并尝试重新使能）
        if self.t_first_goal is None:
            if (not getattr(self, '_wd_warned', False)
                    and now - self.t_boot > 60.0):
                self._wd_warned = True
                self.get_logger().error(
                    '探索看门狗：启动 60 s 内未收到任何前沿目标 —— 本轮记为异常，尝试重新使能 auto_explore')
                try:
                    subprocess.run(['bash', '-lc',
                        'source /opt/ros/humble/setup.bash && '
                        'source /home/kbf/stemm_sim_ws/install/setup.bash && '
                        'source /home/kbf/stemm_explore_ws/install/setup.bash && '
                        'export ROS_DOMAIN_ID=42 && '
                        'ros2 param set /stemm_cartographer_nav2_manager auto_explore true'],
                        timeout=20, check=False)
                except Exception:
                    pass
            return

        # 阶段2：到点则触发"结束建图"（与实机同一条服务）
        if not self.done_sent:
            if now - self.t_first_goal >= self.explore_sec:
                if self._standoff_pending:
                    arrived = (self.pose_xy is not None and self._standoff_target is not None
                               and math.hypot(self.pose_xy[0] - self._standoff_target[0],
                                              self.pose_xy[1] - self._standoff_target[1]) <= 0.25)
                    if not arrived and now < self._standoff_deadline:
                        return                       # 还在往接管点挪
                    self._standoff_pending = False
                    self.get_logger().info(
                        '=== 返航前接管点：%s（用时 %.1fs），继续结束建图 ==='
                        % ('已到位' if arrived else '超时放弃', now - self._standoff_started))
                else:
                    goal = self._pick_standoff_if_tight()
                    if goal is not None and self._send_standoff(goal):
                        self._standoff_pending = True
                        self._standoff_target = goal
                        self._standoff_started = now
                        self._standoff_deadline = now + self.standoff_timeout
                        return
                self.get_logger().info(
                    f'=== 探索限时到（{self.explore_sec:.0f}s），调用 set_mapping_done 结束建图 ===')
                self.t_done_called = now
                self.done_sent = True
                self._start_clock_resampler_for_return()
                self._call_done()
            return

        # 阶段3：跟踪返航。返航一开始就滚动存图（每 2 s 一次），
        # 因为 manager 判定到位后会立刻 SIGINT 整个进程组，末次存图有机会抢不到。
        if (self.map_msg is not None
                and now - getattr(self, '_last_roll_save', 0.0) > 2.0):
            self._last_roll_save = now
            try:
                self._write_map_files()
            except Exception as exc:                 # noqa: BLE001
                self.get_logger().warn(f'滚动存图失败（忽略）：{exc}')
        # 若卡在"等活跃目标取消"，每 6 s 重发一次 set_mapping_done
        # （重发在目标结束后会命中 _dispatch_pending_home_goal 分支）
        # 只在"车真的没在动"时才走这条兜底：车还在往回家方向开的时候去 cancel-all，
        # 等于把 manager 已经发起的返航目标掐掉，纯属自伤（实测占全部返航失败的 100%）。
        if (self.return_home_ok is None and self.t_done_called is not None
                and not self._moved_recently()
                and now - self.t_done_called > 3.0
                and now - self.t_done_called > 3.0 * (getattr(self, '_retries', 0) + 1)
                and getattr(self, '_retries', 0) < 10):
            self._retries = getattr(self, '_retries', 0) + 1
            self.get_logger().warn(
                f'返航未启动，第 {self._retries} 次重发 set_mapping_done（等活跃目标取消可能卡住）')
            try:
                self._call_done()
                # P0-1：连续 3 次重发仍不启动 ⇒ 判定"等活跃目标取消卡住"，主动 cancel-all
                if self._retries >= 3 and self._cancel_sent < 2:
                    self._cancel_sent += 1
                    self._cancel_all_goals()
            except Exception as exc:                 # noqa: BLE001
                self.get_logger().error(f'重试/取消兜底异常（已忽略）：{type(exc).__name__}: {exc}')
        dist = None
        if self.pose_xy is not None:
            dist = math.hypot(self.pose_xy[0], self.pose_xy[1])
        elapsed = now - self.t_done_called
        # 备用完成判据：manager 明确完成态 60 s 未到时，用"回到原点附近"兜底
        if (self.return_home_ok is None and dist is not None
                and elapsed > 60.0 and dist <= 0.30):
            self.return_home_ok = True
            self.get_logger().info(
                f'=== 返航完成（备用判据：距 map 原点 {dist:.3f} m ≤0.30，'
                f'manager 未给完成态，用时 {elapsed:.1f}s）===')
            self._finish()
            return
        if dist is not None and dist <= HOME_RADIUS and self.return_home_ok is None:
            self.return_home_ok = True
            self.get_logger().info(
                f'=== 返航到位：距 map 原点 {dist:.3f} m，返航用时 {elapsed:.1f}s ===')
            self._finish()
        elif self.return_home_ok is None and elapsed > self.hard_warn:
            if not getattr(self, '_warned', False):
                self._warned = True
                self.get_logger().warn(
                    f'!!! 返航已 {elapsed:.0f}s 仍未到位（当前距原点 '
                    f'{dist if dist is None else round(dist, 2)} m）—— 实机为无限时，'
                    f'此处仅告警，请人工判断是否卡死')

    def _start_clock_resampler_for_return(self):
        """返航阶段启用时钟细化：探索期关（cartographer 对 TF 新鲜度敏感），
        返航期开（Nav2 的 now() 需要细粒度，否则 coarse 10 Hz 时钟会导致
        'Extrapolation Error looking up target frame'）。"""
        if getattr(self, '_clk', None) is not None:
            return
        import os
        env = dict(os.environ)
        env['ROS_DOMAIN_ID'] = os.environ.get('ROS_DOMAIN_ID', '42')
        try:
            self._clk = subprocess.Popen(
                ['bash', '-lc',
                 'source /opt/ros/humble/setup.bash && '
                 'source /home/kbf/stemm_sim_ws/install/setup.bash && '
                 'exec ros2 run wheeltec_two_wheel_model sim_clock_resampler'],
                env=env)
            self.get_logger().info('返航阶段已启用时钟细化节点（2 ms）')
        except Exception as exc:                     # noqa: BLE001
            self.get_logger().warn(f'启用时钟细化失败：{exc}')

    def _stop_clock_resampler(self):
        c = getattr(self, '_clk', None)
        if c is not None:
            try:
                c.terminate()
            except Exception:
                pass
            self._clk = None

    def _call_done(self):
        if not self.cli.wait_for_service(timeout_sec=10.0):
            self.get_logger().error('set_mapping_done 服务不可用（10s 超时）—— 探索栈可能未起来')
            return
        req = SetBool.Request()
        req.data = True
        fut = self.cli.call_async(req)
        fut.add_done_callback(lambda f: self.get_logger().info(
            f'set_mapping_done 返回：{f.result()}'))

    def _finish(self):
        self.finished = True
        self._stop_clock_resampler()
        explore = (self.t_done_called - self.t_first_goal) if self.t_done_called else None
        ret = (time.monotonic() - self.t_done_called) if self.t_done_called else None
        self.get_logger().info(
            f'=== 会话结束汇总：探索 {explore if explore is None else round(explore,1)}s'
            f' + 返航 {ret if ret is None else round(ret,1)}s；返航成功={self.return_home_ok} ===')
        self._save_map()

    def _write_map_files(self):
        """用缓存的 /map 一帧自己写 pgm+yaml（nav2 口径：free=254 occupied=0 unknown=205）"""
        import os
        msg = self.map_msg
        if msg is None:
            return False
        w, h, res = msg.info.width, msg.info.height, msg.info.resolution
        img = bytearray(w * h)
        for i, v in enumerate(msg.data):
            if v < 0:
                img[i] = 205
            elif v >= 65:
                img[i] = 0
            elif v <= 25:
                img[i] = 254
            else:
                img[i] = 205
        out = os.path.expanduser(self.map_out)
        os.makedirs(os.path.dirname(out) or '.', exist_ok=True)
        with open(out + '.pgm', 'wb') as fh:
            fh.write(b'P5\n%d %d\n255\n' % (w, h))
            fh.write(bytes(img))
        o = msg.info.origin
        with open(out + '.yaml', 'w', encoding='utf-8') as fh:
            fh.write(f'image: {os.path.basename(out)}.pgm\n'
                     f'mode: trinary\nresolution: {res}\n'
                     f'origin: [{o.position.x}, {o.position.y}, 0.0]\n'
                     f'negate: 0\noccupied_thresh: 0.65\nfree_thresh: 0.196\n')
        return True

    def _cancel_all_goals(self):
        """P0-1：取消 /navigate_to_pose 上的全部目标（零 UUID）。

        action_msgs/srv/CancelGoal 的约定：goal_info.goal_id.uuid 与 stamp 全 0 ⇒ 取消全部。
        manager 的"等活跃目标取消"分支因此可以继续推进，不必等它自己超时。
        """
        if not self.cancel_cli.wait_for_service(timeout_sec=1.0):
            self.get_logger().warn('cancel_goal 服务不可用，跳过主动取消')
            return
        req = CancelGoal.Request()
        req.goal_info = GoalInfo()
        fut = self.cancel_cli.call_async(req)
        self.get_logger().warn(
            f'返航兜底：主动 cancel-all 第 {self._cancel_sent} 次（清掉卡住的活跃目标）')

        def _done(f):
            try:
                n = len(f.result().goals_canceling)
            except Exception:                        # noqa: BLE001
                n = -1
            self.get_logger().info(f'cancel-all 完成：取消 {n} 个目标')
        fut.add_done_callback(_done)

    def _save_map(self):
        out = self.map_out
        if self._write_map_files():
            self.get_logger().info(f'已用缓存 /map 写图：{out}.pgm/.yaml')
            return
        self.get_logger().info(f'保存地图到 {out}（只保留最新一份）')
        try:
            subprocess.run(
                ['bash', '-lc',
                 'source /opt/ros/humble/setup.bash && '
                 'source /home/kbf/stemm_sim_ws/install/setup.bash && '
                 'source /home/kbf/stemm_explore_ws/install/setup.bash && '
                 f'export ROS_DOMAIN_ID=42 && '
                 f'ros2 run nav2_map_server map_saver_cli -f {out}'],
                timeout=60, check=False)
        except Exception as exc:                     # noqa: BLE001
            self.get_logger().warn(f'存图失败：{exc}')


def main():
    rclpy.init()
    node = SessionDriver()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        if not node.finished:
            node.get_logger().warn('中断退出：会话未走到返航到位，仍尝试存图')
            node._save_map()
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
