#!/usr/bin/env python3
"""vision_obstacle_grid —— 深度相机 → 视觉障碍（方案A 的感知源）。

为什么需要它（来自 P0 验收记录 §3b）：
  2D 雷达扫描面在 z=0.225 m，cafe_table 只有 4.2 cm 细立柱能进图，
  4 cm 厚、56 cm 见方的贴地底板完全不可见 → 规划器绕开立柱、车身从底板上碾过去。
  深度相机（光心 0.26 m，俯视下缘 22.85°，地面可视起点 ≈ 0.62 m）正好覆盖这一层。

输出（全部沿用实机 stemm_vision_mapping 的话题契约，仿真/实机同一套参数）：
  /vision/live_cloud      PointCloud2  map 帧，当前帧滤波后的点（去掉自身+超界）→ local_costmap 体素层
  /vision/obstacle_cloud  PointCloud2  map 帧，累积障碍点（只增不减）→ global_costmap 障碍层
  /vision/obstacle_grid   OccupancyGrid map 帧，累积障碍 2D 栅格（0.05 m）→ RViz/存盘/StaticLayer
  /vision/low_cloud       PointCloud2  map 帧，低矮带（0.05~0.35 m）子集 → 取证/可视化

设计原则：
  * 只增不减（累积），与"激光盲区障碍"的语义一致；
  * 单格最少点数滤波（min_points_per_cell），避免孤立噪点把栅格撑大；
  * 自身过滤用 self_filter_radius（以机器人原点为圆心的 XY 半径），防止把车体自己标成障碍；
  * 任何 TF/数据异常只告警不崩，nav2 侧层失效时退化为纯雷达（可回退）。
"""
import math
import os

import numpy as np
import rclpy
import tf2_ros
from nav_msgs.msg import OccupancyGrid
from rcl_interfaces.msg import ParameterDescriptor
from rclpy.node import Node
from rclpy.qos import (DurabilityPolicy, QoSProfile, ReliabilityPolicy)
from rclpy.time import Time
from rclpy.duration import Duration
from sensor_msgs.msg import PointCloud2, PointField


def quat_to_matrix(q):
    x, y, z, w = q.x, q.y, q.z, q.w
    n = math.sqrt(x * x + y * y + z * z + w * w) or 1.0
    x, y, z, w = x / n, y / n, z / n, w / n
    return np.array([
        [1 - 2 * (y * y + z * z), 2 * (x * y - z * w), 2 * (x * z + y * w)],
        [2 * (x * y + z * w), 1 - 2 * (x * x + z * z), 2 * (y * z - x * w)],
        [2 * (x * z - y * w), 2 * (y * z + x * w), 1 - 2 * (x * x + y * y)],
    ])


def cloud_msg(pts, frame_id, stamp):
    msg = PointCloud2()
    msg.header.stamp = stamp
    msg.header.frame_id = frame_id
    msg.height = 1
    msg.width = int(pts.shape[0])
    msg.fields = [
        PointField(name='x', offset=0, datatype=PointField.FLOAT32, count=1),
        PointField(name='y', offset=4, datatype=PointField.FLOAT32, count=1),
        PointField(name='z', offset=8, datatype=PointField.FLOAT32, count=1),
    ]
    msg.is_bigendian = False
    msg.point_step = 12
    msg.row_step = 12 * int(pts.shape[0])
    msg.is_dense = True
    msg.data = np.ascontiguousarray(pts, dtype=np.float32).tobytes()
    return msg


class VisionObstacleGrid(Node):
    def __init__(self):
        super().__init__('vision_obstacle_grid')
        # ★ 2026-10-28：数值型 launch 参数会以 INTEGER 传入（如 live_ttl_sec:=8），
        # 而 declare(double) 遇到 int 会抛 InvalidParameterTypeException 当场崩
        # （本项目已踩过 bool 版同样的坑）。这里对数值开关一律 dynamic_typing，
        # 再用 float() 归一化。
        _DYN = ParameterDescriptor(dynamic_typing=True)

        def d(name, default, descriptor=None):
            return self.declare_parameter(name, default, descriptor or _DYN)
        d('cloud_topic', '/camera/depth/points')
        d('global_frame', 'map')
        d('live_topic', '/vision/live_cloud')
        d('cloud_topic_out', '/vision/obstacle_cloud')
        d('grid_topic', '/vision/obstacle_grid')
        d('low_topic', '/vision/low_cloud')
        d('resolution', 0.05)
        d('tf_use_stamp', True)      # True=按点云时间戳取 TF（修鬼影）；False=旧行为（最新 TF）
        d('tf_debug', False)         # ★ 2026-10-28 取证用：打印本节点 tf buffer 已知帧表
        d('z_min', 0.05)
        d('z_max', 1.80)
        d('low_z_min', 0.05)
        d('low_z_max', 0.35)
        d('range_max', 5.0)
        d('range_min', 0.25)
        d('self_filter_radius', 0.38)
        d('min_points_per_cell', 2)
        # 跨帧持久化：同一格必须在 >= min_frames 帧里都被观测到才算障碍。
        # 目的：抑制掠射角/深度噪点在地面与墙根产生的"幽灵格"（它们会无谓地挤窄通道）
        d('min_frames', 2)
        d('max_points', 120000)
        d('live_hz', 5.0)
        d('accum_hz', 1.0)
        d('max_side_cells', 6000)
        d('obstacle_z', 0.15)
        d('live_voxel', 0.05)
        # 收尾时把累积栅格落盘（事故复盘用；空=不落盘）
        d('dump_path', '')
        # 局部体素层的源必须发在**传感器/车体**帧：nav2 用 cloud 的 frame 原点当"传感器原点"
        # 做射线清除，若发在 map 帧，射线就从地图原点打出去、会把真实障碍擦掉。
        d('live_frame', 'base_footprint')
        # P1-1：累积障碍膨胀（格）。视觉看到的是物体表面，机器人有半宽；
        # 膨胀 1 格（5 cm）可覆盖"擦着边过去"的残余接触。
        d('dilate_cells', 1)
        # P0-己：幽灵障碍——累积格若长期没被再次观测就淡出（0=永不衰减，维持旧行为）。
        # 视觉看到的是物体表面，家具被挪走后旧格会永久堵路；默认 120 s 慢衰减。
        d('decay_sec', 120.0)
        # ★ 2026-10-28 改动1（默认关）：旋转期间不写累积层。
        #   鬼影的成因之一是"同一表面在旋转中被贴到多个位置"，而累积层 clearing=False，
        #   一旦写进去就再也擦不掉。旋转（|ω|>阈值）时只发 live 云给局部层，
        #   停稳后再累积，从源头消掉旋转鬼影。0 = 关闭（保持旧行为）。
        d('omega_gate', 0.0)
        # ★ 2026-10-28 改动3a（默认关）：短 TTL 云 /vision/live_ttl_cloud。
        #   局部代价地图的 VoxelLayer 只会清"当前观测包围盒内、被 raytrace 打到"的格，
        #   于是转动时看到的格一旦离开视野就永久残留（实测 raw_lethal 2250→5453 单调不减）。
        #   这里维护一份"短记忆"（默认 TTL 秒），只保留最近 TTL 内观测到的格，
        #   再转回机身帧发布 —— 不再被观测的格会自动退场，绕开上面的语义。
        # ★ 2026-10-28 C1：云的时间戳是否"取点云采集时刻"。
        #   旧行为用 self.get_clock().now()（发布时刻），而点云是 0~0.2 s 前采集的；
        #   nav2 按 stamp 取 TF ⇒ 等于"用发布时刻的位姿去贴 0.2 s 前的点"。
        #   转动 1.2 rad/s 时角误差可达 0.24 rad、3 m 处错位 0.7 m（厚包络/长舌头的成因）。
        # ★ 2026-10-28 方案A：自由射线云 /vision/free_rays（默认关）。
        #   按相机 FOV 每 step 度一条射线，长度取该角度**最近回波**（无则 free_ray_max），
        #   由局部代价地图的一条 marking=False/clearing=True 源做 raytrace 清障。
        #   这样"以前转过、现在又被看到"的方向会被真正清掉，而不是永久残留。
        d('free_rays', 0)                  # 1=启用
        d('free_ray_topic', '/vision/free_rays')
        d('free_ray_fov_deg', 60.0)        # 相机水平视场（保守值，宁窄不宽）
        d('free_ray_step_deg', 1.0)
        d('free_ray_max', 5.0)             # 射线最长（= 视觉有效距离）
        d('free_ray_margin', 0.10)         # 末端留 10 cm，绝不穿过实体
        d('free_ray_hz', 5.0)
        d('stamp_from_cloud', True)
        # ★ 2026-10-28 C2：累积层发布前做形态学开运算的核（0=关；1=3×3 十字核）。
        #   只作用于**累积**云/栅格，live 云不受影响（局部实时感知不被削）。
        d('open_kernel', 0)
        d('live_ttl_sec', 0.0)          # 0=关闭（旧行为，只发 /vision/live_cloud）
        d('ttl_topic', '/vision/live_ttl_cloud')
        d('ttl_min_pts', 1)             # 单帧内至少几个点才算该格（比累积层的 min_points 松）
        d('odom_topic', '/odom_combined')
        # P9-⑧（2026-10-27 用户批准）：**累积层**（-> /vision/obstacle_cloud -> 全局代价地图）
        # 的独立衰减窗口。原来累积层与实时层共用 decay_sec（实验口径 20 s），结果
        # "视觉看到过的低矮物体"20 s 后就被遗忘，全局规划器随后直接横穿它
        # （s0ar1：卡在健身器材上、轮子空转，而 /map 与雷达都认为那里是空的）。
        # -1 = 沿用 decay_sec（保持旧行为）。
        d('accum_decay_sec', -1.0)
        # P9-⑧b（2026-10-27 用户批准"继续"）：**低矮带单独累积**。
        # 上一步（全带累积 120 s）机制没错但覆盖 -17.8%，因为高带视觉点太多、太吵。
        # 而雷达看不见的恰恰只有低矮带（z 0.05~0.35 m：哑铃、器材底座、床头柜脚）——
        # 高障碍雷达自己就能看见，无需视觉再记一遍。故只把低矮带做"累积+不清除"，
        # 高带仍走 live（局部体素层）。代价最小、最对准事故类型。
        d('low_accum_topic', '/vision/low_accum_cloud')
        d('low_accum_decay_sec', 120.0)

        g = self.get_parameter
        self.cloud_topic = g('cloud_topic').value
        self.global_frame = g('global_frame').value
        self.res = float(g('resolution').value)
        self.tf_use_stamp = bool(g('tf_use_stamp').value)
        self.tf_debug = bool(g('tf_debug').value)   # ★ 2026-10-28 取证开关
        self.z_min = float(g('z_min').value)
        self.z_max = float(g('z_max').value)
        self.low_z = (float(g('low_z_min').value), float(g('low_z_max').value))
        self.range_max = float(g('range_max').value)
        self.range_min = float(g('range_min').value)
        self.self_r = float(g('self_filter_radius').value)
        self.min_pts = max(1, int(g('min_points_per_cell').value))
        self.min_frames = max(1, int(g('min_frames').value))
        self.max_points = int(g('max_points').value)
        self.max_side = int(g('max_side_cells').value)
        self.obstacle_z = float(g('obstacle_z').value)
        self.live_voxel = max(0.01, float(g('live_voxel').value))
        self.dump_path = str(g('dump_path').value or '')
        self.live_frame = str(g('live_frame').value or 'base_footprint')
        self.dilate = max(0, int(g('dilate_cells').value))
        self.decay = float(g('decay_sec').value)
        self.omega_gate = max(0.0, float(g('omega_gate').value))
        self.free_rays = int(g('free_rays').value) == 1
        self.free_fov = float(g('free_ray_fov_deg').value)
        self.free_step = max(0.2, float(g('free_ray_step_deg').value))
        self.free_max = float(g('free_ray_max').value)
        self.free_margin = float(g('free_ray_margin').value)
        self.stamp_from_cloud = bool(g('stamp_from_cloud').value)
        self.open_kernel = max(0, int(g('open_kernel').value))
        self._cloud_stamp = None      # 最近一帧点云的采集时刻
        self.live_ttl = max(0.0, float(g('live_ttl_sec').value))
        self.ttl_min_pts = max(1, int(g('ttl_min_pts').value))
        self.ttl_cells = {}      # 格 -> 最后一次观测（monotonic）
        self.omega = None            # 由 odom_topic 的 twist.angular.z 提供
        self._gated_frames = 0
        _ad = float(g('accum_decay_sec').value)
        self.accum_decay = _ad if _ad >= 0.0 else self.decay
        self.low_accum_decay = float(g('low_accum_decay_sec').value)

        self.cells = set()
        self.low_cells = set()      # 低矮带累积格（-> 全局代价地图的"视觉低障碍"层）
        self.low_seen = {}          # 低矮带格 -> 最后观测时刻
        self.hits = {}          # 格 → 被观测到的帧数（跨帧持久化）
        self.seen_at = {}       # 格 → 最后一次被观测的 monotonic 时间（衰减用）
        self.last_live = np.zeros((0, 3), dtype=np.float64)
        self.last_vox = np.zeros((0, 3), dtype=np.float64)
        self.last_low = np.zeros((0, 3), dtype=np.float64)
        self.stats = {'frames': 0, 'tf_fail': 0, 'bad': 0, 'filtered': 0,
                      'last_pts': 0, 'last_kept': 0, 'pub_grid': 0}
        self._warned_tf = False

        qos_cloud_in = QoSProfile(depth=2, reliability=ReliabilityPolicy.BEST_EFFORT,
                                  durability=DurabilityPolicy.VOLATILE)
        self.create_subscription(PointCloud2, self.cloud_topic, self.on_cloud, qos_cloud_in)
        if self.omega_gate > 0.0:
            try:
                from nav_msgs.msg import Odometry
                self.create_subscription(Odometry, str(g('odom_topic').value),
                                         self.on_odom, 20)
                self.get_logger().info(
                    f'累积层角速度门控开启：|ω|>{self.omega_gate:.2f} rad/s 时只发 live 云、不写累积')
            except Exception as e:                            # noqa: BLE001
                self.get_logger().warn(f'角速度门控订阅失败（将不门控）：{e}')
                self.omega_gate = 0.0

        # 发布侧一律 RELIABLE：可靠发布者兼容 best-effort 订阅者，反之会静默收不到
        qos_vis = QoSProfile(depth=2, reliability=ReliabilityPolicy.RELIABLE,
                             durability=DurabilityPolicy.VOLATILE)
        qos_map = QoSProfile(depth=1, reliability=ReliabilityPolicy.RELIABLE,
                             durability=DurabilityPolicy.TRANSIENT_LOCAL)
        self.pub_live = self.create_publisher(PointCloud2, g('live_topic').value, qos_vis)
        self.pub_cloud = self.create_publisher(PointCloud2, g('cloud_topic_out').value, qos_vis)
        self.pub_low = self.create_publisher(PointCloud2, g('low_topic').value, qos_vis)
        self.pub_low_accum = self.create_publisher(
            PointCloud2, g('low_accum_topic').value, qos_vis)
        self.pub_grid = self.create_publisher(OccupancyGrid, g('grid_topic').value, qos_map)
        self.pub_ttl = (self.create_publisher(PointCloud2, g('ttl_topic').value, qos_vis)
                        if self.live_ttl > 0.0 else None)
        self.pub_free = (self.create_publisher(PointCloud2, g('free_ray_topic').value, qos_vis)
                         if self.free_rays else None)

        self.tf_buffer = tf2_ros.Buffer()
        self.tf_listener = tf2_ros.TransformListener(self.tf_buffer, self)

        self.create_timer(1.0 / max(0.2, float(g('live_hz').value)), self.publish_live)
        if self.pub_free is not None:
            self.create_timer(1.0 / max(0.2, float(g('free_ray_hz').value)), self.publish_free_rays)
            self.get_logger().info(
                f'自由射线云已启用：FOV={self.free_fov:.0f}° step={self.free_step:.1f}° '
                f'max={self.free_max:.1f}m -> {g("free_ray_topic").value}'
                f'（供局部代价地图 clearing 源做 raytrace 清障）')
        if self.pub_ttl is not None:
            self.create_timer(1.0 / max(0.2, float(g('live_hz').value)), self.publish_ttl)
            self.get_logger().info(
                f'短 TTL 云已启用：TTL={self.live_ttl:.1f} s → {g("ttl_topic").value}'
                f'（不再被观测的格会自动退场）')
        self.create_timer(1.0 / max(0.2, float(g('accum_hz').value)), self.publish_accum)
        self.create_timer(5.0, self.report)
        self.get_logger().info(
            f'vision_obstacle_grid: {self.cloud_topic} -> live={g("live_topic").value} '
            f'accum_cloud={g("cloud_topic_out").value} grid={g("grid_topic").value} '
            f'(frame={self.global_frame} res={self.res} z=[{self.z_min},{self.z_max}] '
            f'range=[{self.range_min},{self.range_max}] self_r={self.self_r})')

    # ---------------- 输入 ----------------
    def _pub_stamp(self):
        """发布云用的时间戳：优先用点云采集时刻（C1），拿不到才回退 now()。"""
        if self.stamp_from_cloud and self._cloud_stamp is not None:
            st = self._cloud_stamp
            if st.sec or st.nanosec:
                return st
            self.stats['stamp_fallback'] = self.stats.get('stamp_fallback', 0) + 1
        return self.get_clock().now().to_msg()

    @staticmethod
    def _opening(cells_arr):
        """对格集合做 3×3 十字核开运算：去掉孤立 1 格与 1 格宽的细长结构。"""
        if cells_arr.size == 0:
            return cells_arr
        minx, miny = int(cells_arr[:, 0].min()), int(cells_arr[:, 1].min())
        maxx, maxy = int(cells_arr[:, 0].max()), int(cells_arr[:, 1].max())
        w, h = maxx - minx + 1, maxy - miny + 1
        img = np.zeros((h + 2, w + 2), dtype=bool)        # 补 1 格边，避免边界被腐蚀
        img[cells_arr[:, 1] - miny + 1, cells_arr[:, 0] - minx + 1] = True
        er = img.copy()
        for dy, dx in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            er &= np.roll(np.roll(img, dy, 0), dx, 1)
        di = er.copy()
        for dy, dx in ((-1, 0), (1, 0), (0, -1), (0, 1)):
            di |= np.roll(np.roll(er, dy, 0), dx, 1)
        ys, xs = np.nonzero(di)
        return np.stack([xs - 1 + minx, ys - 1 + miny], axis=1).astype(np.int64)

    def on_odom(self, msg):
        self.omega = msg.twist.twist.angular.z

    def on_cloud(self, msg):
        self.stats['frames'] += 1
        self._cloud_stamp = msg.header.stamp      # C1：记住采集时刻
        names = {f.name: f.offset for f in msg.fields}
        if not all(k in names for k in ('x', 'y', 'z')):
            self.stats['bad'] += 1
            return
        n = msg.width * msg.height
        if n == 0 or msg.point_step == 0:
            return
        if n > self.max_points:
            # 超大点云（例如有人把分辨率开到 640x480x30）先抽稀，保护内存/CPU
            n = self.max_points
        raw = np.frombuffer(msg.data, dtype=np.uint8)
        if raw.size < n * msg.point_step:
            self.stats['bad'] += 1
            return
        buf = raw[:n * msg.point_step].reshape(n, msg.point_step)

        def col(name):
            off = names[name]
            return buf[:, off:off + 4].copy().view(np.float32).reshape(-1)

        x, y, z = col('x'), col('y'), col('z')
        ok = np.isfinite(x) & np.isfinite(y) & np.isfinite(z) & (z > 0.0)
        if not ok.any():
            return

        # ★ 2026-10-28：必须用**点云自己的时间戳**做 TF，而不是"最新 TF"。
        # 原来取 Time()（最新）→ 车在旋转时，用当前姿态去变换 0.2~0.4 s 前的点云，
        # 每帧错位 ω·Δt（实测转速可达 1.5 rad/s、相机 5 Hz ⇒ 每帧偏 0.3 rad≈17°），
        # 多帧叠起来就是"旋转中一圈多重鬼影"；而累积层 clearing=False + 衰减 120 s，
        # 这些鬼影会长时间留在栅格图上不消失。
        use_stamp = bool(self.tf_use_stamp and (msg.header.stamp.sec or msg.header.stamp.nanosec))
        # ★ 2026-10-28 修：fallback 与"旧行为"分支必须取 Time()（= 最新可用公共时间），
        #   不能取 now()。原因（本轮实测，见 logs/diag_axis_*）：
        #     map->odom_combined 由 AMCL 发布，而 AMCL 只在"位移≥update_min_d(0.25 m)
        #     或转角≥update_min_a(0.2 rad)"时才广播 ⇒ **车一静止，TF 链最新时间就冻住**。
        #     点云仍在以 5 Hz 前进（stamp 6.824 s），而 TF 链最新只到 6.790 s，
        #     于是任何"以 now 或点云 stamp 为界"的 lookup 都会抛
        #     ExtrapolationException: requested time ... in the future。
        #     now() 与 Time() 只差在这：Time() 直接拿整条链的最新公共时间，不做外推。
        #   后果（修前实测）：nav_only 里 帧 N / TF 失败 N = 100%，/vision/live_cloud 无数据、
        #   代价地图看不到视觉障碍 —— 正是"视觉层好像没接入"的现象。
        stamp = Time.from_msg(msg.header.stamp) if use_stamp else Time()
        try:
            if use_stamp:
                tr = self.tf_buffer.lookup_transform(self.global_frame, msg.header.frame_id,
                                                     stamp, timeout=Duration(seconds=0.10))
            else:
                # 旧行为：取整条链最新的公共时间（与 amend 之前的 Time() 语义一致）
                tr = self.tf_buffer.lookup_transform(self.global_frame, msg.header.frame_id,
                                                     stamp)
            self.stats['tf_stamp_ok'] = self.stats.get('tf_stamp_ok', 0) + 1
        except Exception as _e1:                 # noqa: BLE001
            self._last_tf_err = f'{type(_e1).__name__}: {_e1}'
            # 时间戳 TF 取不到（TF 链被上游卡住/时间跳变）→ 退回"最新可用"，并计数
            try:
                tr = self.tf_buffer.lookup_transform(self.global_frame, msg.header.frame_id,
                                                     Time())
                self.stats['tf_stamp_fallback'] = self.stats.get('tf_stamp_fallback', 0) + 1
            except Exception:
                tr = None
        if tr is None:
            self.stats['tf_fail'] += 1
            # ★ 2026-10-28 取证：TF 明明在 /tf 上（tf2_echo 能取到 map->odom_combined），
            # 但本节点 lookup 说 "map does not exist" ⇒ 必须看本节点 buffer 到底有哪些帧。
            if getattr(self, 'tf_debug', False):
                now_s = self.get_clock().now().nanoseconds * 1e-9
                if now_s - getattr(self, '_tf_dbg_t', -1e9) > 10.0:
                    self._tf_dbg_t = now_s
                    try:
                        frames = self.tf_buffer.all_frames_as_string()
                    except Exception as _fe:              # noqa: BLE001
                        frames = f'<all_frames_as_string failed: {_fe}>'
                    self.get_logger().warn(
                        f'[tf_debug] lookup {self.global_frame}<-{msg.header.frame_id} 失败，'
                        f'buffer 已知帧:\n{frames[:800]}')
            if not self._warned_tf:
                self._warned_tf = True
                self.get_logger().warn(
                    f'TF {self.global_frame}<-{msg.header.frame_id} 暂不可用（等待 SLAM 起图），'
                    f'先丢弃点云；detail={self._last_tf_err}')
            return
        self._warned_tf = False
        try:
            if use_stamp:
                tr_live = (self.tf_buffer.lookup_transform(self.live_frame, msg.header.frame_id,
                                                           stamp, timeout=Duration(seconds=0.05))
                           if self.live_frame else None)
            else:
                tr_live = (self.tf_buffer.lookup_transform(self.live_frame, msg.header.frame_id,
                                                           stamp, timeout=Duration(seconds=0.05))
                           if self.live_frame else None)
        except Exception:
            try:
                tr_live = (self.tf_buffer.lookup_transform(self.live_frame, msg.header.frame_id,
                                                           Time())
                           if self.live_frame else None)
            except Exception:
                tr_live = None
        t = tr.transform.translation
        R = quat_to_matrix(tr.transform.rotation)
        P = np.stack([x[ok], y[ok], z[ok]], axis=1)
        Pw = P @ R.T + np.array([t.x, t.y, t.z])

        # 自身过滤/距离/高度带都在**车体帧**里判（车体帧原点就是机器人原点，
        # 与 map 帧原点无关；map 帧原点只是建图起点）
        if tr_live is not None:
            tl = tr_live.transform.translation
            Rl = quat_to_matrix(tr_live.transform.rotation)
            Pl = P @ Rl.T + np.array([tl.x, tl.y, tl.z])
            dist = np.hypot(Pl[:, 0], Pl[:, 1])
            zc = Pl[:, 2]
        else:
            dist = np.hypot(Pw[:, 0] - t.x, Pw[:, 1] - t.y)
            zc = Pw[:, 2]
        keep = ((dist > self.self_r) & (dist < self.range_max) &
                (zc > self.z_min) & (zc < self.z_max))
        n_bad = int(z.size - (np.isfinite(x) & np.isfinite(y) & np.isfinite(z)).sum())
        self.stats['bad'] += n_bad
        self.stats['last_pts'] = int(z.size)
        self.stats['last_kept'] = int(keep.sum())
        self.last_live = Pw[keep]
        self.last_live_body = (Pl[keep] if (tr_live is not None) else Pw[keep])
        self._live_body_ok = tr_live is not None      # 只有真机身帧才算射线

        # 体素抽稀：同一 5 cm 体素只保留一个点，喂 local_costmap 体素层时省 TF/CPU
        if self.last_live.shape[0]:
            body = getattr(self, 'last_live_body', self.last_live)
            key3 = np.floor(body / self.live_voxel).astype(np.int64)
            _, idx = np.unique(key3, axis=0, return_index=True)
            self.last_vox = body[np.sort(idx)]
        else:
            self.last_vox = np.zeros((0, 3), dtype=np.float64)
        # 低矮带（贴地底板/台阶/低矮箱子）——取证与可视化
        lo, hi = self.low_z
        if self.last_live.shape[0]:
            zz = self.last_live[:, 2]
            self.last_low = self.last_live[(zz >= lo) & (zz <= hi)]
        else:
            self.last_low = np.zeros((0, 3), dtype=np.float64)

        # ★ 改动1：旋转期间不写累积（live 云照发）。omega 拿不到时按"不门控"处理（fail-safe）。
        gated = (self.omega_gate > 0.0 and self.omega is not None
                 and abs(self.omega) > self.omega_gate)
        if gated:
            self._gated_frames += 1
            if self._gated_frames % 20 == 1:
                self.get_logger().info(
                    f'累积层门控生效：|ω|={abs(self.omega):.2f} rad/s > '
                    f'{self.omega_gate:.2f}，本帧只发 live 云（累计门控 {self._gated_frames} 帧）')

        # 低矮带累积（P9-⑧b）：只记 z∈[low_z_min, low_z_max] 的格
        if self.last_low.shape[0] and not gated:
            lx = np.floor(self.last_low[:, 0] / self.res).astype(np.int64)
            ly = np.floor(self.last_low[:, 1] / self.res).astype(np.int64)
            OFF2 = 1 << 20
            base2 = 2 * OFF2
            k2 = (lx + OFF2) * base2 + (ly + OFF2)
            u2, c2 = np.unique(k2, return_counts=True)
            g2 = u2[c2 >= self.min_pts]
            if g2.size:
                import time as _time2
                t2 = _time2.monotonic()
                for c in zip((g2 // base2 - OFF2).tolist(), (g2 % base2 - OFF2).tolist()):
                    self.low_seen[c] = t2
                    self.low_cells.add(c)

        keep2 = keep & (dist >= self.range_min)
        if gated:
            return
        if not keep2.any():
            return
        ix = np.floor(Pw[keep2, 0] / self.res).astype(np.int64)
        iy = np.floor(Pw[keep2, 1] / self.res).astype(np.int64)
        OFF = 1 << 20
        base = 2 * OFF
        key = (ix + OFF) * base + (iy + OFF)
        uniq, counts = np.unique(key, return_counts=True)
        good = uniq[counts >= self.min_pts]
        # ★ 改动3a：短记忆（该格只要本帧有 >= ttl_min_pts 个点就记，不做 2 帧确认）
        if self.pub_ttl is not None:
            import time as _time_ttl
            base_t = 2 * OFF
            good_t = uniq[counts >= self.ttl_min_pts]
            now_tt = _time_ttl.monotonic()
            for c in zip((good_t // base_t - OFF).tolist(),
                         (good_t % base_t - OFF).tolist()):
                self.ttl_cells[c] = now_tt
        if good.size:
            gx = good // base - OFF
            gy = good % base - OFF
            hits = self.hits
            import time as _time
            now_t = _time.monotonic()
            for c in zip(gx.tolist(), gy.tolist()):
                n = hits.get(c, 0) + 1
                hits[c] = n if n < 10000 else 10000
                self.seen_at[c] = now_t
                if n >= self.min_frames:
                    self.cells.add(c)
        self.stats['filtered'] = int(uniq.size - good.size)

    # ---------------- 输出 ----------------
    def publish_ttl(self):
        """短 TTL 云：把最近 ttl 秒内观测到的格转回机身帧发布（供局部代价地图用）。"""
        if self.pub_ttl is None:
            return
        import time as _t
        if not self.ttl_cells:
            return
        now = _t.monotonic()
        stale = [c for c, ts in self.ttl_cells.items() if now - ts > self.live_ttl]
        for c in stale:
            self.ttl_cells.pop(c, None)
        if not self.ttl_cells:
            return
        cells = np.fromiter((v for c in self.ttl_cells for v in c), dtype=np.int64,
                            count=2 * len(self.ttl_cells)).reshape(-1, 2)
        p_map = np.empty((cells.shape[0], 3), dtype=np.float64)
        p_map[:, 0] = (cells[:, 0] + 0.5) * self.res
        p_map[:, 1] = (cells[:, 1] + 0.5) * self.res
        p_map[:, 2] = self.obstacle_z
        # 必须发在**机身帧**：nav2 用云的 frame 原点当射线原点，发在 map 帧会把射线
        # 从地图原点打出去、擦掉真实障碍。用最新 TF（不用点云 stamp，避免外推失败）。
        try:
            tr = self.tf_buffer.lookup_transform(self.live_frame, self.global_frame, Time())
        except Exception:                                     # noqa: BLE001
            return
        t = tr.transform.translation
        R = quat_to_matrix(tr.transform.rotation)
        # lookup_transform(target=base, source=map) 给出 p_target = R @ p_map + t
        # ★ 2026-10-28 修：原来写成 (p_map - t) @ R（等于转置），云被转错方位 →
        #   局部代价地图满屏 lethal（实测 raw_lethal 2249→13131）。必须用 R @ p + t。
        p_body = p_map @ R.T + np.array([t.x, t.y, t.z])
        stamp = self._pub_stamp()
        self.pub_ttl.publish(cloud_msg(p_body, self.live_frame, stamp))
        self.stats['pub_ttl'] = self.stats.get('pub_ttl', 0) + 1

    def publish_free_rays(self):
        """按相机 FOV 发"自由射线端点"云（机身帧），长度 = 该角度最近回波 − margin。
        多个 z 层各发一遍：VoxelLayer 的 raytrace 会按体素列清，单层会漏掉高层标记。"""
        if not getattr(self, '_live_body_ok', False) or self.last_live_body.shape[0] == 0:
            return
        b = self.last_live_body
        r = np.hypot(b[:, 0], b[:, 1])
        a = np.arctan2(b[:, 1], b[:, 0])
        half = np.radians(self.free_fov) / 2.0
        step = np.radians(self.free_step)
        angs = np.arange(-half, half + 1e-9, step)
        if angs.size == 0:
            return
        ranges = np.full(angs.size, self.free_max)
        ok = (r >= self.range_min) & (r <= self.free_max)
        if ok.any():
            idx = np.round((a[ok] + half) / step).astype(int)
            good = (idx >= 0) & (idx < angs.size)
            if good.any():
                np.minimum.at(ranges, idx[good], r[ok][good])
        ranges = np.maximum(self.range_min, ranges - self.free_margin)
        zs = (0.10, 0.25, 0.45, 0.65, 0.79)
        pts = np.zeros((angs.size * len(zs), 3), dtype=np.float32)
        k = 0
        for z in zs:
            for i in range(angs.size):
                pts[k] = (ranges[i] * np.cos(angs[i]), ranges[i] * np.sin(angs[i]), z)
                k += 1
        self.pub_free.publish(cloud_msg(pts, self.live_frame, self._pub_stamp()))
        self.stats['pub_free'] = self.stats.get('pub_free', 0) + 1

    def publish_live(self):
        if self.last_live.shape[0] == 0:
            return
        stamp = self._pub_stamp()
        src = self.last_vox if self.last_vox.shape[0] else self.last_live
        self.pub_live.publish(cloud_msg(src, self.live_frame or self.global_frame, stamp))
        if self.last_low.shape[0]:
            self.pub_low.publish(cloud_msg(self.last_low, self.global_frame, stamp))

    def publish_accum(self):
        if not self.cells:
            return
        if self.accum_decay > 0.0:
            import time as _time
            now_t = _time.monotonic()
            stale = [c for c in self.cells
                     if now_t - self.seen_at.get(c, 0.0) > self.accum_decay]
            if stale:
                for c in stale:
                    self.cells.discard(c)
                    # ★ 改动2：衰减掉的格必须**重新**攒够 min_frames 次观测才能再进来，
                    #   否则 hits 会把"很久以前看过两次"的记忆一直沿用。
                    self.hits.pop(c, None)
                self.get_logger().info('衰减移除 %d 个长期未再观测的障碍格（%.0fs 窗口）'
                                       % (len(stale), self.accum_decay))
        stamp = self.get_clock().now().to_msg()
        arr = np.fromiter((v for c in self.cells for v in c), dtype=np.int64,
                          count=2 * len(self.cells)).reshape(-1, 2)
        if self.open_kernel > 0 and arr.size:
            before = arr.shape[0]
            arr = self._opening(arr)
            self.stats['opened_removed'] = self.stats.get('opened_removed', 0) + (before - arr.shape[0])
        if self.dilate > 0 and arr.size:
            # 4/8 邻域膨胀：让"视觉看到的表面"向外长 dilate 格，吃掉擦边接触
            offs = []
            for dx in range(-self.dilate, self.dilate + 1):
                for dy in range(-self.dilate, self.dilate + 1):
                    if dx or dy:
                        offs.append((dx, dy))
            parts = [arr]
            for dx, dy in offs:
                parts.append(arr + np.array([[dx, dy]], dtype=np.int64))
            arr = np.unique(np.vstack(parts), axis=0)
        pts = np.empty((arr.shape[0], 3), dtype=np.float32)
        pts[:, 0] = (arr[:, 0] + 0.5) * self.res
        pts[:, 1] = (arr[:, 1] + 0.5) * self.res
        pts[:, 2] = self.obstacle_z
        self.pub_cloud.publish(cloud_msg(pts, self.global_frame, stamp))
        self._publish_low_accum(stamp)

    def _publish_low_accum(self, stamp):
        """低矮带累积云（P9-⑧b）：给全局代价地图当"雷达看不见的低障碍"记忆层。"""
        if not self.low_cells:
            return
        if self.low_accum_decay > 0.0:
            import time as _time
            now_t = _time.monotonic()
            stale = [c for c in self.low_cells
                     if now_t - self.low_seen.get(c, 0.0) > self.low_accum_decay]
            if stale:
                for c in stale:
                    self.low_cells.discard(c)
                    self.low_seen.pop(c, None)
                    self.low_seen.pop(c, None)
                self.get_logger().info('低矮带累积移除 %d 格（%.0fs 窗口）'
                                       % (len(stale), self.low_accum_decay))
        arr = np.fromiter((v for c in self.low_cells for v in c), dtype=np.int64,
                          count=2 * len(self.low_cells)).reshape(-1, 2)
        pts = np.empty((arr.shape[0], 3), dtype=np.float32)
        pts[:, 0] = (arr[:, 0] + 0.5) * self.res
        pts[:, 1] = (arr[:, 1] + 0.5) * self.res
        pts[:, 2] = 0.08            # 明确落在低矮带高度，供全局层按 z 过滤
        self.pub_low_accum.publish(cloud_msg(pts, self.global_frame, stamp))
        self.stats['pub_grid'] += 1
        self.publish_grid(arr, stamp)

    def publish_grid(self, arr, stamp):
        minx, miny = int(arr[:, 0].min()), int(arr[:, 1].min())
        maxx, maxy = int(arr[:, 0].max()), int(arr[:, 1].max())
        w = maxx - minx + 1
        h = maxy - miny + 1
        if w > self.max_side or h > self.max_side:
            self.get_logger().warn(f'视觉栅格 {w}x{h} 超过上限 {self.max_side}，本轮不发布')
            return
        data = np.full((h, w), -1, dtype=np.int8)
        data[arr[:, 1] - miny, arr[:, 0] - minx] = 100
        msg = OccupancyGrid()
        msg.header.stamp = stamp
        msg.header.frame_id = self.global_frame
        msg.info.resolution = float(self.res)
        msg.info.width = int(w)
        msg.info.height = int(h)
        msg.info.origin.position.x = float(minx * self.res)
        msg.info.origin.position.y = float(miny * self.res)
        msg.info.origin.orientation.w = 1.0
        msg.data = data.reshape(-1).tolist()
        self.pub_grid.publish(msg)

    def dump_grid(self):
        """把累积障碍落成 PGM（map_server trinary 约定：0=占用、205=未知、254=自由），
        便于事后核对"机器人卡在哪、那里是不是视觉标出来的"。"""
        if not self.dump_path or not self.cells:
            return
        arr = np.fromiter((v for c in self.cells for v in c), dtype=np.int64,
                          count=2 * len(self.cells)).reshape(-1, 2)
        if self.dilate > 0 and arr.size:
            # 4/8 邻域膨胀：让"视觉看到的表面"向外长 dilate 格，吃掉擦边接触
            offs = []
            for dx in range(-self.dilate, self.dilate + 1):
                for dy in range(-self.dilate, self.dilate + 1):
                    if dx or dy:
                        offs.append((dx, dy))
            parts = [arr]
            for dx, dy in offs:
                parts.append(arr + np.array([[dx, dy]], dtype=np.int64))
            arr = np.unique(np.vstack(parts), axis=0)
        minx, miny = int(arr[:, 0].min()), int(arr[:, 1].min())
        maxx, maxy = int(arr[:, 0].max()), int(arr[:, 1].max())
        w, h = maxx - minx + 1, maxy - miny + 1
        if w > self.max_side or h > self.max_side:
            self.get_logger().warn('累积栅格过大，跳过落盘')
            return
        img = np.full((h, w), 205, dtype=np.uint8)     # 未知
        img[arr[:, 1] - miny, arr[:, 0] - minx] = 0    # 占用
        path = self.dump_path
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path + '.pgm', 'wb') as f:
            f.write(f'P5\n{w} {h}\n255\n'.encode())
            f.write(img.tobytes())
        with open(path + '.yaml', 'w', encoding='utf-8') as f:
            f.write(f'image: {os.path.basename(path)}.pgm\nresolution: {self.res}\n'
                    f'origin: [{minx * self.res:.6f}, {miny * self.res:.6f}, 0.0]\n'
                    f'negate: 0\noccupied_thresh: 0.65\nfree_thresh: 0.196\n')
        self.get_logger().info(f'累积障碍栅格已落盘：{path}.pgm（{w}x{h}, {len(self.cells)} 格）')

    def report(self):
        s = self.stats
        self.get_logger().info(
            f'视觉障碍：累积使能 {len(self.cells)}/{len(self.hits)} 格（过 {self.min_frames} 帧确认）；帧 {s["frames"]}，'
            f'TF 失败 {s["tf_fail"]}，本帧点 {s["last_pts"]} 有效 {s["last_kept"]}，'
            f'单点噪点滤除 {s["filtered"]}，异常帧 {s["bad"]}')


def main():
    rclpy.init()
    node = VisionObstacleGrid()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, Exception):
        pass
    finally:
        try:
            node.dump_grid()
        except Exception as e:  # 落盘失败不影响收尾
            print(f'[vision] dump 失败：{e}')
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
