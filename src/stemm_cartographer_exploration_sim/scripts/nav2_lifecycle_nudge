#!/usr/bin/env python3
"""nav2_lifecycle_nudge —— 把卡在 inactive/未配置的 nav2 生命周期节点推起来。

为什么需要（2026-10-23 实测）：
  车端 `stemm_cartographer_nav2_ready_guard` 的 `timeout_sec` 是**硬编码 90 s**（无 launch arg），
  而 nav2 的 lifecycle_manager 在起栈重负载下偶尔丢 `change_state` 响应，
  于是 controller_server 停在 inactive、guard 超时、整轮 0 派发（当天 8 轮里废了 2 轮）。
  车端源码不能动，所以由仿真侧在 1 Hz 上盯住 6 个 nav2 节点的 primary state，
  发现"连续 stuck_sec 秒既不 ACTIVE 也不在过渡态"就用它自己的 `/change_state` 推：
      unconfigured → configure → activate
      inactive     → activate
  每节点最多 max_attempts 次，全部动作写日志 + JSONL，默认可在 launch 里 nudge:=false 关掉。

不改变任何安全边界，也不改车端代码；正常起栈（节点本来就 active）时它只读不写。
"""
import json
import threading
import time

import rclpy
from lifecycle_msgs.msg import State, Transition
from lifecycle_msgs.srv import ChangeState, GetState
from rclpy.node import Node

DEFAULT_NODES = ('/controller_server', '/planner_server', '/bt_navigator',
                 '/behavior_server', '/smoother_server', '/waypoint_follower')
IN_TRANSITION = (10, 11, 12, 13, 14, 15)   # CONFIGURING..ERRORPROCESSING
ACTIVE = 3


class Nav2LifecycleNudge(Node):
    def __init__(self):
        super().__init__('nav2_lifecycle_nudge')
        d = self.declare_parameter
        d('enabled', True)
        d('nodes', list(DEFAULT_NODES))
        d('grace_sec', 10.0)        # 节点自己起后再等多久才开始管
        d('stuck_sec', 5.0)         # 非 ACTIVE 持续多久才动手
        d('max_attempts', 3)        # 每节点最多推送次数
        d('deadline_sec', 150.0)    # 总时长上限
        d('poll_hz', 1.0)
        d('log_path', '')
        g = self.get_parameter
        self.enabled = bool(g('enabled').value)
        self.nodes = [str(n) for n in g('nodes').value]
        self.grace = float(g('grace_sec').value)
        self.stuck_sec = float(g('stuck_sec').value)
        self.max_attempts = int(g('max_attempts').value)
        self.deadline = float(g('deadline_sec').value)
        self.period = 1.0 / max(0.2, float(g('poll_hz').value))
        self.log_path = str(g('log_path').value or '')

        self.get_cli, self.chg_cli = {}, {}
        for n in self.nodes:
            self.get_cli[n] = self.create_client(GetState, n + '/get_state')
            self.chg_cli[n] = self.create_client(ChangeState, n + '/change_state')
        self.seen = {n: None for n in self.nodes}      # 上次 state.id
        self.since = {n: None for n in self.nodes}     # 非 ACTIVE 起始时刻
        self.attempts = {n: 0 for n in self.nodes}
        self.gave_up = set()
        self.done = False
        self.get_logger().info(
            'nav2_lifecycle_nudge up: nodes=%s stuck>=%.0fs expect=ACTIVE enabled=%s'
            % (len(self.nodes), self.stuck_sec, self.enabled))
        self.thread = threading.Thread(target=self.run, daemon=True)
        self.thread.start()

    # ---------- 工具 ----------
    def record(self, row):
        if not self.log_path:
            return
        try:
            with open(self.log_path, 'a', encoding='utf-8') as f:
                f.write(json.dumps(row, ensure_ascii=False) + '\n')
        except Exception:               # noqa: BLE001
            pass

    def state_of(self, node):
        cli = self.get_cli[node]
        if not cli.wait_for_service(timeout_sec=1.0):
            return None
        try:
            return int(cli.call(GetState.Request()).current_state.id)
        except Exception:               # noqa: BLE001
            return None

    def change(self, node, transition_id):
        cli = self.chg_cli[node]
        if not cli.wait_for_service(timeout_sec=1.0):
            return False
        req = ChangeState.Request()
        req.transition.id = transition_id
        try:
            return bool(cli.call(req).success)
        except Exception:               # noqa: BLE001
            return False

    # ---------- 主循环（独立线程；阻塞式 service call 不占 executor） ----------
    def run(self):
        t0 = time.monotonic()
        time.sleep(self.grace)
        if not self.enabled:
            self.get_logger().info('nudge 已关闭（enabled=false），只做一次状态快照')
        while time.monotonic() - t0 < self.deadline and rclpy.ok():
            pending = [n for n in self.nodes if n not in self.gave_up]
            if not pending:
                break
            acted = False
            for n in list(pending):
                st = self.state_of(n)
                now = time.monotonic()
                if st is None:
                    continue                      # 服务还没起（或该节点不存在）
                if st != self.seen[n]:
                    self.seen[n] = st
                    self.since[n] = None if st == ACTIVE else now
                if st == ACTIVE:
                    self.attempts[n] = 0
                    continue
                if st in IN_TRANSITION:
                    continue                      # 正在过渡，别插队
                if self.since[n] is None:
                    self.since[n] = now
                    continue
                if now - self.since[n] < self.stuck_sec:
                    continue
                if not self.enabled:
                    self.gave_up.add(n)
                    continue
                if self.attempts[n] >= self.max_attempts:
                    self.gave_up.add(n)
                    self.get_logger().error(
                        '[nudge] %s 连续 %d 次推送仍非 ACTIVE（state=%d），放弃' % (n, self.attempts[n], st))
                    self.record({'type': 'give_up', 'node': n, 'state': st,
                                 'attempts': self.attempts[n], 't': round(time.time(), 3)})
                    continue
                self.attempts[n] += 1
                acted = True
                self.get_logger().warn(
                    '[nudge] %s state=%d 卡住 %.0fs → 推送第 %d/%d 次'
                    % (n, st, now - self.since[n], self.attempts[n], self.max_attempts))
                self.record({'type': 'nudge', 'node': n, 'state': st,
                             'attempt': self.attempts[n], 't': round(time.time(), 3)})
                if st == State.PRIMARY_STATE_UNCONFIGURED:
                    ok_c = self.change(n, Transition.TRANSITION_CONFIGURE)
                    self.get_logger().info('    %s configure → %s' % (n, ok_c))
                    time.sleep(0.3)
                    st2 = self.state_of(n)
                    if st2 == State.PRIMARY_STATE_INACTIVE:
                        ok_a = self.change(n, Transition.TRANSITION_ACTIVATE)
                        self.get_logger().info('    %s activate → %s' % (n, ok_a))
                elif st == State.PRIMARY_STATE_INACTIVE:
                    ok_a = self.change(n, Transition.TRANSITION_ACTIVATE)
                    self.get_logger().info('    %s activate → %s' % (n, ok_a))
                else:
                    self.get_logger().warn('    %s state=%d 不在预期分支，跳过' % (n, st))
                time.sleep(0.5)
            if not acted and all(self.seen[n] == ACTIVE for n in self.nodes if self.seen[n] is not None):
                break
            time.sleep(self.period)
        act = [n for n in self.nodes if self.seen.get(n) == ACTIVE]
        self.get_logger().info('[nudge] 收尾：%d/%d 个 nav2 节点 ACTIVE（%s）%s'
                               % (len(act), len(self.nodes), ', '.join(n.lstrip('/') for n in act),
                                  '；本机未插队' if not any(self.attempts.values()) else ''))
        self.record({'type': 'summary', 'active': act,
                     'attempts': {k: v for k, v in self.attempts.items() if v},
                     't': round(time.time(), 3)})
        self.done = True


def main():
    rclpy.init()
    node = Nav2LifecycleNudge()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, Exception):
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
