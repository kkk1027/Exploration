#!/usr/bin/env python3
"""escape_supervisor —— 只用雷达信息的"旋转 + 前进"脱困（P0-3）。

为什么不是原来的做法
--------------------
实机现场（2026-10-22 仿真复现，s3r3 轮）楔死时的完整链条是：

  Nav2 footprint 判楔死 -> 车端 escape_controller 原地转满 2.10 rad（120°）
  -> 代价 253 一点没变（转圈不改变离障碍的距离）-> 交还控制
  -> 车端 manager 做 R1 "盲退" 0.30 m（只看 /map，未知格当自由）
  -> 退到墙里/退完还是楔死 -> 再转 -> 再退 …… 7 次盲退、11 次无效旋转

两个根因：① 只转不走，几何没变，代价自然不变；② 后退完全不看传感器。
用户 2026-10-23 定的边界：**脱困只允许"旋转 + 前进"，任何情况下不得后退**。
所以本节点做人类会做的事：看着雷达，转到最空旷的方向（每 0.1 s 用雷达复核，绝不转进
障碍），然后沿那个方向前进一小段，让车真正离开楔死点。

它只管一件事，且随时让路
------------------------
* 只有在"有导航目标 + 连续停住 >= stall_sec + 1.5 s 内没有任何别的节点在发速度"时才接管；
* 一接管就先算方向：把 /scan_raw 的 360° 点变换到车体系，对每个候选航向（±80°，绝不选
  背后方向）算"车体矩形到最近障碍点的间隙"，取 `间隙 - 0.20*|转角|` 最大者；
* 旋转阶段每个 tick 复核当前朝向间隙，一旦有点进到车体 5 mm 内立刻停转并放弃本单元；
* 前进阶段每个 tick 复核前向 ±20° 间隙，低于 advance_stop_clearance 立刻停；
* 任何时候只要有别的节点发速度（Nav2 / 车端 escape / manager 的 R1），立刻交还控制。

三个兜底（用户 2026-10-23 明确要求）
-----------------------------------
1) 单元 8 s：一个"旋转+前进"单元最多 8 s（rotation 3 s + advance 5 s 的硬顶）。
2) 8 s 降级：单元到 8 s 仍未改善（前向间隙或 footprint 代价没变好）→ 判降级：
   立刻停车、把该点记为受阻区（发给仲裁）、本点冷却 20 s，不再纠缠。
3) 40 s 超时退出：同一段受阻累计 40 s 仍无改善 → 整段停止脱困（停 90 s 长退避），
   记 giveup，交由 Nav2/manager 换目标。

安全边界（全部是"宁可不动"式）
------------------------------
* 绝不发 linear.x < 0（本节点只有三处发布：0、+advance_speed、纯角速度）。
* 旋转只在"当前朝向的车体间隙 > rotate_min_clearance"时进行。
* 前进只在"前向 ±20° 最小间隙 > advance_stop_clearance(0.10 m)"时进行。
* 车体几何与 Nav2 footprint 同源（URDF：x∈[-0.16,0.29]，y=±0.23）。
"""
import json
import math
import os
import time

import rclpy
from action_msgs.msg import GoalStatusArray
from geometry_msgs.msg import PoseStamped, Twist, Vector3
from nav_msgs.msg import Odometry
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, DurabilityPolicy, HistoryPolicy
from sensor_msgs.msg import LaserScan
from std_msgs.msg import Bool, String

try:
    from nav2_msgs.msg import Costmap
except Exception:                       # pragma: no cover
    Costmap = None


ACTIVE_STATUS = (1, 2, 3)               # ACCEPTED / EXECUTING / CANCELING
BLOCKED_TOKENS = ('blocked_', 'escape_', 'wedge', 'stuck_')
IDLE_NAV_STATES = ('waiting_for_frontier', 'waiting_for_rrt_frontier',
                   'waiting_for_nav2', 'idle')


def yaw_of(q):
    return math.atan2(2.0 * (q.w * q.z + q.x * q.y),
                      1.0 - 2.0 * (q.y * q.y + q.z * q.z))


class EscapeSupervisor(Node):
    def __init__(self):
        super().__init__('escape_supervisor')
        p = self.declare_parameter
        # launch 传进来的是字符串，必须自己解析（bool('false') 为 True 会踩坑）
        _en = str(p('enabled', True).value).strip().lower()
        self.enabled = _en in ('true', '1', 'yes', 'on')
        self.scan_topic = str(p('scan_topic', '/scan_raw').value)
        self.odom_topic = str(p('odom_topic', '/odom_combined').value)
        self.cmd_topic = str(p('cmd_topic', '/cmd_vel').value)
        self.nav_state_topic = str(p('nav_state_topic',
                                     '/stemm_cartographer/nav_state').value)
        self.status_topic = str(p('status_topic',
                                  '/navigate_to_pose/_action/status').value)
        self.costmap_topic = str(p('costmap_topic',
                                   '/local_costmap/costmap_raw').value)
        self.zone_topic = str(p('zone_topic', '/escape_blocked_zone').value)
        self.log_path = str(p('log_path', '').value)
        # 车体几何
        self.x_min = float(p('body_x_min', -0.16).value)
        self.x_max = float(p('body_x_max', 0.29).value)
        self.y_half = float(p('body_half_width', 0.23).value)
        self.laser_x = float(p('laser_x', 0.24).value)
        # 触发
        self.stall_sec = float(p('stall_sec', 3.0).value)
        # 运动锚点阈值：位移/转角超过它就算"在动"（0.01 m / 0.02 rad ≈ 噪声下限之上）
        self.motion_eps_m = float(p('motion_eps_m', 0.02).value)
        self.motion_eps_rad = float(p('motion_eps_rad', 0.04).value)
        # 只在"贴障碍"时才脱困：车体到最近障碍的间隙必须小于这个值，
        # 否则说明车在开阔地（正常行驶/等目标），绝不能接管（v1 误触发教训）
        self.require_near_obstacle = float(p('require_near_obstacle_m', 0.55).value)
        self.cmd_quiet_sec = float(p('cmd_quiet_sec', 1.5).value)
        self.cooldown_sec = float(p('cooldown_sec', 4.0).value)
        self.scan_stale_sec = float(p('scan_stale_sec', 2.0).value)
        # 运动包络
        self.rotate_speed = float(p('rotate_speed', 0.35).value)
        self.advance_speed = float(p('advance_speed', 0.08).value)
        self.advance_max_m = float(p('advance_max_m', 0.60).value)
        self.rotate_max_rad = float(p('rotate_max_rad', 1.05).value)
        self.heading_limit = float(p('heading_limit', 1.40).value)   # ±80°
        self.unit_max_sec = float(p('unit_max_sec', 8.0).value)      # 8 s 降级兜底
        self.rotate_budget_sec = float(p('rotate_budget_sec', 3.0).value)
        # 安全（全部以"雷达中心到障碍的测距"计；雷达在车体前缘后方 5 cm）
        # 车轮外沿半径 0.23、雷达在轮轴前 0.24：旋转时轮子扫掠到距雷达 ~0.31，
        # 故安全半径取 0.34（escB 实测 0.26 时旋转过程中轮子蹭到了东西）
        self.rotate_min_range = float(p('rotate_min_range', 0.34).value)
        # 2026-11-14（I）：上面的 0.34 只算了轮子，**没算车尾两角**。
        # URDF 实读（wheeltec_two_wheel_model/_t_classic.urdf.xacro）：
        #   车体 x∈[-0.160, 0.290]、|y|≤0.230（base_footprint 系）
        #   雷达 x = axle_to_front - 0.05 = 0.240
        # 换算到"以雷达为原点"：x∈[-0.400, 0.050]、|y|≤0.230
        # → 后角 distance = hypot(0.400, 0.230) = 0.461 m，比 0.34 大 12 cm。
        # 实测 p14vE_sw1：车在 (7.03,-9.74) 旋转 77°（offset=-1.35），旋转前
        # 左 0.356 m、右 0.583 m，range_cone 只看"目标朝向±45°"，判为安全；
        # 但车尾在雷达后方 0.40 m，扫掠时扫进 HouseWallB，接触 365 帧 / 365.6 s。
        # 对策：旋转前用矩形包络逐方位角核对"该方向的测距 >= 车体在该方向的
        # 边界距离 + margin"。
        self.body_x_min = float(p('body_x_min', -0.400).value)
        self.body_x_max = float(p('body_x_max', 0.050).value)
        self.body_y_half = float(p('body_y_half', 0.230).value)
        self.body_sweep_margin = float(p('body_sweep_margin', 0.030).value)
        self.body_sweep_check = str(
            p('body_sweep_check', True).value).lower() in ('true', '1', 'yes', 'on')
        # 旋转安全扇区半角：选向校验与执行复核必须用同一个值，否则会出现
        # "选出来了却一启动就判 rotate_into_obstacle" 的自相矛盾（escA2 实测）
        self.rotate_sector_deg = float(p('rotate_sector_deg', 45.0).value)
        self.rotate_pick_margin = float(p('rotate_pick_margin', 0.04).value)
        # 前进停止口径：advance_stop_range 是"雷达测距"，雷达在前沿后方
        # body_front_offset，所以真实前沿净空 = advance_stop_range - body_front_offset。
        # 2026-11-14：改口径后默认值取 0.35，等价于旧的 0.30 但语义明确。
        self.body_front_offset = float(p('body_front_offset', 0.05).value)
        self.advance_stop_range = float(p('advance_stop_range', 0.35).value)
        self.min_dir_range = float(p('min_dir_range', 0.50).value)
        self.clearance_gain = float(p('clearance_gain', 0.20).value)
        self.cost_gain = int(p('cost_gain', 40).value)
        # 预算
        self.max_units_per_episode = int(p('max_units_per_episode', 3).value)
        self.recovery_timeout_sec = float(p('recovery_timeout_sec', 40.0).value)
        self.giveup_backoff_sec = float(p('giveup_backoff_sec', 90.0).value)
        self.spot_cooldown_sec = float(p('spot_cooldown_sec', 20.0).value)
        self.degrade_backoff_sec = float(p('degrade_backoff_sec', 12.0).value)
        # 降级小步前进的最大距离（紧贴障碍、只想挪开几厘米时用）
        self.degrade_advance_m = float(p('degrade_advance_m', 0.25).value)
        # ---- 返航阶段的"受控小步倒车"（操作者 2026-10-23 选方案 A）----
        # 只在返航阶段、且雷达**确实看到**后方净空时才允许，单次 <=0.15 m / 0.05 m/s。
        # 探索阶段与一般脱困仍然绝对禁止后退。
        self.return_reverse_enabled = str(p('return_reverse_enabled', True).value).lower() in (
            'true', '1', 'yes', 'on')
        self.return_reverse_speed = abs(float(p('return_reverse_speed', 0.05).value))
        self.return_reverse_max_m = abs(float(p('return_reverse_max_m', 0.15).value))
        self.return_reverse_rear_clear = abs(float(p('return_reverse_rear_clear', 0.30).value))
        self.return_reverse_min_points = int(p('return_reverse_min_points', 20).value)
        self.return_reverse_max_count = int(p('return_reverse_max_count', 8).value)
        # ---- 探索期的"受控小步倒车"（用户 2026-10-26 批准：短距离小速度倒车）----
        # 背景：车端 manager 在 front_blocked 时持续发零速，MPPI 的 vx_min=-0.08 到不了轮子
        # （revr1 实测：有 -0.05 指令但车一动不动，整轮只倒出 0.33 m）。脱困监督是独立通道，
        # 所以这一小步必须由它来做；默认关闭，A/B 时用 explore_reverse_enabled:=true 打开。
        self.explore_reverse_enabled = bool(p('explore_reverse_enabled', False).value)
        self.explore_reverse_max_count = int(p('explore_reverse_max_count', 4).value)
        self.explore_reverse_max_m = float(p('explore_reverse_max_m', 0.15).value)
        self.explore_reverse_speed = float(p('explore_reverse_speed', 0.06).value)
        # C v2 口径（2026-10-26 用真实数据重定，见 docs/P9 §14）：老口径是
        # "front<0.34 m 且非 nav_busy"，实测在 156 个探索期长停滞段里只覆盖 3%，
        # 而真吸收态是"车端闸按住 blocked_waiting_clearance + 车端不再发速度"，
        # 段内 front 中位 0.50、68% 在 0.70 以内。故改用状态+静默计时触发。
        self.explore_reverse_front_m = abs(float(p('explore_reverse_front_m', 0.70).value))
        self.explore_reverse_block_sec = abs(float(p('explore_reverse_block_sec', 6.0).value))
        self.explore_reverse_takeover_busy = str(
            p('explore_reverse_takeover_busy', True).value).lower() in ('true', '1', 'yes', 'on')
        self.explore_reverse_rear_clear_m = abs(float(
            p('explore_reverse_rear_clear_m', 0.40).value))
        self._blocked_since = None      # 车端闸"按住且不再发速度"的起始时刻
        # ---- P9-S0：接触即倒车（默认关）。实测最坏的 S0 事件不是"闸按住"，而是
        # 车头顶住看不见的低矮物体（Dumbbell/FitnessEquipment/床头柜）持续研磨几分钟：
        # c3r4 一轮 14351 个接触帧、接触时长 175 s，而那一轮 blocked 段最长只有 1.0 s ——
        # 状态机根本不会报 blocked，所以 C 的状态口径永远等不到它。这里改用
        # "/collision_contact_zone"（碰撞探针在接触瞬间发布）直接触发一次受限倒车。
        self.contact_reverse_enabled = str(
            p('contact_reverse_enabled', False).value).lower() in ('true', '1', 'yes', 'on')
        self.contact_reverse_window_sec = abs(float(
            p('contact_reverse_window_sec', 5.0).value))
        self.contact_reverse_max = int(p('contact_reverse_max', 3).value)
        # 2026-10-27 实测（b3r4）：contact_seen=5 但一次都没倒车 —— 因为"车端静默 >=0.5 s"
        # 这道门在研磨时永远不成立（车端一路给油门）。接触触发的倒车就是要覆盖车端指令，
        # 安全性改由"后方净空 + 单步 <=0.15 m + 每局 <=3 次 + 冷却 3 s"来保证。
        self.contact_reverse_quiet_sec = abs(float(
            p('contact_reverse_quiet_sec', 0.0).value))
        self.contact_reverse_front_m = abs(float(
            p('contact_reverse_front_m', 0.90).value))
        self.contact_reverse_cooldown_sec = abs(float(
            p('contact_reverse_cooldown_sec', 3.0).value))
        self._contact_at = None
        self._rv_contact_count = 0
        self._rv_explore_count = 0
        self._wedge_info = {}           # 触发时的判据快照（日志归因用）
        # 返航失败（manager 放弃等待人工）时允许连续小步倒车，每步仍 <=0.15 m、逐步雷达复核
        self.return_reverse_streak = int(p('return_reverse_streak', 4).value)
        # 2026-11-13：manager 放弃（return_home_failed_waiting_manual）后不再自动
        # 开一串倒车。实测 p14vB_vis1：车在 (4.39,2.07) 距原点 4.86 m，manager
        # 放弃后 supervisor 连续 8 次倒车（每次 ~0.154 m，共 1.23 m）把车推到
        # (5.28,2.48)，**离原点更远**，重试时反而更难回来。
        # 原设计意图是"退一点让重试有通道"，但那要求"退的方向比当前更差"才成立；
        # 返航时根本不知道原点的方向，盲退只会相向而行。
        # 默认 False（零位移）；需要旧行为时置 true。
        self.giveup_reverse_enabled = bool(p('giveup_reverse', False).value)
        self._rv_streak_left = 0
        # ---- 只读探针（P9-C0）：为 C 层"探索期受控倒车"定口径用，默认关、不改变任何控制行为 ----
        # 用法：STEMM_REV_PROBE=1 bash harness/round.sh <tag> <sec>
        # 受阻计时活跃期间每 STEMM_REV_PROBE_DT 秒（默认 0.25）往 supervisor.jsonl 打一行
        # type=rev_probe，含 C 层每一道候选闸门此刻的原始读数 -> 用真实分布定阈值，不拍脑袋。
        self.rev_probe = os.environ.get('STEMM_REV_PROBE', '') not in ('', '0', 'false', 'False')
        try:
            self.rev_probe_dt = max(0.1, float(os.environ.get('STEMM_REV_PROBE_DT', '0.25')))
        except ValueError:
            self.rev_probe_dt = 0.25
        self._rev_probe_last = 0.0
        self._probe_rows = 0

        # ---- 状态 ----
        self.points = []           # 车体系障碍点 [(x,y)]（最近一帧 /scan_raw）
        self.points_stamp = 0.0
        self.pose = None           # (x, y, yaw)
        self.last_motion = time.monotonic()
        self._motion_anchor = None
        self.last_foreign_cmd = 0.0
        self.last_cmd = None          # 最近一条非本节点的 (vx, wz, 时刻)；探针用
        self.force_request_at = 0.0
        self.own_cmd_at = 0.0
        self.nav_busy = False
        self.mode = ''
        self.state_name = ''
        self._busy_since = 0.0
        self.busy_grace_sec = float(p('busy_grace_sec', 2.0).value)
        self.nav_state = ''
        self.costmap = None
        self.costmap_stamp = 0.0
        # 受阻计时
        self.stuck_since = None
        self.stuck_total = 0.0
        self.stuck_anchor = None      # 进入受阻时的位置；位移 >= 0.5 m 才复位计时
        self.units_this_episode = 0
        self.disabled_until = 0.0
        self.spot_until = 0.0
        self.spot_pose = None
        # 单元状态机
        self.phase = 'idle'        # idle/pick/rotate/advance/end
        self.unit_t0 = 0.0
        self.unit_offset = 0.0
        self.unit_remaining = 0.0
        self.unit_moved = 0.0
        self.degrade_advance = getattr(self, 'degrade_advance', False)
        self._rv_active = False
        self._rv_t0 = 0.0
        self._rv_moved = 0.0
        self._rv_count = 0
        self._rv_last_end = 0.0
        self._rv_explore_phase = False   # 本次倒车属探索期(C)还是返航期
        self._rv_points = 0
        self.unit_anchor = None
        self.arm_clearance = None
        self.arm_cost = None
        self.unit_started_pos = None
        self.stats = {'units': 0, 'ok': 0, 'failed': 0, 'degraded': 0,
                      'giveups': 0, 'aborts': 0, 'no_dir': 0}

        self._fh = open(self.log_path, 'a', buffering=1) if self.log_path else None
        self.get_logger().info(
            'escape_supervisor up: enabled=%s stall=%.1fs quiet=%.1fs unit<=%.0fs '
            'adv<=%.2fm@%.2fm/s rot=%.2frad/s timeout=%.0fs units/episode=%d'
            % (self.enabled, self.stall_sec, self.cmd_quiet_sec, self.unit_max_sec,
               self.advance_max_m, self.advance_speed, self.rotate_speed,
               self.recovery_timeout_sec, self.max_units_per_episode))

        qos_sensor = QoSProfile(depth=1, reliability=ReliabilityPolicy.BEST_EFFORT,
                                history=HistoryPolicy.KEEP_LAST)
        self.create_subscription(LaserScan, self.scan_topic, self.on_scan, qos_sensor)
        self.create_subscription(Odometry, self.odom_topic, self.on_odom, 20)
        self.create_subscription(Twist, self.cmd_topic, self.on_cmd, 20)
        self.create_subscription(PoseStamped, '/collision_contact_zone',
                                 self.on_contact_zone, 10)
        self.create_subscription(String, self.nav_state_topic, self.on_nav_state, 10)
        # P0-甲：看门狗检测到"静默静止"（车端安全闸把速度置零）时主动请求一次脱困单元，
        # 不再依赖本节点自己从 cmd_vel 推断 —— 那条路在 cmd≡0 的场景里永远等不到。
        self.create_subscription(Bool, str(p('escape_request_topic', '/escape_request').value),
                                 self.on_escape_request, 10)
        self.create_subscription(GoalStatusArray, self.status_topic, self.on_status, 10)
        if Costmap is not None:
            costmap_qos = QoSProfile(depth=1, reliability=ReliabilityPolicy.RELIABLE,
                                     durability=DurabilityPolicy.VOLATILE,
                                     history=HistoryPolicy.KEEP_LAST)
            self.create_subscription(Costmap, self.costmap_topic, self.on_costmap,
                                     costmap_qos)
        self.cmd_pub = self.create_publisher(Twist, self.cmd_topic, 10)
        self.zone_pub = self.create_publisher(PoseStamped, self.zone_topic, 10)
        self.assist_pub = self.create_publisher(Bool, '/escape_assist_active', 10)
        self.create_timer(0.1, self.tick)

    # ---------------- 日志 ----------------
    def log(self, **rec):
        rec.setdefault('t', round(time.monotonic(), 2))
        rec.setdefault('pos', [round(v, 2) for v in (self.pose or (0, 0, 0))[:2]])
        if self._fh is not None:
            self._fh.write(json.dumps(rec, ensure_ascii=False) + '\n')
        else:
            self.get_logger().info(json.dumps(rec, ensure_ascii=False))

    # ---------------- 输入 ----------------
    def on_scan(self, m):
        """只保留 (range, angle) —— 安全判据统一用"雷达测距"。

        为什么不用车体矩形：实测发现雷达在车体轮廓内还会有一些点（近距回波/自反射），
        用车体矩形会把它们当成"贴障碍"，让旋转安全闸门永远误报。用测距就没有这个歧义：
        range < X 就是"雷达中心 X 米内有东西"。
        """
        pts = []
        a = m.angle_min
        da = m.angle_increment
        lo = max(0.0, m.range_min * 0.999 - 0.001)
        hi = 49.0
        for i, r in enumerate(m.ranges):
            if not (r >= lo and r <= hi):
                continue
            pts.append((r, a + da * i))
        if pts:
            self.points = pts
            self.points_stamp = time.monotonic()

    def on_odom(self, m):
        now = time.monotonic()
        q = m.pose.pose
        new = (q.position.x, q.position.y, yaw_of(q.orientation))
        if self.pose is not None:
            # 相对"运动锚点"累计位移：逐帧比较在 0.2 m/s×20 Hz = 1 cm/帧 时永远判不动，
            # 这是 v1 误触发（把正常行驶当卡死）的根因。
            if self._motion_anchor is None:
                self._motion_anchor = (new[0], new[1], new[2])
            ax, ay, ayaw = self._motion_anchor
            d = math.hypot(new[0] - ax, new[1] - ay)
            dyaw = abs(math.atan2(math.sin(new[2] - ayaw),
                                  math.cos(new[2] - ayaw)))
            if d > self.motion_eps_m or dyaw > self.motion_eps_rad:
                self.last_motion = now
                self._motion_anchor = (new[0], new[1], new[2])
                if self.stuck_since is not None:
                    self.stuck_total += now - self.stuck_since
                    self.stuck_since = None
        self.pose = new

    def on_cmd(self, m):
        now = time.monotonic()
        if now - self.own_cmd_at < 0.05:
            return                          # 自己发的，忽略
        self.last_cmd = (m.linear.x, m.angular.z, now)
        if abs(m.linear.x) > 0.02 or abs(m.angular.z) > 0.02:
            self.last_foreign_cmd = now

    def on_contact_zone(self, m):
        """碰撞探针在物理接触瞬间上报（P9-S0）。只记时刻，决策在 tick 里做。"""
        self._contact_at = time.monotonic()
        self.log(type='contact_seen', pos=[round(m.pose.position.x, 2),
                                          round(m.pose.position.y, 2)])

    def on_nav_state(self, m):
        self.nav_state = (m.data or '').strip()
        # nav_state 是 JSON（含 mode / navigation_state），解析出来才好判断阶段
        try:
            d = json.loads(self.nav_state)
            self.mode = str(d.get('mode', ''))
            self.state_name = str(d.get('navigation_state', ''))
        except Exception:
            self.mode = ''
            self.state_name = self.nav_state.lower()
        # C v2：车端闸"按住且不再发速度"的连续计时（吸收态的判据，用真实数据定的口径）
        blob = (self.state_name + ' ' + self.mode).lower()
        holding = ('blocked_waiting_clearance' in blob) or ('blocked_precheck' in blob) \
            or ('safety_stop' in self.mode.lower())
        quiet = (time.monotonic() - self.last_foreign_cmd) >= 1.0
        if holding and quiet:
            if self._blocked_since is None:
                self._blocked_since = time.monotonic()
        else:
            self._blocked_since = None

    def on_status(self, m):
        busy = False
        for st in m.status_list:
            if st.status in ACTIVE_STATUS:
                busy = True
                break
        if busy and not self.nav_busy:
            self._busy_since = time.monotonic()
        self.nav_busy = busy

    def on_escape_request(self, m):
        if bool(m.data):
            self.force_request_at = time.monotonic()

    def on_costmap(self, m):
        self.costmap = m
        self.costmap_stamp = time.monotonic()

    # ---------------- 几何 ----------------
    def range_cone(self, offset, half_deg=14.0, stride=2):
        """假定车体朝向转到 offset 后，±half_deg 扇区内的最小测距（m）。"""
        half = math.radians(half_deg)
        best = float('inf')
        for i in range(0, len(self.points), stride):
            r, th = self.points[i]
            d = math.atan2(math.sin(th - offset), math.cos(th - offset))
            if abs(d) > half:
                continue
            if r < best:
                best = r
        return best if best < float('inf') else 9.0

    def min_range_all(self, stride=2):
        best = 9.0
        for i in range(0, len(self.points), stride):
            r = self.points[i][0]
            if r < best:
                best = r
        return best

    def body_radius_at(self, phi):
        """矩形车体在极角 phi（相对车头，弧度）方向的边界距离（以雷达为原点）。"""
        dx = math.cos(phi)
        dy = math.sin(phi)
        cand = []
        if dx > 1e-9:
            cand.append(self.body_x_max / dx)
        elif dx < -1e-9:
            cand.append(self.body_x_min / dx)
        if abs(dy) > 1e-9:
            cand.append(self.body_y_half / abs(dy))
        if not cand:
            return 0.0
        return min(cand)

    def body_sweep_clear(self, margin=None):
        """原地旋转是否安全：逐方位角核对"测距 >= 车体在该方向的边界 + margin"。

        为什么不能只看 range_cone：range_cone 只扫"目标朝向 ±half_deg"，而车体
        矩形是**包住雷达原点**的（x∈[-0.400,+0.050]、|y|≤0.230），车尾沿在雷达
        后方 0.40 m —— 车头方向再空旷也挡不住车尾扫到后方墙壁。旋转任何角度，
        车体都会扫过全部方位角，所以必须逐方位核对。

        返回 (ok, worst_phi_deg, worst_range, worst_need)。
        """
        if not self.body_sweep_check or not self.points:
            return True, 0.0, 9.0, 0.0
        m = self.body_sweep_margin if margin is None else margin
        worst_slack = float('inf')
        worst = (0.0, 9.0, 0.0)          # (phi_deg, range, need)
        for i in range(0, len(self.points), 1):
            r, th = self.points[i]
            need = self.body_radius_at(th) + m
            slack = r - need
            if slack < worst_slack:
                worst_slack = slack
                worst = (math.degrees(th), r, need)
        return (worst_slack >= 0.0), worst[0], worst[1], worst[2]

    def remaining_sector_anchor(self, now):
        """旋转阶段复核用的朝向：用当前剩余转角（含已转过的部分由 step 递减体现）。"""
        return self.unit_remaining

    def rotation_path_clear(self, offset, step=0.15):
        """整段旋转是否安全：沿路每一小步都用"该步朝向 ±35° 扇区"的最小测距复核。

        单元测试（escA）暴露过：只看全局最小测距时，车侧/车后某个方向的近物会让
        旋转闸门永远误报；只看目标朝向又会在"扫过去的那一段"刮到东西。所以按步校验。

        2026-11-14（I）：上面两步都只扫"目标朝向 ±45°"，管不住**车尾**。车体矩形
        包住雷达原点（车尾沿在雷达后方 0.40 m），旋转时车尾会扫过全部方位角，
        所以只要真的转（|offset| > eps），先要求整个包络逐方位角都安全。
        """
        if abs(offset) > math.radians(3.0):
            ok, _phi, _r, _need = self.body_sweep_clear()
            if not ok:
                return False
        n = max(1, int(round(abs(offset) / step)))
        for i in range(1, n + 1):
            th = offset * i / n
            if self.range_cone(th, half_deg=self.rotate_sector_deg, stride=4) \
                    < self.rotate_min_range + self.rotate_pick_margin:
                return False
        return True

    def pick_heading(self):
        """返回 (offset, 最小测距)；offset 为相对当前朝向的转角（限 ±heading_limit）。

        由小到大枚举 |offset|，第一个"目标扇区够空 + 整段旋转路径安全"的航向即选中
        （转角越小越好）；都不满足时返回全局最空旷的那个，交给上层判 no_direction。
        """
        best_any = None
        offsets = []
        k = 0.15
        while k <= self.heading_limit + 1e-6:
            offsets.extend([k, -k])
            k += 0.15
        offsets.insert(0, 0.0)
        order = sorted(offsets, key=abs)
        for off in order:
            clr = self.range_cone(off, half_deg=14.0, stride=4)
            if best_any is None or clr > best_any[1]:
                best_any = (off, clr)
            if clr < self.min_dir_range:
                continue
            if self.range_cone(off, half_deg=self.rotate_sector_deg, stride=4) < self.rotate_min_range:
                continue
            if not self.rotation_path_clear(off):
                continue
            return off, clr
        return best_any[0], best_any[1]

    def footprint_cost(self):
        """Nav2 局部代价地图上机器人所在格的代价（0..254），取不到返回 None。"""
        cm = self.costmap
        if cm is None or self.pose is None or time.monotonic() - self.costmap_stamp > 2.0:
            return None
        info = cm.metadata
        res = info.resolution
        if res <= 0:
            return None
        mx = int((self.pose[0] - info.origin.position.x) / res)
        my = int((self.pose[1] - info.origin.position.y) / res)
        if not (0 <= mx < info.size_x and 0 <= my < info.size_y):
            return None
        idx = my * info.size_x + mx
        if idx >= len(cm.data):
            return None
        return int(cm.data[idx])

    # ---------------- 主循环 ----------------
    def check_progress_reset(self, now):
        """真正走出去 0.5 m 才算脱困成功：清零受阻累计与单元预算。"""
        if self.stuck_anchor is None or self.pose is None:
            return
        if now - self.last_motion < self.stall_sec:
            return
        if math.hypot(self.pose[0] - self.stuck_anchor[0],
                      self.pose[1] - self.stuck_anchor[1]) >= 0.5:
            self.stuck_total = 0.0
            self.stuck_since = None
            self.stuck_anchor = None
            self.units_this_episode = 0

    def accumulate_stuck(self, now):
        """受阻时长独立累计（不受冷却/退避/单元预算影响）。

        原实现把累计写在 maybe_arm() 里，而 maybe_arm 在冷却/退避期间会提前 return，
        于是"累计受阻 40 s 仍无改善 → 超时退出"这条兜底在实测里永远到不了
        （escB2：stuck_total 只涨到 4.4 s，因为每次降级后有 12 s 退避）。
        """
        if self.stuck_since is None:
            if now - self.last_motion >= self.stall_sec:
                self.stuck_since = now
                if self.stuck_anchor is None and self.pose is not None:
                    self.stuck_anchor = self.pose[:2]
            return
        if now - self.last_motion < self.stall_sec:
            # 又动起来了：结算并关闭本轮受阻计时
            self.stuck_total += now - self.stuck_since
            self.stuck_since = None
            return
        total = self.stuck_total + (now - self.stuck_since)
        if total >= self.recovery_timeout_sec and now >= self.disabled_until:
            self.stats['giveups'] += 1
            self.disabled_until = now + self.giveup_backoff_sec
            self.stuck_total = 0.0
            self.stuck_since = None
            self.mark_zone(now)
            self.log(type='giveup_40s', total=round(total, 1),
                     stuck_total=round(total, 1), nav=self.nav_state,
                     note='累计受阻 %.0fs 仍无改善：退出脱困，停 %.0fs'
                          % (total, self.giveup_backoff_sec))

    def tick(self):
        now = time.monotonic()
        self.accumulate_stuck(now)
        if self.rev_probe:
            self.rev_probe_tick(now)
        self.check_progress_reset(now)
        if self.phase in ('rotate', 'advance'):
            self.drive_tick(now)
            return
        if self.phase == 'end':
            self.finish_unit(now)
            return
        if self.phase == 'reverse':
            self.reverse_tick(now)
            return
        if self.maybe_force_unit(now):
            self.ref = None
        if self.maybe_reverse_assist(now):
            return
        self.maybe_arm(now)

    # ---------------- 返航阶段的受控小步倒车 ----------------
    def in_return_phase(self):
        blob = (self.mode + ' ' + self.state_name).lower()
        return ('return' in blob) or ('home' in blob)

    def rear_clearance(self):
        """后方 ±30° 扇区的最小测距与有效点数（必须"看见"才算净空）。"""
        best = 9.0
        n = 0
        half = math.radians(30.0)
        for i in range(0, len(self.points), 2):
            r, th = self.points[i]
            d = math.atan2(math.sin(th - math.pi), math.cos(th - math.pi))
            if abs(d) > half:
                continue
            n += 1
            if r < best:
                best = r
        return best, n

    def rev_probe_tick(self, now):
        """只读探针（P9-C0/C2）：把 C 层每道闸门此刻的读数与"会不会触发"记下来，不动作、不改状态。

        触发条件与闸门解耦：只要"车端闸按住"或"受阻计时活跃"任一成立就记（吸收态里车常在做
        原地微转，`stuck_since` 会被不断清零，只靠它会漏掉最关键的时刻）。
        why 里列出当前**不满足**的闸门；空列表 = 若开关打开，这一次 tick 就会倒车（would_fire）。
        """
        holding = self._blocked_since is not None
        stalled = self.stuck_since is not None
        if not (holding or stalled):
            return
        if now - self._rev_probe_last < self.rev_probe_dt:
            return
        self._rev_probe_last = now
        stall = (now - self.stuck_since) if stalled else None
        hold_s = (now - self._blocked_since) if holding else None
        front20 = self.range_cone(0.0, half_deg=20.0, stride=2)
        min_all = self.min_range_all(stride=2)
        rear_clear, rear_pts = self.rear_clearance()
        st = (self.state_name or '').lower()
        md = (self.mode or '').lower()
        quiet_s = now - self.last_foreign_cmd
        why = []
        if not self.explore_reverse_enabled:
            why.append('switch_off')
        if not holding or (hold_s is not None and hold_s < self.explore_reverse_block_sec):
            why.append('not_holding_%s' % (round(hold_s or 0.0, 1)))
        if front20 > self.explore_reverse_front_m:
            why.append('front_gt_gate')
        if quiet_s < 1.0:
            why.append('cmd_active')
        if self.nav_busy and not self.explore_reverse_takeover_busy:
            why.append('busy_no_takeover')
        if self._rv_explore_count >= self.explore_reverse_max_count:
            why.append('count_exhausted')
        if rear_pts < self.return_reverse_min_points:
            why.append('rear_unobserved')
        elif rear_clear < self.explore_reverse_rear_clear_m:
            why.append('rear_blocked')
        would = [w for w in why if w != 'switch_off']
        cv, cw = (None, None)
        if self.last_cmd is not None:
            cv, cw = round(self.last_cmd[0], 3), round(self.last_cmd[1], 3)
        self._probe_rows += 1
        self.log(type='rev_probe', stall=None if stall is None else round(stall, 2),
                 hold_s=None if hold_s is None else round(hold_s, 2),
                 front20=round(front20, 3), min_all=round(min_all, 3),
                 rear_clear=round(rear_clear, 3), rear_pts=rear_pts,
                 nav=(self.state_name or '')[:32], mode=(self.mode or '')[:24],
                 busy=self.nav_busy, quiet_s=round(quiet_s, 1),
                 motion_s=round(now - self.last_motion, 1),
                 cmd=[cv, cw], ret=self.in_return_phase(),
                 why=why, would_fire=(not would), rows=self._probe_rows)

    def explore_wedged(self, now):
        """探索期"值得倒一小步"的判据（C v2，2026-10-26 用真实数据重定口径）。

        老口径（`front < rotate_min_range 0.34` + 必须 `stuck_since` 且非 nav_busy）在
        156 个探索期 ≥10 s 停滞段里只覆盖 3%，且吸收态几乎总是"有活跃目标"，净触发≈0。
        实测吸收态的定义特征是：
          * `blocked_waiting_clearance` / `blocked_precheck_pending` / `mode=safety_stop`；
          * **车端已经不再发速度**（cmd≈0，段内 |vx| 均值 0.004）；
          * 段内 front20 中位 0.50 m、68% ≤0.70 m（车端安全闸 front_stop=0.65）。
        因此判据改为"车端闸按住 + 静默 ≥ explore_reverse_block_sec + front ≤ explore_reverse_front_m"，
        与 `stuck_since` 解耦（吸收态里车常在做原地微转，老计时被不断清零）。
        """
        if not self.explore_reverse_enabled:
            return False
        if self.pose is None or not self.points:
            return False
        if now - self.points_stamp > self.scan_stale_sec:
            return False
        if self._blocked_since is None:
            return False
        holding = now - self._blocked_since
        if holding < self.explore_reverse_block_sec:
            return False
        if now - self.last_foreign_cmd < 1.0:
            return False                      # 车端还在发速度：不抢
        front = self.range_cone(0.0, half_deg=20.0, stride=2)
        if front > self.explore_reverse_front_m:
            return False                      # 前向不紧：倒车没意义（多半在等目标）
        self._wedge_info = {'front20': round(front, 3), 'block_s': round(holding, 1),
                            'nav': self.state_name[:28], 'mode': self.mode[:20],
                            'busy': self.nav_busy}
        return True

    def maybe_reverse_assist(self, now):
        explore = False
        if not self.return_reverse_enabled and not self.explore_reverse_enabled:
            return False
        contact_panic = False
        if (self.contact_reverse_enabled and self._contact_at is not None
                and not self.in_return_phase()
                and (now - self._contact_at) <= self.contact_reverse_window_sec
                and self._rv_contact_count < self.contact_reverse_max
                and (now - self.contact_reverse_quiet_sec) <= now
                and (now - self._rv_last_end) >= self.contact_reverse_cooldown_sec):
            # 接触后车端已松手（静默 ≥0.5 s）→ 允许一次受限倒车把车退离障碍。
            # 不要求 blocked 状态：实测贴着低矮物体研磨时状态机根本不报 blocked。
            contact_panic = True
            explore = True
        if not contact_panic and not self.in_return_phase():
            if not self.explore_wedged(now):
                return False
            explore = True
        gave_up = ('failed_waiting_manual' in self.state_name.lower()
                   or 'manual' in self.state_name.lower())
        if self.nav_busy and not gave_up:
            # 有活跃目标通常让 Nav2 自己走；但探索期的吸收态恰恰是"目标还在、车端已零速按住"，
            # 所以 C v2 允许在"车端闸按住且静默"时接管（开关 explore_reverse_takeover_busy）。
            if not (explore and self.explore_reverse_takeover_busy):
                return False
        if explore:
            if self._rv_explore_count >= self.explore_reverse_max_count:
                return False
        elif self._rv_count >= self.return_reverse_max_count:
            return False
        if now - self._rv_last_end < (1.0 if gave_up else 2.0):
            return False
        # manager 已放弃时开一串连续小步（每步仍独立复核后方净空）
        # 2026-11-13：默认关闭 —— 见 giveup_reverse_enabled 的注释。
        if gave_up and not self.giveup_reverse_enabled:
            return False
        if gave_up and self._rv_streak_left <= 0:
            self._rv_streak_left = self.return_reverse_streak
        if now - self.points_stamp > self.scan_stale_sec:
            return False
        if contact_panic:
            # 接触路径：允许覆盖车端指令（这正是它的意义），只要求"确实没在正常行驶"
            if now - self.last_motion < 0.3:
                return False
            rfront = self.range_cone(0.0, half_deg=20.0, stride=2)
            if rfront > self.contact_reverse_front_m:
                return False                     # 前方已开阔：倒车没意义
        else:
            if now - self.last_foreign_cmd < 1.0:
                return False
            if now - self.last_motion < (1.0 if explore else 2.0):
                return False
        clear, npts = self.rear_clearance()
        need_pts = self.return_reverse_min_points
        need_clear = self.explore_reverse_rear_clear_m if explore else self.return_reverse_rear_clear
        if npts < need_pts:
            # 真机雷达后方是盲区：看不到就必须当作"不清空"，绝不倒车
            self.log(type='reverse_assist_refused', why='rear_unobserved',
                     rear_points=npts, rear_clear=round(clear, 3), nav=self.nav_state)
            self._rv_last_end = now + 30.0
            return False
        if clear < need_clear:
            self.log(type='reverse_assist_refused', why='rear_blocked',
                     rear_points=npts, rear_clear=round(clear, 3), nav=self.nav_state)
            self._rv_last_end = now + 10.0
            return False
        self.phase = 'reverse'
        self._rv_active = True
        self._rv_explore_phase = explore
        self._rv_t0 = now
        self._rv_moved = 0.0
        self._rv_speed = self.explore_reverse_speed if explore else self.return_reverse_speed
        self._rv_max_m = self.explore_reverse_max_m if explore else self.return_reverse_max_m
        self._rv_start = (self.pose[0], self.pose[1]) if self.pose else None
        if explore:
            self._rv_explore_count += 1
            if contact_panic:
                self._rv_contact_count += 1
                self._contact_at = None      # 一次接触只换一次倒车
        else:
            self._rv_count += 1
        if self._rv_streak_left > 0:
            self._rv_streak_left -= 1
        self.assist_pub.publish(Bool(data=True))
        self.log(type='reverse_assist_start', rear_points=npts,
                 rear_clear=round(clear, 3), nav=self.nav_state,
                 phase=('contact' if contact_panic else 'explore') if explore else 'return',
                 wedge=dict(self._wedge_info) if explore else None,
                 note=('探索期贴死（车端闸按住且已静默 ≥%.1fs）：受控小步倒车'
                       % self.explore_reverse_block_sec
                       if explore else '返航卡住（起点离占据格太近）：受控小步倒车'))
        return True

    def reverse_tick(self, now):
        if now - self.last_foreign_cmd < 0.3 and now - self.own_cmd_at > 0.2:
            self.end_reverse(now, 'foreign_cmd')
            return
        clear, npts = self.rear_clearance()
        need_clear = self.explore_reverse_rear_clear_m if self._rv_explore_phase \
            else self.return_reverse_rear_clear
        if npts < self.return_reverse_min_points or clear < need_clear:
            self.end_reverse(now, 'rear_blocked')
            return
        if self._rv_start is not None and self.pose is not None:
            self._rv_moved = math.hypot(self.pose[0] - self._rv_start[0],
                                        self.pose[1] - self._rv_start[1])
        if self._rv_moved >= getattr(self, '_rv_max_m', self.return_reverse_max_m) \
                or now - self._rv_t0 > 4.0:
            self.end_reverse(now, 'done')
            return
        self.publish(-getattr(self, '_rv_speed', self.return_reverse_speed), 0.0,
                     allow_reverse=True)

    def end_reverse(self, now, why):
        self.publish(0.0, 0.0, allow_reverse=True)
        self._rv_active = False
        self.phase = 'idle'
        self._rv_last_end = now
        self.assist_pub.publish(Bool(data=False))
        self.log(type='reverse_assist_end', why=why,
                 moved=round(self._rv_moved, 3), dur=round(now - self._rv_t0, 2),
                 pos=[round(v, 2) for v in (self.pose or (0, 0, 0))[:2]],
                 nav=self.nav_state, stats=dict(self.stats))

    def _why_block(self, why, now):
        if now - getattr(self, '_last_why_log', 0.0) > 5.0:
            self._last_why_log = now
            self.get_logger().info('强制脱困被挡：%s' % why)
            self.log(type='forced_unit_refused', why=why, nav=self.nav_state)

    def maybe_force_unit(self, now):
        """P0-甲：被看门狗点名时立刻起一个脱困单元（安全闸门一个都不放松）。"""
        if not self.enabled or self.phase == 'reverse':
            return False
        if now - self.force_request_at > 2.0 or self.force_request_at <= 0.0:
            return False
        if now < self.disabled_until or now < self.spot_until:
            self._why_block('冷却/退避中', now); return False
        if now - self.points_stamp > self.scan_stale_sec:
            self._why_block('雷达数据陈旧(%.1fs)' % (now - self.points_stamp), now); return False
        if self.pose is None:
            self._why_block('无位姿', now); return False
        if self.require_near_obstacle > 0.0:
            clear = self.min_range_all(stride=2)
            if clear > self.require_near_obstacle:
                self._why_block('离障碍还远 %.2f>%.2f' % (clear, self.require_near_obstacle), now)
                return False
        if self.units_this_episode >= self.max_units_per_episode:
            self._why_block('本回合单元数已用完 %d/%d' % (self.units_this_episode,
                                                       self.max_units_per_episode), now)
            return False
        self.force_request_at = 0.0
        self.get_logger().warn('收到看门狗脱困请求 → 强制起一个脱困单元')
        self.log(type='forced_unit_start', nav=self.nav_state)
        self.start_unit(now)
        return True

    def maybe_arm(self, now):
        if not self.enabled:
            return
        if now < self.disabled_until or now < self.spot_until:
            return
        if now - self.points_stamp > self.scan_stale_sec:
            return
        if self.pose is None:
            return
        # 楔死状：mode/state 里出现 blocked/escape/wedge/stuck。
        # 注意返航阶段同样要允许脱困（车端返航的"盲退"已关，返航被夹住只能靠旋转+前进出来）。
        blob = (self.mode + ' ' + self.state_name).lower()
        blocked_state = any(t in blob for t in BLOCKED_TOKENS)
        if not (self.nav_busy or blocked_state):
            return
        if self.state_name.lower() in IDLE_NAV_STATES:
            return
        if now - self.last_foreign_cmd < self.cmd_quiet_sec:
            return
        if now - self.last_motion < self.stall_sec:
            return
        if self.require_near_obstacle > 0.0:
            clear = self.min_range_all(stride=2)
            if clear > self.require_near_obstacle:
                return                       # 离障碍还远：不是楔死，不接管
        if now - self._busy_since < self.busy_grace_sec:
            return                           # 目标刚派发，给它自己走一会儿
        if self.units_this_episode >= self.max_units_per_episode:
            return
        if self.stuck_since is None:
            return                           # 还没进受阻计时（accumulate_stuck 负责）
        self.start_unit(now)

    def start_unit(self, now):
        offset, clr = self.pick_heading()
        self.arm_clearance = self.range_cone(0.0, half_deg=14.0, stride=2)
        self.arm_cost = self.footprint_cost()
        if clr < self.min_dir_range:
            # 降级：没有"够宽敞"的方向，但若最优方向仍有前进余量，就走一小步（不盲动、不后退）。
            # 实测 demo5 的返航卡死正是这种情形：车被夹在墙边，需要挪开几厘米才能满足
            # manager 的"起点离占据格 >=0.22 m"判据，却因为没到 0.50 m 而一直干等超时。
            if clr >= self.advance_stop_range + 0.04 and self.rotation_path_clear(offset):
                self.degrade_advance = True
            else:
                self.stats['no_dir'] += 1
                self.spot_until = now + self.degrade_backoff_sec
                self.mark_zone(now)
                self.log(type='no_direction', best_offset=round(offset, 2),
                         best_clearance=round(clr, 3),
                         arm_clearance=round(self.arm_clearance, 3),
                         nav=self.nav_state,
                         note='没有 >=%.2fm 的自由方向，不盲动' % self.min_dir_range)
                return
        self.stats['units'] += 1
        self.units_this_episode += 1
        self.phase = 'pick'
        self.unit_t0 = now
        self.unit_offset = offset
        self.unit_remaining = offset
        self.unit_moved = 0.0
        self.degrade_advance = getattr(self, 'degrade_advance', False)
        self._rv_active = False
        self._rv_t0 = 0.0
        self._rv_moved = 0.0
        self._rv_count = 0
        self._rv_last_end = 0.0
        self._rv_points = 0
        self.unit_anchor = self.pose[:2]
        self.unit_started_pos = self.pose[:2]
        self.log(type='unit_start', offset=round(offset, 2),
                 degraded_dir=bool(getattr(self, 'degrade_advance', False)),
                 dir_range=round(clr, 3),
                 arm_range=round(self.arm_clearance, 3),
                 cost=self.arm_cost, nav=self.nav_state,
                 units_episode=self.units_this_episode,
                 stuck_total=round(self.stuck_total, 1))
        self.phase = 'rotate'

    def drive_tick(self, now):
        unit_dt = now - self.unit_t0
        if now - self.last_foreign_cmd < 0.3 and now - self.own_cmd_at > 0.2:
            self.abort_unit(now, 'foreign_cmd')
            return
        if unit_dt >= self.unit_max_sec:
            self.end_unit(now, degraded=True)
            return
        if self.phase == 'rotate':
            # 只看"正在转进去的那一侧"（含车体半宽对应的展角），避免车后有近物就永不动
            cur = self.range_cone(self.remaining_sector_anchor(now), half_deg=self.rotate_sector_deg, stride=3)
            if cur < self.rotate_min_range:
                self.abort_unit(now, 'rotate_into_obstacle')
                return
            # 2026-11-14（I）：执行期也复核车体包络 —— 选向时安全不代表转了一半还安全
            # （p14vE_sw1：选向时左 0.356 m，转到一半就只剩 0.185 m）。
            if abs(self.unit_remaining) > math.radians(3.0):
                ok, phi, r, need = self.body_sweep_clear()
                if not ok:
                    self.abort_unit(now, 'rotate_sweep_blocked')
                    self.log(type='rotate_sweep_blocked',
                             phi_deg=round(phi, 1), range_m=round(r, 3),
                             need_m=round(need, 3), nav=self.nav_state,
                             note='车体包络扫掠空间不足，立即停转')
                    return
            if abs(self.unit_remaining) < 0.10 or unit_dt >= self.rotate_budget_sec:
                self.unit_remaining = 0.0
                self.phase = 'advance'
                return
            sign = 1.0 if self.unit_remaining > 0.0 else -1.0
            self.unit_remaining -= sign * self.rotate_speed * 0.1
            self.publish(0.0, sign * self.rotate_speed)
            return
        # advance
        # 前进闸门看 ±45°（车体侧向也会蹭），不再只看 ±20°
        # 口径（2026-11-14）：advance_stop_range 是**雷达测距**门限，真实前沿净空
        # = advance_stop_range - body_front_offset（雷达在车体前沿后方 0.05 m）。
        # 默认 0.35 → 前沿净空 0.30 m（旧代码直接写 0.30 时真实净空只有 0.25）。
        fwd = self.range_cone(0.0, half_deg=45.0, stride=2)
        if fwd <= self.advance_stop_range:
            self.end_unit(now, degraded=False)
            return
        moved = math.hypot(self.pose[0] - self.unit_started_pos[0],
                           self.pose[1] - self.unit_started_pos[1])
        self.unit_moved = moved
        limit = self.advance_max_m
        if getattr(self, 'degrade_advance', False):
            limit = min(limit, self.degrade_advance_m)
        if moved >= limit:
            self.end_unit(now, degraded=False)
            return
        self.publish(self.advance_speed, 0.0)

    def publish(self, vx, wz, allow_reverse=False):
        # 唯一的速度出口。用户边界：脱困只能"旋转+前进"，不得后退；
        # 唯一例外是返航阶段的受控小步倒车（allow_reverse=True，由 reverse_assist 调用）。
        if vx < 0.0 and not allow_reverse:
            vx = 0.0
        self.cmd_pub.publish(Twist(linear=Vector3(x=float(vx), y=0.0, z=0.0),
                                   angular=Vector3(x=0.0, y=0.0, z=float(wz))))
        self.own_cmd_at = time.monotonic()

    def end_unit(self, now, degraded):
        self.publish(0.0, 0.0)
        post_clear = self.range_cone(0.0, half_deg=20.0, stride=2)
        post_cost = self.footprint_cost()
        improved = False
        if self.arm_clearance is not None and post_clear - self.arm_clearance >= self.clearance_gain:
            improved = True
        if (self.arm_cost is not None and post_cost is not None
                and self.arm_cost - post_cost >= self.cost_gain):
            improved = True
        moved = 0.0
        if self.unit_anchor is not None and self.pose is not None:
            moved = math.hypot(self.pose[0] - self.unit_anchor[0],
                               self.pose[1] - self.unit_anchor[1])
        if improved:
            self.stats['ok'] += 1
        else:
            self.stats['failed'] += 1
            if degraded or moved < 0.02:
                self.stats['degraded'] += 1
                self.spot_until = now + self.degrade_backoff_sec
                self.mark_zone(now)
        self.log(type='unit_end', improved=improved, degraded=degraded,
                 offset=round(self.unit_offset, 2), moved=round(moved, 3),
                 arm_range=None if self.arm_clearance is None else round(self.arm_clearance, 3),
                 post_range=round(post_clear, 3),
                 arm_cost=self.arm_cost, post_cost=post_cost,
                 dur=round(now - self.unit_t0, 1),
                 unit_dt=round(now - self.unit_t0, 1),
                 nav=self.nav_state, stats=dict(self.stats))
        self.phase = 'idle'
        self.degrade_advance = False
        self.unit_offset = 0.0
        self.unit_remaining = 0.0
        self.unit_anchor = None
        self.arm_clearance = None
        self.arm_cost = None
        self.disabled_until = now + self.cooldown_sec

    def abort_unit(self, now, why):
        self.publish(0.0, 0.0)
        self.stats['aborts'] += 1
        self.log(type='unit_abort', why=why, dur=round(now - self.unit_t0, 2),
                 nav=self.nav_state, stats=dict(self.stats))
        self.phase = 'idle'
        self.unit_offset = 0.0
        self.unit_remaining = 0.0
        self.arm_clearance = None
        self.arm_cost = None
        self.unit_anchor = None
        self.disabled_until = now + self.cooldown_sec

    def mark_zone(self, now):
        if self.pose is None:
            return
        msg = PoseStamped()
        msg.header.frame_id = 'map'
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.pose.position.x = float(self.pose[0])
        msg.pose.position.y = float(self.pose[1])
        msg.pose.orientation.w = 1.0
        self.zone_pub.publish(msg)
        # 让仲裁知道"这里别再来"
        self.get_logger().warn(
            '受阻区上报（脱困失败）：(%.2f, %.2f)' % (self.pose[0], self.pose[1]))

    def destroy_node(self):
        try:
            self.publish(0.0, 0.0)
        except Exception:
            pass
        if self._fh is not None:
            try:
                self._fh.close()
            except Exception:
                pass
        super().destroy_node()


def main():
    rclpy.init()
    node = EscapeSupervisor()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
