#!/usr/bin/env bash
# patch_sim_time —— 车端栈的"仿真运行期参数补丁"（不改车端源码，只用 ros2 param set）。
#
# 顺序按实测教训排（2026-10-23）：
#   0) mapping_tf_guard 的 use_sim_time 必须**最先**补 —— 它只有 30 s 硬超时，
#      超时会 SIGINT 整个 launch（p0t8 / p0demo3 就是这样整轮被打断的）。
#   1) 关车端盲退（P0）：开局就要生效，否则头 30 s 内脱困仍会走两次 R1 盲退。
#   2) 把 Nav2 足迹补回真实车宽（P0-5）。
#   3) 其余 4 个节点的 use_sim_time。
#   4) Nav2 容忍度 / 目标容差。
set +u
source /opt/ros/humble/setup.bash
source /home/kbf/stemm_sim_ws/install/setup.bash
source /home/kbf/stemm_explore_ws/install/setup.bash
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-42}"

MGR=/stemm_cartographer_nav2_manager
DISABLE_RETREAT="${1:-1}"   # 1=P0（默认）；0=保留车端盲退，做对照基线用
# 阶段2（用户 2026-10-24 批准）：允许"仅当前向受阻时的 ≤0.15 m 雷达复核受控小步倒车"。
# 车端 R1b 探索后退本来就是"前向持续 <0.45 m 且后方条带在 /map 上复核过"才动，
# 所以这里只是把它重新打开并把包络收窄到 0.15 m / 0.05 m/s，不新增任何代码路径。
EXPLORE_BACKSTEP="${2:-1}"  # 1=启用受控小步倒车（默认，用户已批准）；0=维持 P0 的绝对禁止
# 2026-10-25 P0：单次 0.15 m、每次会话 2 步、间隔 8 s 的预算，对"车头贴脸 0.34 m"的
# 死角不够用（实测卡 3~13 s、外加等下一个目标）。放宽到 6 步 / 4 s 间隔，
# 单步包络（0.15 m @0.05 m/s、后方雷达复核）不变。
RETREAT_MAX="${3:-2}"
RETREAT_IVL="${4:-8.0}"

set_param() {   # $1=node $2=name $3=value → 成功返回 0
  # 2026-10-24：ros2 param set 偶发**永久阻塞**（daemon/负载），曾把阶段2 第一条之后的
  # 全部参数卡死（倒车包络没生效且无人知道）。加硬超时保证脚本一定能往下走。
  timeout 4 ros2 param set "$1" "$2" "$3" >/dev/null 2>&1
}

retry_until() {   # $1=seconds $2=node $3=param $4=value
  local end=$(( $(date +%s) + $1 ))
  while [ "$(date +%s)" -lt "$end" ]; do
    set_param "$2" "$3" "$4" && { echo "[patch] $2 $3=$4 ✓"; return 0; }
    sleep 0.3
  done
  echo "[patch] $2 $3=$4 ✗（超时）"; return 1
}

# ---------------- 0) 先救 mapping_tf_guard（30 s 硬超时）----------------
retry_until 15 /stemm_cartographer_mapping_tf_guard use_sim_time true

# ---------------- 1) P0：关闭车端盲退 ----------------
if [ "$DISABLE_RETREAT" = "1" ]; then
  if [ "$EXPLORE_BACKSTEP" = "1" ]; then
    # 阶段2：探索期只允许"受控小步倒车"——包络 0.15 m / 0.05 m/s，每次会话最多 2 步，
    # 触发条件仍是车端自己的 R1b（前向 blocked_retreat_after_sec 秒内持续 <0.45 m，
    # 且后方条带在 /map 上先复核过 rear_margin=0.25 m）。返航倒车仍保持关闭。
    #
    # ★★ 2026-11-14 竞态修复（p14vQ_far3 实测暴露）★★
    #
    # 原来这里的第一句是 `exploration_retreat_enabled true`，然后才设上限。
    # 但 cartographer_manager 里这个参数**默认就是 True**（第 393 行），
    # 且默认 `max_distance_m=0.35` / `speed_mps=0.10` / `max_sec=3.0`。
    # 于是从 manager 启动那一刻起，它就以 0.35 m / 0.10 m/s 的包络在跑；
    # 本脚本是异步的（retry_until 带重试 + timeout），"开闸"到"设限"之间存在窗口。
    #
    # 实测后果（p14vQ_far3）：sim=14 就因 front=0.2285 触发 R1b，
    # 日志 `R1 bounded reverse: moved back 0.30 m at 0.10 m/s (limit 0.35 m / 3.0 s)`
    # —— 用的是旧默认值，退 0.302 m（设计上限只有 0.15 m），退完 min_d=0.004，
    # 单窗 0.302 m > 探索期包络 0.20 m ⇒ reverse_authorized=False ⇒ no_reverse FAIL。
    # 同一轮 patch 的第 418 行才写下 max_distance_m=0.15，但为时已晚。
    #
    # 正确顺序（2026-11-14 第二轮修正）：**先落"真正起作用的上限"，再动开关**。
    #
    # 第一版修法写的是「先关闸 → 设上限 → 再开闸」，但 p14vR_far1 实测
    # `exploration_retreat_enabled=false ✗（超时）`（far2 同一句却 ✓）
    # —— 说明 manager 的参数服务在 patch 跑的时候还没准备好，
    # 12 s 的重试窗口不够，这一步**时灵时不灵**，不能拿它兜底。
    #
    # 关键事实：`exploration_retreat_enabled` 默认已是 True，
    # 所以"关闸"本来就只是个形式；真正保护车的是 `max_distance_m`。
    # R1b 的实际位移上界 = min(max_distance_m, speed_mps*max_sec)，
    # 只要 0.15 m 这条先落地，后面 speed/max_sec 还是默认值也翻不出 0.15 m。
    #
    # 因此改成：把 max_distance_m 提到**第一条**并给足 30 s 等待（等节点起来），
    # 其余上限紧随其后（节点一旦应答，后续都是亚秒级），最后才写 enabled。
    # 残余窗口 = 节点开始应答 → 第一条 set 落地 ≈ 一次 RPC，不再是 12 s 级。
    retry_until 30 "$MGR" exploration_retreat_max_distance_m 0.15
    retry_until 6  "$MGR" exploration_retreat_speed_mps 0.05
    retry_until 6  "$MGR" exploration_retreat_max_sec 2.0
    retry_until 6  "$MGR" exploration_retreat_rear_margin_m 0.25
    retry_until 6  "$MGR" blocked_retreat_max_per_session "$RETREAT_MAX"
    retry_until 6  "$MGR" blocked_retreat_min_interval_sec "$RETREAT_IVL"
    retry_until 6  "$MGR" exploration_retreat_enabled true
    echo "[patch] 阶段2 探索期受控小步倒车已启用（<=0.15m @0.05m/s，雷达复核后方；每局 $RETREAT_MAX 步 / 间隔 ${RETREAT_IVL}s）"
  else
    # 同理（2026-11-14）：`exploration_retreat_enabled` 默认就是 True，
    # "关闸"这一步会因 manager 参数服务未就绪而超时（p14vR_far1 实测 ✗（超时））。
    # 真正让 R1b 停手的是**会话预算**：把 max_per_session 先压到 0，
    # 即使 enabled 一直是 True 也不会再退。所以预算优先，enabled 只作可读性。
    retry_until 30 "$MGR" blocked_retreat_max_per_session 0
    retry_until 6  "$MGR" exploration_retreat_enabled false
    echo "[patch] 探索期倒车保持绝对禁止（EXPLORE_BACKSTEP=0）"
  fi
  retry_until 4  "$MGR" return_home_retreat_enabled false
  retry_until 4  "$MGR" return_home_failure_retreat_enabled false
  # 车端 stemm_escape_controller 只会"原地转到底"，仿真侧 escape_supervisor 是它的超集
  # （同样只用雷达、同样绝不后退，但会转向最空旷方向并前进一小段）；两者同跑会抢 /cmd_vel。
  if [ "${DISABLE_CAR_ESCAPE:-1}" = "1" ]; then
    retry_until 8 /stemm_escape_controller enabled false
  else
    echo "[patch] 保留车端 escape_controller（DISABLE_CAR_ESCAPE=0）"
  fi
  echo "[patch] 阶段1 盲退关闭完成"

  # ---------------- 2) P0-5：Nav2 足迹补回真实车宽 ----------------
  # 真机含轮总宽 0.46 m ⇒ 轮外沿 y=±0.23，而车端 footprint 半宽只有 0.20：
  # 规划器以为"车心离墙 0.20 m 安全"，实测刮墙时车心离墙恰好 0.19 m（轮子插进去 3 cm）。
  FOOTPRINT='[[-0.18,-0.235],[-0.18,0.235],[0.32,0.235],[0.32,-0.235]]'
  retry_until 12 /local_costmap/local_costmap footprint "$FOOTPRINT"
  retry_until 12 /global_costmap/global_costmap footprint "$FOOTPRINT"
else
  echo "[patch] 跳过 P0（DISABLE_RETREAT=$DISABLE_RETREAT）：保留车端盲退与旧足迹"
fi

# ---------------- 3) 其余节点的 use_sim_time ----------------
TARGETS="$MGR /stemm_cartographer_odom_session_guard /stemm_cartographer_state_saver /stemm_cartographer_map_service_adapter"
DONE=""
DEADLINE=$(( $(date +%s) + 25 ))
while [ "$(date +%s)" -lt "$DEADLINE" ]; do
  for T in $TARGETS; do
    case " $DONE " in *" $T "*) continue ;; esac
    set_param "$T" use_sim_time true && { DONE="$DONE $T"; echo "[patch] $T use_sim_time=true ✓"; }
  done
  n=0; for t in $TARGETS; do case " $DONE " in *" $t "*) n=$((n+1));; esac; done
  [ "$n" -eq 4 ] && break
  sleep 0.5
done
echo "[patch] 阶段3 use_sim_time：$n/4"

# ---------------- 4) Nav2 容忍度 / 目标容差 ----------------
retry_until 20 "$MGR" frontier_goal_topic /validated_frontier_goal
for N in /controller_server /planner_server /bt_navigator /behavior_server \
         /global_costmap/global_costmap /local_costmap/local_costmap; do
  retry_until 8 "$N" transform_tolerance 0.5
done
retry_until 8 /controller_server yaw_goal_tolerance 0.15
retry_until 8 /controller_server xy_goal_tolerance 0.15
echo "[patch] 全部阶段完成"
exit 0
