#!/usr/bin/env bash
# patch_sim_time —— 给车端未传 use_sim_time 的节点补运行时参数（仿真专用）。
# 已确认：stemm_cartographer_mapping_tf_guard 在 launch 里没有 use_sim_time 参数，
# 仿真里它会用墙钟 now() 与仿真的 TF 时间戳比较 → 30 s 内必判"TF 不新鲜"。
# 这里以 0.5 s 间隔重试，直到参数设置成功或超时（默认 30 s）。
set +u
source /opt/ros/humble/setup.bash
source /home/kbf/stemm_sim_ws/install/setup.bash
source /home/kbf/stemm_explore_ws/install/setup.bash
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-42}"
# 车端 launch 里有若干节点没传 use_sim_time；仿真里必须补，否则它们用墙钟与仿真的 TF/时间戳比较
TARGETS="${1:-/stemm_cartographer_mapping_tf_guard /stemm_cartographer_nav2_manager /stemm_cartographer_odom_session_guard /stemm_cartographer_state_saver /stemm_cartographer_map_service_adapter}"
DEADLINE=$(( $(date +%s) + ${2:-30} ))
DONE=""
while [ "$(date +%s)" -lt "$DEADLINE" ]; do
  for TARGET in $TARGETS; do
    case " $DONE " in *" $TARGET "*) continue ;; esac
    OUT=$(ros2 param set "$TARGET" use_sim_time true 2>&1)
    case "$OUT" in
      *"True"*) DONE="$DONE $TARGET"; echo "[patch_sim_time] ${TARGET} ✓" ;;
    esac
  done
  n=0; for t in $TARGETS; do case " $DONE " in *" $t "*) n=$((n+1));; esac; done
  [ "$n" -eq "$(echo $TARGETS | wc -w)" ] && { echo "[patch_sim_time] 全部完成"; exit 0; }
  sleep 0.5
done
# Nav2 容忍度：仿真里细时钟会带来几毫秒级"未来"查询，放宽 transform_tolerance
for N in /controller_server /planner_server /bt_navigator /behavior_server /global_costmap/global_costmap /local_costmap/local_costmap; do
  ros2 param set "$N" transform_tolerance 0.5 >/dev/null 2>&1 && echo "[patch_sim_time] ${N} transform_tolerance=0.5 ✓"
done
# 车端 return_home 的末段姿态对齐有 25 s 上限；仿真控制器末端易小幅摆动，
# 放宽 Nav2 的目标容差让 BT 能更早宣告成功（仅仿真侧运行时参数）
ros2 param set /controller_server yaw_goal_tolerance 0.15   >/dev/null 2>&1 && echo "[patch_sim_time] controller_server yaw_goal_tolerance=0.15 ✓"
ros2 param set /controller_server xy_goal_tolerance 0.15    >/dev/null 2>&1 && echo "[patch_sim_time] controller_server xy_goal_tolerance=0.15 ✓"
ros2 param set /controller_server xy_goal_tolerance 0.15    >/dev/null 2>&1
echo "[patch_sim_time] 部分未成功：$DONE"; exit 0
