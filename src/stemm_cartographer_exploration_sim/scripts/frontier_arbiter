#!/usr/bin/env python3
"""frontier_arbiter —— 仿真侧前沿仲裁（S1）：可达性预筛 + 失败黑名单 + 最小前沿规模 + 目标回拉。

背景：实测候选点产量充足（163 个/75 s），但派发目标成功率仅 33%（4/6 被取消），
且 escape/blocked 恢复开销大。原因是候选点只经过"代价地图障碍判断"，
没有做"规划器可达性"校验，也没消除已失败过的候选。

做法（不改车端源码）：
  /filtered_goal_points ──┐
  /map (transient_local) ──┼─► 打分(未知格数) → 取前 N → 回拉 → ComputePathToPose 校验
  /odom_combined ─────────┘                                        │
                                                                   ▼
                                              /validated_frontier_goal (PoseStamped)
  manager 的 frontier_goal_topic 运行期指到本话题即可（无侵入）。

参数：
  min_unknown_cells  候选周围未知格数下限（默认 30，5cm 栅格 ≈ 0.075 m²）
  check_radius       统计未知格与回拉用的半径（默认 1.0 m）
  pullback_m         目标回拉距离，落到已知自由空间一侧（默认 0.6 m）
  blacklist_sec      失败候点的黑名单时长（默认 60 s）
  blacklist_radius   黑名单作用半径（默认 0.8 m）
  max_candidates     每轮校验的候选数（默认 5）
  republish_sec      最小重发间隔（默认 8 s）
  path_timeout_sec   ComputePathToPose 超时（默认 4 s）
"""
import json
import math
import os
import time

import rclpy
from action_msgs.msg import GoalStatusArray
from geometry_msgs.msg import PoseStamped, Twist
from nav_msgs.msg import OccupancyGrid, Odometry
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
from std_msgs.msg import String
from wheeltec_rrt_msg.msg import PointArray



# =====================================================================
# 纯函数打分内核（不依赖 ROS，便于 harness/test_scoring.py 离线秒级验证）
# grid = {'res','w','h','ox','oy','data'}；data: -1=未知, 0..24=自由, >=50=占据
# =====================================================================
FREE_MAX = 25
OCC_MIN = 50


def to_cell(g, x, y):
    return int((x - g['ox']) / g['res']), int((y - g['oy']) / g['res'])


def cell_stats(g, x, y, radius_m):
    """半径内 未知格数 / 自由格数。"""
    r = max(1, int(radius_m / g['res']))
    cx, cy = to_cell(g, x, y)
    unknown = free = 0
    for j in range(max(0, cy - r), min(g['h'], cy + r + 1)):
        base = j * g['w']
        for i in range(max(0, cx - r), min(g['w'], cx + r + 1)):
            v = g['data'][base + i]
            if v < 0:
                unknown += 1
            elif v < FREE_MAX:
                free += 1
    return unknown, free


def unknown_component_size(g, x, y, cap=2000, radius_m=3.0):
    """候选点所在"未知连通块"的大小（BFS，半径内、上限 cap）。

    这是"S3+S2 收益函数"的核心：大块未知（还没探过的大区域）值得优先，
    而已经探得七零八落只剩碎角的地方，块大小很小 → 自然被压后。
    """
    res = g['res']
    rmax = max(2, int(radius_m / res))
    cx, cy = to_cell(g, x, y)
    # 先找一个未知格做种子（候选点本身可能落在自由格/占据边上）
    seed = None
    for rad in range(0, rmax + 1):
        for j in range(cy - rad, cy + rad + 1):
            for i in (cx - rad, cx + rad) if rad else (cx,):
                if 0 <= i < g['w'] and 0 <= j < g['h']:
                    if g['data'][j * g['w'] + i] < 0:
                        seed = (i, j)
                        break
            if seed:
                break
        if seed:
            break
    if seed is None:
        return 0
    seen = {(seed[0], seed[1])}
    q = [seed]
    n = 0
    data = g['data']
    w, h = g['w'], g['h']
    while q and n < cap:
        i, j = q.pop()
        n += 1
        for ni, nj in ((i + 1, j), (i - 1, j), (i, j + 1), (i, j - 1)):
            if not (0 <= ni < w and 0 <= nj < h):
                continue
            if abs(ni - cx) > rmax or abs(nj - cy) > rmax:
                continue
            if (ni, nj) in seen:
                continue
            if data[nj * w + ni] < 0:
                seen.add((ni, nj))
                q.append((ni, nj))
    return n


def frontier_width(g, x, y, radius_m=1.5):
    """前沿"宽度"代理：半径内与未知格相邻的自由格数。

    用来替代"前沿段长度"（RRT 只给点，没有段）：碎角/单格突起会得到很小的值。
    """
    r = max(1, int(radius_m / g['res']))
    cx, cy = to_cell(g, x, y)
    w, h, data = g['w'], g['h'], g['data']
    n = 0
    for j in range(max(0, cy - r), min(h, cy + r + 1)):
        base = j * w
        for i in range(max(0, cx - r), min(w, cx + r + 1)):
            if data[base + i] < 0 or data[base + i] >= FREE_MAX:
                continue
            adj_unknown = False
            for ni, nj in ((i + 1, j), (i - 1, j), (i, j + 1), (i, j - 1)):
                if 0 <= ni < w and 0 <= nj < h and data[nj * w + ni] < 0:
                    adj_unknown = True
                    break
            if adj_unknown:
                n += 1
    return n


def score_one(g, x, y, dist, cfg, penalty=0.0):
    """单个候选的收益分（越大越好）。返回 dict 便于日志取证。"""
    info_r = cfg['info_radius']
    u, free = cell_stats(g, x, y, info_r)
    blk = unknown_component_size(g, x, y, cap=cfg['block_cap'], radius_m=cfg['block_radius'])
    width = frontier_width(g, x, y, radius_m=cfg['width_radius'])
    ratio = u / float(u + free) if (u + free) > 0 else 0.0
    info = u * (1.0 + cfg['w_block'] * min(blk, cfg['block_cap']) / float(cfg['block_cap']))
    score = (info * (cfg['ratio_floor'] + (1.0 - cfg['ratio_floor']) * ratio)
             + cfg['w_width'] * min(width, cfg['width_cap'])
             - cfg['w_dist'] * dist
             - penalty)
    if width < cfg['min_width']:
        score *= cfg['small_frontier_factor']     # 碎角：降权不硬拒（留到最后细化）
    return {'x': x, 'y': y, 'unknown': u, 'free': free, 'block': blk,
            'width': width, 'ratio': ratio, 'penalty': penalty, 'score': score}


def prefilter_one(g, x, y, dist, cfg, penalty=0.0):
    """便宜的一级打分：只用 未知格数 / 未知占比 / 距离 / 罚分（不做 BFS）。"""
    u, free = cell_stats(g, x, y, cfg['info_radius'])
    ratio = u / float(u + free) if (u + free) > 0 else 0.0
    score = (u * (cfg['ratio_floor'] + (1.0 - cfg['ratio_floor']) * ratio)
             - cfg['w_dist'] * dist - penalty)
    return {'x': x, 'y': y, 'unknown': u, 'free': free, 'ratio': ratio,
            'penalty': penalty, 'score': score}


def rank_candidates(g, cands, cfg, penalty_fn=None, pose=None, prefilter_n=None):
    """两级排序：先便宜预筛到 prefilter_n 个，再对它们做完整打分（连通块+前沿宽度）。

    候选池可能有几百个，全量做 BFS 会让 1 Hz 的 tick 卡死 —— 这是实测必须的两级结构。
    """
    pre = []
    for x, y in cands:
        dist = math.hypot(x - pose[0], y - pose[1]) if pose is not None else 0.0
        pen = penalty_fn(x, y) if penalty_fn else 0.0
        pre.append(prefilter_one(g, x, y, dist, cfg, pen))
    pre.sort(key=lambda r: r['score'], reverse=True)
    top = pre[:prefilter_n] if prefilter_n else pre
    out = []
    for r in top:
        dist = math.hypot(r['x'] - pose[0], r['y'] - pose[1]) if pose is not None else 0.0
        out.append(score_one(g, r['x'], r['y'], dist, cfg, r['penalty']))
    out.sort(key=lambda r: r['score'], reverse=True)
    return out



def unknown_in_cone(g, x, y, heading, dist_lo, dist_hi, half_deg, stride=1):
    """候选点"前方"锥形区域里的未知格数（沿 heading 方向，距离 dist_lo..dist_hi，±half_deg）。

    这是 v3 收益函数的核心：真正值得去的不是"周围一片未知"，而是"朝那个方向有一大块未知"。
    v2 用"邻域未知占比"当主项，结果偏好往未测绘深处扎（实测撞进看不见的桌子底座），v3 反过来。
    """
    res = g['res']
    w, h, data = g['w'], g['h'], g['data']
    cx, cy = to_cell(g, x, y)
    r_lo = int(dist_lo / res)
    r_hi = int(dist_hi / res)
    if r_hi <= r_lo:
        return 0
    tan_half = math.tan(math.radians(half_deg))
    n = 0
    for j in range(cy - r_hi, cy + r_hi + 1):
        if not (0 <= j < h):
            continue
        base = j * w
        dj = j - cy
        for i in range(cx - r_hi, cx + r_hi + 1):
            if not (0 <= i < w):
                continue
            di = i - cx
            along = di * heading[0] + dj * heading[1]
            if along < r_lo or along > r_hi:
                continue
            lateral = abs(-dj * heading[0] + di * heading[1])
            if lateral > along * tan_half:
                continue
            if data[base + i] < 0:
                n += 1
    return n


def near_ratio(g, x, y, radius_m):
    """候选点周围"已知自由 / (已知自由+未知)"的比例 —— 用来判断它是不是真的"站在已知边界上"。"""
    free = unknown = 0
    r = max(1, int(radius_m / g['res']))
    cx, cy = to_cell(g, x, y)
    w, h, data = g['w'], g['h'], g['data']
    for j in range(max(0, cy - r), min(h, cy + r + 1)):
        base = j * w
        for i in range(max(0, cx - r), min(w, cx + r + 1)):
            v = data[base + i]
            if v < 0:
                unknown += 1
            elif v < FREE_MAX:
                free += 1
    tot = free + unknown
    return (free / float(tot)) if tot else 0.0, free, unknown


def score_v3(g, x, y, dist, heading, cfg, penalty=0.0):
    """收益函数 v3：朝向前方大块未知 + 站在已知边界上（approach 侧安全）。

    score = 前方未知(cap) × (0.5 + 0.5×近邻已知占比) + 0.05×连通块 - 0.5×距离 - 罚分
    另外：近邻已知占比 < gate 时（候选大半埋在未知里）重量降权，避免"往未测绘深处扎"。
    """
    u_ahead = unknown_in_cone(g, x, y, heading, cfg['cone_near'], cfg['cone_far'],
                              cfg['cone_half_deg'])
    nr, free_near, unk_near = near_ratio(g, x, y, cfg['near_radius'])
    blk = unknown_component_size(g, x, y, cap=cfg['block_cap'], radius_m=cfg['block_radius'])
    score = (min(u_ahead, cfg['cone_cap']) * (0.5 + 0.5 * nr)
             + cfg['w_block3'] * min(blk, cfg['block_cap'])
             - cfg['w_dist'] * dist
             - penalty)
    if nr < cfg['near_gate']:
        score *= cfg['buried_factor']
    return {'x': x, 'y': y, 'unknown': unknown_in_cone(g, x, y, heading, 0.2, 1.0, 90.0),
            'ahead': u_ahead, 'near_ratio': nr, 'free_near': free_near,
            'unk_near': unk_near, 'block': blk, 'ratio': nr,
            'width': 0, 'penalty': penalty, 'score': score}


def turn_angle_to(heading_from_robot, robot_yaw):
    """从机头朝向到"机器人→候选"方向需要转的角度（弧度，取绝对值 0..pi）。"""
    want = math.atan2(heading_from_robot[1], heading_from_robot[0])
    d = math.atan2(math.sin(want - robot_yaw), math.cos(want - robot_yaw))
    return abs(d)


def prefilter_v3(g, x, y, dist, heading, cfg, penalty=0.0):
    """v3 的便宜一级：只算近邻占比与前方锥（不做连通块 BFS）。"""
    nr, free_near, unk_near = near_ratio(g, x, y, cfg['near_radius'])
    u_ahead = unknown_in_cone(g, x, y, heading, cfg['cone_near'], cfg['cone_far'],
                              cfg['cone_half_deg'])
    score = (min(u_ahead, cfg['cone_cap']) * (0.5 + 0.5 * nr)
             - cfg['w_dist'] * dist - penalty)
    if nr < cfg['near_gate']:
        score *= cfg['buried_factor']
    return {'x': x, 'y': y, 'unknown': u_ahead, 'ahead': u_ahead, 'near_ratio': nr,
            'free_near': free_near, 'unk_near': unk_near, 'ratio': nr,
            'block': 0, 'width': 0, 'penalty': penalty, 'score': score}


def rank_candidates_v3(g, cands, cfg, penalty_fn=None, pose=None, prefilter_n=None):
    if pose is None:
        pose = (0.0, 0.0)
    pre = []
    for x, y in cands:
        dist = math.hypot(x - pose[0], y - pose[1])
        dx, dy = x - pose[0], y - pose[1]
        n = math.hypot(dx, dy) or 1.0
        heading = (dx / n, dy / n)
        pen = penalty_fn(x, y) if penalty_fn else 0.0
        r = prefilter_v3(g, x, y, dist, heading, cfg, pen)
        r['heading'] = heading
        r['dist'] = dist
        pre.append(r)
    pre.sort(key=lambda r: r['score'], reverse=True)
    top = pre[:prefilter_n] if prefilter_n else pre
    out = []
    for r in top:
        out.append(score_v3(g, r['x'], r['y'], r['dist'], r['heading'], cfg, r['penalty']))
    out.sort(key=lambda r: r['score'], reverse=True)
    return out


class Arbiter(Node):
    def __init__(self):
        super().__init__('frontier_arbiter')
        p = self.declare_parameter
        self.min_unknown = int(p('min_unknown_cells', 30).value)
        # D4：v3 的规模门槛原本只看"近处 1 m 未知格"，而真正进分的是 0.3~3.0 m 前方锥。
        # 保守做法：两个判据取"或"——原本能过的照样过，只是把"近处少、前方一大片"的候选也放进来。
        self.min_ahead = int(p('min_ahead_cells', 300).value)
        self.radius = float(p('check_radius', 1.0).value)
        self.pullback = float(p('pullback_m', 0.6).value)
        self.bl_sec = float(p('blacklist_sec', 60.0).value)
        self.bl_r = float(p('blacklist_radius', 0.8).value)
        self.max_cand = int(p('max_candidates', 5).value)
        # D8：候选 30 s 太陈旧（地图早变了）、池 400 且同片多点重复竞争
        self.cand_max_age = float(p('candidate_max_age_sec', 15.0).value)
        self.cand_pool = int(p('cand_pool_size', 800).value)
        self.repub = float(p('republish_sec', 8.0).value)
        self.path_timeout = float(p('path_timeout_sec', 4.0).value)
        self.frame = str(p('frame_id', 'map').value)
        # P0-4：前向净空预检——必须穿过窄缝才能到达的候选直接丢弃
        self.corridor_check = bool(p('corridor_check', True).value)
        # 保守口径：走廊净宽下限 0.90 → 1.05 m。
        # 理由（2026-10-23 实测）：两张 cafe_table 的"细立柱"之间在 /map 里是 0.92 m 宽，
        # 机器人在此判据下会钻进去，而它们 0.56 m 见方的贴地底座实际只有 0.36 m 净距
        # （雷达 0.225 m 高度看不见）→ f2 轮 690 次轮子接触全在这里。抬高净宽下限后这类
        # "看着能过、实际过不去"的口子会被前向净空预检直接否掉。
        self.corridor_width = float(p('corridor_width_m', 1.05).value)
        # 硬下限：低于这个净宽一律不派（车宽 0.40 + 车端前向安全闸 0.45 的几何下界 0.90，
        # 取 0.92 留 2 cm 余地）；未知占比过高说明"这块还没探"，同样不派。
        self.corridor_hard = float(p('corridor_hard_m', 0.92).value)
        self.corridor_unknown_max = float(p('corridor_unknown_max', 0.35).value)
        # D1：末端也查（原来 skip=1.2 m 会整段跳过目标点附近）；保留参数名做兼容，
        # 但语义改为"末端额外加密采样距离"，不再"跳过"。
        self.corridor_tail_dense = float(p('corridor_tail_dense_m', 0.8).value)
        # D2/D3：用"到最近障碍的距离"代替轴向法向扫线（斜通道不再被高估 1.41 倍），
        # 障碍集合 = /map 占据 ∪ 视觉障碍栅格占据
        self.clearance_mode = str(p('clearance_mode', 'distance').value).lower()
        self.use_vision_obstacles = bool(p('corridor_use_vision', True).value)
        self.vision_grid_topic = str(p('vision_grid_topic', '/vision/obstacle_grid').value)
        # 候选质量探针（2026-10-24）：记录每个"实际派发"的候选在**统一障碍图**
        # （激光∪视觉）上的复杂度/可脱困性指标，供离线统计"哪类候选会导致卡死"。
        self.probe_log = str(p('probe_log', '').value)
        self.probe_escape_r = float(p('probe_escape_clear_m', 0.60).value)
        self.probe_narrow_r = float(p('probe_narrow_clear_m', 0.35).value)
        self.probe_radius = float(p('probe_radius_m', 2.0).value)
        self.corridor_stride = max(1, int(p('corridor_stride_cells', 2).value))
        self.narrow_penalty_sec = float(p('narrow_blacklist_sec', 45.0).value)
        # 物理接触区（撞过的地方）：强降权 + 长记忆，避免反复撞同一张桌子
        # 陷阱记忆：撞过的地方半径放大到 2.5 m（两张桌子底座之间这种"地图上开阔、
        # 物理上过不去"的陷阱，一次撞到就把整片圈起来），时长 300 s、罚 1500。
        self.contact_zone_sec = float(p('contact_zone_sec', 300.0).value)
        self.contact_zone_radius = float(p('contact_zone_radius_m', 2.5).value)
        self.contact_zone_penalty = float(p('contact_zone_penalty', 1500.0).value)
        # D7：把"撞过的地方"从软降权升级为**近半径内等效硬拒**（1e5 远高于主项上限 3000），
        # 但仍是罚分而非硬 skip —— 万一所有候选都在禁区，也要能派出最不坏的那个，不许饿死。
        self.contact_hard_radius = float(p('contact_hard_radius_m', 1.5).value)
        self.contact_hard_penalty = float(p('contact_hard_penalty', 1e5).value)
        # 收益函数 v2（S3+S2）：大块未知优先、碎角降权、已探完区域降权
        self.cfg = {
            'info_radius': float(p('info_radius', 1.0).value),
            'block_cap': int(p('block_cap', 6000).value),
            'block_radius': float(p('block_radius', 6.0).value),
            'width_radius': float(p('width_radius', 1.5).value),
            'min_width': int(p('min_frontier_width', 6).value),
            'width_cap': int(p('width_cap', 8).value),
            'w_block': float(p('w_block', 1.5).value),
            'w_width': float(p('w_width', 40.0).value),
            'w_dist': float(p('w_dist', 0.5).value),
            'ratio_floor': float(p('ratio_floor', 0.35).value),
            'small_frontier_factor': float(p('small_frontier_factor', 0.4).value),
        }
        self.retry_penalty = float(p('retry_penalty', 60.0).value)
        self.retry_radius = float(p('retry_radius_m', 1.2).value)
        self.retry_window = float(p('retry_window_sec', 300.0).value)
        self.pub_history = []        # [(x, y, ts)] 已派发过的目标（用于"反复拉锯"降权）
        # D13：区域级（1 m 网格）被拒计数 —— 同一片"陷阱区"会持续生产候选，
        # 点级黑名单压不住，这里按区域整体降权（仍是罚分，不做硬拒）
        self.region_sec = float(p('region_penalty_sec', 120.0).value)
        self.region_penalty = float(p('region_penalty', 150.0).value)
        self.region_cap = int(p('region_penalty_cap', 900).value)
        self.region_refuse_hard = int(p('region_refuse_hard_count', 6).value)
        self.region = {}            # (i,j) -> [ts, ...] 被拒时刻
        self.verbose_rank = str(p('verbose_rank', True).value).lower() in ('true', '1', 'yes')
        # 两级打分：昂贵指标只算前 N 个（候选池可能几百个）
        self.prefilter_n = int(p('prefilter_n', 12).value)
        # 与 manager 的 80° 转向门对齐（留 5° 余量），避免"派发了但被拒 → 原地转 → 再派发"
        self.turn_limit_deg = float(p('turn_limit_deg', 75.0).value)
        # D12：全部候选都在机头外时，不再"回退派发最优者"（manager 的 80° 门必拒 → 空转 5~10 s），
        # 改为本拍不派、让 RRT 重新采样；turn_hard_skip=0 可退回旧行为。
        self.turn_hard_skip = str(p('turn_hard_skip', 'true').value).lower() in ('true', '1', 'yes')
        # 收益函数 v2 开关：实测在 2026-10-23 的整轮里明显退化（两轮都出现 200+ 次物理接触、
        # 返航失败），按"出现退化先回退"的约定默认关闭；内核与离线测试保留，供后续做同种子 A/B。
        self.scoring = str(p('scoring', 'v1').value).lower()
        if str(p('scoring_v2', False).value).lower() in ('true', '1', 'yes'):
            self.scoring = 'v2'
        self.cfg3 = {
            'cone_near': float(p('cone_near_m', 0.3).value),
            'cone_far': float(p('cone_far_m', 3.0).value),
            'cone_half_deg': float(p('cone_half_deg', 60.0).value),
            'cone_cap': int(p('cone_cap', 3000).value),
            'near_radius': float(p('near_radius', 0.6).value),
            'near_gate': float(p('near_gate', 0.15).value),
            'buried_factor': float(p('buried_factor', 0.25).value),
            'w_block3': float(p('w_block3', 0.02).value),
            # 复用 v2 已声明的参数（同一节点里重复 declare 会抛
            # ParameterAlreadyDeclaredException —— smoke 自检 90 s 内就抓到了）
            'block_cap': self.cfg['block_cap'],
            'block_radius': self.cfg['block_radius'],
            'w_dist': self.cfg['w_dist'],
        }

        self.map = None
        self.pose = None
        self.yaw = 0.0
        self.cands = []          # [(x, y, ts)]
        self._cand_cells = {}    # 1 m 网格 → (x, y, ts)：同格只留最新，抑制重复竞争
        self.blacklist = []      # [(x, y, expire_ts)]
        self.last_pub = 0.0
        self.last_goal = None
        self.pending = None
        self.cmd = (0.0, 0.0)
        self.mgr_busy = False
        self.stuck_zones = []     # [(x, y, expire)]
        self.contact_zones = []   # [(x, y, expire)] 物理撞过的位置
        self._stuck_ref = None    # (t, x, y)
        self.stats = {'seen': 0, 'rejected_size': 0, 'rejected_path': 0,
                      'rejected_black': 0, 'published': 0,
                      'rejected_narrow': 0, 'narrow_fallback': 0, 'narrow_blocked_all': 0,
                      'escape_zones': 0}

        qmap = QoSProfile(depth=1, reliability=ReliabilityPolicy.RELIABLE,
                          durability=DurabilityPolicy.TRANSIENT_LOCAL)
        self.create_subscription(OccupancyGrid, '/map', self.on_map, qmap)
        self.create_subscription(PointArray, '/filtered_goal_points', self.on_cands, 10)
        self.create_subscription(Odometry, '/odom_combined', self.on_odom, 20)
        self.create_subscription(Twist, '/cmd_vel', self.on_cmd, 20)
        # S2：当前是否有 Nav2 活动目标（无目标时立刻给下一个候选）
        # 车端 manager 的状态流里带 escape/blocked/retreat 等事件
        self.create_subscription(String, '/stemm_cartographer/nav_state',
                                 self.on_nav_state, 10)
        self.create_subscription(GoalStatusArray, '/navigate_to_pose/_action/status',
                                 self.on_status, 10)
        self.pub = self.create_publisher(PoseStamped, '/validated_frontier_goal', 10)
        self.costmap = None
        self.create_subscription(OccupancyGrid, '/global_costmap/costmap', self.on_costmap, qmap)
        # P0-3 的脱困监督会把"这里脱困失败"发过来，作为受阻区降权
        self.create_subscription(PoseStamped, '/escape_blocked_zone', self.on_escape_zone, 10)
        self.create_subscription(PoseStamped, '/collision_contact_zone',
                                 self.on_contact_zone, 10)
        # D3：视觉障碍也参与"净空/宽窄"判定（此前只用于代价地图）
        self.vision_grid = None
        self._vg_seq = 0
        self._map_seq = 0
        self._clear_key = None
        self._clear_field = None
        self.create_subscription(OccupancyGrid, self.vision_grid_topic,
                                 self.on_vision_grid, qmap)
        self.create_timer(1.0, self.tick)
        self.get_logger().info('frontier_arbiter 就绪：可达性预筛/黑名单/最小前沿/回拉')

    # ---- 回调 ----
    def on_map(self, m):
        self.map = m
        self._map_seq += 1

    def on_vision_grid(self, m):
        self.vision_grid = m
        self._vg_seq += 1

    def on_cmd(self, m):
        self.cmd = (m.linear.x, m.angular.z)

    def on_status(self, m):
        busy = False
        for st in m.status_list:
            if st.status in (1, 2, 3):      # ACCEPTED / EXECUTING / CANCELING
                busy = True
        self.mgr_busy = busy

    def on_nav_state(self, m):
        txt = (m.data or '').lower()
        # 只认真正处于 escape/blocked 的动作态；排除返航与 retry_recovery 这类常态字串
        hit = ('escape_' in txt or 'blocked_' in txt or '"escape' in txt or '"blocked' in txt)
        if hit and 'return' not in txt and 'retry_recovery' not in txt:
            now = time.monotonic()
            if now - getattr(self, '_last_zone', 0.0) < 5.0:
                return
            self._last_zone = now
            if self.pose is not None:
                self.stuck_zones.append(
                    (self.pose[0], self.pose[1], time.monotonic() + self.bl_sec))
                if len(self.stuck_zones) > 15:
                    self.stuck_zones = self.stuck_zones[-15:]
                self.get_logger().warn(
                    f'受阻区记录（事件驱动 {txt[:24]}）：({self.pose[0]:.2f},{self.pose[1]:.2f})')

    def on_escape_zone(self, m):
        now = time.monotonic()
        self.stuck_zones.append((m.pose.position.x, m.pose.position.y, now + self.bl_sec))
        if len(self.stuck_zones) > 15:
            self.stuck_zones = self.stuck_zones[-15:]
        self.stats['escape_zones'] = self.stats.get('escape_zones', 0) + 1
        self.get_logger().warn(
            '脱困失败受阻区（监督节点上报）：(%.2f,%.2f)'
            % (m.pose.position.x, m.pose.position.y))

    def on_contact_zone(self, m):
        self.contact_zones.append((m.pose.position.x, m.pose.position.y,
                                   time.monotonic() + self.contact_zone_sec))
        if len(self.contact_zones) > 20:
            self.contact_zones = self.contact_zones[-20:]
        self.stats['contact_zones'] = self.stats.get('contact_zones', 0) + 1
        self.get_logger().warn(
            '物理接触区记录：(%.2f,%.2f)；统计 %s'
            % (m.pose.position.x, m.pose.position.y, self.stats))

    def on_costmap(self, m):
        self.costmap = m

    def reachable(self, x, y):
        """在全局代价地图上做 BFS 连通性判定（未知/致命格视为不可通行）。"""
        cm = self.costmap
        if cm is None or self.pose is None:
            return True                      # 代价地图未就绪时不阻塞
        info = cm.info
        res = info.resolution
        w, h = info.width, info.height
        ox, oy = info.origin.position.x, info.origin.position.y
        sx = int((self.pose[0] - ox) / res); sy = int((self.pose[1] - oy) / res)
        gx = int((x - ox) / res);            gy = int((y - oy) / res)
        if not (0 <= sx < w and 0 <= sy < h) or not (0 <= gx < w and 0 <= gy < h):
            return False
        data = cm.data
        if data[gy * w + gx] < 0 or data[gy * w + gx] >= 90:
            return False                     # 终点本身不可通行
        from collections import deque
        seen = bytearray(w * h)
        q = deque([(sx, sy)])
        seen[sy * w + sx] = 1
        budget = 60000
        while q and budget > 0:
            cx, cy = q.popleft(); budget -= 1
            if cx == gx and cy == gy:
                return True
            for nx, ny in ((cx+1,cy),(cx-1,cy),(cx,cy+1),(cx,cy-1)):
                if 0 <= nx < w and 0 <= ny < h:
                    idx = ny * w + nx
                    if seen[idx]:
                        continue
                    v = data[idx]
                    if v < 0 or v >= 90:     # 未知或致命/内切
                        continue
                    seen[idx] = 1
                    q.append((nx, ny))
        return False


    def _note_uniq(self, kind, x, y):
        """D5：同一 tick 里同一个候选只计一次，给出"唯一候选数"口径。"""
        seen = getattr(self, '_tick_uniq', None)
        if seen is None:
            self._tick_uniq = seen = set()
        key = (kind, round(x, 1), round(y, 1))
        if key in seen:
            return
        seen.add(key)
        k = kind + '_uniq'
        self.stats[k] = self.stats.get(k, 0) + 1

    def note_refusal(self, x, y):
        """D13：把"这个候选被拒"记到 1 m 网格区域表里。"""
        now = time.monotonic()
        key = (int(math.floor(x)), int(math.floor(y)))
        lst = self.region.setdefault(key, [])
        lst.append(now)
        if len(lst) > 40:
            del lst[:-40]
        # 顺手过期清理（限制表大小）
        if len(self.region) > 400:
            self.region = {k: v for k, v in self.region.items()
                           if v and now - v[-1] < self.region_sec}

    def region_penalty_of(self, x, y):
        now = time.monotonic()
        key = (int(math.floor(x)), int(math.floor(y)))
        lst = [t for t in self.region.get(key, []) if now - t < self.region_sec]
        if lst:
            self.region[key] = lst
        n = len(lst)
        if n == 0:
            return 0.0
        pen = min(self.region_cap, self.region_penalty * n)
        if n >= self.region_refuse_hard:
            pen += 1e4                      # 该区域反复被拒 → 等效"最后才考虑"
        return pen

    # ---- D1/D2/D3：净空场 ----
    def clearance_field(self):
        """返回 (dist_m, ox, oy, res, w, h, unknown) 或 None。

        dist_m[i,j] = 该格到最近**障碍**的距离（米）。障碍集合 = `/map` 占据(>=50)
        ∪ 视觉障碍栅格占据(==100)。用 scipy 的精确距离变换：
          * D2：不再沿轴向扫法向，斜通道不会被高估（原来 ≈1.41 倍）；
          * D3：视觉障碍（桌底座等雷达盲区）也计入；
          * D1：配合调用方"整条路径到末端都采样"，不再跳过目标附近。
        `unknown` 是 /map 的未知掩码，仅用于算"未知占比"。
        缓存按 (/map 序号, 视觉栅格序号) 失效，1 Hz tick 下每轮最多重建一次。
        """
        m = self.map
        if m is None:
            return None
        info = m.info
        res = info.resolution
        if res <= 0:
            return None
        w, h = info.width, info.height
        ox, oy = info.origin.position.x, info.origin.position.y
        key = (self._map_seq, self._vg_seq, w, h, round(res, 6), round(ox, 4), round(oy, 4))
        if key == self._clear_key and self._clear_field is not None:
            return self._clear_field
        try:
            import numpy as np
            from scipy import ndimage
        except Exception:                     # noqa: BLE001 - 没装 scipy 就退回轴向扫线
            self._clear_key = None
            self._clear_field = None
            return None
        arr = np.asarray(m.data, dtype=np.int16).reshape(h, w)
        blocked = arr >= 50
        unknown = arr < 0
        vg = self.vision_grid
        if self.use_vision_obstacles and vg is not None:
            vr = vg.info.resolution
            vox, voy = vg.info.origin.position.x, vg.info.origin.position.y
            v = np.asarray(vg.data, dtype=np.int16).reshape(vg.info.height, vg.info.width)
            occ = np.argwhere(v == 100)
            if occ.size and vr > 0:
                wx = vox + (occ[:, 1] + 0.5) * vr
                wy = voy + (occ[:, 0] + 0.5) * vr
                ci = ((wx - ox) / res).astype(np.int32)
                cj = ((wy - oy) / res).astype(np.int32)
                ok = (ci >= 0) & (ci < w) & (cj >= 0) & (cj < h)
                if ok.any():
                    blocked = blocked.copy()
                    blocked[cj[ok], ci[ok]] = True
        dist_cells = ndimage.distance_transform_edt(~blocked)
        field = (dist_cells * res, ox, oy, res, w, h, unknown)
        self._clear_key = key
        self._clear_field = field
        return field

    def region_complexity(self, field, wx, wy):
        """候选点周围 2 m 的"复杂度/可脱困性"（基于激光∪视觉的统一净空场）。

        指标（都在 probe_radius 内）：
          vis_occ_r2   视觉障碍格数量（激光看不到的那类复杂源）
          narrow_r2    净空 <0.35 m 的格数（"窄/挤"的量）
          free_r2      净空 >=0.30 m 的格数（可走动空间）
          comp_r2      与候选点连通的自由格数（BFS，封顶 4000）—— 太小=死角
          esc_dirs     8 个方向里能"走出去 >=probe_escape_clear_m"的方向数（0=四向皆堵）
        """
        import numpy as np
        dist_m, ox, oy, res, w, h, unknown = field
        ci = int((wx - ox) / res); cj = int((wy - oy) / res)
        if not (0 <= ci < w and 0 <= cj < h):
            return {}
        k = max(1, int(self.probe_radius / res))
        i0, i1 = max(0, ci - k), min(w, ci + k + 1)
        j0, j1 = max(0, cj - k), min(h, cj + k + 1)
        win = dist_m[j0:j1, i0:i1]
        narrow = int((win < self.probe_narrow_r).sum())
        free = int((win >= 0.30).sum())
        # 连通域（8 邻域，自由定义 dist>=0.30）
        free_mask = win >= 0.30
        comp = 0
        if free_mask.size:
            from collections import deque
            si, sj = ci - i0, cj - j0
            if 0 <= si < free_mask.shape[1] and 0 <= sj < free_mask.shape[0] and free_mask[sj, si]:
                seen = np.zeros_like(free_mask, dtype=bool)
                seen[sj, si] = True
                q = deque([(sj, si)]); comp = 1
                while q and comp < 4000:
                    y, x = q.popleft()
                    for dy in (-1, 0, 1):
                        for dx in (-1, 0, 1):
                            ny, nx = y + dy, x + dx
                            if 0 <= ny < free_mask.shape[0] and 0 <= nx < free_mask.shape[1] \
                                    and not seen[ny, nx] and free_mask[ny, nx]:
                                seen[ny, nx] = True; q.append((ny, nx)); comp += 1
        # 8 方向可逃逸性：沿该方向连续 probe_escape_clear_m 都保持 >=该净空
        esc = 0
        step = max(1, int(0.10 / res))
        for ang in [i * math.pi / 4.0 for i in range(8)]:
            ok = True
            for d in range(step, int(self.probe_escape_clear_m / res) + 1, step):
                x = ci + int(round(math.cos(ang) * d)); y = cj + int(round(math.sin(ang) * d))
                if not (0 <= x < w and 0 <= y < h) or dist_m[y, x] < self.probe_narrow_r:
                    ok = False
                    break
            esc += 1 if ok else 0
        vis_occ = 0
        vg = self.vision_grid
        if self.use_vision_obstacles and vg is not None:
            vr = vg.info.resolution
            vox, voy = vg.info.origin.position.x, vg.info.origin.position.y
            v = np.asarray(vg.data, dtype=np.int16).reshape(vg.info.height, vg.info.width)
            occ = np.argwhere(v == 100)
            if occ.size and vr > 0:
                vwx = vox + (occ[:, 1] + 0.5) * vr
                vwy = voy + (occ[:, 0] + 0.5) * vr
                m = (np.hypot(vwx - wx, vwy - wy) <= self.probe_radius)
                vis_occ = int(m.sum())
        return {'vis_occ_r2': vis_occ, 'narrow_r2': narrow, 'free_r2': free,
                'comp_r2': comp, 'esc_dirs': esc}

    def probe_candidate(self, gx, gy, r, min_w, unk):
        """把"本次派发的候选"的完整特征写一行 JSONL（离线统计用）。"""
        if not self.probe_log:
            return None
        try:
            field = self.clearance_field()
            cx = self.region_complexity(field, gx, gy) if field is not None else {}
        except Exception as exc:                       # noqa: BLE001
            cx = {'error': f'{type(exc).__name__}: {exc}'}
            self.get_logger().warn(f'候选探针失败（忽略）：{cx["error"]}')
        row = {'t': round(time.time(), 3), 'goal': [round(gx, 3), round(gy, 3)],
               'robot': [round(self.pose[0], 3), round(self.pose[1], 3)] if self.pose else None,
               'min_w': None if min_w is None else round(float(min_w), 3),
               'unknown': None if unk is None else unk,
               'ahead': (r or {}).get('ahead'), 'near_ratio': (r or {}).get('near_ratio'),
               'block': (r or {}).get('block'), 'penalty': (r or {}).get('penalty'),
               'score': (r or {}).get('score')}
        row.update(cx or {})
        try:
            os.makedirs(os.path.dirname(self.probe_log) or '.', exist_ok=True)
            with open(self.probe_log, 'a', encoding='utf-8') as f:
                f.write(json.dumps(row, ensure_ascii=False) + '\n')
        except Exception:                              # noqa: BLE001
            pass
        return row

    def clearance_at(self, field, wx, wy):
        """世界坐标 → (到最近障碍距离 m, 未知占比 0..1)；窗口按 0.5 m 统计未知占比。"""
        dist_m, ox, oy, res, w, h, unknown = field
        import numpy as np
        ci = int((wx - ox) / res)
        cj = int((wy - oy) / res)
        if not (0 <= ci < w and 0 <= cj < h):
            return 0.0, 1.0
        d = float(dist_m[cj, ci])
        r = max(1, int(0.5 / res))
        lo_i, hi_i = max(0, ci - r), min(w, ci + r + 1)
        lo_j, hi_j = max(0, cj - r), min(h, cj + r + 1)
        win = unknown[lo_j:hi_j, lo_i:hi_i]
        tot = int(win.size) or 1
        return d, float(int(win.sum()) / tot)

    def path_and_width(self, x, y):
        """BFS 出整条路径，再沿路径查"垂直于路径的连续自由宽度"。

        返回 (reachable, narrow_at, min_width, unknown_share)。
        narrow_at 为走廊宽度不足处坐标；min_width 为路径实测最小净宽（未知格按半宽计），
        unknown_share 为该处的未知占比（用来判断"看着宽其实是没探到"）。
        判据：路径上任一点，垂直方向上连续自由格（<90 且已知）的总长必须 >= corridor_width，
        以免把目标派到"必须挤过窄缝"的地方 —— 这正是反复楔死的来源。
        """
        cm = self.costmap
        if cm is None or self.pose is None:
            return True, None, None, 0.0
        info = cm.info
        res = info.resolution
        if res <= 0:
            return True, None, None, 0.0
        w, h = info.width, info.height
        ox, oy = info.origin.position.x, info.origin.position.y
        data = cm.data
        sx = int((self.pose[0] - ox) / res)
        sy = int((self.pose[1] - oy) / res)
        gx = int((x - ox) / res)
        gy = int((y - oy) / res)
        if not (0 <= sx < w and 0 <= sy < h) or not (0 <= gx < w and 0 <= gy < h):
            return False, None, None, 0.0
        if data[gy * w + gx] < 0 or data[gy * w + gx] >= 90:
            return False, None, None, 0.0
        from collections import deque
        parent = {}
        seen = bytearray(w * h)
        start = sy * w + sx
        seen[start] = 1
        q = deque([(sx, sy)])
        budget = max(80000, w * h * 2)     # D11：预算随地图面积走，避免远处目标被误判不可达
        found = False
        while q and budget > 0:
            cx, cy = q.popleft(); budget -= 1
            if cx == gx and cy == gy:
                found = True
                break
            for nx, ny in ((cx + 1, cy), (cx - 1, cy), (cx, cy + 1), (cx, cy - 1)):
                if 0 <= nx < w and 0 <= ny < h:
                    idx = ny * w + nx
                    if seen[idx]:
                        continue
                    v = data[idx]
                    if v < 0 or v >= 90:
                        continue
                    seen[idx] = 1
                    parent[idx] = cy * w + cx
                    q.append((nx, ny))
        if not found:
            return False, None, None, 0.0
        if not self.corridor_check:
            return True, None, None, 0.0
        # 回溯路径
        path = []
        cur = gy * w + gx
        while cur != start:
            path.append(cur)
            cur = parent.get(cur)
            if cur is None:
                break
        path.reverse()
        # 宽度判据换到 /map（占据栅格：>=50 才是障碍，-1 未知按可通行算）。
        # 用 costmap 会踩膨胀层的坑：值 <90 的格已经是"离障碍 >=0.52 m"，
        # 直接按净宽读会把 1.05 m 的通道误判成窄缝。
        occ = self.map
        if occ is None:
            return True, None, None, 0.0
        ores = occ.info.resolution
        ow, oh = occ.info.width, occ.info.height
        oox, ooy = occ.info.origin.position.x, occ.info.origin.position.y
        odata = occ.data

        def map_val(mx, my):
            if mx < 0 or my < 0 or mx >= ow or my >= oh:
                return 100
            return odata[my * ow + mx]

        # ---- D1/D2/D3：优先用"到最近障碍的距离场"（含视觉障碍，且整条路径到末端都查）----
        field = self.clearance_field() if self.clearance_mode == 'distance' else None
        if field is not None:
            step = max(1, self.corridor_stride)
            idxs = list(range(0, len(path), step))
            tail = int(self.corridor_tail_dense / res)
            if tail > 0 and len(path) > 1:
                idxs = sorted(set(idxs) | set(range(max(0, len(path) - tail), len(path))))
                if idxs[-1] != len(path) - 1:
                    idxs.append(len(path) - 1)      # 目标格本身必须查（D1）
            min_w = float('inf')
            min_unk = 0.0
            min_at = None
            for i in idxs:
                idx = path[i]
                cx_, cy_ = idx % w, idx // w
                wxp_ = cx_ * res + ox
                wyp_ = cy_ * res + oy
                d, unk_ = self.clearance_at(field, wxp_, wyp_)
                width_ = 2.0 * d                    # 净宽 ≈ 2×到最近障碍的距离
                if width_ < min_w:
                    min_w, min_unk, min_at = width_, unk_, (wxp_, wyp_)
            if min_at is None:
                return True, None, None, 0.0
            if min_w < self.corridor_width:
                return True, min_at, min_w, min_unk
            return True, None, min_w, min_unk

        need = self.corridor_width
        skip = int(self.corridor_skip_far / res)
        half = int(need / ores / 2) + 1
        min_w = float('inf')       # 路径上实测最小净宽（未知格按半宽计）
        min_unk = 0.0              # 取到最小宽度处的未知占比
        min_at = None
        for i in range(0, max(0, len(path) - skip), self.corridor_stride):
            idx = path[i]
            cx, cy = idx % w, idx // w
            # 用父节点方向求切向，再取垂直方向
            par = parent.get(idx)
            if par is None:
                tx, ty = 1, 0
            else:
                tx, ty = cx - par % w, cy - par // w
            n = math.hypot(tx, ty) or 1.0
            px, py = -ty / n, tx / n        # 垂直方向
            # 路径格坐标（costmap 系）→ /map 格坐标，两者分辨率可能不同
            wxp = cx * res + ox
            wyp = cy * res + oy
            mcx = int((wxp - oox) / ores)
            mcy = int((wyp - ooy) / ores)
            if half * ores > 2.0:              # 分辨率异常时保护
                half = int(2.0 / ores)
            # 逐格扫：免费格按 1 计、未知格按 0.5 计（2026-10-23：原来把未知当自由，
            # 门洞半米没探到就以为"1.05 m 宽"，车开进去才发现只有 0.9 m）
            def scan(sign):
                known = 0.0
                unk = 0.0
                k = 1
                while k <= half:
                    mx = int(round(mcx + sign * px * k)); my = int(round(mcy + sign * py * k))
                    v = map_val(mx, my)
                    if v >= 50:
                        break
                    if v < 0:
                        unk += 1.0
                        if unk > 0.5 * half:      # 未知太多就不再看更远
                            break
                    else:
                        known += 1.0
                    k += 1
                return known, unk

            klo, ulo = scan(+1)
            khi, uhi = scan(-1)
            n_cells = klo + khi + 1.0
            n_unk = ulo + uhi
            width = (n_cells - 0.5 * n_unk) * ores
            if width < min_w:
                min_w = width
                min_unk = n_unk / max(1.0, n_cells)
                min_at = (wxp, wyp)
        if min_at is None:
            return True, None, None, 0.0
        if min_w < need:
            return True, min_at, min_w, min_unk
        return True, None, min_w, min_unk

    def on_odom(self, m):
        q = m.pose.pose.position
        o = m.pose.pose.orientation
        self.pose = (q.x, q.y)
        self.yaw = math.atan2(2.0 * (o.w * o.z + o.x * o.y),
                              1.0 - 2.0 * (o.y * o.y + o.z * o.z))

    def on_cands(self, m):
        now = time.monotonic()
        cells = self._cand_cells
        for pt in m.points:
            key = (int(math.floor(pt.x)), int(math.floor(pt.y)))
            cells[key] = (pt.x, pt.y, now)       # 同格覆盖 ⇒ 只留最新采样
        self.stats['seen'] += len(m.points)
        # 过期清理 + 容量限制（按时间保留最新的 cand_pool 个）
        fresh = [(k, v) for k, v in cells.items() if now - v[2] <= self.cand_max_age]
        if len(fresh) > self.cand_pool:
            fresh.sort(key=lambda kv: kv[1][2], reverse=True)
            fresh = fresh[:self.cand_pool]
            self._cand_cells = dict(fresh)
        else:
            self._cand_cells = dict(fresh)
        self.cands = list(self._cand_cells.values())

    # ---- 工具 ----
    def unknown_cells(self, x, y):
        m = self.map
        if m is None:
            return 0
        info = m.info
        r = int(self.radius / info.resolution)
        cx = int((x - info.origin.position.x) / info.resolution)
        cy = int((y - info.origin.position.y) / info.resolution)
        n = 0
        for j in range(max(0, cy - r), min(info.height, cy + r + 1)):
            base = j * info.width
            for i in range(max(0, cx - r), min(info.width, cx + r + 1)):
                if m.data[base + i] < 0:
                    n += 1
        return n

    def blacklisted(self, x, y, now):
        self.blacklist = [b for b in self.blacklist if b[2] > now]
        if len(self.blacklist) > 40:                 # 限容量，最旧的先丢
            self.blacklist = self.blacklist[-40:]
        return any(math.hypot(x - b[0], y - b[1]) < self.bl_r for b in self.blacklist)

    def pull_back(self, x, y):
        if self.pose is None or self.pullback <= 0:
            return self.snap_known_free(x, y)
        dx, dy = self.pose[0] - x, self.pose[1] - y
        d = math.hypot(dx, dy)
        if d < 1e-6:
            return self.snap_known_free(x, y)
        k = min(self.pullback, d * 0.5) / d
        return self.snap_known_free(x + dx * k, y + dy * k)

    def snap_known_free(self, x, y, max_r_m=0.35):
        """D9：回拉点若落进未知/占据格，吸附到最近"已知自由"格（螺旋搜索 ≤0.35 m）。

        原因：BFS 把未知当不可通行，回拉点落在未知里会让候选直接被判"不可达"
        （实测 rejected_path 131–494/轮）。找不到就原样返回，不改变语义。
        """
        m = self.map
        if m is None:
            return x, y
        info = m.info
        res = info.resolution
        if res <= 0:
            return x, y
        w, h = info.width, info.height
        ox, oy = info.origin.position.x, info.origin.position.y
        ci = int((x - ox) / res)
        cj = int((y - oy) / res)

        def known_free(i, j):
            if not (0 <= i < w and 0 <= j < h):
                return False
            v = m.data[j * w + i]
            return 0 <= v < 50

        if known_free(ci, cj):
            return x, y
        rmax = max(1, int(max_r_m / res))
        for r in range(1, rmax + 1):
            best = None
            for dj in range(-r, r + 1):
                for di in range(-r, r + 1):
                    if max(abs(di), abs(dj)) != r:
                        continue
                    if known_free(ci + di, cj + dj):
                        d2 = di * di + dj * dj
                        if best is None or d2 < best[0]:
                            best = (d2, ci + di, cj + dj)
            if best is not None:
                return (ox + (best[1] + 0.5) * res, oy + (best[2] + 0.5) * res)
        return x, y

    def reachable_async(self, x, y):
        """异步可达性校验：返回 future 或 None（不可用/已有在途请求）"""
        if self.pending is not None:
            return None
        if not self.cli.service_is_ready():
            if not self.cli.wait_for_service(timeout_sec=0.2):
                return None
        req = ComputePathToPose.Request()
        req.goal = PoseStamped()
        req.goal.header.frame_id = self.frame
        req.goal.header.stamp = self.get_clock().now().to_msg()
        req.goal.pose.position.x, req.goal.pose.position.y = x, y
        req.goal.pose.orientation.w = 1.0
        req.use_start = False
        fut = self.cli.call_async(req)
        self.pending = (fut, x, y)
        return fut

    # ---- 主循环 ----
    def _update_stuck(self, now):
        """S3：有速度指令但位移几乎为 0 → 记为受阻区（60 s 衰减）"""
        if self.pose is None:
            return
        moving_cmd = abs(self.cmd[0]) > 0.05 or abs(self.cmd[1]) > 0.05
        if not moving_cmd:
            self._stuck_ref = None
            return
        if self._stuck_ref is None:
            self._stuck_ref = (now, self.pose[0], self.pose[1])
            return
        t0, x0, y0 = self._stuck_ref
        if now - t0 >= 2.0:
            if math.hypot(self.pose[0] - x0, self.pose[1] - y0) < 0.01:
                self.stuck_zones.append((self.pose[0], self.pose[1], now + self.bl_sec))
                self.get_logger().warn(
                    f'受阻区记录：({self.pose[0]:.2f},{self.pose[1]:.2f}) 持续 {now-t0:.1f}s 无位移')
            self._stuck_ref = (now, self.pose[0], self.pose[1])
        self.stuck_zones = [z for z in self.stuck_zones if z[2] > now]

    def zone_penalty(self, x, y, now):
        """"禁入/降权"区域罚分（v1 与 v2/v3 共用）。

        包含：受阻区、碰撞区（D7：近半径等效硬拒）、区域级被拒历史（D13）。
        一律用**罚分**而非硬 skip —— 全都落在禁区时仍能派出最不坏的那个。
        """
        pen = 0.0
        for zx, zy, _ in self.stuck_zones:
            if math.hypot(x - zx, y - zy) < 1.5:
                pen += 400.0
                break
        self.contact_zones = [z for z in self.contact_zones if z[2] > now]
        for zx, zy, _ in self.contact_zones:
            d = math.hypot(x - zx, y - zy)
            if d < self.contact_hard_radius:
                pen += self.contact_hard_penalty
                break
            if d < self.contact_zone_radius:
                pen += self.contact_zone_penalty
                break
        pen += self.region_penalty_of(x, y)
        return pen

    def _stuck_penalty(self, x, y, now):
        return self.zone_penalty(x, y, now)

    def grid(self):
        """把 /map 转成打分内核要的 dict（只做一次浅转换，避免每候选重复取属性）。"""
        m = self.map
        if m is None:
            return None
        info = m.info
        return {'res': info.resolution, 'w': info.width, 'h': info.height,
                'ox': info.origin.position.x, 'oy': info.origin.position.y,
                'data': m.data}

    def penalty(self, x, y):
        """所有"别去那儿"的来源合并成一个罚分（罚分制，不硬拒，避免整片被吃）。"""
        now = time.monotonic()
        pen = 0.0
        self.blacklist = [b for b in self.blacklist if b[2] > now]
        for bx, by, _ in self.blacklist:
            if math.hypot(x - bx, y - by) < self.bl_r:
                pen += 250.0
                self.stats['penalized_black'] = self.stats.get('penalized_black', 0) + 1
                self._note_uniq('penalized_black', x, y)
                break
        pen += self.zone_penalty(x, y, now)
        # 反复拉锯：同一个位置附近被派发过很多次却没推进 → 降权
        self.pub_history = [h for h in self.pub_history if now - h[2] < self.retry_window]
        n = sum(1 for hx, hy, _ in self.pub_history
                if math.hypot(x - hx, y - hy) < self.retry_radius)
        pen += self.retry_penalty * n
        return pen

    def tick(self):
        self._tick_uniq = set()
        if self.scoring == 'v3':
            return self._tick_v3()
        if self.scoring == 'v2':
            return self._tick_v2()
        return self._tick_v1()

    def _tick_v1(self):
        now = time.monotonic()
        self._update_stuck(now)
        if self.map is None or self.pose is None or not self.cands:
            return
        if self.mgr_busy and now - self.last_pub < self.repub:
            return
        cands = [c for c in self.cands if now - c[2] < self.cand_max_age]
        if not cands:
            return
        scored = []
        for x, y, _ in cands:
            u = self.unknown_cells(x, y)
            if self.blacklisted(x, y, now):
                self.stats['penalized_black'] = self.stats.get('penalized_black', 0) + 1
                u -= 250
            if u < self.min_unknown:
                self.stats['rejected_size'] += 1
                continue
            u_eff = u - self._stuck_penalty(x, y, now)
            scored.append((u_eff, -math.hypot(x - self.pose[0], y - self.pose[1]), x, y))
        scored.sort(reverse=True)
        fallback = None
        for u, negd, x, y in scored[:self.max_cand]:
            gx, gy = self.pull_back(x, y)
            ok, narrow, min_w, unk = self.path_and_width(gx, gy)
            if not ok:
                self.blacklist.append((gx, gy, now + self.bl_sec))
                self.stats['rejected_path'] += 1
                self._note_uniq('rejected_path', gx, gy)
                self.note_refusal(gx, gy)
                continue
            if narrow is not None:
                self.stats['rejected_narrow'] += 1
                self._note_uniq('rejected_narrow', gx, gy)
                self.blacklist.append((gx, gy, now + self.narrow_penalty_sec))
                self.note_refusal(gx, gy)
                if (min_w is not None and min_w >= self.corridor_hard
                        and unk <= self.corridor_unknown_max and fallback is None):
                    fallback = (gx, gy)
                self.get_logger().info(
                    '前向净空预检否决：走廊 < %.2fm @(%.2f,%.2f)，目标 (%.2f,%.2f)'
                    % (self.corridor_width, narrow[0], narrow[1], gx, gy))
                continue
            self.probe_candidate(gx, gy, None, min_w, u)
            self.publish_goal(gx, gy, None, u)
            return
        if fallback is not None:
            self.stats['narrow_fallback'] += 1
            self.get_logger().warn(
                '候选全部需要穿窄缝，回退派发最优点 (%.2f,%.2f)；统计 %s'
                % (fallback[0], fallback[1], self.stats))
            self.publish_goal(fallback[0], fallback[1], None, 0)
            return
        self.get_logger().warn(f'本轮候选全部被拒：{self.stats}')

    def _tick_v3(self):
        now = time.monotonic()
        self._update_stuck(now)
        if self.map is None or self.pose is None or not self.cands:
            return
        if self.mgr_busy and now - self.last_pub < self.repub:
            return
        cands = [(x, y) for x, y, t in self.cands if now - t < self.cand_max_age]
        if not cands:
            return
        g = self.grid()
        if g is None:
            return
        # 先按"机头朝向"过一遍：manager 自己会拒绝 >80° 的转向目标（日志实测因此空转 5~10 s），
        # 这里提前筛掉/降权，省掉那次拒绝与随后的原地旋转。
        turn_limit = math.radians(self.turn_limit_deg)
        filtered = []
        dropped_turn = 0
        for x, y in cands:
            dx, dy = x - self.pose[0], y - self.pose[1]
            n = math.hypot(dx, dy) or 1.0
            if turn_angle_to((dx / n, dy / n), self.yaw) > turn_limit:
                dropped_turn += 1
                continue
            filtered.append((x, y))
        if dropped_turn:
            self.stats['turn_dropped'] = self.stats.get('turn_dropped', 0) + dropped_turn
        if not filtered:
            if self.turn_hard_skip:
                # D12：本拍不派 —— manager 的 80° 门会先原地转再拒，实测白烧 5~10 s。
                # 空一拍让 RRT 重新采样（republish 1.5 s 会很快给新候选）。
                self.stats['turn_skip_all'] = self.stats.get('turn_skip_all', 0) + 1
                if now - getattr(self, '_last_turn_skip_log', 0.0) > 10.0:
                    self._last_turn_skip_log = now
                    self.get_logger().info(
                        '本拍全部候选都在机头 %.0f° 之外（%d 个）→ 跳过派发，等 RRT 重新采样'
                        % (self.turn_limit_deg, dropped_turn))
                return
            self.stats['turn_fallback'] = self.stats.get('turn_fallback', 0) + 1
            self.get_logger().info(
                f'[v3] 全部候选都在机头 {self.turn_limit_deg:.0f}° 之外（{dropped_turn} 个），'
                f'回退派发最优候选')
            filtered = list(cands)
        try:
            ranked = rank_candidates_v3(g, filtered, self.cfg3, penalty_fn=self.penalty,
                                        pose=self.pose, prefilter_n=self.prefilter_n)
        except Exception as exc:                          # noqa: BLE001
            self.get_logger().error(f'v3 打分异常，回退 v1：{type(exc).__name__}: {exc}')
            self.scoring = 'v1'
            return self._tick_v1()
        keep = [r for r in ranked
                if r['unknown'] >= self.min_unknown or r.get('ahead', 0) >= self.min_ahead]
        self.stats['rejected_size'] += len(ranked) - len(keep)
        for r_drop in ranked:
            if r_drop not in keep:
                self._note_uniq('rejected_size', r_drop['x'], r_drop['y'])
        if not keep:
            self.get_logger().warn(
                f'[v3] 无候选过规模门槛（min_unknown={self.min_unknown}）；统计 {self.stats}')
            return
        if self.verbose_rank:
            self.get_logger().info('[v3] 候选前 3：' + ' | '.join(
                '(%.2f,%.2f) score=%.1f ahead=%d near=%.2f pen=%.0f'
                % (r['x'], r['y'], r['score'], r['ahead'], r['near_ratio'], r['penalty'])
                for r in keep[:3]))
        fallback = None
        for r in keep[:self.max_cand]:
            gx, gy = self.pull_back(r['x'], r['y'])
            ok, narrow, min_w, unk = self.path_and_width(gx, gy)
            if not ok:
                self.blacklist.append((gx, gy, now + self.bl_sec))
                self.stats['rejected_path'] += 1
                self._note_uniq('rejected_path', gx, gy)
                self.note_refusal(gx, gy)
                continue
            if narrow is not None:
                self.stats['rejected_narrow'] += 1
                self._note_uniq('rejected_narrow', gx, gy)
                self.blacklist.append((gx, gy, now + self.narrow_penalty_sec))
                self.note_refusal(gx, gy)
                # 软回退只允许"确实够宽、而且宽度不是靠未知格撑出来的"候选。
                # 2026-10-23：原来无条件派发最优窄候选，车开进 0.9 m 门洞后被车端
                # 前向安全闸（0.45 m）判死、原地静止 40~90 s，就是这条路径造成的。
                if (min_w is not None and min_w >= self.corridor_hard
                        and unk <= self.corridor_unknown_max and fallback is None):
                    fallback = (gx, gy, r, min_w, unk)
                continue
            try:
                r['min_w'] = min_w
            except Exception:                     # noqa: BLE001
                pass
            self.probe_candidate(gx, gy, r, min_w, r.get('unknown'))
            self.publish_goal(gx, gy, r)
            return
        if fallback is not None:
            self.stats['narrow_fallback'] += 1
            self.get_logger().warn(
                '[v3] 候选全部需穿窄缝，回退派发实测最宽者 (%.2f,%.2f) 净宽 %.2f m 未知占比 %.0f%%'
                % (fallback[0], fallback[1], fallback[3], 100 * fallback[4]))
            self.publish_goal(fallback[0], fallback[1], fallback[2])
            return
        # 全部低于硬下限：宁可原地等新前沿，也不把车塞进过不去的口子
        self.stats['narrow_blocked_all'] = self.stats.get('narrow_blocked_all', 0) + 1
        if now - getattr(self, '_last_narrow_warn', 0.0) > 10.0:
            self._last_narrow_warn = now
            self.get_logger().warn(
                '[v3] 本轮候选全部低于走廊硬下限 %.2f m（不做软回退，等新前沿）；统计 %s'
                % (self.corridor_hard, self.stats))

    def _tick_v2(self):
        now = time.monotonic()
        self._update_stuck(now)
        if self.map is None or self.pose is None or not self.cands:
            return
        if self.mgr_busy and now - self.last_pub < self.repub:
            return                      # 目标执行中才限速；空闲时立刻补一个新候选（S2）
        cands = [(x, y) for x, y, t in self.cands if now - t < self.cand_max_age]
        if not cands:
            return
        g = self.grid()
        if g is None:
            return
        try:
            ranked = rank_candidates(g, cands, self.cfg,
                                     penalty_fn=self.penalty, pose=self.pose,
                                     prefilter_n=self.prefilter_n)
        except Exception as exc:                          # noqa: BLE001
            self.get_logger().error(f'打分异常，回退旧逻辑：{type(exc).__name__}: {exc}')
            ranked = []
        # 规模门槛：未知格太少（碎角/坑）直接不要
        keep = [r for r in ranked
                if r['unknown'] >= self.min_unknown or r.get('ahead', 0) >= self.min_ahead]
        self.stats['rejected_size'] += len(ranked) - len(keep)
        for r_drop in ranked:
            if r_drop not in keep:
                self._note_uniq('rejected_size', r_drop['x'], r_drop['y'])
        if not keep:
            self.get_logger().warn(
                f'无候选过规模门槛（min_unknown={self.min_unknown}）；统计 {self.stats}')
            return
        if self.verbose_rank:
            top = keep[:3]
            self.get_logger().info('候选打分前 3：' + ' | '.join(
                '(%.2f,%.2f) score=%.1f u=%d blk=%d w=%d pen=%.0f'
                % (r['x'], r['y'], r['score'], r['unknown'], r['block'],
                   r['width'], r['penalty']) for r in top))
        fallback = None
        for r in keep[:self.max_cand]:
            gx, gy = self.pull_back(r['x'], r['y'])
            ok, narrow, min_w, unk = self.path_and_width(gx, gy)
            if not ok:
                self.blacklist.append((gx, gy, now + self.bl_sec))
                self.stats['rejected_path'] += 1
                self._note_uniq('rejected_path', gx, gy)
                self.note_refusal(gx, gy)
                continue
            if narrow is not None:
                self.stats['rejected_narrow'] += 1
                self._note_uniq('rejected_narrow', gx, gy)
                self.blacklist.append((gx, gy, now + self.narrow_penalty_sec))
                self.note_refusal(gx, gy)
                if fallback is None:
                    fallback = (gx, gy, r)
                self.get_logger().info(
                    '前向净空预检否决：走廊 < %.2fm @(%.2f,%.2f)，目标 (%.2f,%.2f)'
                    % (self.corridor_width, narrow[0], narrow[1], gx, gy))
                continue
            try:
                r['min_w'] = min_w
            except Exception:                     # noqa: BLE001
                pass
            self.probe_candidate(gx, gy, r, min_w, r.get('unknown'))
            self.publish_goal(gx, gy, r)
            return
        if fallback is not None:
            self.stats['narrow_fallback'] += 1
            self.get_logger().warn(
                '候选全部需要穿窄缝，回退派发最优点 (%.2f,%.2f)；统计 %s'
                % (fallback[0], fallback[1], self.stats))
            self.publish_goal(fallback[0], fallback[1], fallback[2])
            return
        self.get_logger().warn(f'本轮候选全部被拒：{self.stats}')

    def publish_goal(self, gx, gy, r, u=None):
        now = time.monotonic()
        if (self.last_goal is not None and self.last_pub
                and now - self.last_pub < 5.0
                and math.hypot(gx - self.last_goal[0], gy - self.last_goal[1]) < 0.30):
            return                              # 5 s 内同一目标不重复发（避免目标churn）
        msg = PoseStamped()
        msg.header.frame_id = self.frame
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.pose.position.x, msg.pose.position.y = gx, gy
        msg.pose.orientation.w = 1.0
        self.pub.publish(msg)
        self.last_pub = time.monotonic()
        self.last_goal = (gx, gy)
        self.pub_history.append((gx, gy, self.last_pub))
        self.stats['published'] += 1
        try:
            self.get_logger().info(
                '仲裁通过：候选(%s) 未知=%s 块=%s 宽=%s penalty=%s → 目标 (%.2f,%.2f)；统计 %s'
                % (('%.2f,%.2f' % (r['x'], r['y'])) if r else '?',
                   (r['unknown'] if r else u) if (r or u is not None) else '?',
                   r['block'] if r else '?',
                   ('%.2f' % r['min_w']) if (r and 'min_w' in r) else (r['width'] if r else '?'),
                   ('%.0f' % r['penalty']) if r else '?',
                   gx, gy, self.stats))
        except Exception:
            pass

    def on_path_result(self, fut, gx, gy, u):
        self.pending = None
        now = time.monotonic()
        ok = False
        try:
            res = fut.result()
            ok = bool(res and res.path and len(res.path.poses) > 0)
        except Exception:
            ok = False
        if not ok:
            self.blacklist.append((gx, gy, now + self.bl_sec))
            self.stats['rejected_path'] += 1
            return
        msg = PoseStamped()
        msg.header.frame_id = self.frame
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.pose.position.x, msg.pose.position.y = gx, gy
        msg.pose.orientation.w = 1.0
        self.pub.publish(msg)
        self.last_pub = now
        self.last_goal = (gx, gy)
        self.stats['published'] += 1
        self.get_logger().info(f'仲裁通过：未知格 {u}，目标 ({gx:.2f},{gy:.2f})；统计 {self.stats}')


def main():
    rclpy.init()
    node = Arbiter()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
