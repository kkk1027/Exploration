#!/usr/bin/env python3
"""frontier_arbiter —— 仿真侧前沿仲裁（S1）：可达性预筛 + 失败黑名单 + 最小前沿规模 + 目标回拉。

背景：实测候选点产量充足（163 个/75 s），但派发目标成功率仅 33%（4/6 被取消），
且 escape/blocked 恢复开销大。原因是候选点只经过"代价地图障碍判断"，
没有做"规划器可达性"校验，也没消除已失败过的候选。

做法（不改车端源码）：
  /filtered_goal_points ──┐
  /map (transient_local) ──┼─► 打分(未知格数) → 取前 N → 回拉 → ComputePathToPose 校验
  /odom_combined ─────────┘                                        │
                                                                   ▼
                                              /validated_frontier_goal (PoseStamped)
  manager 的 frontier_goal_topic 运行期指到本话题即可（无侵入）。

参数：
  min_unknown_cells  候选周围未知格数下限（默认 30，5cm 栅格 ≈ 0.075 m²）
  check_radius       统计未知格与回拉用的半径（默认 1.0 m）
  pullback_m         目标回拉距离，落到已知自由空间一侧（默认 0.6 m）
  blacklist_sec      失败候点的黑名单时长（默认 60 s）
  blacklist_radius   黑名单作用半径（默认 0.8 m）
  max_candidates     每轮校验的候选数（默认 5）
  republish_sec      最小重发间隔（默认 8 s）
  path_timeout_sec   ComputePathToPose 超时（默认 4 s）
"""
import json
from collections import deque
import math
import os
import random
import sys
import time

# P9-L1：「在等」而不是「过不去」的状态词（来自 50 轮历史 timeline 的实测分类）
FF_WAIT_WORDS = ('waiting_for_rrt_frontier', 'warming_up', 'arrived', 'canceled',
                 'return_home_wait', 'clearance_restored', 'succeeded', 'stopped')

import rclpy
from action_msgs.msg import GoalStatusArray
from geometry_msgs.msg import PoseStamped, Twist
from nav_msgs.msg import OccupancyGrid, Odometry, Path
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
from std_msgs.msg import String
from wheeltec_rrt_msg.msg import PointArray



# =====================================================================
# 纯函数打分内核（不依赖 ROS，便于 harness/test_scoring.py 离线秒级验证）
# grid = {'res','w','h','ox','oy','data'}；data: -1=未知, 0..24=自由, >=50=占据
# =====================================================================
FREE_MAX = 25
OCC_MIN = 50


def to_cell(g, x, y):
    return int((x - g['ox']) / g['res']), int((y - g['oy']) / g['res'])


def cell_stats(g, x, y, radius_m):
    """半径内 未知格数 / 自由格数。"""
    r = max(1, int(radius_m / g['res']))
    cx, cy = to_cell(g, x, y)
    unknown = free = 0
    for j in range(max(0, cy - r), min(g['h'], cy + r + 1)):
        base = j * g['w']
        for i in range(max(0, cx - r), min(g['w'], cx + r + 1)):
            v = g['data'][base + i]
            if v < 0:
                unknown += 1
            elif v < FREE_MAX:
                free += 1
    return unknown, free


def unknown_component_size(g, x, y, cap=2000, radius_m=3.0):
    """候选点所在"未知连通块"的大小（BFS，半径内、上限 cap）。

    这是"S3+S2 收益函数"的核心：大块未知（还没探过的大区域）值得优先，
    而已经探得七零八落只剩碎角的地方，块大小很小 → 自然被压后。
    """
    res = g['res']
    rmax = max(2, int(radius_m / res))
    cx, cy = to_cell(g, x, y)
    # 先找一个未知格做种子（候选点本身可能落在自由格/占据边上）
    seed = None
    for rad in range(0, rmax + 1):
        for j in range(cy - rad, cy + rad + 1):
            for i in (cx - rad, cx + rad) if rad else (cx,):
                if 0 <= i < g['w'] and 0 <= j < g['h']:
                    if g['data'][j * g['w'] + i] < 0:
                        seed = (i, j)
                        break
            if seed:
                break
        if seed:
            break
    if seed is None:
        return 0
    seen = {(seed[0], seed[1])}
    q = [seed]
    n = 0
    data = g['data']
    w, h = g['w'], g['h']
    while q and n < cap:
        i, j = q.pop()
        n += 1
        for ni, nj in ((i + 1, j), (i - 1, j), (i, j + 1), (i, j - 1)):
            if not (0 <= ni < w and 0 <= nj < h):
                continue
            if abs(ni - cx) > rmax or abs(nj - cy) > rmax:
                continue
            if (ni, nj) in seen:
                continue
            if data[nj * w + ni] < 0:
                seen.add((ni, nj))
                q.append((ni, nj))
    return n


def frontier_width(g, x, y, radius_m=1.5):
    """前沿"宽度"代理：半径内与未知格相邻的自由格数。

    用来替代"前沿段长度"（RRT 只给点，没有段）：碎角/单格突起会得到很小的值。
    """
    r = max(1, int(radius_m / g['res']))
    cx, cy = to_cell(g, x, y)
    w, h, data = g['w'], g['h'], g['data']
    n = 0
    for j in range(max(0, cy - r), min(h, cy + r + 1)):
        base = j * w
        for i in range(max(0, cx - r), min(w, cx + r + 1)):
            if data[base + i] < 0 or data[base + i] >= FREE_MAX:
                continue
            adj_unknown = False
            for ni, nj in ((i + 1, j), (i - 1, j), (i, j + 1), (i, j - 1)):
                if 0 <= ni < w and 0 <= nj < h and data[nj * w + ni] < 0:
                    adj_unknown = True
                    break
            if adj_unknown:
                n += 1
    return n


def score_one(g, x, y, dist, cfg, penalty=0.0):
    """单个候选的收益分（越大越好）。返回 dict 便于日志取证。"""
    info_r = cfg['info_radius']
    u, free = cell_stats(g, x, y, info_r)
    blk = unknown_component_size(g, x, y, cap=cfg['block_cap'], radius_m=cfg['block_radius'])
    width = frontier_width(g, x, y, radius_m=cfg['width_radius'])
    ratio = u / float(u + free) if (u + free) > 0 else 0.0
    info = u * (1.0 + cfg['w_block'] * min(blk, cfg['block_cap']) / float(cfg['block_cap']))
    score = (info * (cfg['ratio_floor'] + (1.0 - cfg['ratio_floor']) * ratio)
             + cfg['w_width'] * min(width, cfg['width_cap'])
             - cfg['w_dist'] * dist
             - penalty)
    if width < cfg['min_width']:
        score *= cfg['small_frontier_factor']     # 碎角：降权不硬拒（留到最后细化）
    return {'x': x, 'y': y, 'unknown': u, 'free': free, 'block': blk,
            'width': width, 'ratio': ratio, 'penalty': penalty, 'score': score}


def prefilter_one(g, x, y, dist, cfg, penalty=0.0):
    """便宜的一级打分：只用 未知格数 / 未知占比 / 距离 / 罚分（不做 BFS）。"""
    u, free = cell_stats(g, x, y, cfg['info_radius'])
    ratio = u / float(u + free) if (u + free) > 0 else 0.0
    score = (u * (cfg['ratio_floor'] + (1.0 - cfg['ratio_floor']) * ratio)
             - cfg['w_dist'] * dist - penalty)
    return {'x': x, 'y': y, 'unknown': u, 'free': free, 'ratio': ratio,
            'penalty': penalty, 'score': score}


def rank_candidates(g, cands, cfg, penalty_fn=None, pose=None, prefilter_n=None):
    """两级排序：先便宜预筛到 prefilter_n 个，再对它们做完整打分（连通块+前沿宽度）。

    候选池可能有几百个，全量做 BFS 会让 1 Hz 的 tick 卡死 —— 这是实测必须的两级结构。
    """
    pre = []
    for x, y in cands:
        dist = math.hypot(x - pose[0], y - pose[1]) if pose is not None else 0.0
        pen = penalty_fn(x, y) if penalty_fn else 0.0
        pre.append(prefilter_one(g, x, y, dist, cfg, pen))
    pre.sort(key=lambda r: r['score'], reverse=True)
    top = pre[:prefilter_n] if prefilter_n else pre
    out = []
    for r in top:
        dist = math.hypot(r['x'] - pose[0], r['y'] - pose[1]) if pose is not None else 0.0
        out.append(score_one(g, r['x'], r['y'], dist, cfg, r['penalty']))
    out.sort(key=lambda r: r['score'], reverse=True)
    return out



def unknown_in_cone(g, x, y, heading, dist_lo, dist_hi, half_deg, stride=1):
    """候选点"前方"锥形区域里的未知格数（沿 heading 方向，距离 dist_lo..dist_hi，±half_deg）。

    这是 v3 收益函数的核心：真正值得去的不是"周围一片未知"，而是"朝那个方向有一大块未知"。
    v2 用"邻域未知占比"当主项，结果偏好往未测绘深处扎（实测撞进看不见的桌子底座），v3 反过来。
    """
    res = g['res']
    w, h, data = g['w'], g['h'], g['data']
    cx, cy = to_cell(g, x, y)
    r_lo = int(dist_lo / res)
    r_hi = int(dist_hi / res)
    if r_hi <= r_lo:
        return 0
    tan_half = math.tan(math.radians(half_deg))
    n = 0
    for j in range(cy - r_hi, cy + r_hi + 1):
        if not (0 <= j < h):
            continue
        base = j * w
        dj = j - cy
        for i in range(cx - r_hi, cx + r_hi + 1):
            if not (0 <= i < w):
                continue
            di = i - cx
            along = di * heading[0] + dj * heading[1]
            if along < r_lo or along > r_hi:
                continue
            lateral = abs(-dj * heading[0] + di * heading[1])
            if lateral > along * tan_half:
                continue
            if data[base + i] < 0:
                n += 1
    return n


def near_ratio(g, x, y, radius_m):
    """候选点周围"已知自由 / (已知自由+未知)"的比例 —— 用来判断它是不是真的"站在已知边界上"。"""
    free = unknown = 0
    r = max(1, int(radius_m / g['res']))
    cx, cy = to_cell(g, x, y)
    w, h, data = g['w'], g['h'], g['data']
    for j in range(max(0, cy - r), min(h, cy + r + 1)):
        base = j * w
        for i in range(max(0, cx - r), min(w, cx + r + 1)):
            v = data[base + i]
            if v < 0:
                unknown += 1
            elif v < FREE_MAX:
                free += 1
    tot = free + unknown
    return (free / float(tot)) if tot else 0.0, free, unknown


def score_v3(g, x, y, dist, heading, cfg, penalty=0.0):
    """收益函数 v3：朝向前方大块未知 + 站在已知边界上（approach 侧安全）。

    score = 前方未知(cap) × (0.5 + 0.5×近邻已知占比) + 0.05×连通块 - 0.5×距离 - 罚分
    另外：近邻已知占比 < gate 时（候选大半埋在未知里）重量降权，避免"往未测绘深处扎"。
    """
    u_ahead = unknown_in_cone(g, x, y, heading, cfg['cone_near'], cfg['cone_far'],
                              cfg['cone_half_deg'])
    nr, free_near, unk_near = near_ratio(g, x, y, cfg['near_radius'])
    blk = unknown_component_size(g, x, y, cap=cfg['block_cap'], radius_m=cfg['block_radius'])
    score = (min(u_ahead, cfg['cone_cap']) * (0.5 + 0.5 * nr)
             + cfg['w_block3'] * min(blk, cfg['block_cap'])
             - cfg['w_dist'] * dist
             - penalty)
    if nr < cfg['near_gate']:
        score *= cfg['buried_factor']
    return {'x': x, 'y': y, 'unknown': unknown_in_cone(g, x, y, heading, 0.2, 1.0, 90.0),
            'ahead': u_ahead, 'near_ratio': nr, 'free_near': free_near,
            'unk_near': unk_near, 'block': blk, 'ratio': nr,
            'width': 0, 'penalty': penalty, 'score': score}


def turn_angle_to(heading_from_robot, robot_yaw):
    """从机头朝向到"机器人→候选"方向需要转的角度（弧度，取绝对值 0..pi）。"""
    want = math.atan2(heading_from_robot[1], heading_from_robot[0])
    d = math.atan2(math.sin(want - robot_yaw), math.cos(want - robot_yaw))
    return abs(d)


def prefilter_v3(g, x, y, dist, heading, cfg, penalty=0.0):
    """v3 的便宜一级：只算近邻占比与前方锥（不做连通块 BFS）。"""
    nr, free_near, unk_near = near_ratio(g, x, y, cfg['near_radius'])
    u_ahead = unknown_in_cone(g, x, y, heading, cfg['cone_near'], cfg['cone_far'],
                              cfg['cone_half_deg'])
    score = (min(u_ahead, cfg['cone_cap']) * (0.5 + 0.5 * nr)
             - cfg['w_dist'] * dist - penalty)
    if nr < cfg['near_gate']:
        score *= cfg['buried_factor']
    return {'x': x, 'y': y, 'unknown': u_ahead, 'ahead': u_ahead, 'near_ratio': nr,
            'free_near': free_near, 'unk_near': unk_near, 'ratio': nr,
            'block': 0, 'width': 0, 'penalty': penalty, 'score': score}


def rank_candidates_v3(g, cands, cfg, penalty_fn=None, pose=None, prefilter_n=None):
    if pose is None:
        pose = (0.0, 0.0)
    pre = []
    for x, y in cands:
        dist = math.hypot(x - pose[0], y - pose[1])
        dx, dy = x - pose[0], y - pose[1]
        n = math.hypot(dx, dy) or 1.0
        heading = (dx / n, dy / n)
        pen = penalty_fn(x, y) if penalty_fn else 0.0
        r = prefilter_v3(g, x, y, dist, heading, cfg, pen)
        r['heading'] = heading
        r['dist'] = dist
        pre.append(r)
    pre.sort(key=lambda r: r['score'], reverse=True)
    top = pre[:prefilter_n] if prefilter_n else pre
    out = []
    for r in top:
        out.append(score_v3(g, r['x'], r['y'], r['dist'], r['heading'], cfg, r['penalty']))
    out.sort(key=lambda r: r['score'], reverse=True)
    return out


class Arbiter(Node):
    def __init__(self):
        super().__init__('frontier_arbiter')
        p = self.declare_parameter
        self.min_unknown = int(p('min_unknown_cells', 30).value)
        # D4：v3 的规模门槛原本只看"近处 1 m 未知格"，而真正进分的是 0.3~3.0 m 前方锥。
        # 保守做法：两个判据取"或"——原本能过的照样过，只是把"近处少、前方一大片"的候选也放进来。
        self.min_ahead = int(p('min_ahead_cells', 300).value)
        self.radius = float(p('check_radius', 1.0).value)
        self.pullback = float(p('pullback_m', 0.6).value)
        self.bl_sec = float(p('blacklist_sec', 60.0).value)
        self.bl_r = float(p('blacklist_radius', 0.8).value)
        # P3（2026-11-11，用户批准 5→12）：实测每派发消耗 4.9 个候选、整轮仅 28 个唯一候选，
        # 而"先远后近"排序会把更多候选排到前面。5 个的校验窗口太窄：一旦前 4 个被净空/
        # 后验门否决，只剩 1 个备选，退化为"必须派最不坏的那个"。
        self.max_cand = int(p('max_candidates', 12).value)
        # D8：候选 30 s 太陈旧（地图早变了）、池 400 且同片多点重复竞争
        self.cand_max_age = float(p('candidate_max_age_sec', 15.0).value)
        self.cand_pool = int(p('cand_pool_size', 800).value)
        self.repub = float(p('republish_sec', 8.0).value)
        self.path_timeout = float(p('path_timeout_sec', 4.0).value)
        self.frame = str(p('frame_id', 'map').value)
        # P0-4：前向净空预检——必须穿过窄缝才能到达的候选直接丢弃
        self.corridor_check = bool(p('corridor_check', True).value)
        # 保守口径：走廊净宽下限 0.90 → 1.05 m。
        # 理由（2026-10-23 实测）：两张 cafe_table 的"细立柱"之间在 /map 里是 0.92 m 宽，
        # 机器人在此判据下会钻进去，而它们 0.56 m 见方的贴地底座实际只有 0.36 m 净距
        # （雷达 0.225 m 高度看不见）→ f2 轮 690 次轮子接触全在这里。抬高净宽下限后这类
        # "看着能过、实际过不去"的口子会被前向净空预检直接否掉。
        # ===== 通行保证式判据（2026-10-25 P0，替代"走廊阈值随场景调"的做法）=====
        # 判据只由车体尺寸 + 误差决定，不允许按房间/世界切换：
        #   要求整条路径上"垂直自由带宽" >= 车宽 + 2×安全余量
        #   = 0.47 + 2×0.215 ≈ 0.90 m（车宽取运行时补丁后的 0.47 m）
        # 另加两条硬约束（这次 P0 的核心：不再允许"勉强能过"）：
        #   * 窄段（带宽 < pass_width）累计长度 > narrow_len_max → 否决；
        #   * 连续未知段 > unknown_span_max → 否决（未知一律按障碍算，只允许短跨度例外）。
        #
        # ★ S5 M1（2026-11-14）：本文件**不再持有米制阈值**。
        #   pass_width / narrow_floor 由 RobotProfile 的
        #   `body_width + 2×side_margin` 算出（车体几何唯一事实源）。
        #   参数默认改为 0.0 = "未指定，用 profile 派生值"；
        #   显式给正数时以参数为准（A/B 与回退用）。
        #   见 docs/S5_构型无关适配层_实施计划.md §3 M1 / §4 Step 1。
        self.use_robot_profile = bool(p('use_robot_profile', True).value)
        self.robot_profile_name = str(p('robot_profile', 'wheeltec_diff').value)
        self.profile = self._load_robot_profile()
        self.pass_width = self._metric_threshold(
            'pass_width', float(p('pass_width_m', 0.0).value))
        self.narrow_len_max = float(p('narrow_len_max_m', 1.00).value)
        self.unknown_span_max = float(p('unknown_span_max_m', 0.35).value)
        # 兼容旧参数：corridor_width 不再按世界给默认值，统一取 pass_width
        self.corridor_width = float(p('corridor_width_m', self.pass_width).value)
        # 硬下限：低于这个净宽一律不派（0.92 = pass_width 0.90 再留 2 cm 余地）。
        # ⚠️ S5 M1 的派生量表**不包含** corridor_hard：它是"物理下限 + 余量"的
        #    组合，换车时需要重推但不是 profile 的纯函数。Step 1 保持原值不动，
        #    未覆盖项登记在 docs/S5_实施报告.md。
        self.corridor_hard = float(p('corridor_hard_m', 0.92).value)
        # ===== S3（2026-11-11）：把"物理过不去"与"能过但窄"彻底拆开 =====
        # 旧实现只有 corridor_hard 一道门，0.92 以下一律硬拒。实测后果：
        #   每轮 reject_narrow_hard 中位 2942 次，而 published 仅 30 次
        #   → 候选池被卡几乎归零 → 车 34% 的探索时间在原地等目标。
        # 物理上真正过不去的是"车宽 + 两侧余量都不剩"，即净宽 < narrow_floor。
        # 介于 narrow_floor~corridor_hard 的车**能过**，只是风险高 —— 这类
        # 不该被否决，应该被"大额罚分排到后面"，让排序决定而不是直接没得选。
        # 注意：宽度测量同时改了 S2（沿法向两侧求和），实测值只会比旧值大或相等，
        # 因此本项放开不会把"旧尺度下就过不去"的点放进来。
        #
        # 历史注释更正（S5 §3 M1 遗留矛盾 #1）：
        #   原文写 "车宽 0.40 + 两侧各 0.09 余量" —— 数值 0.58 对，两个因子都错。
        #   真值是 车宽 0.470 + 两侧各 0.055 = 0.58（见 robot_profiles/wheeltec_diff.yaml）。
        #   **只改注释不改数值**：改数值会让 S3 的 A/B 结论失效。
        self.narrow_floor = self._metric_threshold(
            'narrow_floor', float(p('narrow_floor_m', 0.0).value))
        self.corridor_unknown_max = float(p('corridor_unknown_max', 0.35).value)
        # D1：末端也查（原来 skip=1.2 m 会整段跳过目标点附近）；保留参数名做兼容，
        # 但语义改为"末端额外加密采样距离"，不再"跳过"。
        self.corridor_tail_dense = float(p('corridor_tail_dense_m', 0.8).value)
        # 2026-10-26 修：这个属性一直"只有使用、没有声明"（历史遗留）。
        # 只要 path_and_width 走到"没有净空场"的回退分支就 AttributeError，
        # 把仲裁节点当场打死 —— 车端于是拿不到任何新目标，
        # 用户看到的就是"路径不刷新、车长时间卡住"。默认 0.0：整条路径都查。
        self.corridor_skip_far = float(p('corridor_skip_far_m', 0.0).value)
        # D2/D3：用"到最近障碍的距离"代替轴向法向扫线（斜通道不再被高估 1.41 倍），
        # 障碍集合 = /map 占据 ∪ 视觉障碍栅格占据
        self.clearance_mode = str(p('clearance_mode', 'distance').value).lower()
        self.use_vision_obstacles = bool(p('corridor_use_vision', True).value)
        self.vision_grid_topic = str(p('vision_grid_topic', '/vision/obstacle_grid').value)
        # ===== 视觉就绪门（2026-11-13）=====
        # 背景：视觉节点比探索开始晚就绪（实测 p14vA_s2：首次导航 +17.3 s、
        # 视觉首帧 +24.4 s，中间 7.1 s 无视觉，车已走约 2 m）。更关键的是，
        # 车停在出发点、朝向首目标前的那一小段时间，往往是某些侧方家具
        # **唯一**能进入 60° 前向视场的时机；错过就要等到绕回来。
        #
        # 对策：视觉启用且未就绪时，不发布探索目标。超 `vision_ready_timeout_sec`
        # 后无论是否就绪都放行，避免视觉节点故障时整轮探索被永久卡死。
        # `vision_ready_min_cells`：视觉累积栅格至少要有这么多占据格才算就绪；
        # 用 >0 而不是"收到消息"，因为节点刚起时会发空栅格。
        self.vision_ready_gate = bool(p('vision_ready_gate', True).value)
        self.vision_ready_timeout = float(p('vision_ready_timeout_sec', 45.0).value)
        self.vision_ready_min_cells = int(p('vision_ready_min_cells', 1).value)
        # 候选质量探针（2026-10-24）：记录每个"实际派发"的候选在**统一障碍图**
        # （激光∪视觉）上的复杂度/可脱困性指标，供离线统计"哪类候选会导致卡死"。
        self.probe_log = str(p('probe_log', '').value)
        # 观测工作流 v2：每拍一行时间线（1 Hz），供 round_digest 画轨迹图并和
        # probe / supervisor / launch.log 做秒级交叉核对。
        # 兜底：launch 参数没送到时用环境变量（实测在整轮里 timeline_log 偶发丢失，
        # 导致 digest 退化成 10 s 采样、卡死秒级判定不可用；环境变量由 round.sh 导出）
        self.timeline_log = (str(p('timeline_log', '').value)
                             or os.environ.get('STEMM_TIMELINE_LOG', ''))
        self._tl_fh = None
        self._tl_n = 0
        self._tl_last_wall = 0.0
        # 2026-11-14（S5 Step 0）：每拍耗时探针。
        # 为什么要单独记：S5 §5-B 要求"tick P95 ≤ 基线 P95 × 1.5 且 ≤ 80 ms"，
        # 但改造前**根本没有任何 tick 耗时数据**（见 S5 §4 Step 0 的说明）：
        #   probe.jsonl   只有 reverse_msgs 一个耗时类字段
        #   timeline.jsonl 无耗时字段
        #   candidate_probe.jsonl 无耗时字段
        # ⇒ 如不先补，Step 2 的"单拍 P95 增量 ≤ 10 ms"永远无法判定。
        # 实现口径：tick() 开头计时，finally 里记账；耗时写入**下一拍**的
        # timeline 行（因为 write_timeline 在本拍开头就写了），滞后 ≤ 1 s。
        self._tick_ms_prev = None       # 上一拍耗时（毫秒）
        self._tick_paw_prev = 0         # 上一拍 path_and_width 调用次数
        self._tick_paw_calls = 0        # 本拍累计（path_and_width 里自增）
        self._tick_ms_max = 0.0
        self._tick_ms_sum = 0.0
        self._tick_ms_n = 0
        self._tick_ms_over_budget = 0   # 超过 tick_budget_ms 的拍数
        # S5 §5-B 的硬上限 80 ms；超限只计数告警，**不降级**（降级会改决策）
        self.tick_budget_ms = float(p('tick_budget_ms', 80.0).value)
        self.probe_escape_r = float(p('probe_escape_clear_m', 0.60).value)
        self.probe_narrow_r = float(p('probe_narrow_clear_m', 0.35).value)
        self.probe_radius = float(p('probe_radius_m', 2.0).value)
        # ===== 候选闸门 V1（2026-10-24）=====
        # 只治"能防住"的那类：落点是死口袋/过挤（激光∪视觉统一障碍图上的可脱困性）。
        # 依据 10 轮 85 派发/13 卡死：esc_dirs=0 → 83% 卡死，5-8 → 4%；comp_r2<=100 → 83%。
        # 硬拒仅用 esc_dirs/comp_r2（误杀率 10.6%）；occ 复杂度只重罚不硬拒
        # （实测 esc_dirs=6 / occ=0.31 的安全点若硬拒会被误杀）。
        # 2026-10-24 V1 实测退化（10 轮 PASS 100%→70%、返航失败 0→3、接触 0→1，而静止 12→12 没改善）
        # ⇒ 按"退化先回退"默认关闭。原因见 P6 报告：卡死 62% 来自 manager 绕过仲裁，
        # 只查仲裁候选的闸门对总量无效，反而带来 442 次/轮的拒绝 churn。
        # 类型提示同 veto_enabled：launch 传 gate:=true 会被归一化成 bool，
        # 用字符串默认值 declare 会抛 InvalidParameterTypeException 打死节点。
        self.gate_enabled = self._as_bool(p('gate_enabled', False).value)
        self.gate_esc_min = int(p('gate_esc_dirs_min', 3).value)
        self.gate_comp_min = int(p('gate_comp_min_cells', 500).value)
        self.gate_occ_soft = float(p('gate_occ_soft', 0.30).value)
        self.gate_occ_penalty = float(p('gate_occ_penalty', 1200.0).value)
        self.gate_esc_weights = (1.0, 0.70, 0.35, 0.10)   # esc_dirs 5-8 / 3-4 / 1-2 / 0
        # ===== V2-② 保底安全候选（2026-10-24）=====
        # 目的：仲裁器"挑不出合格候选"时不再什么都不派 —— 否则 manager 会在
        # rrt_fallback_wait 之后自己采样（实测卡死 62% 来自那条路径）。
        # 做法：从前 max_cand 个候选里挑一个"开阔、连通、离车不远"的点当观察点。
        self.fallback_enabled = str(p('fallback_goal_enabled', 'true').value).lower() in ('true','1','yes')
        # 收紧后的默认值：B0/V3 两组里各有一轮是在"保底观察点把车送去远角"之后
        # 出现接触/硬倒车，所以把观察点限制在更近、更开阔的范围（宁可不派）。
        self.fallback_min_esc = int(p('fallback_min_esc_dirs', 6).value)
        self.fallback_min_comp = int(p('fallback_min_comp_cells', 1000).value)
        self.fallback_max_dist = float(p('fallback_max_dist_m', 2.0).value)
        self.fallback_cooldown = float(p('fallback_cooldown_sec', 10.0).value)
        self.fallback_max_total = int(p('fallback_max_total', 10).value)
        self._fb_last = 0.0
        self._fb_count = 0
        # ===== V2-③ 后置 veto（2026-10-24）=====
        # 目的：闸门只看"落点"，管不到"manager 在窗口之外自己采样的目标"。
        # 做法：订阅 /plan，取末位点当"当前真正在执行的目标"；若它既不是本节点
        # 最近派过的点、又命中硬闸门（esc_dirs 太小 / 复杂度过高），就取消它。
        # 安全约束（吃过教训，见 docs/P7 第 4 节）：
        #   * 只在探索期生效（nav_state 里 mapping_done=false 且无返航迹象）；
        #   * 目标落在 map 原点近旁（返航终点）一律不碰；
        #   * 每局限 2 次、30 s 冷却、同一目标 20 s 内不重复 veto；
        #   * 只取消"当前 EXECUTING 的那个 goal_id"，绝不用 cancel-all。
        # 注意：launch 传 veto:=true 时 ROS 会把它解析成 **bool**，
        # 若这里用字符串默认值 declare，rclpy 会直接抛
        # InvalidParameterTypeException 把整个仲裁节点打死（实测第 1 轮即崩）。
        # 所以默认值用 bool，并同时容忍字符串/数字写法。
        self.veto_enabled = self._as_bool(p('veto_enabled', False).value)
        # P9-⑥（用户 2026-10-26："路径永远不经过略宽于车身的窄处"）
        # 候选闸门查的是**仲裁器自己 BFS 出来的那条路**，而真正开的是 nav2 planner
        # 在代价地图上算出的 /plan —— 不是同一条路。这里对 /plan 再做一次体检：
        #   plan_guard_log  : 只记录（每轮统计计划的最小净宽 / 最长窄段）
        #   plan_guard_veto : 命中判据就取消目标（"宁可不走"）
        self.plan_guard_log = self._as_bool(p('plan_guard_log', False).value)
        self.plan_guard_veto = self._as_bool(p('plan_guard_veto', False).value)
        self.plan_guard_max_cancel = int(p('plan_guard_max_cancel', 6).value)
        # ---- P9-L1/L2：卡死治理「确定过不去 → 报失败/换目标」----
        # 阈值来自 50 轮历史 timeline 的离线复算（harness/analyze_failfast.py）：
        #   滑窗 20 s / 漂移 <=0.20 m / front 中位 <0.60 m 或 nav=blocked_*
        #   → 命中 62 次，确认(同 2 m 内 60 s >=2 次) 0.38 次/轮，误报 5/50 轮，覆盖 7/11 顶住类事件。
        # 注意：历史数据证明"里程 >=0.6 m"这条不能当必要条件（真卡死时里程≈0，会把事件全滤掉）。
        self.failfast_enabled = self._as_bool(p('failfast_enabled', False).value)
        self.ff_window = float(p('failfast_window_sec', 20.0).value)
        self.ff_drift = float(p('failfast_drift_m', 0.20).value)
        self.ff_front = float(p('failfast_front_m', 0.60).value)
        self.ff_confirm = max(1, int(p('failfast_confirm_hits', 2).value))
        self.ff_ttl = float(p('failfast_ttl_sec', 60.0).value)
        self.ff_hard_radius = float(p('failfast_hard_radius_m', 1.2).value)
        self.ff_zone_radius = float(p('failfast_zone_radius_m', 2.0).value)
        self.ff_max_actions = int(p('failfast_max_actions', 8).value)
        self.ff_escalate_sec = float(p('failfast_escalate_sec', 40.0).value)
        # 拉黑单位＝"死角/自由连通域"（用户 2026-10-26 批准）：只拉黑落点半径挡不住
        # "同一墙角的另一侧"，实测 L2 动作 10 次仍出现 82/99 s 长停滞。
        self.ff_comp_radius = float(p('failfast_comp_radius_m', 6.0).value)
        self._ff_cells = {}        # {(ci, cj): until}  禁入连通域的栅格

        self._ff_hist = deque(maxlen=240)   # [(t, x, y)]（deque：_update_failfast 里 popleft）
        self._ff_hits = []          # [(t, x, y)]
        self._ff_hard = []          # [(x, y, until)] 本轮禁入区
        self._ff_actions = 0
        self._ff_last_action = 0.0
        self._ff_stuck_since = None
        self._ff_blocked_since = None
        self.ff_blocked_sec = float(p('failfast_blocked_sec', 15.0).value)
        self._pg_cancels = 0
        self._pg_logged_plan = None
        self.veto_min_esc = int(p('veto_min_esc_dirs', 3).value)
        self.veto_occ_max = float(p('veto_occ_frac_max', 0.30).value)
        self.veto_self_r = float(p('veto_self_radius_m', 0.60).value)
        self.veto_self_sec = float(p('veto_self_window_sec', 8.0).value)
        self.veto_max = int(p('veto_max_per_session', 2).value)
        self.veto_cooldown = float(p('veto_cooldown_sec', 30.0).value)
        self.veto_home_guard = float(p('veto_home_guard_m', 0.80).value)
        # ==== 后置否决改为"迁移"（2026-10-27 用户方案）====
        # 原始 V2-③ 命中就取消 → 车停车等下一个候选（实测等候选最长 27~92 s）。
        # 改成：命中后**不取消落点本身**，而是把它迁到一个合格点继续执行。
        # 两档策略（可切换）：
        #   random   ：在原落点附近随机采样，取最近的合格点（用户方案，默认）
        #   rollback ：在正在执行的 /plan 上从末位往回，取最后一个合格位姿
        # 两档都失败才回落成"取消"。合格判据与后置否决同一套（esc_dirs/occ），
        # 代价地图可用时再叠加落点代价判据。配额/冷却沿用 veto 的（默认每局 2 次）。
        self.veto_migrate = self._as_bool(p('veto_migrate', True).value)
        self.veto_migrate_mode = str(p('veto_migrate_mode', 'random').value).lower()
        self.veto_migrate_r = float(p('veto_migrate_radius_m', 2.0).value)
        self.veto_migrate_samples = int(p('veto_migrate_samples', 32).value)
        self.veto_migrate_min_move = float(p('veto_migrate_min_move_m', 1.0).value)
        # ★ 2026-11-04 P12 Step3：后置纠偏「原地改目标」模式。
        #   命中后置判据时**不取消** nav2 目标，而是把"最近的合格自由点 G*"通过
        #   /goal_update 推给 nav2 BT 的 GoalUpdater ⇒ BT 原地改写 goal 并重规划，
        #   外层 NavigateToPose 动作继续（到 G* 由 controller 判成功：
        #   controller_server.cpp:439 用 path.poses.back() 做目标校验）。
        #   默认 False（行为与现状完全一致），灰度验证后由用户切 True。
        #
        # ⚠ 2026-11-09 P13-5：**该模式已被强制停用**。原因：nav2_behavior_tree 的
        #   GoalUpdater 用实例成员 last_goal_received_ 缓存 /goal_update，且不随新的
        #   NavigateToPose 目标复位（见 goal_updater_node.cpp:53-56）。一旦发过一次
        #   goal_update，之后每个新目标都可能被替换成那次旧纠偏点 → controller 首次
        #   isGoalReached() 就命中 → 30 ms "Reached the goal!"（幻影成功）。
        #   实测 v2 五轮 79.2% 的 reached 属于这一类，而 offv2 五轮（未触发 inplace）
        #   幻影数 = 0。配套改动：BT 里已移除 GoalUpdater 装饰器。
        #   因此即使这里被设为 true，也不得不降级为 migrate（cancel）模式 ——
        #   否则 /goal_update 发出去也无人消费，等于静默失效。
        self.veto_inplace = self._as_bool(p('veto_inplace', False).value)
        if self.veto_inplace:
            # ★ 2026-11-11 S4：nav2 GoalUpdater 的上游 bug 已修（见
            #   navigation2-humble/nav2_behavior_tree/.../goal_updater_node.cpp：
            #   换新目标时丢弃 last_goal_received_ 缓存），所以本模式可以重新启用。
            #   但上线前必须确认两件事，否则会回到 79.2% 假到达：
            #     ① nav2_behavior_tree 已重新编译并安装；
            #     ② BT XML 已挂回 GoalUpdater 装饰器（2026-11-09 曾为了止损把它删了）。
            #   若②没做，_publish_goal_update 会因为 /goal_update 无订阅者而
            #   返回 False，自动退回 migrate（取消重派），不会静默失效。
            self.get_logger().warn(
                'veto_inplace=True：启用「原地改向」（不取消目标）。'
                '前置条件：nav2_behavior_tree 已含 2026-11-11 修复补丁、'
                '且 BT XML 已挂回 GoalUpdater；请先用 5 轮验证 reached 误差 < 0.3 m。')
        self.inplace_radius = float(p('inplace_radius_m', 3.5).value)
        self.inplace_tries = int(p('inplace_tries', 48).value)
        # ★ inplace 专用判据：migrate 的 veto_migrate_min_move(1.0 m) 是为了"把目标挪开"，
        #   而原地纠偏要的是"最近的合格点"，两者必须解耦；宽度阈值也单列（默认 0.70 m，
        #   比 corridor_width 1.05 松，因为纠偏点是"临时落点"而不是"候选前沿"）。
        self.inplace_min_width = float(p('inplace_min_width_m', 0.70).value)
        self.inplace_min_robot = float(p('inplace_min_robot_m', 0.50).value)
        self.inplace_min_goal = float(p('inplace_min_goal_m', 0.20).value)
        # ★ 2026-11-04 实测修正：对"已在正常推进"的目标中途改向会显著抬高停滞
        #   （ab4 组 r3/r4/r5 停滞 109/81/87 s，而 A 组 23~54 s）。原始数据里
        #   被取消的目标多数是"已跑 8~14 s、剩余仅 5 m"的正常推进。
        #   故只允许在**离目标仍远**的早期阶段纠偏（默认 >2.5 m），一旦接近就放手让
        #   当前目标跑完（此时若仍不合格，交由既有 cancel 兜底或下一轮候选处理）。
        self.inplace_only_beyond = float(p('inplace_only_beyond_m', 0.0).value)
        # ★ v2：G* 必须"显著优于"原目标才值得纠偏——原判据只要求可达+代价门，
        #   结果 58% 的纠偏位移 ≤0.5 m、把目标挪到同样拥挤的地方（停滞 +35%）。
        self.inplace_max_occ = float(p('inplace_max_occ_frac', 0.15).value)
        self.inplace_min_esc = int(p('inplace_min_esc_dirs', 4).value)
        self.inplace_max = int(p('inplace_max', 1).value)
        self.inplace_cooldown = float(p('inplace_cooldown_sec', 3.0).value)
        self.inplace_min_disp = float(p('inplace_min_disp_m', 1.00).value)
        self.inplace_fallback_cancel = self._as_bool(
            p('inplace_fallback_cancel', True).value)
        self._inplace_last = 0.0
        self._inplace_prev = None
        self.pub_goal_update = self.create_publisher(
            PoseStamped, p('goal_update_topic', '/goal_update').value, 10)
        self.pub_correction = self.create_publisher(
            String, p('goal_correction_topic', '/goal_correction').value, 10)
        self._veto_last = 0.0
        self._veto_count = 0
        self._veto_prev = None         # (x, y, ts) 上一次 veto 的目标
        self._nav_payload = None       # 最近一帧 nav_state 解析结果
        self._nav_seen = False
        self._active_uuid = []         # 当前 ACCEPTED/EXECUTING 的 goal uuid（bytes）
        self._veto_detail = []
        # ===== 探索末段"停车友好"偏置（2026-10-24）=====
        # 实测最主要的残余失败模式：探索时间到时车停在贴障位置，车端 manager 以
        # "current pose is too close to occupied /map cells" / "front obstacle too
        # close" 拒绝启动返航，3 次重试 6 秒内耗尽 → 整轮返航失败
        # （272 轮历史里这条消息出现在 21 轮 = 7.7%，且新几组失败几乎全是它）。
        # 做法：最后 tail_sec 秒里给"四周不够开阔"的候选加罚，让车尽量停在空地；
        #       同时把保底观察点的门槛临时放宽，避免末段干脆没有目标。
        # 2026-10-24 十轮实测：开着它反而更差（全绿 10/10→8/10、返航失败 0→2、
        # 卡死 12→16）。末段把车往开阔处送，等于让它在收尾阶段多跑一段路，
        # 反而更容易在截止那一刻卡在半路。⇒ 默认关闭，实现与参数保留备查。
        self.tail_park_enabled = self._as_bool(p('tail_park_enabled', False).value)
        self.explore_sec = float(p('explore_sec', 180.0).value)
        self.tail_sec = float(p('tail_park_sec', 25.0).value)
        self.tail_min_esc = int(p('tail_park_min_esc_dirs', 5).value)
        self.tail_penalty_value = float(p('tail_park_penalty', 900.0).value)
        self._first_pub_t = None
        # ===== "可达但不可返回"检查 + 脱困目标（2026-10-25）=====
        # myrun 事故：车在 (-1.05,3.82) 死角里停了 100 秒 —— 每个前沿候选的路径都要
        # 过同一个窄口（走廊预检不过），仲裁于是每拍"全部被拒"，一个目标都不派；
        # manager 自己的采样也过不去，车就一直原地待着，脱困单元也失败。
        # 两处补齐：
        #  1) return_check：派发前要求目标附近**有掉头空间**（车对角线 ~0.81 m），
        #     否则这地方"进得去出不来"；
        #  2) escape_goal：真的所有前沿都派不出去时，从一个**本地环**里挑
        #     "净空最大、当前能到"的点先派出去，把车挪出死角，而不是什么都不做。
        self.return_check = self._as_bool(p('return_check_enabled', True).value)
        self.return_turn_width = float(p('return_turn_width_m', 0.85).value)
        # P9-⑦（用户 2026-10-26 提问）：候选输出会不会把 nav2 的 allow_unknown 纳入判据？
        # 原来**不会**：候选闸门的通行 BFS 走代价地图（未知编码 -1 会被挡），
        # 但"沿路净宽"是在 /map 上算的，而 /map 里未知格**按可通行**处理，只靠
        # unknown_span_max(0.35 m) 给一小段容差。nav2 一旦设成 allow_unknown:false，
        # 两边口径就不一致：仲裁认为能到、规划器却拒绝，或反过来把车带进"没看清"的角。
        # unknown_block=True 把容差清零（任何未知段都不许），并额外要求落点本身是已知自由格。
        self.unknown_block = self._as_bool(p('unknown_block', False).value)
        # P9-D（用户 2026-10-26 批准，根治"真窄卡死族"的前提）：
        # 判宽时把**未知格按障碍计**。原来未知只用于统计占比，距离场只由已知障碍生成，
        # 于是"半侧还没观测到"的缝在决策时刻被量成宽路 —— 这正是 19 次窄点卡死里
        # 大部分"决策时看着能过、进去后墙才出现"的机制来源。
        self.width_unknown_block = self._as_bool(p('width_unknown_block', False).value)
        if self.unknown_block:
            self.unknown_span_max = 0.0
        # P9-A（用户 2026-10-26 批准的方向，2026-10-26 夜实测后重定义）：把"一刀切 pass_width
        # 否决"换成"0.752 m 硬禁 + 1.6~1.05 m 带可退出性判定"。原因：pass_width=1.05 上线后
        # rejected_narrow 涨到 587~671/轮（供给被掐掉一半），而真窄卡死仍有 19 次/14 轮；
        # 单纯再加一条更低阈值的否决是空操作（<1.05 的路径早就被否决了）。所以 A 的语义是：
        # * 路径最小净宽 < noexit_pinch_m(0.752) → 照旧硬否决（真挤不过去）；
        # * 落在 [pinch, pass_width) → 判"能不能退出"：能退出就**放行**（恢复供给），
        #   不能退出才否决并单独计 reject_noexit；这样才能同时压卡死与提高覆盖。
        self.noexit_enabled = self._as_bool(p('noexit_enabled', False).value)
        self.noexit_pinch_m = float(p('noexit_pinch_m', 0.752).value)
        self.noexit_short_m = float(p('noexit_short_m', 0.35).value)
        self.noexit_retreat_m = float(p('noexit_retreat_m', 1.20).value)
        self.noexit_turn_m = float(p('noexit_turn_m', 0.81).value)
        self.noexit_retreat_need_m = float(p('noexit_retreat_need_m', 1.00).value)
        self.noexit_turn_hold_m = float(p('noexit_turn_hold_m', 0.30).value)
        # P9-S0（2026-10-27 用户批准"接触闭环三件套"）：
        # ① 物理接触 → 取消当前目标（原来只把接触点记为候选降权，当前目标会一直往障碍里推，
        #    实测 c3r4 贴着 Dumbbell 研磨 175 s）；
        # ② 同一处重复接触 → 记忆时间递增（反复撞比撞一次更该避开）；
        # ③ 接触触发的受限倒车在监督侧（escape_supervisor::contact_panic）。
        self.contact_fail_enabled = self._as_bool(p('contact_fail_enabled', False).value)
        self.contact_fail_max = int(p('contact_fail_max', 6).value)
        self.contact_fail_cooldown_sec = float(p('contact_fail_cooldown_sec', 3.0).value)
        self.contact_hits = {}
        self._cf_count = 0
        self._cf_last = 0.0
        # P9-CORR（2026-10-27 用户批准机制 1/2/4，**不跨轮持久**）：
        #   1) 计划体检授权：/plan 穿 <pass_width 的缝 → 直接取消（plan_guard_veto）
        #   2) 走廊级记忆：把"穿窄处"的窄点记成不可通行走廊（本轮内存，命中递增 TTL）
        #   4) 统一入口：在 on_plan 里对所有来源的 /plan 都查走廊，不只查我方候选
        self.corridor_block_enabled = self._as_bool(p('corridor_block_enabled', True).value)
        self.corridor_radius_m = float(p('corridor_radius_m', 0.35).value)
        self.corridor_ttl_sec = float(p('corridor_ttl_sec', 30.0).value)
        self.corridor_ttl_max_sec = float(p('corridor_ttl_max_sec', 180.0).value)
        self.corridors = []        # [{x,y,r,w,exp,hits}] 仅本轮内存（用户明确不跨轮持久）
        self._corr_last = 0.0
        self._corr_veto_min_gap = float(p('corridor_veto_min_gap', 2.0).value)
        self._last_path_reject = None
        # S1（2026-11-11）：本拍路径实测最小净宽，写进 timeline 供离线看分布
        # （旧日志只打了门限，导致"被否的点到底是 0.91 还是 0.30"无从判断）
        self._last_path_min_w = None
        self._gu_warned = False        # S4：/goal_update 无订阅者只警告一次
        # 半径取 0.6 m："这一脚到那儿能不能转过身"，而不是"附近某处有片空地"。
        # 取 1.2 m 时实测 3 轮里一次都没触发（房间尺度上总能找到空地），等于没生效。
        self.return_scan_radius = float(p('return_scan_radius_m', 0.60).value)
        self.escape_goal_enabled = self._as_bool(p('escape_goal_enabled', True).value)
        self.escape_min_clearance = float(p('escape_min_clearance_m', 0.55).value)
        self.escape_max_dist = float(p('escape_max_dist_m', 2.00).value)
        self.escape_cooldown = float(p('escape_cooldown_sec', 8.0).value)
        self.escape_max_total = int(p('escape_max_total', 20).value)
        # P9-⑤(b)：脱困落点是否必须留出掉头空间（默认开）
        # 注意：launch 传 ``escape_need_turn:=false`` 会被归一化成 bool，
        # 用 bool(...) 读会把字符串 'false' 当成 True（历史踩过）。
        self.escape_need_turn = self._as_bool(p('escape_need_turn', True).value)
        # ===== P13-4a：脱困目标两轮搜索（2026-11-09）=====
        # 机制（docs/P13_基线.md §5）：v2 五轮 giveup_40s 共 8 次、unit_start 共 0 次；
        # 同批日志里 148/149/146 s 的长卡死都伴随"前沿全灭 → 脱困目标"反复失败。
        # 原因：原判据要求"掉头空间 >=0.85 m 且 路径完全无窄段"，真橼死处几乎必然
        # 一个都不满足 → 直接返回 None → 车继续原地待着。
        # 所以改为：严格轮优先；全空时才跑放宽轮（仍守住几何硬下限）。
        self.escape_allow_narrow = self._as_bool(p('escape_allow_narrow', True).value)
        self.escape_relax_turn = self._as_bool(p('escape_relax_turn', True).value)
        self.escape_turn_relax = float(p('escape_turn_relax_m', 0.70).value)
        self.escape_min_comp = int(p('escape_min_comp_cells', 500).value)
        self._esc_last = 0.0
        self._esc_count = 0
        self.corridor_stride = max(1, int(p('corridor_stride_cells', 2).value))
        self.narrow_penalty_sec = float(p('narrow_blacklist_sec', 45.0).value)
        # ==== 候选后验门（2026-10-27）====
        # 现象：候选是在"当时的地图"上选的；雷达/深度相机扫到那一带后，同一位置可能
        # 已被膨胀/占据/视觉障碍覆盖，却没有任何环节复核 → 派出去才发现过不去。
        # 这里在下发前用**当前全局代价地图**再判一次；不通过就拒 + 进黑名单。
        # 视觉障碍只存在于代价地图（/map 里没有），所以这一关必须看代价地图。
        self.cost_gate = bool(p('cost_gate', False).value)
        self.cost_gate_hard = int(p('cost_gate_hard', 99).value)
        self.cost_gate_disc = float(p('cost_gate_disc_m', 0.35).value)
        self.cost_gate_free_ratio = float(p('cost_gate_free_ratio', 0.80).value)
        # ==== 方向黏性"软约束"（2026-10-27 用户决策：方向不得一票否决候选）====
        # 车端原来的 ±80° 转角门禁把"车后/侧后、需 ~150° 掉头"的候选整片拒掉，
        # 连拒 4 次才解锁、解锁后又去吃队列里的远点（12~15 m）→ 规划超迭代失败 →
        # 车原地等。实测 10 轮里这样被拒 79 次（中位 151°、≤3 m 占 27%）。
        # 这里改为：转角只作为**打分惩罚**，永不拒；并加"近处可执行优先"。
        self.turn_pen_k = float(p('turn_penalty_k', 60.0).value)
        self.near_first = self._as_bool(p('near_first', True).value)
        self.near_first_r = float(p('near_first_radius_m', 3.0).value)
        # ==== 区域新度打分（2026-10-28 用户要求：优先级看"哪片区域没探过"）====
        # 旧口径只数目标周围 0.6 m 的未知格；改为叠加"2 m 半径未知格"作为主权重，
        # 并对"已探明区"（2 m 内已知空闲占比 >= repeat_ff）重罚，避免车被反复送回老地方。
        # 注意：launch 传参会被 YAML 推断类型，整数（250）与 float 声明不匹配会抛
        # InvalidParameterTypeException 把整个仲裁器打崩（2026-10-28 实测一次）。
        # 这里统一用容错读取：先取 value，再用 float(str(...)) 兜一层。
        def _f(name, default):
            try:
                return float(p(name, default).value)
            except Exception:                    # noqa: BLE001
                return float(default)
        # 修复点质量（2026-10-28 用户要求）：随机合格点若只"代价低"而综合质量差，
        # 车容易过不去/出不来。所以修复后必须再过两关：
        #   ① nav2 可通行先验：用仲裁器自己的 path_and_width（BFS 路径 + 沿途净宽）
        #   ② 一般候选判据：region_complexity（esc_dirs / occ_frac_r2）与 candidate_gate
        self.repair_verify = self._as_bool(p('cost_repair_verify', True).value)
        self.repair_verify_tries = int(p('cost_repair_verify_tries', 3).value)
        self.repair_tick_cap = int(p('cost_repair_tick_cap', 6).value)
        # 校验失败的兜底：若所有采样点都过不了"可通行 + 候选判据"，仍然改投
        # **仅过代价门**的最近点（而不是回落到否决）。依据：rp6 实测严格校验后
        # 每轮 68~164 个候选被否决掉 ⇒ 供给被掐、等候选 16→22 s、停滞 9→15 s。
        self.repair_fallback = self._as_bool(p('cost_repair_fallback', True).value)
        self.novelty_w = _f('novelty_w', 0.0)
        self.novelty_r = _f('novelty_radius_m', 2.0)
        self.repeat_ff = _f('repeat_free_frac', 0.90)
        self.repeat_pen = _f('repeat_penalty', 0.0)
        self.near_first_band = _f('near_first_band', 0.10)
        # ===== P1/P2（2026-11-11）候选落点倾向：未知区特征 + 候选池探针 =====
        # 设计前提（用户 2026-11-11 明确）：**只做候选序列内的排序**，
        # 不改候选生成策略（RRT / 前沿提取一律不动）。
        # P1 负责回答"这个候选打开的未知区有多大、在哪个方向、离车多远"；
        # P2 负责把"排序依据"逐拍落盘，否则改造退化时只能看到"停滞变长"这种粗信号。
        self.ureg_enabled = self._as_bool(p('ureg_enabled', True).value)
        # 候选周边多大半径内的未知格用来判定"候选属于哪个未知连通分量"
        self.ureg_radius = _f('ureg_radius_m', 0.50)
        # 小于此格数的分量视为地图噪声/缝隙，不参与归属（1 m² = 400 格 @5cm）
        self.ureg_min_cells = int(p('ureg_min_cells', 40).value)
        # 候选池快照：每拍记录排序后前 N 名的完整依据（0 = 关闭）
        self.pool_probe_n = int(p('pool_probe_n', 12).value)
        self.pool_probe_log = str(p('pool_probe_log', '').value)
        # ===== P4/P5（2026-11-11）候选落点倾向：先远后近两阶段 =====
        # 用户方案（2026-11-11 批准）：候选序列内先去"当前位姿下最远的未知格内候选"，
        # 再去剩下未探索的未知区 —— 先探出室内大致框架、再逐步补齐。
        # **仅排序**：不改候选生成（RRT/前沿提取一律不动），只在可用候选内重排。
        # frame_far_first 是总开关：默认 0 = 逐位等价当前行为（便于 A/B 干净对照）。
        self.frame_far_first = self._as_bool(p('frame_far_first', False).value)
        # 框架阶段的准入门槛：未知厚度（距最近已知格）不小于此值的候选才允许
        # 作主目标，避免把"远处但只是墙角缝隙"的候选当成框架推进点。
        self.frame_depth_min = _f('frame_depth_min_m', 0.0)
        # ===== P4 阶段判据（2026-11-13 第三次修正：混合判据）=====
        # 演进过程（每次都有实测依据，别再改回去）：
        #   v1 停滞驱动（已探明面积连续 N 拍不增长）：实测 2.7 次/轮切换，
        #      90 s 内在框架/补齐之间交替，一半时间有 risk_discount 保护 —— 能跑。
        #   v2 供给驱动（远候选数为 0）：**实测失败**。远候选"有货"≠"可达"，
        #      153 拍里从未连续 3 拍为 0 ⇒ 永不切补齐 ⇒ 全程框架阶段。
        #      而框架阶段不做距离折现、按距离降序，最远点常落在未知边缘
        #      净空实测 0.00m ⇒ 净宽否决 ⇒ top-14 全灭 ⇒ 只派出 2 个目标、
        #      选点等待 80.5%。（p14v2_sm3）
        #   v3 混合（当前）：停滞驱动为**主**，供给耗尽作为**加速通道** ——
        #      远区真空了就不必再等停滞计时；只要还有远候选就走已验证的慢判据。
        self.frame_supply_empty_ticks = int(p('frame_supply_empty_ticks', 3).value)
        self.frame_stall_ticks = int(p('frame_stall_ticks', 8).value)
        self.frame_growth_cells = int(p('frame_growth_cells', 400).value)
        # 判据 (b)：剩余未知连通分量数 <= 此值（停滞判据的辅助条件）
        self.frame_regions_max = int(p('frame_regions_max', 6).value)
        # 滞回（用户 D1：可回退，但切换后至少保持这么久）
        self.frame_hysteresis = _f('frame_hysteresis_sec', 20.0)
        # 回切（停滞逼的补齐）：已探明跳增这么多格 ⇒ 发现新房间
        self.frame_regrow_cells = int(p('frame_regrow_cells', 2500).value)
        # 安全阀：框架阶段连续这么多拍无候选通过硬门 ⇒ 强制切补齐
        self.frame_deny_limit = int(p('frame_deny_limit', 5).value)
        # P5(ii)：远目标准入 —— 超过此距离的目标必须凑够净宽门槛
        self.far_admit_on = self._as_bool(p('far_admit', True).value)
        self.far_admit_dist = _f('far_admit_dist_m', 5.0)
        # 净宽门槛：0 = 用 pass_width(0.90，车宽+2×余量的通行下限)，
        # 而不是 corridor_hard(0.92)。实测 0.90 vs 0.92 这 2 cm 差会把整片
        # 0.90 m 宽的走廊里的远目标全部否决（单轮 35 次），属于测量噪声。
        self.far_admit_width = _f('far_admit_width_m', 0.0)
        # P5(iii)：中继降级 —— 远目标被否决时，沿已算出的路径取这个弧长处的点
        self.far_relay_on = self._as_bool(p('far_relay', True).value)
        self.far_relay_m = _f('far_relay_m', 4.0)
        self.far_relay_min_goal = _f('far_relay_min_goal_m', 1.5)
        # 候选后验"修复"（2026-10-27 用户方案）：后验不合格**不再一律否决**，
        # 而是在原候选附近随机采样，改投最近的合格点位。理由：否决会掐断供给
        # （实测单源化后 manager 连续 93 s 无目标），修复则保留仲裁通道的主导地位
        # （合格点仍走 /validated_frontier_goal，TTL 优先），RRT 只是兜底。
        self.repair_on = bool(p('cost_repair', True).value)
        self.repair_radius = float(p('cost_repair_radius_m', 1.20).value)
        self.repair_samples = int(p('cost_repair_samples', 24).value)
        self.repair_keep_unknown = float(p('cost_repair_keep_unknown', 0.30).value)
        self.repair_min_unknown = int(p('cost_repair_min_unknown', 20).value)
        # 物理接触区（撞过的地方）：强降权 + 长记忆，避免反复撞同一张桌子
        # 陷阱记忆：撞过的地方半径放大到 2.5 m（两张桌子底座之间这种"地图上开阔、
        # 物理上过不去"的陷阱，一次撞到就把整片圈起来），时长 300 s、罚 1500。
        self.contact_zone_sec = float(p('contact_zone_sec', 300.0).value)
        self.contact_zone_radius = float(p('contact_zone_radius_m', 2.5).value)
        self.contact_zone_penalty = float(p('contact_zone_penalty', 1500.0).value)
        # D7：把"撞过的地方"从软降权升级为**近半径内等效硬拒**（1e5 远高于主项上限 3000），
        # 但仍是罚分而非硬 skip —— 万一所有候选都在禁区，也要能派出最不坏的那个，不许饿死。
        self.contact_hard_radius = float(p('contact_hard_radius_m', 1.5).value)
        self.contact_hard_penalty = float(p('contact_hard_penalty', 1e5).value)
        # 收益函数 v2（S3+S2）：大块未知优先、碎角降权、已探完区域降权
        self.cfg = {
            'info_radius': float(p('info_radius', 1.0).value),
            'block_cap': int(p('block_cap', 6000).value),
            'block_radius': float(p('block_radius', 6.0).value),
            'width_radius': float(p('width_radius', 1.5).value),
            'min_width': int(p('min_frontier_width', 6).value),
            'width_cap': int(p('width_cap', 8).value),
            'w_block': float(p('w_block', 1.5).value),
            'w_width': float(p('w_width', 40.0).value),
            'w_dist': float(p('w_dist', 0.5).value),
            'ratio_floor': float(p('ratio_floor', 0.35).value),
            'small_frontier_factor': float(p('small_frontier_factor', 0.4).value),
        }
        self.retry_penalty = float(p('retry_penalty', 60.0).value)
        self.retry_radius = float(p('retry_radius_m', 1.2).value)
        self.retry_window = float(p('retry_window_sec', 300.0).value)
        self.pub_history = []        # [(x, y, ts)] 已派发过的目标（用于"反复拉锯"降权）
        self._last_plan = None       # 最近一条 /plan 的位姿序列（供后置迁移的 rollback 档）
        # D13：区域级（1 m 网格）被拒计数 —— 同一片"陷阱区"会持续生产候选，
        # 点级黑名单压不住，这里按区域整体降权（仍是罚分，不做硬拒）
        self.region_sec = float(p('region_penalty_sec', 120.0).value)
        self.region_penalty = float(p('region_penalty', 150.0).value)
        self.region_cap = int(p('region_penalty_cap', 900).value)
        self.region_refuse_hard = int(p('region_refuse_hard_count', 6).value)
        self.region = {}            # (i,j) -> [ts, ...] 被拒时刻
        self.verbose_rank = str(p('verbose_rank', True).value).lower() in ('true', '1', 'yes')
        # 两级打分：昂贵指标只算前 N 个（候选池可能几百个）
        self.prefilter_n = int(p('prefilter_n', 12).value)
        # 与 manager 的 80° 转向门对齐（留 5° 余量），避免"派发了但被拒 → 原地转 → 再派发"
        self.turn_limit_deg = float(p('turn_limit_deg', 75.0).value)
        # D12：全部候选都在机头外时，不再"回退派发最优者"（manager 的 80° 门必拒 → 空转 5~10 s），
        # 改为本拍不派、让 RRT 重新采样；turn_hard_skip=0 可退回旧行为。
        self.turn_hard_skip = str(p('turn_hard_skip', 'true').value).lower() in ('true', '1', 'yes')
        # 收益函数 v2 开关：实测在 2026-10-23 的整轮里明显退化（两轮都出现 200+ 次物理接触、
        # 返航失败），按"出现退化先回退"的约定默认关闭；内核与离线测试保留，供后续做同种子 A/B。
        self.scoring = str(p('scoring', 'v1').value).lower()
        if str(p('scoring_v2', False).value).lower() in ('true', '1', 'yes'):
            self.scoring = 'v2'
        self.cfg3 = {
            'cone_near': float(p('cone_near_m', 0.3).value),
            'cone_far': float(p('cone_far_m', 3.0).value),
            'cone_half_deg': float(p('cone_half_deg', 60.0).value),
            'cone_cap': int(p('cone_cap', 3000).value),
            'near_radius': float(p('near_radius', 0.6).value),
            'near_gate': float(p('near_gate', 0.15).value),
            'buried_factor': float(p('buried_factor', 0.25).value),
            'w_block3': float(p('w_block3', 0.02).value),
            # 复用 v2 已声明的参数（同一节点里重复 declare 会抛
            # ParameterAlreadyDeclaredException —— smoke 自检 90 s 内就抓到了）
            'block_cap': self.cfg['block_cap'],
            'block_radius': self.cfg['block_radius'],
            'w_dist': self.cfg['w_dist'],
        }

        # ===== P13-1：派发风险评分（依据 docs/P13_基线.md 的实测数据）=====
        # 基线事实（16 轮 / 297 次派发，幻影成功已剔除）：
        #   * 派发距离中位 5.32 m（>4 m 占 79.8%、>6 m 占 35.0%）；
        #   * 取消率随距离**单调**上升：<3 m 19% → 4~6 m 60% → >6 m 81%；
        #   * 转角 / esc_dirs / comp_r2 在各桶之间**非单调**，有效样本仅 14~55。
        # 所以只对距离用"收益折现"这种强形式：
        #     p(d) = 1 / (1 + (d / risk_dist_half_m)^2)
        #     score = u_eff * p(d) - aux
        # 远处候选只有"信息量显著更大"时才胜出；其余项只当低权重次序项，
        # 权重由 A/B 决定，而不是按"看起来合理"直接配大权重。
        #
        # half 用 4.5 而不是 6.0：把基线的三个分桶点同时拟合得最好
        #   2 m→0.84（基线"还能跑完"约 0.81）
        #   5 m→0.45（基线 4~6 m 取消 60% ⇒ 0.40）
        #   9 m→0.20（基线 >6 m 取消 81% ⇒ 0.19）
        # 用 6.0 时 9 m 仍是 0.31，会出现"远处信息量 3 倍就能翻盘"——
        # 而基线里这类派发 81% 是直接取消的。
        self.risk_enabled = self._as_bool(p('risk_enabled', True).value)
        self.risk_dist_half = max(0.5, float(p('risk_dist_half_m', 4.5).value))
        # P13-3：把 pass_width / narrow_len_max / unknown_span_max 三处硬门
        # 降级为软约束（只保留 corridor_hard_m 作为几何硬下限）。
        # 依据：p13c A/B 实测 rejected_narrow 812~936 次/轮 vs published 29~33 次/轮，
        # 供给被砍到只剩 10%，merge 因此回落到未评分的 raw（47~103 条/轮）。
        self.route_gate_soft = self._as_bool(p('route_gate_soft', True).value)
        self.risk_w_soft = float(p('risk_w_soft', 900.0).value)
        self._last_path_soft = 0.0
        self.risk_eval_n = max(1, int(p('risk_eval_n', 6).value))
        self.risk_w_turn = float(p('risk_w_turn', 60.0).value)
        self.risk_w_egress = float(p('risk_w_egress', 120.0).value)
        self.risk_w_route = float(p('risk_w_route', 150.0).value)
        self.risk_w_deadend = float(p('risk_w_deadend', 100.0).value)
        self.risk_w_occ = float(p('risk_w_occ', 600.0).value)
        self.risk_esc_target = max(1, int(p('risk_esc_target_dirs', 6).value))
        # ★ 宽度目标不能取 pass_width(0.90)：path_and_width 是硬门，能通过硬门的候选
        #   必然 min_w >= 0.90，取 0.90 当目标会让本项**恒为 0**（形同虚设）。
        #   这里取 1.20 = "舒福宽度"，于是 0.90~1.20 的候选会被区分出来。
        self.risk_route_target = max(0.1, float(
            p('risk_route_target_m', 1.20).value))
        self.risk_min_comp = int(p('risk_min_comp_cells', 800).value)
        self.risk_occ_soft = float(p('risk_occ_soft', 0.30).value)
        self._last_risk_info = None

        # ===== P13-2A：把原始 RRT 目标也纳入同一套风险评分 =====
        # 基线事实：`merge.jsonl` 里 raw 转发 39~59 条/轮 ≥ validated 29~40 条/轮，
        # 即约六成候选供给**完全不经过本节点**（也完全不看距离/可脱困/净宽）。
        # 根源在车端 C++ assigner：revenue = info_gain(1 m) * 3.0 - 欧氏距离。
        # 方案 A（本实现，无需重编 C++）：订阅 /assigned_frontier_goal，
        # 在"前沿候选全部派不出去"时，用同一套风险模型从最近的 raw 样本里选最优。
        # 它只接管原有的"保底观察点/脱困目标"位置，不会覆盖正常的前沿派发。
        self.raw_score_enabled = self._as_bool(p('raw_score_enabled', True).value)
        self.raw_max_age = float(p('raw_max_age_sec', 4.0).value)
        self.raw_max_dist = float(p('raw_max_dist_m', 8.0).value)
        self.raw_starve_sec = float(p('raw_starve_sec', 6.0).value)
        self.raw_score_n = max(1, int(p('raw_score_n', 3).value))
        # ★ 2026-11-09 P13-2A 修正（A/B 实测发现）：
        #   raw 分支必须与前沿候选走**同一套硬门**，否则会把车送到更差的地方。
        #   实测（p13ab_b*，360 probe）分来源中位数：
        #     frontier: esc_dirs 8,  min_w 1.30, risk_dist 4.00
        #     raw_rrt : esc_dirs 0,  min_w 0.00, risk_dist 5.50（258 次尝试派发）
        #   根因：原实现只检查 `ok`，丢掉了 `narrow`（窄段）信号。
        #   另：raw 候选 esc_dirs 中位 0（落在死角），而加性罚分 120 压不住
        #   u*p 上千的正收益，所以另加一道“可脱困方向数”下限。
        self.raw_require_narrow_free = self._as_bool(
            p('raw_require_narrow_free', True).value)
        self.raw_min_esc = int(p('raw_min_esc_dirs', 3).value)
        self.raw_goals = []          # [(ts, x, y)]

        # ===== P13-6：判决传递（verdict propagation）=====
        # 实测事实（p13d B 组 5 轮均值）：
        #   raw_seen=165.6/轮、raw_deadend=189.8/轮、raw_publish=仅 1.6/轮，
        #   而 frontier_merge 仍把 raw 转发 35~93 条/轮。
        #   ⇒ 98.6% 的 raw 被判死胡同/窄缝/不可达，判决却从未离开本节点。
        # 机制：把每条判决发到 /frontier_verdict，由 frontier_merge 消费；
        #   merge 对"新鲜负判决"的目标不再无条件兜底（另设饿死保护）。
        self.verdict_enabled = self._as_bool(p('verdict_enabled', True).value)
        self.verdict_topic = str(p('verdict_topic', '/frontier_verdict').value)
        self.verdict_period = float(p('verdict_period_sec', 2.0).value)
        self.verdict_ttl = float(p('verdict_ttl_sec', 6.0).value)
        self.verdicts = {}           # {(qx, qy): (t, verdict, score)}
        self._t_verdict = 0.0
        # ★ 判决只在 pick_raw_goal() 里产生，而该函数在 raw_score_enabled=False
        #   时直接返回。所以 verdict_enabled=True + raw_score_enabled=False
        #   会让判决通道**静默失效**（merge 永远查不到判决 ⇒ 照旧全量兜底）。
        #   这里显式告警，避免把它误当成"判决传递无效"的结论。
        if self.verdict_enabled and not self.raw_score_enabled:
            self.get_logger().warn(
                'P13-6：verdict_enabled=True 但 raw_score_enabled=False —— '
                '判决只在 raw 评分分支里产生，此时通道不会发出任何判决，'
                'frontier_merge 将退回无条件兜底。若要单独测判决传递，'
                '请同时打开 raw_score。')

        self.map = None
        self.pose = None
        self.yaw = 0.0
        self.cands = []          # [(x, y, ts)]
        self._cand_cells = {}    # 1 m 网格 → (x, y, ts)：同格只留最新，抑制重复竞争
        # P1：未知连通分量场缓存（按 /map 序号失效，与 clearance_field 同思路）
        self._ureg_key = None
        self._ureg_field = None
        self._ureg_pts = {}      # rid -> (wx, wy) numpy 数组，惰性构建
        self._pool_tick = 0
        # P4：阶段状态机（frame=先远后近 / fill=补零散）
        self.strategy_phase = 'frame' if self.frame_far_first else 'fill'
        self._phase_t = 0.0
        self._phase_known_best = None
        self._phase_switch_known = None
        self._phase_stall = 0
        self._phase_supply_empty = 0      # 连续"无远候选"的拍数
        self._far_supply = 0              # 上一拍打分后剩下的远候选数
        self._phase_forced = False        # 本次入 fill 是被兜底判据（推不动）逼的
        self._frame_all_denied = 0        # 框架阶段连续"全灭"拍数（安全阀用）
        self._known_key = None
        self._known_n = 0
        # P5(iii)：path_and_width 最近一次算出的世界坐标路径 + 它对应的目标
        self._last_path_w = None
        self._last_path_goal = None
        # P5(iii) 修复：真正派发出去那个目标的路径（随 passing 钉住，不被后续调用覆盖）
        self._dispatch_path = None
        self._dispatch_goal = None
        self.blacklist = []      # [(x, y, expire_ts)]
        self.last_pub = 0.0
        self.last_goal = None
        self.pending = None
        self.cmd = (0.0, 0.0)
        self.mgr_busy = False
        self.stuck_zones = []     # [(x, y, expire)]
        self.contact_zones = []   # [(x, y, expire)] 物理撞过的位置
        self._stuck_ref = None    # (t, x, y)
        self.stats = {'seen': 0, 'rejected_size': 0, 'rejected_path': 0,
                      'rejected_black': 0, 'published': 0,
                      'rejected_narrow': 0, 'narrow_fallback': 0, 'narrow_blocked_all': 0,
                      'reject_noexit': 0, 'noexit_passed': 0, 'noexit_checked': 0,
                      'gate_reject': 0, 'gate_penalized': 0,
                      'reject_cost': 0, 'cost_checked': 0, 'repair_cost': 0,
                      'escape_zones': 0, 'reject_narrow_hard': 0,
                      'route_soft_pass': 0,
                      # P1/P2：未知区特征可用次数 / 候选池快照条数
                      'ureg_ok': 0, 'ureg_miss': 0, 'pool_probe': 0,
                      # P4/P5：阶段切换 / 框架准入 / 远目标准入 / 中继降级
                      'phase_to_fill': 0, 'phase_to_frame': 0,
                      'frame_depth_reject': 0, 'far_admit_reject': 0,
                      'far_relay_ok': 0, 'far_relay_miss': 0,
                      # P13-1 风险评分观测口径（只用于 A/B 归因）
                      'risk_penalized': 0, 'risk_eval': 0, 'risk_selected': 0,
                      # P13-2A 原始 RRT 候选
                      'raw_seen': 0, 'raw_publish': 0, 'raw_overdist': 0,
                      'raw_unreachable': 0, 'raw_narrow': 0, 'raw_deadend': 0,
                      # P13-6 判决传递（每条判决只在其"首次"或"翻转"时计数）
                      'verdict_pub': 0, 'verdict_dead_end': 0,
                      'verdict_too_narrow': 0, 'verdict_unreachable': 0,
                      'verdict_over_dist': 0, 'verdict_feasible': 0,
                      # P13-4a 脱困目标放宽轮触发次数
                      'escape_relaxed': 0}

        qmap = QoSProfile(depth=1, reliability=ReliabilityPolicy.RELIABLE,
                          durability=DurabilityPolicy.TRANSIENT_LOCAL)
        self.create_subscription(OccupancyGrid, '/map', self.on_map, qmap)
        self.create_subscription(PointArray, '/filtered_goal_points', self.on_cands, 10)
        # P13-2A：车端 assigner 的原始目标（此前不在本节点视野内）
        self.create_subscription(PoseStamped, '/assigned_frontier_goal',
                                 self.on_raw_goal, 10)
        self.create_subscription(Odometry, '/odom_combined', self.on_odom, 20)
        self.create_subscription(Twist, '/cmd_vel', self.on_cmd, 20)
        # S2：当前是否有 Nav2 活动目标（无目标时立刻给下一个候选）
        # 车端 manager 的状态流里带 escape/blocked/retreat 等事件
        self.create_subscription(String, '/stemm_cartographer/nav_state',
                                 self.on_nav_state, 10)
        self.create_subscription(GoalStatusArray, '/navigate_to_pose/_action/status',
                                 self.on_status, 10)
        # V2-③：planner_server 的 /plan 末位点 = 正在执行的目标
        self.create_subscription(Path, '/plan', self.on_plan, 5)
        self.pub = self.create_publisher(PoseStamped, '/validated_frontier_goal', 10)
        # P13-6：判决通道（std_msgs/String + JSON，避免新增 msg 包需重编）
        self.verdict_pub = self.create_publisher(String, self.verdict_topic, 10)
        self.costmap = None
        self.create_subscription(OccupancyGrid, '/global_costmap/costmap', self.on_costmap, qmap)
        # P0-3 的脱困监督会把"这里脱困失败"发过来，作为受阻区降权
        self.create_subscription(PoseStamped, '/escape_blocked_zone', self.on_escape_zone, 10)
        self.create_subscription(PoseStamped, '/collision_contact_zone',
                                 self.on_contact_zone, 10)
        # D3：视觉障碍也参与"净空/宽窄"判定（此前只用于代价地图）
        self.vision_grid = None
        self._vg_seq = 0
        # 2026-11-13：视觉就绪门状态
        self._vision_ready = False
        self._vision_ready_t = 0.0
        self._vision_cells = 0
        self._vision_gate_start = time.monotonic()
        self._vision_ready_timeout_logged = False
        self._map_seq = 0
        self._clear_key = None
        self._clear_field = None
        # 2026-11-14（S5-B1）：未知占比窗口均值的缓存 (key, ndarray)。
        # 只随 /map 变化，见 _path_lateral_widths 里的说明。
        self._unk_frac_cache = None
        self.create_subscription(OccupancyGrid, self.vision_grid_topic,
                                 self.on_vision_grid, qmap)
        self.create_timer(1.0, self.tick)
        self.get_logger().info(
            'frontier_arbiter 就绪：可达性预筛/黑名单/最小前沿/回拉｜scoring=%s '
            'candidate_probe=%s' % (getattr(self, 'scoring', '?'), repr(self.probe_log)))
        # P1/P2（2026-11-11）：未知区特征 + 候选池快照 的启停状态必须回显，
        # 否则"探针没落盘"会被误当成"候选池分析结果为空"。
        self.get_logger().info(
            'P1/P2：ureg_enabled=%s ureg_r=%.2fm ureg_min=%d格 '
            'max_cand=%d pool_probe_n=%d pool_probe_log=%s'
            % (self.ureg_enabled, self.ureg_radius, self.ureg_min_cells,
               self.max_cand, self.pool_probe_n, repr(self.pool_probe_log)))

    # ---- S5 M1：车体画像与阈值派生 ---------------------------------------
    def _load_robot_profile(self):
        """加载 RobotProfile。**任何失败都不许打死仲裁节点**。

        理由：仲裁节点死了整个探索会话就没有目标来源（历史事故：一个
        未声明的 `corridor_skip_far` 属性把节点当场 AttributeError 打死，
        车端表现为"路径不刷新、长时间卡住"）。所以这里只告警、返回 None，
        由 `_metric_threshold` 退回显式参数。
        """
        if not self.use_robot_profile:
            self.get_logger().warn(
                'use_robot_profile=false：通行阈值只取显式参数，profile 不参与'
                '（回退路径，需同时显式给 pass_width:=… narrow_floor:=…）')
            return None
        try:
            # install 里本脚本是**符号链接**，__file__ 指向 install。
            # 先 realpath 回 src（免重新编译即可生效），再退回 install 布局
            # （CMake 里 robot_model 也装到 lib/<pkg>，非 symlink-install 时用）。
            for d in (os.path.dirname(os.path.realpath(__file__)),
                      os.path.dirname(os.path.abspath(__file__))):
                if d and d not in sys.path:
                    sys.path.insert(0, d)
            from robot_model import load_profile
            prof = load_profile(self.robot_profile_name)
        except Exception as exc:                        # noqa: BLE001
            self.get_logger().error(
                'S5-M1：加载 robot_profile=%r 失败（%s）。'
                '通行阈值退回显式参数——请显式给 pass_width:=… narrow_floor:=…，'
                '否则本节点会拒绝启动。'
                % (self.robot_profile_name, exc))
            return None
        self.get_logger().info('S5-M1：%s（来源 %s）'
                               % (prof.describe(), prof.source))
        return prof

    def _metric_threshold(self, name, explicit):
        """米制阈值的唯一取值入口：显式参数 > profile 派生值 > 报错。

        `explicit <= 0` 表示"未指定，用 profile 派生值"。这是 S5 §2 原则 1
        （阈值不得出现在代码里）的落地方式：代码里只有 0.0 这个哨兵值，
        真正的数字来自车体几何。

        两处都拿不到值时**在启动期抛错**，而不是猜一个数——判据用错一个
        米制阈值会直接变成物理接触（P0），宁可起不来。
        """
        if explicit and explicit > 0.0:
            if self.profile is not None:
                derived = getattr(self.profile, name + '_m')
                if abs(explicit - derived) > 1e-9:
                    self.get_logger().warn(
                        'S5-M1：%s_m 显式参数 %.4f 与 profile 派生值 %.4f 不一致，'
                        '以显式参数为准（A/B/回退路径）'
                        % (name, explicit, derived))
            return float(explicit)
        if self.profile is None:
            raise RuntimeError(
                'S5-M1：%s 既没有显式参数（=%r）也没有可用 profile。'
                '请给 --ros-args -p %s_m:=<米>，或修好 robot_profile。'
                % (name, explicit, name))
        return float(getattr(self.profile, name + '_m'))

    # ---- 回调 ----
    def on_map(self, m):
        self.map = m
        self._map_seq += 1

    def on_vision_grid(self, m):
        self.vision_grid = m
        self._vg_seq += 1
        if not self._vision_ready:
            # 2026-11-13：节点刚起时会先发空栅格，必须等真正有占据格才算就绪。
            n = sum(1 for v in m.data if v >= 50) if m.data else 0
            self._vision_cells = n
            if n >= self.vision_ready_min_cells:
                self._vision_ready = True
                self._vision_ready_t = time.monotonic()
                self.get_logger().info(
                    '视觉就绪：累积障碍 %d 格（启动后 %.1f s），开始派发探索目标'
                    % (n, self._vision_ready_t - self._vision_gate_start))

    def vision_ready(self):
        """视觉是否已可用。门控关闭或视觉未启用时恒为 True（保持旧行为）。"""
        if not self.vision_ready_gate or not self.use_vision_obstacles:
            return True
        if self._vision_ready:
            return True
        now = time.monotonic()
        if now - self._vision_gate_start > self.vision_ready_timeout:
            if not self._vision_ready_timeout_logged:
                self._vision_ready_timeout_logged = True
                self.get_logger().warn(
                    '视觉 %.0f s 内未就绪（累计 %d 格 < %d），超时放行；'
                    '本轮探索将在无视觉输入下运行'
                    % (self.vision_ready_timeout, self._vision_cells,
                       self.vision_ready_min_cells))
            return True
        return False

    def on_cmd(self, m):
        self.cmd = (m.linear.x, m.angular.z)

    def on_status(self, m):
        busy = False
        uu = []
        for st in m.status_list:
            if st.status in (1, 2, 3):      # ACCEPTED / EXECUTING / CANCELING
                busy = True
                if st.status == 2:          # EXECUTING —— veto 只取消这一个
                    try:
                        uu.append(bytes(st.goal_info.goal_id.uuid))
                    except Exception:       # noqa: BLE001
                        pass
        self.mgr_busy = busy
        self._active_uuid = uu

    def on_nav_state(self, m):
        txt_raw = m.data or ''
        txt = txt_raw.lower()
        # V2-③ 阶段判定：nav_state 是车端 manager 发的 JSON（见 stemm_nav2_manager.manager）
        try:
            o = json.loads(txt_raw)
            if isinstance(o, dict):
                self._nav_payload = o
                self._nav_seen = True
        except Exception:                    # noqa: BLE001
            pass
        # 只认真正处于 escape/blocked 的动作态；排除返航与 retry_recovery 这类常态字串
        hit = ('escape_' in txt or 'blocked_' in txt or '"escape' in txt or '"blocked' in txt)
        if hit and 'return' not in txt and 'retry_recovery' not in txt:
            now = time.monotonic()
            if now - getattr(self, '_last_zone', 0.0) < 5.0:
                return
            self._last_zone = now
            if self.pose is not None:
                self.stuck_zones.append(
                    (self.pose[0], self.pose[1], time.monotonic() + self.bl_sec))
                if len(self.stuck_zones) > 15:
                    self.stuck_zones = self.stuck_zones[-15:]
                self.get_logger().warn(
                    f'受阻区记录（事件驱动 {txt[:24]}）：({self.pose[0]:.2f},{self.pose[1]:.2f})')

    def on_escape_zone(self, m):
        now = time.monotonic()
        self.stuck_zones.append((m.pose.position.x, m.pose.position.y, now + self.bl_sec))
        if len(self.stuck_zones) > 15:
            self.stuck_zones = self.stuck_zones[-15:]
        self.stats['escape_zones'] = self.stats.get('escape_zones', 0) + 1
        self.get_logger().warn(
            '脱困失败受阻区（监督节点上报）：(%.2f,%.2f)'
            % (m.pose.position.x, m.pose.position.y))

    def on_contact_zone(self, m):
        x, y = float(m.pose.position.x), float(m.pose.position.y)
        key = (round(x, 1), round(y, 1))
        n = int(self.contact_hits.get(key, 0)) + 1
        self.contact_hits[key] = n
        ttl = self.contact_zone_sec * min(6, n)     # 同一处反复撞 → 记忆更久
        self.contact_zones.append((x, y, time.monotonic() + ttl))
        if len(self.contact_zones) > 20:
            self.contact_zones = self.contact_zones[-20:]
        self.stats['contact_zones'] = self.stats.get('contact_zones', 0) + 1
        self.get_logger().warn(
            '物理接触区记录：(%.2f,%.2f) 第 %d 次（记忆 %.0fs）；统计 %s'
            % (x, y, n, ttl, self.stats))
        self._maybe_fail_on_contact(x, y)

    def _maybe_fail_on_contact(self, x, y):
        """接触即失败（默认关）：物理接触时取消正在执行的目标，别让它继续往里推。

        纪律边界：返航期不动（返航失败只记录不解决）；有冷却与每轮上限。
        """
        if not self.contact_fail_enabled:
            return
        pay = self._nav_payload or {}
        blob = (str(pay.get('mode', '')) + ' ' + str(pay.get('navigation_state', ''))).lower()
        if 'return' in blob or 'home' in blob:
            return
        now = time.monotonic()
        if now - self._cf_last < self.contact_fail_cooldown_sec:
            return
        if self._cf_count >= self.contact_fail_max:
            return
        if self._do_veto_cancel():
            self._cf_count += 1
            self._cf_last = now
            self.stats['contact_fail_cancel'] = self.stats.get('contact_fail_cancel', 0) + 1
            self.get_logger().warn(
                '物理接触 → 取消当前目标（第 %d 次）：(%.2f,%.2f）' % (self._cf_count, x, y))

    def on_costmap(self, m):
        self.costmap = m

    def reachable(self, x, y):
        """在全局代价地图上做 BFS 连通性判定（未知/致命格视为不可通行）。"""
        cm = self.costmap
        if cm is None or self.pose is None:
            return True                      # 代价地图未就绪时不阻塞
        info = cm.info
        res = info.resolution
        w, h = info.width, info.height
        ox, oy = info.origin.position.x, info.origin.position.y
        sx = int((self.pose[0] - ox) / res); sy = int((self.pose[1] - oy) / res)
        gx = int((x - ox) / res);            gy = int((y - oy) / res)
        if not (0 <= sx < w and 0 <= sy < h) or not (0 <= gx < w and 0 <= gy < h):
            return False
        data = cm.data
        if data[gy * w + gx] < 0 or data[gy * w + gx] >= 90:
            return False                     # 终点本身不可通行
        from collections import deque
        seen = bytearray(w * h)
        q = deque([(sx, sy)])
        seen[sy * w + sx] = 1
        budget = 60000
        while q and budget > 0:
            cx, cy = q.popleft(); budget -= 1
            if cx == gx and cy == gy:
                return True
            for nx, ny in ((cx+1,cy),(cx-1,cy),(cx,cy+1),(cx,cy-1)):
                if 0 <= nx < w and 0 <= ny < h:
                    idx = ny * w + nx
                    if seen[idx]:
                        continue
                    v = data[idx]
                    if v < 0 or v >= 90:     # 未知或致命/内切
                        continue
                    seen[idx] = 1
                    q.append((nx, ny))
        return False


    def _note_uniq(self, kind, x, y):
        """D5：同一 tick 里同一个候选只计一次，给出"唯一候选数"口径。"""
        seen = getattr(self, '_tick_uniq', None)
        if seen is None:
            self._tick_uniq = seen = set()
        key = (kind, round(x, 1), round(y, 1))
        if key in seen:
            return
        seen.add(key)
        k = kind + '_uniq'
        self.stats[k] = self.stats.get(k, 0) + 1

    def note_refusal(self, x, y):
        """D13：把"这个候选被拒"记到 1 m 网格区域表里。"""
        now = time.monotonic()
        key = (int(math.floor(x)), int(math.floor(y)))
        lst = self.region.setdefault(key, [])
        lst.append(now)
        if len(lst) > 40:
            del lst[:-40]
        # 顺手过期清理（限制表大小）
        if len(self.region) > 400:
            self.region = {k: v for k, v in self.region.items()
                           if v and now - v[-1] < self.region_sec}

    def region_penalty_of(self, x, y):
        now = time.monotonic()
        key = (int(math.floor(x)), int(math.floor(y)))
        lst = [t for t in self.region.get(key, []) if now - t < self.region_sec]
        if lst:
            self.region[key] = lst
        n = len(lst)
        if n == 0:
            return 0.0
        pen = min(self.region_cap, self.region_penalty * n)
        if n >= self.region_refuse_hard:
            pen += 1e4                      # 该区域反复被拒 → 等效"最后才考虑"
        return pen

    # ---- D1/D2/D3：净空场 ----
    def vision_occ_mask(self):
        """视觉障碍在 **/map 栅格坐标** 下的 bool 掩码（按视觉栅格序号缓存）。"""
        m = self.map
        vg = self.vision_grid
        if m is None or vg is None or not self.use_vision_obstacles:
            return None
        key = (self._vg_seq, self._map_seq)
        if getattr(self, '_vis_key', None) == key:
            return self._vis_mask
        import numpy as np
        info = m.info
        w, h, res = info.width, info.height, info.resolution
        ox, oy = info.origin.position.x, info.origin.position.y
        mask = np.zeros((h, w), dtype=bool)
        vr = vg.info.resolution
        if vr > 0:
            v = np.asarray(vg.data, dtype=np.int16).reshape(vg.info.height, vg.info.width)
            occ = np.argwhere(v == 100)
            if occ.size:
                vwx = vg.info.origin.position.x + (occ[:, 1] + 0.5) * vr
                vwy = vg.info.origin.position.y + (occ[:, 0] + 0.5) * vr
                ci = ((vwx - ox) / res).astype(np.int32)
                cj = ((vwy - oy) / res).astype(np.int32)
                ok = (ci >= 0) & (ci < w) & (cj >= 0) & (cj < h)
                if ok.any():
                    mask[cj[ok], ci[ok]] = True
        self._vis_key = key
        self._vis_mask = mask
        return mask

    def clearance_field(self):
        """返回 (dist_m, ox, oy, res, w, h, unknown) 或 None。

        dist_m[i,j] = 该格到最近**障碍**的距离（米）。障碍集合 = `/map` 占据(>=50)
        ∪ 视觉障碍栅格占据(==100)。用 scipy 的精确距离变换：
          * D2：不再沿轴向扫法向，斜通道不会被高估（原来 ≈1.41 倍）；
          * D3：视觉障碍（桌底座等雷达盲区）也计入；
          * D1：配合调用方"整条路径到末端都采样"，不再跳过目标附近。
        `unknown` 是 /map 的未知掩码，仅用于算"未知占比"。
        缓存按 (/map 序号, 视觉栅格序号) 失效，1 Hz tick 下每轮最多重建一次。
        """
        m = self.map
        if m is None:
            return None
        info = m.info
        res = info.resolution
        if res <= 0:
            return None
        w, h = info.width, info.height
        ox, oy = info.origin.position.x, info.origin.position.y
        key = (self._map_seq, self._vg_seq, w, h, round(res, 6), round(ox, 4), round(oy, 4),
               bool(self.width_unknown_block))
        if key == self._clear_key and self._clear_field is not None:
            return self._clear_field
        try:
            import numpy as np
            from scipy import ndimage
        except Exception:                     # noqa: BLE001 - 没装 scipy 就退回轴向扫线
            self._clear_key = None
            self._clear_field = None
            return None
        arr = np.asarray(m.data, dtype=np.int16).reshape(h, w)
        blocked = arr >= 50
        unknown = arr < 0
        if self.width_unknown_block:
            # 未知格按障碍计（P9-D）：距离场因此把"没看清"的地方也当成走不通
            blocked = blocked | unknown
        vg = self.vision_grid
        if self.use_vision_obstacles and vg is not None:
            vr = vg.info.resolution
            vox, voy = vg.info.origin.position.x, vg.info.origin.position.y
            v = np.asarray(vg.data, dtype=np.int16).reshape(vg.info.height, vg.info.width)
            occ = np.argwhere(v == 100)
            if occ.size and vr > 0:
                wx = vox + (occ[:, 1] + 0.5) * vr
                wy = voy + (occ[:, 0] + 0.5) * vr
                ci = ((wx - ox) / res).astype(np.int32)
                cj = ((wy - oy) / res).astype(np.int32)
                ok = (ci >= 0) & (ci < w) & (cj >= 0) & (cj < h)
                if ok.any():
                    blocked = blocked.copy()
                    blocked[cj[ok], ci[ok]] = True
        dist_cells = ndimage.distance_transform_edt(~blocked)
        field = (dist_cells * res, ox, oy, res, w, h, unknown)
        self._clear_key = key
        self._clear_field = field
        return field

    def region_complexity(self, field, wx, wy):
        """候选点周围 2 m 的"复杂度/可脱困性"（基于激光∪视觉的统一净空场）。

        指标（都在 probe_radius 内）：
          vis_occ_r2   视觉障碍格数量（激光看不到的那类复杂源）
          narrow_r2    净空 <0.35 m 的格数（"窄/挤"的量）
          free_r2      净空 >=0.30 m 的格数（可走动空间）
          comp_r2      与候选点连通的自由格数（BFS，封顶 4000）—— 太小=死角
          esc_dirs     8 个方向里能"走出去 >=probe_escape_clear_m"的方向数（0=四向皆堵）
        """
        import numpy as np
        dist_m, ox, oy, res, w, h, unknown = field
        ci = int((wx - ox) / res); cj = int((wy - oy) / res)
        if not (0 <= ci < w and 0 <= cj < h):
            return {}
        k = max(1, int(self.probe_radius / res))
        i0, i1 = max(0, ci - k), min(w, ci + k + 1)
        j0, j1 = max(0, cj - k), min(h, cj + k + 1)
        win = dist_m[j0:j1, i0:i1]
        narrow = int((win < self.probe_narrow_r).sum())
        free = int((win >= 0.30).sum())
        # 连通域（8 邻域，自由定义 dist>=0.30）
        free_mask = win >= 0.30
        comp = 0
        if free_mask.size:
            from collections import deque
            si, sj = ci - i0, cj - j0
            if 0 <= si < free_mask.shape[1] and 0 <= sj < free_mask.shape[0] and free_mask[sj, si]:
                seen = np.zeros_like(free_mask, dtype=bool)
                seen[sj, si] = True
                q = deque([(sj, si)]); comp = 1
                while q and comp < 4000:
                    y, x = q.popleft()
                    for dy in (-1, 0, 1):
                        for dx in (-1, 0, 1):
                            ny, nx = y + dy, x + dx
                            if 0 <= ny < free_mask.shape[0] and 0 <= nx < free_mask.shape[1] \
                                    and not seen[ny, nx] and free_mask[ny, nx]:
                                seen[ny, nx] = True; q.append((ny, nx)); comp += 1
        # 8 方向可逃逸性：沿该方向连续 probe_escape_clear_m 都保持 >=该净空
        esc = 0
        step = max(1, int(0.10 / res))
        for ang in [i * math.pi / 4.0 for i in range(8)]:
            ok = True
            for d in range(step, int(self.probe_escape_r / res) + 1, step):
                x = ci + int(round(math.cos(ang) * d)); y = cj + int(round(math.sin(ang) * d))
                if not (0 <= x < w and 0 <= y < h) or dist_m[y, x] < self.probe_narrow_r:
                    ok = False
                    break
            esc += 1 if ok else 0
        vis_occ = 0
        vmask = self.vision_occ_mask()
        if vmask is not None:
            vis_occ = int(vmask[j0:j1, i0:i1].sum())
        return {'vis_occ_r2': vis_occ, 'narrow_r2': narrow, 'free_r2': free,
                'comp_r2': comp, 'esc_dirs': esc,
                # 口径与 harness/analyze_candidates.py 完全一致：
                # occ_frac_r2 = 2m 窗口内"净空<0.30m"的格占比。
                # 之前这里没返回该键，导致 gate_adjusted_penalty 里
                # f.get('occ_frac_r2',0.0) 永远取默认 0 → 软惩罚形同虚设。
                'occ_frac_r2': (1.0 - free / float(win.size)) if win.size else 0.0}

    # ================= P13-1：派发风险评分 =================
    def risk_discount(self, dist):
        """距离折现因子 p(d) = 1/(1+(d/half)^2)。

        half=4.5 m 时：2 m→0.84、4 m→0.56、6 m→0.36、9 m→0.20、12 m→0.12。
        直接对应基线里的取消率曲线（剔除幻影后 <3 m 19% / 4~6 m 60% / >6 m 81%）
        —— 而不是为了把“不要派远的”拍成一个小罚分了事。
        """
        if not self.risk_enabled:
            return 1.0
        d = max(0.0, float(dist))
        return 1.0 / (1.0 + (d / self.risk_dist_half) ** 2)

    def risk_aux(self, gx, gy, dist=None):
        """落点侧风险（转角 / 可脱困 / 死口袋 / 拥挤）—— 附加罚分，权重刻意小。

        与 candidate_gate 的区别：gate 是硬拒（默认关，一开就 churn）；
        这里是连续罚分，只参与排序，**永不拒绝候选**。
        返回 (aux, info)；info 里带各分项，供 candidate_probe 落盘做 A/B 归因。
        """
        if not self.risk_enabled or self.pose is None:
            return 0.0, {}
        if dist is None:
            dist = math.hypot(gx - self.pose[0], gy - self.pose[1])
        aux = 0.0
        info = {'risk_dist': round(dist, 2)}
        turn = self._turn_to(gx, gy)
        aux += self.risk_w_turn * (turn / math.pi)
        info['risk_turn_deg'] = round(math.degrees(turn), 1)
        field = self.clearance_field()
        if field is None:
            info['risk_aux'] = round(aux, 1)
            return aux, info
        try:
            f = self.region_complexity(field, gx, gy)
        except Exception:                       # noqa: BLE001
            f = {}
        if f:
            esc = int(f.get('esc_dirs', 8))
            aux += (self.risk_w_egress
                    * max(0, self.risk_esc_target - esc)
                    / float(self.risk_esc_target))
            occ = float(f.get('occ_frac_r2', 0.0))
            aux += self.risk_w_occ * max(0.0, occ - self.risk_occ_soft)
            comp = int(f.get('comp_r2', 0))
            if self.risk_min_comp > 0 and comp < self.risk_min_comp:
                aux += (self.risk_w_deadend
                        * (1.0 - comp / float(self.risk_min_comp)))
            info.update({'risk_esc_dirs': esc, 'risk_comp_r2': comp,
                         'risk_occ_frac': round(occ, 3)})
        ts = self.turn_space_near(gx, gy)
        if ts is not None:
            info['risk_turn_space'] = round(ts, 3)
        info['risk_aux'] = round(aux, 1)
        return aux, info

    def risk_route(self, min_w, unk):
        """沿实际 BFS 路径的风险（窄段 / 未知占比）。

        path_and_width 目前是硬门（不过就拒），但硬门会掉供给（实测单轮
        rejected_narrow 256、rejected_path 122）。同一条路径的连续量进排序，
        可以让"略窄但确实能走"的候选排到"看起来很宽但停在最后"的前面。
        """
        if not self.risk_enabled:
            return 0.0, {}
        aux = 0.0
        info = {}
        if min_w is not None:
            short = max(0.0, self.risk_route_target - float(min_w))
            aux += self.risk_w_route * short / self.risk_route_target
            info['risk_min_w_path'] = round(float(min_w), 3)
        if unk is not None:
            aux += (self.risk_w_route * 0.5
                    * max(0.0, min(1.0, float(unk))))
            info['risk_unknown_share'] = round(float(unk), 3)
        # P13-3：硬门降级后的软门罚分（幅度足以把窄路排到宽路之后，
        # 但不会像硬门那样直接掐断供给出去）
        soft = float(getattr(self, '_last_path_soft', 0.0) or 0.0)
        if soft > 0.0:
            aux += self.risk_w_soft * min(1.0, soft)
            info['risk_soft_gate'] = round(soft, 3)
        return aux, info

    # ================= P13-6：判决传递 =================
    # 判决取值：
    #   dead_end    落点可脱困方向数 < raw_min_esc_dirs（死口袋，g 型）
    #   unreachable 落点不可达 / 落点在未知或占据格
    #   too_narrow  必须穿窄缝才能到达（min_w 记录实际净宽）
    #   over_dist   超过 raw_max_dist_m 且近期无人饿死（距离保护）
    #   feasible    通过全部判据（score = risk_total）
    # 约定：merge 侧只对**负判决**做拦截，feasible 仅用于观测与归因。
    VERDICT_NEGATIVE = ('dead_end', 'unreachable', 'too_narrow', 'over_dist')

    def _verdict_key(self, x, y):
        """0.30 m 网格量化。与 on_raw_goal 的去重半径一致，
        使\"同一条 raw 重复投递\"落在同一格，判决可直接复用。"""
        return (int(math.floor(x / 0.30)), int(math.floor(y / 0.30)))

    def _pub_verdict(self, key, x, y, verdict, score):
        """发布一条判决。

        刻意不携带时间戳：由接收方按**到达时刻**计时。
        原因：本节点用 time.monotonic()，merge 用 /clock（仿真时间），
        两者混用在 pause/reset 后会产生负年龄，导致 TTL 判定永远成立或永远失效。
        """
        try:
            m = String()
            m.data = json.dumps({'k': [key[0], key[1]],
                                 'x': round(float(x), 2),
                                 'y': round(float(y), 2),
                                 'v': verdict,
                                 's': round(float(score), 1)})
            self.verdict_pub.publish(m)
            self.stats['verdict_pub'] = self.stats.get('verdict_pub', 0) + 1
        except Exception:                      # noqa: BLE001
            pass

    def _record_verdict(self, x, y, verdict, score=0.0):
        """记录判决；同一格判决未翻转时不重复发布（避免刷屏）。"""
        if not self.verdict_enabled:
            return
        now = time.monotonic()
        key = self._verdict_key(x, y)
        prev = self.verdicts.get(key)
        self.verdicts[key] = (now, verdict, round(float(score), 1))
        self.stats['verdict_' + verdict] = self.stats.get(
            'verdict_' + verdict, 0) + 1
        if prev is not None and prev[1] == verdict:
            return                             # 判决未翻转：只在快照里重发
        self._pub_verdict(key, x, y, verdict, score)
        if len(self.verdicts) > 400:           # 容量保护
            dead = [k for k, v in self.verdicts.items()
                    if now - v[0] > self.verdict_ttl]
            for k in dead:
                self.verdicts.pop(k, None)

    def publish_verdict_snapshot(self):
        """周期性重发全表：丢包或 merge 后启动时能自愈。"""
        if not self.verdict_enabled:
            return
        now = time.monotonic()
        if now - self._t_verdict < self.verdict_period:
            return
        self._t_verdict = now
        for key, (t, v, s) in list(self.verdicts.items()):
            if now - t > self.verdict_ttl:
                self.verdicts.pop(key, None)
                continue
            # 还原到格中心，避免下游按坐标再量化时落到相邻格
            self._pub_verdict(key, key[0] * 0.30 + 0.15,
                              key[1] * 0.30 + 0.15, v, s)

    # ================= P13-2A：原始 RRT 候选评分 =================
    def on_raw_goal(self, m):
        """收下 assigner 的原始目标（以前完全不经过本节点）。

        同一坐标 0.30 m 内只保留最新一条：assigner 会每隔 ~8 s 重投同一个投影点，
        不去重的话它会占满整个候选池（历史实测）。
        """
        now = time.monotonic()
        x = float(m.pose.position.x)
        y = float(m.pose.position.y)
        self.raw_goals = [g for g in self.raw_goals
                          if math.hypot(g[1] - x, g[2] - y) > 0.30]
        self.raw_goals.append((now, x, y))
        if len(self.raw_goals) > 40:
            del self.raw_goals[:-40]
        self.stats['raw_seen'] = self.stats.get('raw_seen', 0) + 1

    def pick_raw_goal(self, now):
        """在前沿候选全部派不出去时，从最近的 raw 样本里选风险最低的一条。

        评分与前沿候选共用同一模型：u * p(dist) - aux(落点) - route(沿路)。
        返回 (gx, gy, min_w, unknown, info) 或 None。

        刻意不抢正常派发：只在 `_tick_v1` 的 passing/fallback 都为空之后才调用，
        所以不会把已经合格的前沿候选挤掉。
        """
        if not self.raw_score_enabled or self.pose is None:
            return None
        self.raw_goals = [g for g in self.raw_goals
                          if now - g[0] <= self.raw_max_age]
        if not self.raw_goals:
            return None
        scored = []
        for _t, rx, ry in self.raw_goals:
            gx, gy = self.pull_back(rx, ry)
            if self.failfast_blocked(gx, gy, now):
                continue
            d = math.hypot(gx - self.pose[0], gy - self.pose[1])
            u = self.unknown_cells(gx, gy)
            if self.blacklisted(gx, gy, now):
                u -= 250
            p = self.risk_discount(d)
            aux, info = self.risk_aux(gx, gy, dist=d)
            # P13-6：判决必须打在**原始坐标** (rx,ry) 上，不能打在回拉后的
            # (gx,gy) 上 —— merge 看到的是 assigner 原始点，用回拉点做键永远匹配不上。
            scored.append((u * p - aux, gx, gy, d, u, p, aux, info, rx, ry))
        if not scored:
            return None
        scored.sort(key=lambda q: q[0], reverse=True)
        best = None
        over_best = None     # 超距候选（只在饿死时允许派发）
        # ===== E1 实测修正（2026-11-10）=====
        # 原实现只给**唯一的胜者**发 feasible，其余候选全被判负。
        # 实测后果（p13e1_b3）：dead_end 186 + too_narrow 50 = 236 条负判决，
        # 而 verdict_feasible 仅 3 条 ⇒ merge 拿不到任何被批准的兜底目标，
        # 契约退化成"纯黑名单"，merge_raw 51→22（-57%），
        # manager 候选池 84→54，覆盖面反而变小（E1 见 docs §12）。
        #
        # 正确语义：判决描述的是**该候选自身可不可信**，不是"它是不是本拍胜者"。
        # 所以每个通过全部硬门的候选都发 feasible（带自己的 risk_total），
        # 让 merge 有一个"已被批准"的池子可回退，而不是只剩否决。
        #
        # 评估范围也从 top-`raw_score_n`(默认 3) 放开到全部候选：
        # 只评 3 个时，一旦这 3 个都落在死角，整拍就没有任何 feasible 产出，
        # 而 merge 侧却可能持有 20+ 条 raw 待判。硬门本身（esc/可达/窄缝）
        # 已由下面的分支把关，放开范围不会放过坏目标。
        for sc, gx, gy, d, u, p, aux, info, rx, ry in scored:
            # 可脱困下限：esc_dirs 太少 = 死口袋，任何收益都不值得（与 gate 同口径）
            esc = int(info.get('risk_esc_dirs', 8))
            if esc < self.raw_min_esc:
                self.stats['raw_deadend'] = self.stats.get('raw_deadend', 0) + 1
                self._record_verdict(rx, ry, 'dead_end', esc)
                continue
            ok, narrow, min_w, unk = self.path_and_width(gx, gy)
            if not ok:
                self.stats['raw_unreachable'] = self.stats.get('raw_unreachable', 0) + 1
                self._record_verdict(rx, ry, 'unreachable', d)
                continue
            # ★ 与前沿候选同一套硬门：需要穿窄缝才能到 → 不派
            if narrow is not None and self.raw_require_narrow_free:
                self.stats['raw_narrow'] = self.stats.get('raw_narrow', 0) + 1
                self._record_verdict(rx, ry, 'too_narrow',
                                     min_w if min_w is not None else 0.0)
                continue
            route, rinfo = self.risk_route(min_w, unk)
            row = dict(info)
            row.update(rinfo)
            row['risk_dist'] = round(d, 2)
            row['risk_route'] = round(route, 1)
            row['risk_discount_loss'] = round(u * (1.0 - p), 1)
            row['risk_total'] = round(
                aux + route + float(row['risk_discount_loss']), 1)
            row['risk_source'] = 'raw_rrt'
            row['risk_reachable'] = True
            row['unknown'] = u
            cand = (sc - route, gx, gy, min_w, u, row, d, rx, ry)
            if d > self.raw_max_dist:
                # 超距候选：不进 feasible 池（merge 不该随手转发 12~16 m 外的目标），
                # 但**保留**为 over_best —— 饿死时才允许用它（见下面的超距保护）。
                # ★ 不能在这里 `continue` 掉：那样 best 永远为 None，
                #   超距保护与饿死绕过两段逻辑都成了死代码。
                if over_best is None or cand[0] > over_best[0]:
                    over_best = cand
                continue
            # ★ 通过全部硬门且不超距 → 立刻发 feasible，让 merge 有这个兜底选项。
            #   这是 E1 修正的核心：feasible 描述"该候选可信"，不是"它是胜者"。
            self._record_verdict(rx, ry, 'feasible', row['risk_total'])
            if best is None or (sc - route) > best[0]:
                best = cand
        # 没有合规候选但有超距候选：交给超距保护决定
        if best is None and over_best is not None:
            _s, gx, gy, min_w, u, row, d, rx, ry = over_best
            if (now - self.last_pub) < self.raw_starve_sec:
                self.stats['raw_overdist'] = self.stats.get('raw_overdist', 0) + 1
                self._record_verdict(rx, ry, 'over_dist', d)
                return None
            # 饿死中：放行超距目标，并补发 feasible 让 merge 也认可它
            self._record_verdict(rx, ry, 'feasible', row['risk_total'])
            return gx, gy, min_w, u, row
        if best is None:
            return None
        _f, gx, gy, min_w, u, row, d, rx, ry = best
        # feasible 已在候选循环里逐个发过，这里不再重发。
        return gx, gy, min_w, u, row

    def pick_safe_observation(self, cands):
        """V2-②：从候选里挑一个"开阔、连通、离车不远"的观察点（作为保底目标）。

        与闸门相反：闸门是"排除坏点"，这里是"在坏点之外找一个还能站的点"。
        找不到就返回 None（宁可不派，也不派危险点）。
        """
        if not self.fallback_enabled or self.pose is None:
            return None
        if self._fb_count >= self.fallback_max_total:
            return None
        now = time.monotonic()
        field = self.clearance_field()
        if field is None:
            return None
        # 末段窗口里放宽门槛与冷却：宁可派个"还算开阔"的点，也不要让车在
        # 探索结束那一刻处于"无目标 + 停在贴障位置"的状态（返航会被车端拒绝）。
        min_esc = self.fallback_min_esc
        max_dist = self.fallback_max_dist
        cooldown = self.fallback_cooldown
        if self.in_tail_window():
            min_esc = min(min_esc, max(3, self.tail_min_esc - 1))
            max_dist = max(max_dist, 2.5)
            cooldown = min(cooldown, 4.0)
        if now - self._fb_last < cooldown:
            return None
        best, best_score = None, -1e9
        for (x, y) in cands[:max(8, self.max_cand * 2)]:
            gx, gy = self.pull_back(x, y)
            dist = math.hypot(gx - self.pose[0], gy - self.pose[1])
            if dist > max_dist or dist < 0.8:
                continue
            try:
                f = self.region_complexity(field, gx, gy)
            except Exception:                      # noqa: BLE001
                continue
            if not f:
                continue
            if f['esc_dirs'] < min_esc or f['comp_r2'] < self.fallback_min_comp:
                continue
            # 开阔优先 + 近一点：esc_dirs 高、距离近、窄格占比低。
            # 注意 region_complexity 返回的是 narrow_r2/free_r2（绝对格数），
            # 直接拿绝对格数当占比会把大面积开阔区误判成"挤"，所以先换算成占比。
            tot = f['narrow_r2'] + f['free_r2'] + 1
            narrow_frac = f['narrow_r2'] / tot
            sc = (f['esc_dirs'] * 10 - dist * 3 - narrow_frac * 20
                  - f['vis_occ_r2'] * 0.05)
            if sc > best_score:
                best_score, best = sc, (gx, gy)
        if best is None:
            return None
        self._fb_last = now
        self._fb_count += 1
        return best

    # ===== V2-③ 后置 veto ====================================================
    @staticmethod
    def _as_bool(v):
        if isinstance(v, bool):
            return v
        return str(v).strip().lower() in ('true', '1', 'yes', 'on')

    def _explore_phase(self):
        """现在是不是"探索期"（决定 veto 能不能动）。

        保守到宁可不动作：没收到过 nav_state 就一律 false —— 车端状态流断了的时候
        我们无从判断是不是已经在返航，此时去 cancel 就可能重演"自己人掐掉返航目标"。
        """
        if not self._nav_seen or self._nav_payload is None:
            return False
        p = self._nav_payload
        try:
            if p.get('mapping_done') is True:
                return False
            if p.get('pending_home_goal'):          # 已有返航目标在路上
                return False
            if int(p.get('return_home_retry_count') or 0) > 0:
                return False
        except Exception:                           # noqa: BLE001
            return False
        return True

    def plan_width_profile(self, poses):
        """沿 nav2 规划出的 /plan 逐点查净宽。

        返回 (min_w, 最长窄段 m, 未知占比最大值, 最窄点序号, 最窄点世界坐标, 点数,
        起点净宽)。2026-10-27 增补后四项：用户报"地图上有红障碍、路径却横穿"，需要区分
        **起点就在障碍里**（车贴着障碍的假象）与**中途真的穿过障碍**（真 bug）。
        """
        field = self.clearance_field()
        if field is None or not poses:
            return None
        res, ox_, oy_, fw_, fh_ = field[3], field[1], field[2], field[4], field[5]
        step = max(1, int(round(0.05 / res)))
        min_w = 9.9
        min_i = -1
        min_xy = None
        first_w = None
        oob = 0
        narrow_len = narrow_max = 0.0
        unk_max = 0.0
        for i, ps in enumerate(poses):
            if i % step:
                continue
            px_, py_ = float(ps.pose.position.x), float(ps.pose.position.y)
            # 2026-10-27：**地图范围外必须跳过**。clearance_at 对越界点返回 0.0（保守设计），
            # 而规划的目标常常指向尚未建图的 frontier —— 越界点会被当成"净宽 0 的穿障"，
            # 把"往未知区规划"误报成"横穿障碍"（实测 v8ar1 的 5 条最差计划全属此类）。
            ci = (px_ - ox_) / res
            cj = (py_ - oy_) / res
            if not (0 <= ci < fw_ and 0 <= cj < fh_):
                oob += 1
                continue
            d, unk = self.clearance_at(field, px_, py_)
            wd = 2.0 * d
            if first_w is None:
                first_w = wd
            if wd < min_w:
                min_w = wd
                min_i = i
                min_xy = (px_, py_)
            if wd < self.pass_width:
                narrow_len += 0.05
                narrow_max = max(narrow_max, narrow_len)
            else:
                narrow_len = 0.0
            if unk > 0.5:
                unk_max = max(unk_max, unk)
        return (min_w, narrow_max, unk_max, min_i, min_xy, len(poses),
                -1.0 if first_w is None else first_w, oob)

    def on_plan(self, m):
        """V2-③：拿 /plan 的末位点当"正在执行的目标"，命中硬闸门就取消。

        只处理"不是本节点派的"目标 —— 自己派的点在派发时已经过闸门，
        再 veto 一次等于自己打自己，还会把派发节奏搞乱。
        例外：P9-⑥ 的 plan_guard 对所有计划（含自己派的）做窄处体检。
        """
        if not m.poses:
            return
        # 供 veto 迁移的 rollback 档使用：保留最近一条计划的位姿序列
        try:
            self._last_plan = [(p.pose.position.x, p.pose.position.y) for p in m.poses]
        except Exception:                       # noqa: BLE001
            pass
        if self.plan_guard_log or self.plan_guard_veto:
            prof = self.plan_width_profile(m.poses)
            if prof is not None:
                (min_w, narrow_run, unk_share, min_i, min_xy, n_pts,
                 first_w, oob) = prof
                key = (round(min_w, 2), len(m.poses))
                if key != self._pg_logged_plan:
                    self._pg_logged_plan = key
                    self.stats['plan_min_w'] = round(min_w, 2)
                    self.stats['plan_narrow_run'] = round(narrow_run, 2)
                    bad = (narrow_run > self.narrow_len_max) or (unk_share > 0.5)
                    if bad:
                        self.stats['plan_narrow_plans'] = self.stats.get('plan_narrow_plans', 0) + 1
                    xy = ('%.2f,%.2f' % min_xy) if min_xy else '?'
                    self.get_logger().info(
                        '计划窄处体检：/plan %d 点，最小净宽 %.2f m@#%d(%s)，起点净宽 %.2f m，'
                        '最长窄段 %.2f m，越界(未建图)点 %d 个'
                        '（pass_width=%.2f / narrow_len_max=%.2f）→ %s'
                        % (n_pts, min_w, min_i, xy, first_w, narrow_run, oob,
                           self.pass_width, self.narrow_len_max,
                           '穿窄处' if bad else 'OK'))
                    if bad and (self.plan_guard_veto or self.corridor_block_enabled):
                        if min_xy is not None:
                            self._corridor_add(min_xy[0], min_xy[1], min_w)
                    if bad and self.plan_guard_veto \
                            and self._pg_cancels < self.plan_guard_max_cancel:
                        self._pg_cancels += 1
                        self.stats['plan_veto'] = self.stats.get('plan_veto', 0) + 1
                        self.get_logger().warn(
                            '✗ 计划穿窄处（最窄 %.2f m、窄段 %.2f m）→ 取消该目标；第 %d 次'
                            % (min_w, narrow_run, self._pg_cancels))
                        self._do_veto_cancel()
                        return
        # P9-CORR 机制4：**所有来源**的 /plan 都先查走廊（含车端 RRT 派发的目标），
        # 不必等逐点体检；命中就取消，并对同一走廊做 2 s 限速，避免与 manager 拉锯。
        if self.corridor_block_enabled and self.corridors and self._explore_phase():
            pts = [m.poses[0].pose.position, m.poses[-1].pose.position]
            hit = None
            for pp in pts:
                hit = self._corridor_hit(float(pp.x), float(pp.y))
                if hit is not None:
                    break
            if hit is not None:
                now_c = time.monotonic()
                if now_c - self._corr_last >= self._corr_veto_min_gap \
                        and self._pg_cancels < self.plan_guard_max_cancel + 6:
                    if self._do_veto_cancel():
                        self._corr_last = now_c
                        self._pg_cancels += 1
                        self.stats['corridor_veto'] = self.stats.get('corridor_veto', 0) + 1
                        self.get_logger().warn(
                            '✗ 目标落在已知不可通行走廊内（净宽 %.2f m @(%.2f,%.2f)）→ 取消'
                            % (hit['w'], hit['x'], hit['y']))
                        return
        if not self.veto_enabled:
            return
        try:
            pos = m.poses[-1].pose.position
            gx, gy = float(pos.x), float(pos.y)
        except Exception:                       # noqa: BLE001
            return
        self.veto_probe(gx, gy, tag='plan')

    # ---------------- P9-CORR：走廊级记忆（本轮内存） ----------------
    def _corridor_add(self, x, y, w):
        """把"穿窄处"的窄点记成不可通行走廊；同一处重复命中则延长失效时间。"""
        if not self.corridor_block_enabled:
            return
        now = time.monotonic()
        for c in self.corridors:
            if math.hypot(x - c['x'], y - c['y']) <= 0.6:
                c['hits'] = int(c.get('hits', 1)) + 1
                c['w'] = min(float(c.get('w', w)), float(w))
                ttl = min(self.corridor_ttl_max_sec, self.corridor_ttl_sec * c['hits'])
                c['exp'] = now + ttl
                self.get_logger().warn(
                    '走廊记忆更新：(%.2f,%.2f) 净宽 %.2f m，第 %d 次，记忆 %.0fs'
                    % (c['x'], c['y'], c['w'], c['hits'], ttl))
                return
        self.corridors.append({'x': x, 'y': y, 'r': self.corridor_radius_m,
                               'w': float(w), 'hits': 1,
                               'exp': now + self.corridor_ttl_sec})
        if len(self.corridors) > 30:
            self.corridors = self.corridors[-30:]
        self.get_logger().warn(
            '走廊记忆新增：(%.2f,%.2f) 净宽 %.2f m（本轮内存，%0.f s）'
            % (x, y, w, self.corridor_ttl_sec))

    def _corridor_prune(self):
        if not self.corridors:
            return
        now = time.monotonic()
        keep = [c for c in self.corridors if c['exp'] > now]
        if len(keep) != len(self.corridors):
            self.corridors = keep
            self.stats['corridors_active'] = len(keep)

    def _corridor_hit(self, x, y):
        """点是否落在某条"不可通行走廊"里（本轮内存、带 TTL）。"""
        if not self.corridor_block_enabled or not self.corridors:
            return None
        now = time.monotonic()
        for c in self.corridors:
            if c['exp'] <= now:
                continue
            if math.hypot(x - c['x'], y - c['y']) <= max(c['r'], 0.3):
                return c
        return None

    def _corridor_blocked_path(self, path, res, ox, oy, w):
        """BFS 路径是否穿过任一条走廊（每隔 4 个点采样）。"""
        if not self.corridor_block_enabled or not self.corridors:
            return None
        for i in range(0, len(path), 4):
            idx = path[i]
            wx = (idx % w) * res + ox
            wy = (idx // w) * res + oy
            c = self._corridor_hit(wx, wy)
            if c is not None:
                return (wx, wy, c)
        return None

    def _area_stats(self, x, y, radius):
        """(radius) 圆内：未知格数、已知空闲占"已知格"的比例（用于候选打分口径）。"""
        m = self.map
        if m is None:
            return None, None
        info = m.info
        res = info.resolution
        if res <= 0:
            return None, None
        n = max(1, int(radius / res))
        ci = int((x - info.origin.position.x) / res)
        cj = int((y - info.origin.position.y) / res)
        unk = free = occ = 0
        for dj in range(-n, n + 1):
            j = cj + dj
            if not (0 <= j < info.height):
                continue
            base = j * info.width
            for di in range(-n, n + 1):
                if di * di + dj * dj > n * n:
                    continue
                i = ci + di
                if not (0 <= i < info.width):
                    continue
                v = m.data[base + i]
                if v < 0 or v == 205:
                    unk += 1
                elif v == 0:
                    occ += 1
                else:
                    free += 1
        known = free + occ
        # 返回（未知格数, 已知格占比）。注意不要返回"已知里的空闲占比"——
        # 一片全新的区域里 free/(free+occ) 也会是 1.0，会把它误判成"已探明"。
        frac = round(known / float(known + unk), 3) if (known + unk) else None
        return unk, frac

    def _turn_to(self, x, y):
        """车头朝向量与"车→候选"方向的夹角（0..π）。位姿不可用时返回 0。"""
        if self.pose is None or len(self.pose) < 3:
            return 0.0
        dx, dy = x - self.pose[0], y - self.pose[1]
        if abs(dx) < 1e-9 and abs(dy) < 1e-9:
            return 0.0
        want = math.atan2(dy, dx)
        d = abs(math.atan2(math.sin(want - self.pose[2]),
                           math.cos(want - self.pose[2])))
        return min(d, math.pi)

    def near_first_reorder(self, top, band=None):
        """近处可执行优先（2026-10-27 用户要求 2）。

        top 里若有"距车 <= near_first_r"的候选，则把它们提到最前面（按距离升序），
        其余保持原打分顺序。依据：车就在旁边却干等 30 s，比掉头 4~7 s 贵得多。
        """
        if not self.near_first or self.pose is None or not top:
            return top
        b = self.near_first_band if band is None else band
        best = top[0][0] if isinstance(top[0][0], (int, float)) else None
        floor = (best * (1.0 - b)) if (best is not None and best > 0) else None
        near, far = [], []
        for item in top:
            x, y = item[2], item[3]
            d = math.hypot(x - self.pose[0], y - self.pose[1])
            ok_band = (floor is None) or (item[0] >= floor)
            (near if (d <= self.near_first_r and ok_band) else far).append((d, item))
        if not near:
            return top
        near.sort(key=lambda t: t[0])
        self.stats['near_first_pick'] = self.stats.get('near_first_pick', 0) + 1
        return [it for _, it in near] + [it for _, it in far]

    def _veto_ok(self, x, y):
        """后置否决判据的反面：该点是否**合格**（用于迁移目标）。"""
        field = self.clearance_field()
        if field is None:
            return False
        try:
            f = self.region_complexity(field, x, y)
        except Exception:                       # noqa: BLE001
            return False
        if not f:
            return False
        if f['esc_dirs'] < self.veto_min_esc:
            return False
        if f['occ_frac_r2'] >= self.veto_occ_max:
            return False
        if self.costmap is not None and self.cost_gate_reject(x, y, None, count=False):
            return False
        if self.pose is not None and math.hypot(x - self.pose[0], y - self.pose[1]) < self.veto_migrate_min_move:
            return False
        return True

    def _veto_migrate_point(self, gx, gy, mode):
        """找一个合格的迁移落点；找不到返回 None。mode: relay / random / rollback。"""
        if mode == 'relay':
            # P5(iii)：沿原目标已算出的路径取中继点（框架阶段优先）
            return self.relay_point(gx, gy)
        if mode == 'rollback':
            plan = getattr(self, '_last_plan', None) or []
            for (px, py) in reversed(plan):
                if self._veto_ok(px, py):
                    return px, py
            return None
        best = None
        for _ in range(max(1, self.veto_migrate_samples)):
            ang = random.uniform(0.0, 2.0 * math.pi)
            rad = self.veto_migrate_r * math.sqrt(random.random())
            nx, ny = gx + rad * math.cos(ang), gy + rad * math.sin(ang)
            if not self._veto_ok(nx, ny):
                continue
            d = math.hypot(nx - gx, ny - gy)
            if best is None or d < best[0]:
                best = (d, nx, ny)
        return (best[1], best[2]) if best else None

    def _inplace_ok(self, x, y, gx, gy):
        """inplace 专用合格判据（与 migrate 解耦）。

        * 离车不小于 inplace_min_robot（默认 0.5 m）——太近的点控制器没法收敛
        * 与原目标不小于 inplace_min_goal（默认 0.2 m）——否则等于没改
        * 落点代价门（cost_gate_reject：致命/内切/盘内占据）
        * 区域复杂度（region_complexity：逃逸方向与 2 m 邻域占用率）仍必须过关
        """
        if self.pose is None:
            return False
        if math.hypot(x - self.pose[0], y - self.pose[1]) < self.inplace_min_robot:
            return False
        if math.hypot(x - gx, y - gy) < self.inplace_min_goal:
            return False
        if self.costmap is not None and self.cost_gate_reject(x, y, None, count=False):
            return False
        # ★ v2：要求 G* 的区域质量**显著优于**触发阈值（触发是 occ≥0.30 / esc<3），
        #   否则纠偏只是把目标挪到同样拥挤处（实测 58% 位移≤0.5 m ⇒ 停滞 +35%）。
        field = self.clearance_field()
        if field is not None:
            try:
                f = self.region_complexity(field, x, y)
            except Exception:                               # noqa: BLE001
                return False
            if not f:
                return False
            if f['occ_frac_r2'] >= self.inplace_max_occ:
                return False
            if f['esc_dirs'] < self.inplace_min_esc:
                return False
        return True

    def _nearest_valid_point(self, gx, gy, radius):
        """确定性搜索「离原目标最近的合格自由点 G*」——由内向外按半径推进。

        ★ 2026-11-04 实测修正：初版按 res(0.05 m) 逐圈采样、且 `tried` 只数"过了
        _inplace_ok 的候选"，放宽判据后**内圈候选就把 inplace_tries 预算用光**，
        结果反而一个点都找不到（ab3 组 5 轮仅 1 次纠偏）。现改为：
          * 半径步长 0.25 m（而不是 res），角向按弧长 ~0.35 m 采样；
          * 预算 inplace_tries 只数**真正做了 path_and_width 的候选**；
          * 仍由内向外，第一个合格点即返回（语义=最近）。
        """
        if self.costmap is None:
            return None
        tries = 0
        r = max(0.20, float(self.inplace_min_goal))
        r_max = max(r, float(radius))
        while r <= r_max + 1e-9:
            n = max(8, int(2.0 * math.pi * r / 0.35))
            for k in range(n):
                ang = 2.0 * math.pi * k / n
                nx, ny = gx + r * math.cos(ang), gy + r * math.sin(ang)
                if not self._inplace_ok(nx, ny, gx, gy):
                    continue
                tries += 1
                if tries > max(1, self.inplace_tries):
                    return None
                try:
                    reach, _narrow_at, min_w, _unk = self.path_and_width(nx, ny)
                except Exception:                            # noqa: BLE001
                    continue
                if not reach:
                    continue
                if (self.inplace_min_width > 0.0 and min_w is not None
                        and min_w < self.inplace_min_width):
                    continue
                return nx, ny
            r += 0.25
        return None

    def _publish_goal_update(self, x, y, reason, gx, gy, now):
        """把 G* 推给 nav2 BT（/goal_update）；成功返回 True（调用方因此**不取消**目标）。"""
        if self.pub_goal_update is None:
            return False
        # S4（2026-11-11）：/goal_update 没有订阅者时返回 False，让调用方退回
        # migrate（取消重派）。否则一旦 BT 没挂回 GoalUpdater，本模式会"看起来
        # 成功但不改向" —— 目标继续跑向旧点，比取消还糟（静默失效）。
        try:
            if self.pub_goal_update.get_subscription_count() == 0:
                if not self._gu_warned:
                    self._gu_warned = True
                    self.get_logger().warn(
                        '/goal_update 无订阅者（BT 未挂 GoalUpdater）→ veto_inplace '
                        '自动退回 veto_migrate（取消重派）')
                return False
        except Exception:                     # noqa: BLE001 - 旧版 rclpy 无此方法
            pass
        if self.stats.get('veto_inplace', 0) >= self.inplace_max:
            return False
        if now - self._inplace_last < self.inplace_cooldown:
            return False
        if (self._inplace_prev is not None
                and math.hypot(x - self._inplace_prev[0], y - self._inplace_prev[1])
                < self.inplace_min_disp):
            return False
        msg = PoseStamped()
        msg.header.frame_id = self.frame
        msg.header.stamp = self.get_clock().now().to_msg()   # GoalUpdater 只接受更新的 stamp
        msg.pose.position.x, msg.pose.position.y = float(x), float(y)
        yaw = float(getattr(self, 'yaw', 0.0) or 0.0)
        msg.pose.orientation.z = math.sin(yaw / 2.0)
        msg.pose.orientation.w = math.cos(yaw / 2.0)
        self.pub_goal_update.publish(msg)
        self._inplace_last = now
        self._inplace_prev = (x, y)
        self.stats['veto_inplace'] = self.stats.get('veto_inplace', 0) + 1
        dist = math.hypot(x - gx, y - gy)
        try:
            self.pub_correction.publish(String(data=json.dumps({
                't': round(time.time(), 2), 'reason': reason,
                'from': [round(gx, 2), round(gy, 2)], 'to': [round(x, 2), round(y, 2)],
                'dist': round(dist, 2),
                'n': self.stats.get('veto_inplace', 0)})))
        except Exception:                                   # noqa: BLE001
            pass
        return True

    def veto_probe(self, gx, gy, tag=''):
        """对一个外部目标做后置否决判定（拆出来便于离线自测）。"""
        if not self.veto_enabled or self.pose is None:
            return None
        if not self._explore_phase():
            return None
        now = time.monotonic()
        # 1) 自己派的点：最近 veto_self_sec 内、距离 < veto_self_r
        for hx, hy, ts in reversed(self.pub_history[-25:]):
            if now - ts <= self.veto_self_sec and math.hypot(gx - hx, gy - hy) < self.veto_self_r:
                return None
        # 2) 原点近旁（返航终点/原地观察）不碰
        if math.hypot(gx, gy) < self.veto_home_guard:
            return None
        # 3) 额度与冷却
        if self._veto_count >= self.veto_max:
            return None
        if now - self._veto_last < self.veto_cooldown:
            return None
        # 4) 同一目标 20 s 内不重复 veto（否则会跟 manager 拉锯）
        pv = self._veto_prev
        if pv is not None and now - pv[2] < 20.0 and math.hypot(gx - pv[0], gy - pv[1]) < 0.50:
            return None
        field = self.clearance_field()
        if field is None:
            return None
        try:
            f = self.region_complexity(field, gx, gy)
        except Exception:                       # noqa: BLE001
            return None
        if not f:
            return None
        why = []
        if f['esc_dirs'] < self.veto_min_esc:
            why.append('esc_dirs=%d<%d' % (f['esc_dirs'], self.veto_min_esc))
        if f['occ_frac_r2'] >= self.veto_occ_max:
            why.append('occ=%.2f>=%.2f' % (f['occ_frac_r2'], self.veto_occ_max))
        if not why:
            return None
        reason = ','.join(why)
        # ---- P12：原地纠偏（不取消目标）优先 ----
        if self.veto_inplace and self.pose is not None and \
                math.hypot(gx - self.pose[0], gy - self.pose[1]) < self.inplace_only_beyond:
            # 已接近目标：不再中途改向（实测会显著抬高停滞），沿用既有兜底
            if not self.inplace_fallback_cancel:
                return reason
        elif self.veto_inplace:
            rep0 = self._nearest_valid_point(gx, gy, self.inplace_radius)
            if rep0 is not None and self._publish_goal_update(
                    rep0[0], rep0[1], reason, gx, gy, now):
                self._veto_last = now
                self._veto_prev = (gx, gy, now)
                self._veto_count += 1
                self.stats['veto_inplace_ok'] = self.stats.get('veto_inplace_ok', 0) + 1
                self.get_logger().warn(
                    'V2-③ 后置纠偏（inplace 原地改目标，**不取消**，%s）'
                    '(%.2f,%.2f) → (%.2f,%.2f) 距离 %.2f m；本轮第 %d/%d 次'
                    % (reason, gx, gy, rep0[0], rep0[1],
                       math.hypot(rep0[0] - gx, rep0[1] - gy),
                       self.stats['veto_inplace_ok'], self.inplace_max))
                return reason
            if not self.inplace_fallback_cancel:
                self.get_logger().info(
                    'V2-③ 后置纠偏未找到合格点（或超限/冷却），按配置不回落取消：%s (%.2f,%.2f)'
                    % (reason, gx, gy))
                return reason

        # ---- 迁移优先：把落点换成一个合格点继续走，而不是停车 ----
        if self.veto_migrate:
            modes = [self.veto_migrate_mode] + [m for m in ('random', 'rollback')
                                                if m != self.veto_migrate_mode]
            # P5(iii)：框架阶段的远目标优先用"路径中继点"—— 实测 >6 m 目标
            # 取消率 69% 且失败在途中，把目标缩到 4 m 处再接续比随机挪 2 m 更靠谱。
            if (self.far_relay_on and self._frame_mode()
                    and math.hypot(gx - self.pose[0], gy - self.pose[1])
                    > self.far_admit_dist):
                modes.insert(0, 'relay')
            for mode in modes:
                rep = self._veto_migrate_point(gx, gy, mode)
                if rep is None:
                    continue
                if not self._do_veto_cancel():
                    continue                      # 取消不掉就别改投（否则两个目标打架）
                self._veto_last = now
                self._veto_prev = (gx, gy, now)
                self._veto_count += 1
                self.stats['veto_migrate'] = self.stats.get('veto_migrate', 0) + 1
                self.stats['veto_migrate_' + mode] = \
                    self.stats.get('veto_migrate_' + mode, 0) + 1
                self.publish_goal(rep[0], rep[1], None)
                self.get_logger().warn(
                    'V2-③ 后置迁移（%s，%s）(%.2f,%.2f) → (%.2f,%.2f) 距离 %.2f m；'
                    '本轮第 %d/%d 次'
                    % (mode, reason, gx, gy, rep[0], rep[1],
                       math.hypot(rep[0] - gx, rep[1] - gy),
                       self._veto_count, self.veto_max))
                return reason
        ok = self._do_veto_cancel()
        self._veto_last = now
        self._veto_prev = (gx, gy, now)
        if ok:
            self._veto_count += 1
            self.stats['veto'] = self.stats.get('veto', 0) + 1
            self._veto_detail.append((round(now, 2), round(gx, 2), round(gy, 2), reason))
            self.get_logger().warn(
                'V2-③ 后置否决：外部目标 (%.2f,%.2f) 命中硬闸门 %s（%s）→ 已取消；'
                '本轮第 %d/%d 次' % (gx, gy, reason, tag, self._veto_count, self.veto_max))
        else:
            self.get_logger().warn(
                'V2-③ 后置否决判定命中 %s @(%.2f,%.2f)，但取消失败（无活跃目标或服务未就绪）'
                % (reason, gx, gy))
        return reason if ok else None

    def _do_veto_cancel(self):
        """只取消当前 EXECUTING 的那一个 goal_id（绝不用 cancel-all）。"""
        if not self._active_uuid:
            return False
        try:
            from action_msgs.srv import CancelGoal
            from action_msgs.msg import GoalInfo
            from unique_identifier_msgs.msg import UUID
        except Exception:                       # noqa: BLE001
            return False
        cli = getattr(self, 'cancel_cli', None)
        if cli is None:
            try:
                cli = self.cancel_cli = self.create_client(
                    CancelGoal, '/navigate_to_pose/_action/cancel_goal')
            except Exception:                   # noqa: BLE001
                return False
        if not cli.service_is_ready():
            return False
        req = CancelGoal.Request()
        gi = GoalInfo()
        uid = UUID()
        uid.uuid = list(self._active_uuid[0])
        gi.goal_id = uid
        req.goal_info = gi
        try:
            cli.call_async(req)
            return True
        except Exception:                       # noqa: BLE001
            return False

    def turn_space_near(self, gx, gy):
        """目标附近**最大可掉头净空**（= 2×到最近障碍的距离，单位 m）。

        "可达但不可返回"的物理含义：差速车开进一条比自身对角线还窄的通道后，
        既转不过身、又不允许长距离倒车（我们只批了 0.15 m 小步），于是**出不来**。
        车体对角线 sqrt(0.47² + 0.66²) ≈ 0.81 m，所以这里要找一个
        "直径 ≥ return_turn_width" 的空地。
        """
        field = self.clearance_field()
        if field is None:
            return None
        dist_m, ox, oy, res, w, h, _unknown = field
        ci = int((gx - ox) / res); cj = int((gy - oy) / res)
        if not (0 <= ci < w and 0 <= cj < h):
            return None
        k = max(1, int(self.return_scan_radius / res))
        i0, i1 = max(0, ci - k), min(w, ci + k + 1)
        j0, j1 = max(0, cj - k), min(h, cj + k + 1)
        win = dist_m[j0:j1, i0:i1]
        if not win.size:
            return None
        return 2.0 * float(win.max())

    def return_infeasible(self, gx, gy):
        """返回 (是否"进得去出不来", 掉头空间)。"""
        if not self.return_check:
            return False, None
        turn = self.turn_space_near(gx, gy)
        if turn is None:
            return False, None
        return (turn < self.return_turn_width), turn

    def pick_escape_goal(self):
        """所有前沿候选都派不出去时，挑一个"先把车挪出去"的本地目标。

        只在**车周围 escape_max_dist 内的自由格**里找。分两轮（P13-4a）：

        严格轮（跟历史行为一致）：
          * 当前能到（costmap BFS，与前沿用同一套通行规则，但路径短得多）；
          * 路径完全无窄段；
          * 落点附近掉头空间 >= return_turn_width；
          * 连通自由格数 >= escape_min_comp。
        放宽轮（仅严格轮全空时，escape_allow_narrow 控制）：
          * 允许路径存在窄段，但最小净宽仍须 >= corridor_hard_m、未知占比 <= corridor_unknown_max；
          * 掉头空间门槛降到 escape_turn_relax_m（默认 0.70，仍 > 车体对角线的一半）；
          * 连通区不再硬过滤，只参与打分。

        依据：v2 五轮 giveup_40s 8 次、unit_start 0 次，长卡死（148/149/146 s）
        均伴随“前沿全灭 → 脱困目标”反复返回 None。
        宁可不派也不乱派：两轮都找不到才返回 None。
        """
        if not self.escape_goal_enabled or self.pose is None:
            return None
        if self._esc_count >= self.escape_max_total:
            return None
        now = time.monotonic()
        if now - self._esc_last < self.escape_cooldown:
            return None
        field = self.clearance_field()
        if field is None:
            return None
        dist_m, ox, oy, res, w, h, _unknown = field

        def scan(relaxed):
            """在车周环上采样合格落点。relaxed=False 为严格轮。"""
            turn_need = self.return_turn_width
            if relaxed and self.escape_relax_turn:
                turn_need = min(self.return_turn_width, self.escape_turn_relax)
            best, best_score = None, -1e9
            r = 0.5
            while r <= self.escape_max_dist + 1e-6:
                for k in range(16):
                    ang = 2.0 * math.pi * k / 16.0
                    gx = self.pose[0] + math.cos(ang) * r
                    gy = self.pose[1] + math.sin(ang) * r
                    ci = int((gx - ox) / res); cj = int((gy - oy) / res)
                    if not (0 <= ci < w and 0 <= cj < h):
                        continue
                    d_here = float(dist_m[cj, ci])
                    if 2.0 * d_here < self.escape_min_clearance:
                        continue
                    # P9-⑤(b)：脱困目标必须**转得动身**（差速车对角线 0.81 m）。
                    if self.escape_need_turn:
                        turn = self.turn_space_near(gx, gy)
                        if turn is not None and turn < turn_need:
                            continue
                    ok, narrow, min_w, unk = self.path_and_width(gx, gy)
                    if not ok:
                        continue
                    if narrow is not None:
                        # 严格轮：窄段一律不派；
                        # 放宽轮：只放行"真的够宽、而且宽度不是靠未知格撑出来"的。
                        # S3（2026-11-11）：门槛改 narrow_floor（物理过不去），
                        # 而不是 corridor_hard（"够宽裕"）—— 脱困本来就是应急，
                        # 用宽裕门槛会把自己的脱困出口也堵死。
                        if not (relaxed and self.escape_allow_narrow):
                            continue
                        if min_w is None or min_w < self.narrow_floor:
                            continue
                        if unk is not None and unk > self.corridor_unknown_max:
                            continue
                    # 连通区：严格轮当硬判据（历史行为），放宽轮只参与打分 ——
                    # 橼死处本来就常常是一个小连通区，再拿它硬筛等于没放宽。
                    comp = 9999
                    if self.escape_min_comp > 0 or relaxed:
                        try:
                            f = self.region_complexity(field, gx, gy)
                        except Exception:               # noqa: BLE001
                            f = {}
                        comp = int((f or {}).get('comp_r2', 0))
                    if (not relaxed and self.escape_min_comp > 0
                            and comp < self.escape_min_comp):
                        continue
                    # 净空大 + 连通区大 + 距离近
                    sc = (2.0 * d_here - 0.6 * r
                          + 0.5 * min(comp, 2000) / 1000.0)
                    if sc > best_score:
                        best_score, best = sc, (gx, gy, d_here, r, relaxed)
                r += 0.25
            return best

        best = scan(False)
        if best is None and self.escape_allow_narrow:
            self.stats['escape_relaxed'] = self.stats.get('escape_relaxed', 0) + 1
            best = scan(True)
            if best is not None:
                self.get_logger().warn(
                    '脱困目标严格轮全空 → 启用放宽轮（允许窄段，净宽>=%.2f、未知<=%.0f%%、'
                    '掉头>=%.2f m）' % (self.corridor_hard,
                                      100 * self.corridor_unknown_max,
                                      self.escape_turn_relax))
        if best is None:
            return None
        self._esc_last = now
        self._esc_count += 1
        self.stats['escape_goal'] = self.stats.get('escape_goal', 0) + 1
        self.get_logger().warn(
            '前沿全部派不出去 → 派脱困目标 (%.2f,%.2f)（净空 %.2f m、距车 %.2f m%s）；第 %d 次'
            % (best[0], best[1], best[2], best[3],
               '、放宽轮' if best[4] else '', self._esc_count))
        return (best[0], best[1])

    def candidate_gate(self, gx, gy):
        """候选闸门 V1：返回 (reject_reason 或 None, features 或 None)。

        只防"落点本身是死口袋/过挤"这一类（约占可治理卡死的多数）；
        落点开阔但整片复杂、manager 自派、返航卡死不在本层范围。
        """
        if not self.gate_enabled:
            return None, None
        field = self.clearance_field()
        if field is None:
            return None, None
        try:
            f = self.region_complexity(field, gx, gy)
        except Exception:                       # noqa: BLE001
            return None, None
        if not f:
            return None, None
        if f['esc_dirs'] < self.gate_esc_min:
            return 'esc_dirs=%d<%d' % (f['esc_dirs'], self.gate_esc_min), f
        if f['comp_r2'] < self.gate_comp_min:
            return 'comp_r2=%d<%d' % (f['comp_r2'], self.gate_comp_min), f
        return None, f

    def in_tail_window(self):
        """是否处在"探索末段"窗口（决定要不要偏置停车友好）。"""
        if not self.tail_park_enabled or self.explore_sec <= 0.0:
            return False
        if self._first_pub_t is None:
            return False
        remain = self.explore_sec - (time.monotonic() - self._first_pub_t)
        return 0.0 <= remain <= self.tail_sec

    def tail_penalty(self, gx, gy, f=None):
        """末段偏置：不够开阔的候选加罚（不硬拒，避免把自己饿死）。"""
        if not self.in_tail_window():
            return 0.0
        if f is None:
            field = self.clearance_field()
            if field is None:
                return 0.0
            try:
                f = self.region_complexity(field, gx, gy)
            except Exception:                   # noqa: BLE001
                return 0.0
        if not f:
            return 0.0
        if (f.get('esc_dirs', 0) >= self.tail_min_esc
                and f.get('occ_frac_r2', 1.0) < self.gate_occ_soft):
            return 0.0
        return self.tail_penalty_value

    def gate_adjusted_penalty(self, f):
        """occ 复杂度 → 罚分（不硬拒，避免误杀 esc_dirs 高的安全点）。"""
        if not f:
            return 0.0
        pen = 0.0
        if f.get('occ_frac_r2', 0.0) >= self.gate_occ_soft:
            pen += self.gate_occ_penalty
        esc = int(f.get('esc_dirs', 8))
        w = self.gate_esc_weights[3] if esc == 0 else (
            self.gate_esc_weights[2] if esc <= 2 else (
                self.gate_esc_weights[1] if esc <= 4 else self.gate_esc_weights[0]))
        # 把"可脱困性"折算成收益折扣：等价于扣掉 (1-w) 比例的未知收益
        return pen + (1.0 - w) * 400.0

    def write_timeline(self, extra=None):
        """每拍落一行时间线（若配置了 timeline_log）。"""
        if not self.timeline_log:
            return
        try:
            now_wall = time.time()
            if now_wall - self._tl_last_wall < 0.9:      # 限 1 Hz
                return
            self._tl_last_wall = now_wall
            if self._tl_fh is None:
                os.makedirs(os.path.dirname(self.timeline_log) or '.', exist_ok=True)
                self._tl_fh = open(self.timeline_log, 'a', encoding='utf-8')
            sim_t = None
            try:
                sim_t = self.get_clock().now().nanoseconds / 1e9
            except Exception:                            # noqa: BLE001
                pass
            _pay = self._nav_payload or {}
            _mp = _pay.get('pose') or {}
            row = {
                't': round(now_wall, 3), 'sim': None if sim_t is None else round(sim_t, 3),
                'x': None if self.pose is None else round(self.pose[0], 3),
                'y': None if self.pose is None else round(self.pose[1], 3),
                'yaw': None if getattr(self, 'yaw', None) is None else round(self.yaw, 3),
                # 2026-10-27：x/y 是 **odom 帧**（来自 /odom_combined），而目标/计划/map 都是 map 帧。
                # 出生点不在原点时两者差一个固定偏移，事后按 x/y 筛点位会筛空（踩过一次）。
                # 这里直接从车端 nav_state 的 pose（map 帧）再记一份，归因一律用 mx/my。
                'mx': (round(float(_mp['x']), 3) if _mp.get('x') is not None else None),
                'my': (round(float(_mp['y']), 3) if _mp.get('y') is not None else None),
                'cmd': [None if self.cmd is None else round(self.cmd[0], 3),
                        None if self.cmd is None else round(self.cmd[1], 3)],
                'busy': bool(getattr(self, 'mgr_busy', False)),
                'n_cands': len(getattr(self, 'cands', []) or []),
                'mode': (self._nav_payload or {}).get('mode') if getattr(self, '_nav_payload', None) else None,
                'nav': (self._nav_payload or {}).get('navigation_state') if getattr(self, '_nav_payload', None) else None,
                'front': (self._nav_payload or {}).get('front_min_range') if getattr(self, '_nav_payload', None) else None,
                'last_goal': None if self.last_goal is None else [round(self.last_goal[0], 3), round(self.last_goal[1], 3)],
                'published': self.stats.get('published', 0),
                'veto': self.stats.get('veto', 0),
                # S4（2026-11-11）：区分「原地改向（不取消）」与「取消重派」。
                # inplace_ok 走 /goal_update + GoalUpdater，不打断 NavigateToPose；
                # migrate 走 cancel + 重派。两者此消彼长才是 S4 生效的直接证据。
                'veto_inplace': self.stats.get('veto_inplace_ok', 0),
                'veto_migrate': self.stats.get('veto_migrate', 0),
                'escape_goal': self.stats.get('escape_goal', 0),
                'fallback_obs': self.stats.get('fallback_obs', 0),
                'rejected_narrow': self.stats.get('rejected_narrow', 0),
                'rejected_oneway': self.stats.get('rejected_oneway', 0),
                # P9-A 观测：A 打开后必须能看到"救回多少供给 / 否决多少不可退出"
                'contact_fail_cancel': self.stats.get('contact_fail_cancel', 0),
                'corridor_veto': self.stats.get('corridor_veto', 0),
                'reject_corridor': self.stats.get('reject_corridor', 0),
                'corridors_active': len(self.corridors),
                'reject_noexit': self.stats.get('reject_noexit', 0),
                'reject_narrow_hard': self.stats.get('reject_narrow_hard', 0),
                'pass_narrow_soft': self.stats.get('pass_narrow_soft', 0),
                'path_min_w': getattr(self, '_last_path_min_w', None),
                'route_soft_pass': self.stats.get('route_soft_pass', 0),
                'noexit_passed': self.stats.get('noexit_passed', 0),
                'noexit_checked': self.stats.get('noexit_checked', 0),
                'pinch_len_max': self.stats.get('pinch_len_max', 0.0),
                'reject_cost': self.stats.get('reject_cost', 0),
                'cost_checked': self.stats.get('cost_checked', 0),
                'repair_cost': self.stats.get('repair_cost', 0),
                # P13-1：风险评分可观测性
                'risk_penalized': self.stats.get('risk_penalized', 0),
                'risk_eval': self.stats.get('risk_eval', 0),
                'risk_selected': self.stats.get('risk_selected', 0),
                # P13-2A：原始 RRT 候选评分
                'raw_seen': self.stats.get('raw_seen', 0),
                'raw_publish': self.stats.get('raw_publish', 0),
                'raw_overdist': self.stats.get('raw_overdist', 0),
                'raw_unreachable': self.stats.get('raw_unreachable', 0),
                'raw_narrow': self.stats.get('raw_narrow', 0),
                'raw_deadend': self.stats.get('raw_deadend', 0),
                # P13-6 判决传递
                'verdict_pub': self.stats.get('verdict_pub', 0),
                'verdict_dead_end': self.stats.get('verdict_dead_end', 0),
                'verdict_too_narrow': self.stats.get('verdict_too_narrow', 0),
                'verdict_unreachable': self.stats.get('verdict_unreachable', 0),
                'verdict_over_dist': self.stats.get('verdict_over_dist', 0),
                'verdict_feasible': self.stats.get('verdict_feasible', 0),
                # P13-4a 脱困目标放宽轮
                'escape_relaxed': self.stats.get('escape_relaxed', 0),
                # 2026-11-14（S5 Step 0）性能观测：上一拍的耗时口径 / 本拍耗时。
                # tick_ms_prev 是**上一拍**的实测值（滞后 ≤ 1 s，见 __init__ 注释）：
                #   tick() 开头就调 write_timeline()，本拍还不能知道自己的耗时。
                # tick_paw_prev 是上一拍 path_and_width（BFS 路径 + 测宽）调用次数，
                # 上限 = max_candidates（默认 12） + 若干重试，是性能热点的直接画像。
                'tick_ms_prev': (None if self._tick_ms_prev is None
                                 else round(self._tick_ms_prev, 2)),
                'tick_paw_prev': int(self._tick_paw_prev),
                'tick_ms_max': round(self._tick_ms_max, 2),
                'tick_ms_avg': (round(self._tick_ms_sum / self._tick_ms_n, 2)
                                if self._tick_ms_n else None),
                'tick_n': int(self._tick_ms_n),
                'tick_over_budget': int(self._tick_ms_over_budget),
                # 2026-11-14（S5-B1）：未知占比滤波缓存的命中/重建次数。
                # 判据：builds 应 ≈ (轮数 × /map 更新次数)，而 reuse ≈ 调用总数，
                # 若 builds 与 paw 调用数同量级，说明缓存没生效。
                'unk_frac_builds': int(self.stats.get('unk_frac_builds', 0)),
                'unk_frac_reuse': int(self.stats.get('unk_frac_reuse', 0)),
            }
            if extra:
                row.update(extra)
            self._tl_fh.write(json.dumps(row) + '\n')
            self._tl_fh.flush()
            self._tl_n += 1
        except Exception as exc:                          # noqa: BLE001
            try:
                self.get_logger().warn(f'timeline 写入失败（忽略）：{type(exc).__name__}: {exc}')
                self.timeline_log = ''
            except Exception:                             # noqa: BLE001
                pass

    def probe_candidate(self, gx, gy, r, min_w, unk):
        """把"本次派发的候选"的完整特征写一行 JSONL（离线统计用）。"""
        if not self.probe_log:
            return None
        try:
            field = self.clearance_field()
            cx = self.region_complexity(field, gx, gy) if field is not None else {}
        except Exception as exc:                       # noqa: BLE001
            cx = {'error': f'{type(exc).__name__}: {exc}'}
            self.get_logger().warn(f'候选探针失败（忽略）：{cx["error"]}')
        # 2026-10-28：补"打分质量"字段（用户要求给候选打分单独一套验收指标）
        try:
            _u2, _k2 = self._area_stats(gx, gy, 2.0)
        except Exception:                       # noqa: BLE001
            _u2 = _k2 = None
        row = {'t': round(time.time(), 3), 'goal': [round(gx, 3), round(gy, 3)],
               'robot': [round(self.pose[0], 3), round(self.pose[1], 3)] if self.pose else None,
               'min_w': None if min_w is None else round(float(min_w), 3),
               'unknown': None if unk is None else unk,
               # 2 m 半径内的未知格数 / 已知空闲占比：派发时的"区域新度"
               'unk_2m': _u2, 'free_frac_2m': _k2,
               'turn_deg': round(math.degrees(self._turn_to(gx, gy)), 1),
               'dispatch_idx': self.stats.get('published', 0) + 1,
               'dist_to_robot': (round(math.hypot(gx - self.pose[0], gy - self.pose[1]), 2)
                                 if self.pose else None),
               'ahead': (r or {}).get('ahead'), 'near_ratio': (r or {}).get('near_ratio'),
               'block': (r or {}).get('block'), 'penalty': (r or {}).get('penalty'),
               'score': (r or {}).get('score')}
        # P13-1：把本次派发的风险分项一并落盘，供 harness/analyze_dispatch_risk.py 做 A/B
        ri = getattr(self, '_last_risk_info', None) or {}
        self._last_risk_info = None
        for _k, _v in ri.items():
            if _k not in row:
                row[_k] = _v
        row.update(cx or {})
        try:
            os.makedirs(os.path.dirname(self.probe_log) or '.', exist_ok=True)
            with open(self.probe_log, 'a', encoding='utf-8') as f:
                f.write(json.dumps(row, ensure_ascii=False) + '\n')
        except Exception:                              # noqa: BLE001
            pass
        return row

    def clearance_at(self, field, wx, wy):
        """世界坐标 → (到最近障碍距离 m, 未知占比 0..1)；窗口按 0.5 m 统计未知占比。"""
        dist_m, ox, oy, res, w, h, unknown = field
        import numpy as np
        ci = int((wx - ox) / res)
        cj = int((wy - oy) / res)
        if not (0 <= ci < w and 0 <= cj < h):
            return 0.0, 1.0
        d = float(dist_m[cj, ci])
        r = max(1, int(0.5 / res))
        lo_i, hi_i = max(0, ci - r), min(w, ci + r + 1)
        lo_j, hi_j = max(0, cj - r), min(h, cj + r + 1)
        win = unknown[lo_j:hi_j, lo_i:hi_i]
        tot = int(win.size) or 1
        return d, float(int(win.sum()) / tot)

    def _noexit_verdict(self, wlist, step_m):
        """A 层：沿途 pinch 的"可退出性"判定（docs/P9 §15 重定义后的语义）。

        wlist: [(宽度, 世界x, 世界y), ...] 与路径同序，索引 0 = 车这一侧。
        返回 None = 所有 pinch 区都能退出（放行，恢复供给）；否则返回 (wx, wy) =
        第一个"进得去出不来"的 pinch 区中点（调用方据此否决并计 reject_noexit）。

        判据（任一成立即该区放行）：
          ① 穿透跨度 <= noexit_short_m（只擦车角）；
          ② 掉头空间：区内存在**连续** noexit_turn_hold_m 的 w >= noexit_turn_m
             （车对角线 0.81 m；只认连续段，避免一格测量毛刺被当成凹室）；
          ③ 回退空间：区起点向车一侧 noexit_retreat_m 窗口内，w >= pinch_m 的连续段
             长度 >= noexit_retreat_need_m（能沿原路退出来）。
        相邻子缝之间如果只隔很短（< noexit_turn_m 的路径长度），合并成一个区一起判 ——
        否则"缝-凹室-缝"会被拆成两段各自判死，而这恰恰是能掉头退出的形状。
        """
        pinch = self.noexit_pinch_m
        short = self.noexit_short_m
        turn = self.noexit_turn_m
        step = max(step_m, 1e-6)
        back_n = max(1, int(round(self.noexit_retreat_m / step)))
        need_n = max(2, int(round(self.noexit_retreat_need_m / step)))
        turn_n = max(2, int(round(getattr(self, 'noexit_turn_hold_m', 0.30) / step)))
        merge_gap_n = max(1, int(round(turn / step)))
        n = len(wlist)
        # ---- 1) 提取子缝 ----
        segs = []
        i = 0
        while i < n:
            if wlist[i][0] >= pinch:
                i += 1
                continue
            j = i
            while j + 1 < n and wlist[j + 1][0] < pinch:
                j += 1
            segs.append([i, j])
            i = j + 1
        # ---- 2) 合并挨得近的子缝（缝-凹室-缝）----
        zones = []
        for a, b in segs:
            if zones and a - zones[-1][1] <= merge_gap_n:
                zones[-1][1] = b
            else:
                zones.append([a, b])
        # ---- 3) 逐个区判可退出性 ----
        for a, b in zones:
            span = (b - a + 1) * step
            if span <= short:
                continue                                  # ① 只擦车角
            run = best_turn = 0
            for k in range(a, b + 1):
                if wlist[k][0] >= turn:
                    run += 1
                    best_turn = max(best_turn, run)
                else:
                    run = 0
            if best_turn >= turn_n:
                continue                                  # ② 区内能掉头
            run = best_ret = 0
            for k in range(max(0, a - back_n), a):
                if wlist[k][0] >= pinch:
                    run += 1
                    best_ret = max(best_ret, run)
                else:
                    run = 0
            if best_ret >= need_n:
                continue                                  # ③ 能沿原路退出
            self.stats['pinch_len_max'] = round(
                max(self.stats.get('pinch_len_max', 0.0), span), 2)
            m = (a + b) // 2
            return (wlist[m][1], wlist[m][2])
        return None

    def _path_lateral_widths(self, field, path, idxs, res, ox, oy, w, h):
        """S2：沿路径每点取"垂直于路径方向、两侧到障碍距离之和"。

        旧实现用 `width = 2×到最近障碍距离`，只在"两侧对称"时成立。而**前沿点
        永远站在已知/未知的交界线上**，典型形状是
            [已知墙] ←0.45 m→ [候选] ←开阔未知 4 m→
        此时最近障碍距离 d=0.45 ⇒ width=0.90 ⇒ 被 corridor_hard(0.92) 判死，
        而物理上另一侧有 4 m。代码注释里原本写着"未知格按半宽计"，但距离场
        分支实际上把未知当自由（不算障碍），于是只剩单侧测距。

        关键性质：2d 是总宽的**下界**（最近障碍必然只出现在某一侧），所以
        改为两侧实测求和后，宽度只会**变大或相等**，不会变小 —— 不引入新的
        不安全，只去掉对前沿点的系统性低估。最后仍与 2d 取 max 作为保险。

        返回 (widths, unknowns, wxs, wys) 四个与 idxs 等长的 list；
        缺少 numpy/scipy 或场分辨率不匹配时返回 None（调用方退回旧行为）。
        """
        try:
            import numpy as np
            from scipy import ndimage
        except Exception:                     # noqa: BLE001 - 没装就退回标量实现
            return None
        dist_m, fox, foy, fres, fw, fh, unknown = field
        P = len(idxs)
        if P == 0:
            return None
        if abs(fres - res) > 1e-9 or abs(fox - ox) > 1e-6 or abs(foy - oy) > 1e-6:
            return None                       # 索引会错位，不做
        wxs = np.empty(P, dtype=np.float64)
        wys = np.empty(P, dtype=np.float64)
        for t, i in enumerate(idxs):
            idx = path[i]
            wxs[t] = (idx % w) * res + ox
            wys[t] = (idx // w) * res + oy
        # 切向 = 相邻点差分；末点沿前一段方向
        if P >= 2:
            tx = np.empty(P)
            ty = np.empty(P)
            tx[:-1] = np.diff(wxs)
            ty[:-1] = np.diff(wys)
            tx[-1] = tx[-2]
            ty[-1] = ty[-2]
        else:
            tx = np.ones(P)
            ty = np.zeros(P)
        nrm = np.hypot(tx, ty)
        nrm[nrm < 1e-9] = 1.0
        npx = -ty / nrm                        # 单位法向
        npy = tx / nrm
        # 侧向采样范围：只需覆盖到 corridor_hard 的对侧就够判断；上限 2 m 防病态
        span = float(min(max(self.corridor_hard, 0.30), 2.0))
        K = max(1, int(round(span / res)))
        ks = np.arange(1, K + 1, dtype=np.float64)[:, None]      # (K,1)
        ci0 = (wxs - fox) / fres
        cj0 = (wys - foy) / fres
        thr = 0.5 * fres                       # 到障碍 < 半格 ⇒ 视为已撞

        def reach(sign):
            ci = ci0[None, :] + sign * ks * npx[None, :]
            cj = cj0[None, :] + sign * ks * npy[None, :]
            ii = np.clip(np.rint(ci).astype(np.int32), 0, fw - 1)
            jj = np.clip(np.rint(cj).astype(np.int32), 0, fh - 1)
            hit = dist_m[jj, ii] < thr                    # (K,P)
            any_hit = hit.any(axis=0)
            first = np.argmax(hit, axis=0).astype(np.float64)
            first = np.where(any_hit, first, float(K))    # 未撞到 = 截断（保守）
            return first * res

        d_plus = reach(+1.0)
        d_minus = reach(-1.0)
        ii0 = np.clip(np.rint(ci0).astype(np.int32), 0, fw - 1)
        jj0 = np.clip(np.rint(cj0).astype(np.int32), 0, fh - 1)
        lower = 2.0 * dist_m[jj0, ii0]            # 旧实现值 = 理论下界
        widths = np.maximum(d_plus + d_minus, lower)
        # 未知占比：整张未知图做一次窗口均值再查表（与 clearance_at 同口径，0.5 m 窗）
        #
        # ★ 2026-11-14（S5 Step 0 性能优化 B1）：这里原来**每次调用**都对整张
        # 未知掩码重做一次 uniform_filter。实测代价：单次 path_and_width
        # P50 = 30 ms，而一拍最多调 189 次 ⇒ tick P95 达 467~827 ms，
        # 195 拍里 120 拍超过 S5 §5-B 的 80 ms 上限。
        # 关键事实：`unknown` 只随 /map 变化，而 /map 已由 `clearance_field()`
        # 按 (_map_seq, _vg_seq, ...) 缓存。所以这个滤波结果在同一张图上是
        # **纯常量**，重复算毫无意义。
        # 缓存键与 clearance_field 保持一致；不改变任何数值结果（同一个
        # 输入数组、同一组参数、同一个 mode），因此决策逐位不变。
        r = max(1, int(0.5 / fres))
        ckey = (id(unknown), fres, r, fw, fh,
                int(getattr(self, '_map_seq', -1)),
                int(getattr(self, '_vg_seq', -1)))
        cached = getattr(self, '_unk_frac_cache', None)
        if cached is not None and cached[0] == ckey:
            unk_frac = cached[1]
        else:
            unk_frac = ndimage.uniform_filter(
                unknown.astype(np.float64), size=2 * r + 1, mode='nearest')
            self._unk_frac_cache = (ckey, unk_frac)
            self.stats['unk_frac_builds'] = (
                self.stats.get('unk_frac_builds', 0) + 1)
        self.stats['unk_frac_reuse'] = self.stats.get('unk_frac_reuse', 0) + 1
        unks = unk_frac[jj0, ii0]
        return (widths.tolist(), unks.tolist(), wxs.tolist(), wys.tolist())

    def path_and_width(self, x, y):
        """BFS 出整条路径，再沿路径查"垂直于路径的连续自由宽度"。

        返回 (reachable, narrow_at, min_width, unknown_share)。
        narrow_at 为走廊宽度不足处坐标；min_width 为路径实测最小净宽（未知格按半宽计），
        unknown_share 为该处的未知占比（用来判断"看着宽其实是没探到"）。
        判据：路径上任一点，垂直方向上连续自由格（<90 且已知）的总长必须 >= corridor_width，
        以免把目标派到"必须挤过窄缝"的地方 —— 这正是反复楔死的来源。
        """
        # S5 Step 0：纯计数，供 tick 耗时归因（BFS 路径+测宽是本节点的性能热点）
        self._tick_paw_calls = getattr(self, '_tick_paw_calls', 0) + 1
        # P13-3：每次调用先清零，防止上一次路径的软门罚分泄漏到本次
        self._last_path_soft = 0.0
        cm = self.costmap
        if cm is None or self.pose is None:
            return True, None, None, 0.0
        info = cm.info
        res = info.resolution
        if res <= 0:
            return True, None, None, 0.0
        w, h = info.width, info.height
        ox, oy = info.origin.position.x, info.origin.position.y
        data = cm.data
        sx = int((self.pose[0] - ox) / res)
        sy = int((self.pose[1] - oy) / res)
        gx = int((x - ox) / res)
        gy = int((y - oy) / res)
        if not (0 <= sx < w and 0 <= sy < h) or not (0 <= gx < w and 0 <= gy < h):
            return False, None, None, 0.0
        if data[gy * w + gx] < 0 or data[gy * w + gx] >= 90:
            return False, None, None, 0.0
        # P9-⑦：allow_unknown:false 时，落点必须落在**已知自由**的 /map 格里
        # （nav2 不会再"跨未知区"到目标；落点在未知里必然规划失败）
        if self.unknown_block and self.map is not None:
            occ = self.map
            ores2 = occ.info.resolution
            oox2, ooy2 = occ.info.origin.position.x, occ.info.origin.position.y
            mi = int((x - oox2) / ores2)
            mj = int((y - ooy2) / ores2)
            if not (0 <= mi < occ.info.width and 0 <= mj < occ.info.height):
                return False, None, None, 0.0
            mv = occ.data[mj * occ.info.width + mi]
            if mv < 0 or mv >= 50:
                return False, None, None, 0.0
        from collections import deque
        parent = {}
        seen = bytearray(w * h)
        start = sy * w + sx
        seen[start] = 1
        q = deque([(sx, sy)])
        budget = max(80000, w * h * 2)     # D11：预算随地图面积走，避免远处目标被误判不可达
        found = False
        while q and budget > 0:
            cx, cy = q.popleft(); budget -= 1
            if cx == gx and cy == gy:
                found = True
                break
            for nx, ny in ((cx + 1, cy), (cx - 1, cy), (cx, cy + 1), (cx, cy - 1)):
                if 0 <= nx < w and 0 <= ny < h:
                    idx = ny * w + nx
                    if seen[idx]:
                        continue
                    v = data[idx]
                    if v < 0 or v >= 90:
                        continue
                    seen[idx] = 1
                    parent[idx] = cy * w + cx
                    q.append((nx, ny))
        if not found:
            return False, None, None, 0.0
        if not self.corridor_check:
            return True, None, None, 0.0
        # 回溯路径
        path = []
        cur = gy * w + gx
        while cur != start:
            path.append(cur)
            cur = parent.get(cur)
            if cur is None:
                break
        path.reverse()
        # P5(iii)（2026-11-11）：把这条路径转成世界坐标存一份，供"中继降级"取点。
        # 必须带上目标坐标：每拍最多会调 max_cand 次 path_and_width，只有与
        # 被否决目标坐标一致的那条路径才是它对的那条。
        try:
            self._last_path_w = [
                (ox + ((ci % w) + 0.5) * res, oy + ((ci // w) + 0.5) * res)
                for ci in path]
            self._last_path_goal = (round(x, 2), round(y, 2))
        except Exception:                      # noqa: BLE001
            self._last_path_w = None
            self._last_path_goal = None
        # 宽度判据换到 /map（占据栅格：>=50 才是障碍，-1 未知按可通行算）。
        # 用 costmap 会踩膨胀层的坑：值 <90 的格已经是"离障碍 >=0.52 m"，
        # 直接按净宽读会把 1.05 m 的通道误判成窄缝。
        occ = self.map
        if occ is None:
            return True, None, None, 0.0
        ores = occ.info.resolution
        ow, oh = occ.info.width, occ.info.height
        oox, ooy = occ.info.origin.position.x, occ.info.origin.position.y
        odata = occ.data

        def map_val(mx, my):
            if mx < 0 or my < 0 or mx >= ow or my >= oh:
                return 100
            return odata[my * ow + mx]

        # P9-CORR：路径穿过已知"不可通行走廊" → 直接否决（机制2 的消费端）
        self._corridor_prune()
        if self.corridor_block_enabled and self.corridors:
            blk = self._corridor_blocked_path(path, res, ox, oy, w)
            if blk is not None:
                self.stats['reject_corridor'] = self.stats.get('reject_corridor', 0) + 1
                self._note_uniq('reject_corridor', blk[0], blk[1])
                self._last_path_reject = 'corridor'
                return True, (blk[0], blk[1]), None, 0.0
        # ---- D1/D2/D3：优先用"到最近障碍的距离场"（含视觉障碍，且整条路径到末端都查）----
        field = self.clearance_field() if self.clearance_mode == 'distance' else None
        if field is not None:
            # 逐格扫描（不再 stride 跳点：跳点会漏掉只有一两格宽的"勉强能过"的坎）
            idxs = list(range(len(path)))
            if len(idxs) > 4000:               # 极端长路径上限保护
                idxs = idxs[:2000] + idxs[-2000:]
            min_w = float('inf')
            min_unk = 0.0
            min_at = None
            narrow_len = 0.0
            narrow_len_max_run = 0.0
            unknown_run = 0.0
            unknown_run_max = 0.0
            step_m = res
            wlist = []          # A 层用：与路径同序的 (宽度, 世界x, 世界y)
            # ===== S2（2026-11-11）：宽度改为"沿法向两侧实测求和" =====
            # 旧值 width = 2×到最近障碍距离，只在两侧对称时成立；前沿点永远站在
            # 已知/未知交界上，典型形状是 [已知墙]←0.45m→[候选]←开阔未知→
            # 此时旧值 0.90 < corridor_hard 0.92 就被判死，而右侧实际有 4 m。
            # 新值 = d_左 + d_右，且与旧值取 max（旧值是理论下界）⇒ 宽度只增不减。
            lat = self._path_lateral_widths(field, path, idxs, res, ox, oy, w, h)
            if lat is not None:
                widths_l, unks_l, wxs_l, wys_l = lat
            else:
                # 降级：无 numpy/scipy 或分辨率不匹配 → 退回旧的 2×最近距离
                widths_l = []
                unks_l = []
                wxs_l = []
                wys_l = []
                for i in idxs:
                    idx = path[i]
                    wxp_ = (idx % w) * res + ox
                    wyp_ = (idx // w) * res + oy
                    d_, unk_ = self.clearance_at(field, wxp_, wyp_)
                    widths_l.append(2.0 * d_)
                    unks_l.append(unk_)
                    wxs_l.append(wxp_)
                    wys_l.append(wyp_)
            for _k, i in enumerate(idxs):
                width_ = widths_l[_k]
                unk_ = unks_l[_k]
                wxp_ = wxs_l[_k]
                wyp_ = wys_l[_k]
                wlist.append((width_, wxp_, wyp_))
                if width_ < min_w:
                    min_w, min_unk, min_at = width_, unk_, (wxp_, wyp_)
                if width_ < self.pass_width:
                    narrow_len += step_m
                    narrow_len_max_run = max(narrow_len_max_run, narrow_len)
                else:
                    narrow_len = 0.0
                # 未知占比高 = 这一段其实"没看清"，按障碍算；只允许短跨度
                if unk_ > 0.5:
                    unknown_run += step_m
                    unknown_run_max = max(unknown_run_max, unknown_run)
                else:
                    unknown_run = 0.0
            self.stats['pass_narrow_len_max'] = round(
                max(self.stats.get('pass_narrow_len_max', 0.0), narrow_len_max_run), 2)
            self.stats['pass_unknown_max'] = round(
                max(self.stats.get('pass_unknown_max', 0.0), unknown_run_max), 2)
            self._last_path_min_w = None if min_w == float('inf') else round(min_w, 3)
            if min_at is None:
                self._last_path_reject = None
                return True, None, None, 0.0
            # ===== P13-3：硬门降级为软约束（2026-11-09）=====
            # 实测依据（p13c A/B，各 5 轮）：
            #   rejected_narrow 812~936 次/轮，而 published 只有 29~33 次/轮；
            #   仲裁器供不起货 → frontier_merge 在 validated TTL(5 s) 过期后
            #   直接转发**未评分**的 raw（47~103 条/轮）→ 实际派发由 raw 主导
            #   → 距离/转角无法改善（B 组 5.26 m / 83° 反而略差）。
            # 所以三处"一刀切否决"改为：只在几何上真过不去时硬拒（corridor_hard），
            # 其余换成大额罚分进 risk_route，让排序决定而不是直接没得选。
            if self.route_gate_soft:
                # ===== S3（2026-11-11）：硬门只留"物理过不去" =====
                # 旧实现 `min_w < corridor_hard(0.92)` 一刀切硬拒，实测每轮
                # reject_narrow_hard 中位 2942 次、published 仅 30 次 ⇒ 候选池
                # 被卡到几乎归零 ⇒ 车 34% 的探索时间在原地等目标。
                # 真实几何下限是"车宽 0.40 + 两侧各留 0.09"= 0.58 m：
                #   净宽 < narrow_floor  ⇒ 物理过不去，硬拒（保留防楔死能力）
                #   净宽 >= narrow_floor ⇒ 能过，只是风险高 ⇒ 大额罚分放行
                if min_w < self.narrow_floor:
                    self._last_path_reject = 'narrow_hard'
                    self.stats['reject_narrow_hard'] = self.stats.get(
                        'reject_narrow_hard', 0) + 1
                    return True, min_at, min_w, min_unk   # 真过不去：几何硬门
                # 通过，但把"窄 / 未知 / 长窄段"折算成额外风险交给排序
                soft = 0.0
                span_narrow = max(1e-6, self.corridor_hard - self.narrow_floor)
                span_wide = max(1e-6, self.risk_route_target - self.corridor_hard)
                if min_w < self.corridor_hard:
                    # 能过但窄：罚分从 2.0（贴着呢）连续降到 1.0（刚好 corridor_hard）
                    soft += 1.0 + min(1.0, (self.corridor_hard - min_w) / span_narrow)
                    self.stats['pass_narrow_soft'] = self.stats.get(
                        'pass_narrow_soft', 0) + 1
                elif min_w < self.risk_route_target:
                    # 够宽但没到"从容"：0~1.0 的轻度罚分
                    soft += min(1.0, (self.risk_route_target - min_w) / span_wide)
                if narrow_len_max_run > self.narrow_len_max:
                    soft += min(1.0, (narrow_len_max_run - self.narrow_len_max)
                                / max(1e-6, self.narrow_len_max))
                if unknown_run_max > self.unknown_span_max:
                    soft += min(1.0, (unknown_run_max - self.unknown_span_max)
                                / max(1e-6, self.unknown_span_max))
                self._last_path_soft = round(soft, 3)
                self.stats['route_soft_pass'] = self.stats.get(
                    'route_soft_pass', 0) + 1
                self._last_path_reject = None
                return True, None, min_w, min_unk
            self._last_path_soft = 0.0
            if narrow_len_max_run > self.narrow_len_max and not self.noexit_enabled:
                self._last_path_reject = 'narrow'
                return True, min_at, min_w, min_unk      # 窄段太长 → 否决
            if unknown_run_max > self.unknown_span_max:
                self._last_path_reject = 'unknown'
                return True, min_at, min_w, min_unk      # 未知段太长 → 否决
            if min_w < self.pass_width:
                # A 层（noexit_enabled）：pass_width 只做"上限"，真正的判据是"能不能退出"。
                # 采样点不连续（超长路径截断）时放弃 A，退回原判据，避免把长度算错。
                contiguous = (len(wlist) == len(path))
                if self.noexit_enabled and contiguous and min_w >= self.noexit_pinch_m:
                    self.stats['noexit_checked'] = self.stats.get('noexit_checked', 0) + 1
                    bad_at = self._noexit_verdict(wlist, step_m)
                    if bad_at is None:
                        self.stats['noexit_passed'] = self.stats.get('noexit_passed', 0) + 1
                        self._last_path_reject = None
                        return True, None, min_w, min_unk   # 能退出 → 放行（恢复供给）
                    self._last_path_reject = 'noexit'
                    return True, bad_at, min_w, min_unk
                self._last_path_reject = 'narrow'
                return True, min_at, min_w, min_unk
            self._last_path_reject = None
            return True, None, min_w, min_unk

        need = self.corridor_width
        skip = int(self.corridor_skip_far / res)
        half = int(need / ores / 2) + 1
        min_w = float('inf')       # 路径上实测最小净宽（未知格按半宽计）
        min_unk = 0.0              # 取到最小宽度处的未知占比
        min_at = None
        for i in range(0, max(0, len(path) - skip), self.corridor_stride):
            idx = path[i]
            cx, cy = idx % w, idx // w
            # 用父节点方向求切向，再取垂直方向
            par = parent.get(idx)
            if par is None:
                tx, ty = 1, 0
            else:
                tx, ty = cx - par % w, cy - par // w
            n = math.hypot(tx, ty) or 1.0
            px, py = -ty / n, tx / n        # 垂直方向
            # 路径格坐标（costmap 系）→ /map 格坐标，两者分辨率可能不同
            wxp = cx * res + ox
            wyp = cy * res + oy
            mcx = int((wxp - oox) / ores)
            mcy = int((wyp - ooy) / ores)
            if half * ores > 2.0:              # 分辨率异常时保护
                half = int(2.0 / ores)
            # 逐格扫：免费格按 1 计、未知格按 0.5 计（2026-10-23：原来把未知当自由，
            # 门洞半米没探到就以为"1.05 m 宽"，车开进去才发现只有 0.9 m）
            def scan(sign):
                known = 0.0
                unk = 0.0
                k = 1
                while k <= half:
                    mx = int(round(mcx + sign * px * k)); my = int(round(mcy + sign * py * k))
                    v = map_val(mx, my)
                    if v >= 50:
                        break
                    if v < 0:
                        unk += 1.0
                        if unk > 0.5 * half:      # 未知太多就不再看更远
                            break
                    else:
                        known += 1.0
                    k += 1
                return known, unk

            klo, ulo = scan(+1)
            khi, uhi = scan(-1)
            n_cells = klo + khi + 1.0
            n_unk = ulo + uhi
            width = (n_cells - 0.5 * n_unk) * ores
            if width < min_w:
                min_w = width
                min_unk = n_unk / max(1.0, n_cells)
                min_at = (wxp, wyp)
        # S1（2026-11-11）：本分支同样记录实测最小净宽（clearance_mode != distance）
        self._last_path_min_w = (None if min_w == float('inf')
                                 else round(min_w, 3))
        if min_at is None:
            return True, None, None, 0.0
        if min_w < need:
            return True, min_at, min_w, min_unk
        return True, None, min_w, min_unk

    def on_odom(self, m):
        q = m.pose.pose.position
        o = m.pose.pose.orientation
        self.pose = (q.x, q.y)
        self.yaw = math.atan2(2.0 * (o.w * o.z + o.x * o.y),
                              1.0 - 2.0 * (o.y * o.y + o.z * o.z))

    def on_cands(self, m):
        now = time.monotonic()
        cells = self._cand_cells
        for pt in m.points:
            key = (int(math.floor(pt.x)), int(math.floor(pt.y)))
            cells[key] = (pt.x, pt.y, now)       # 同格覆盖 ⇒ 只留最新采样
        self.stats['seen'] += len(m.points)
        # 过期清理 + 容量限制（按时间保留最新的 cand_pool 个）
        fresh = [(k, v) for k, v in cells.items() if now - v[2] <= self.cand_max_age]
        if len(fresh) > self.cand_pool:
            fresh.sort(key=lambda kv: kv[1][2], reverse=True)
            fresh = fresh[:self.cand_pool]
            self._cand_cells = dict(fresh)
        else:
            self._cand_cells = dict(fresh)
        self.cands = list(self._cand_cells.values())

    # ================= P1（2026-11-11）未知区连通分量 =================
    def unknown_region_field(self):
        """未知格连通分量标签场。缺 numpy/scipy 时返回 None（调用方退回旧行为）。

        为什么需要：候选落点倾向要按"这个候选打开的未知区有多大、离车多远"排序，
        而不是只看候选点自身（候选点永远贴在已知/未知边界上，自身距离没有区域含义）。
        缓存按 (/map 序号, 尺寸, 分辨率) 失效 —— 与 clearance_field 同一套思路。
        """
        if not self.ureg_enabled:
            return None
        m = self.map
        if m is None:
            return None
        info = m.info
        res = info.resolution
        if res <= 0:
            return None
        w, h = info.width, info.height
        key = (self._map_seq, w, h, round(res, 6))
        if key == self._ureg_key and self._ureg_field is not None:
            return self._ureg_field
        try:
            import numpy as np
            from scipy import ndimage
        except Exception:                      # noqa: BLE001 - 没装 scipy 就关闭本功能
            self._ureg_key = None
            self._ureg_field = None
            return None
        arr = np.asarray(m.data, dtype=np.int16).reshape(h, w)
        unknown = arr < 0
        # 8 邻域：细缝（门框、桌腿之间）不该被切成分量
        labels, n = ndimage.label(unknown,
                                 structure=np.ones((3, 3), dtype=np.int8))
        # 面积用 bincount 统计：各 scipy 版本都有 ndimage.sum，但已被废弃，
        # bincount 更快且不受版本影响
        cnt = np.bincount(labels.ravel(), minlength=n + 1)
        sizes = cnt[1:].astype(np.int64)
        # P1 增补（2026-11-11 实测驱动）：未知**厚度**场。
        # 为什么必须补：connected-component 在本世界上是退化的 —— 实测 91% 的未知格
        # 属于**同一个**分量（27000+ 格），其余 149 个分量加起来才 6 m²。于是
        # "候选所属区域的最远点距车多远"对几乎所有候选都是同一个数
        # （实测拍内极差中位 = 0.00 m），排不出任何顺序。
        # 厚度场（未知格到最近已知格的距离）不受此影响：房间中心厚、门框处薄，
        # 实测拍内归一化极差 161%，是真正有区分度的区域级特征。
        depth = ndimage.distance_transform_edt(unknown) * res
        try:
            objs = ndimage.find_objects(labels)
        except Exception:                      # noqa: BLE001
            objs = None
        self._ureg_field = {'labels': labels, 'n': int(n), 'sizes': sizes,
                            'objs': objs, 'res': res, 'w': w, 'h': h,
                            'ox': info.origin.position.x,
                            'oy': info.origin.position.y,
                            'unknown': unknown, 'depth': depth}
        self._ureg_key = key
        self._ureg_pts = {}        # 地图变了，惰性缓存的分量点列必须全部作废
        return self._ureg_field

    def unknown_depth_at(self, x, y, radius=None):
        """"(x,y) 周边 radius 内未知厚度（米）的最大值；特征不可用返回 None。

        厚度 = 该未知格到最近**已知**格的距离。它回答的是"从这个点往未知里
        还能推多深"，正是"室内框架还没探到的深处"的代理量。
        """
        f = self.unknown_region_field()
        if f is None or 'depth' not in f:
            return None
        r = self.ureg_radius if radius is None else radius
        res = f['res']
        ci = int((x - f['ox']) / res)
        cj = int((y - f['oy']) / res)
        n = max(1, int(r / res))
        j0, j1 = max(0, cj - n), min(f['h'], cj + n + 1)
        i0, i1 = max(0, ci - n), min(f['w'], ci + n + 1)
        if j0 >= j1 or i0 >= i1:
            return None
        win = f['depth'][j0:j1, i0:i1]
        if not win.size:
            return None
        return float(win.max())

    def unknown_region_at(self, x, y, radius=None):
        """(x,y) 周边 radius 内**面积最大**的未知连通分量 id；没有则 0。

        候选点贴在边界上，单格查询经常落在已知格，所以在半径内扫一遍
        （默认 0.5 m ≈ 10 格 @5cm）。面积小于 ureg_min_cells 的分量按噪声丢弃。
        """
        f = self.unknown_region_field()
        if f is None:
            return 0
        r = self.ureg_radius if radius is None else radius
        res = f['res']
        ci = int((x - f['ox']) / res)
        cj = int((y - f['oy']) / res)
        n = max(1, int(r / res))
        labels = f['labels']
        sizes = f['sizes']
        best, best_sz = 0, 0
        for dj in range(-n, n + 1):
            j = cj + dj
            if not (0 <= j < f['h']):
                continue
            base = j
            for di in range(-n, n + 1):
                if di * di + dj * dj > n * n:
                    continue
                i = ci + di
                if not (0 <= i < f['w']):
                    continue
                rid = int(labels[base, i])
                if rid <= 0:
                    continue
                sz = int(sizes[rid - 1])
                if sz > best_sz:
                    best, best_sz = rid, sz
        if best_sz < self.ureg_min_cells:
            return 0
        return best

    def region_span(self, rid, pose=None):
        """该未知分量相对车位的 (最近, 质心, 最远) 距离（米）；不可用返回 None。

        reg_far 就是"候选打开的那片未知区的远端有多远"，是落点倾向的主依据；
        reg_cen 作为更稳的备选（远端对零散凸起敏感）。
        """
        f = self.unknown_region_field()
        if f is None or rid <= 0 or rid > f['n']:
            return None
        pose = pose if pose is not None else self.pose
        if pose is None:
            return None
        pts = self._ureg_pts.get(rid)
        if pts is None:
            try:
                import numpy as np
            except Exception:                  # noqa: BLE001
                return None
            objs = f.get('objs')
            sl = objs[rid - 1] if (objs is not None and rid - 1 < len(objs)) else None
            if sl is None:
                return None
            win = f['labels'][sl] == rid
            jj, ii = np.nonzero(win)
            j0 = sl[0].start or 0
            i0 = sl[1].start or 0
            pts = (f['ox'] + (ii + i0 + 0.5) * f['res'],
                   f['oy'] + (jj + j0 + 0.5) * f['res'])
            self._ureg_pts[rid] = pts
        try:
            import numpy as np
        except Exception:                      # noqa: BLE001
            return None
        wx, wy = pts
        d = np.hypot(wx - pose[0], wy - pose[1])
        return float(d.min()), float(d.mean()), float(d.max())

    def unknown_edge_far(self):
        """"前沿最远距离"：紧邻已知空闲的未知格中，离车最远多少米。

        这是"框架是否探完"的判据 (a)（用户 2026-11-11 选定：该值连续若干拍
        不再增长 ⇒ 边界已推到尽头，可切补齐阶段）。必须限制在"紧邻已知空闲"
        的未知格上，否则会取到地图角落的未知块，永远显示"还有很远的没探"。
        """
        f = self.unknown_region_field()
        if f is None or self.pose is None:
            return None
        cache = f.get('edge_pts')
        if cache is None:
            try:
                import numpy as np
                from scipy import ndimage
            except Exception:                  # noqa: BLE001
                return None
            m = self.map
            if m is None:
                return None
            info = m.info
            arr = np.asarray(m.data, dtype=np.int16).reshape(info.height,
                                                              info.width)
            unknown = arr < 0
            known_free = (arr >= 0) & (arr < 50)
            it = max(1, int(0.30 / f['res']))
            edge = unknown & ndimage.binary_dilation(known_free, iterations=it)
            if not edge.any():
                cache = ()
            else:
                jj, ii = np.nonzero(edge)
                cache = (f['ox'] + (ii + 0.5) * f['res'],
                         f['oy'] + (jj + 0.5) * f['res'])
            f['edge_pts'] = cache
        if not cache:
            return None
        try:
            import numpy as np
        except Exception:                      # noqa: BLE001
            return None
        wx, wy = cache
        d = np.hypot(wx - self.pose[0], wy - self.pose[1])
        return float(d.max())

    # ================= P4（2026-11-11）先远后近两阶段 =================
    def _frame_mode(self):
        """当前是否在"框架阶段"（先远后近）。总开关关闭时永远是 False。"""
        return bool(self.frame_far_first) and self.strategy_phase == 'frame'

    def _sort_candidates(self, items):
        """按当前阶段排序。items 均为 (score, negd, x, y)，negd = -距离。

        补齐阶段：score 降序 —— 与改造前**逐位等价**（(score,-dist,x,y) 的
        元组降序就是 score 优先、近者优先做并列裁决）。
        框架阶段：negd 升序 = 距离降序 = **越远越优先**，score 只做并列裁决。

        为什么不把"距离"塞进第一个元素：下游 `top.append((u - pen - risk_pen,
        negd, x, y))` 里 pen/risk 是百~千量级的罚分，会把米级的距离彻底淹没。
        改排序规则、不改元组结构，是唯一不动下游三处解包的做法。
        """
        if not self._frame_mode():
            return sorted(items, reverse=True)
        return sorted(items, key=lambda q: (q[1], -q[0]))

    def known_cells(self):
        """/map 上已知格数（>=0，即空闲+占据）。缺 numpy 时返回 None。

        为什么阶段判据 (a) 用它而不是"最远前沿距离"（2026-11-11 实测）：
        `unknown_edge_far` 在 90 s 里上涨 40 拍 / 下跌 38 拍、单拍最大变动 1.27 m,
        是纯噪声 —— 它取的是全图最远前沿，而地图边缘/墙体背面随时会被揭示，
        数值随机跳。实测直接后果：90 s 内阶段切换 3 次（框架→补齐→框架→补齐），
        两阶段互相抵消，"先远"根本跑不出来。
        已探明格数是**单调递增**的，只有真的探不下去了才会停滞，语义上也正好
        对应"室内框架已成型"。
        """
        m = self.map
        if m is None:
            return None
        key = (self._map_seq, m.info.width, m.info.height)
        if key == getattr(self, '_known_key', None):
            return self._known_n
        try:
            import numpy as np
        except Exception:                      # noqa: BLE001
            return None
        arr = np.asarray(m.data, dtype=np.int16).reshape(m.info.height,
                                                        m.info.width)
        self._known_n = int((arr >= 0).sum())
        self._known_key = key
        return self._known_n

    def _update_strategy_phase(self, now):
        """框架 ↔ 补齐 的阶段切换（用户 D1/D2：可回退 + 滞回；远区耗尽切补齐）。

        ★ 2026-11-13 改为**供给驱动**（用户 D2 原意）：
          (a) 主判据：连续 frame_supply_empty_ticks 拍里候选池中**没有远候选**
              （距离 > far_admit_dist 且已过 min_unknown）
          (b) 兜底：若远候选一直有、但已探明面积也连续 frame_stall_ticks 拍不增长，
              说明"远是远，但推不动"，也切补齐（防止永远等不到）
        切回框架只需一条：远候选重新出现（典型场景：开了个门，新一大片未知进来）。

        为什么不再只用"地图停滞"：实测 727 个框架拍里远候选为 0 的只有 6 拍(1%)，
        却切了 17 次 —— 车开往 6 m 外目标的路上（12~20 s）全在已知区跑，地图本
        来就不长，"停滞"从第 8 秒起恒为真。那实际测的是"行驶时间"，不是"探尽"。
        """
        if not self.frame_far_first:
            self.strategy_phase = 'fill'
            return
        if not self._phase_t:
            self._phase_t = now
        # ---- 供给计数（主判据）----
        if self._far_supply <= 0:
            self._phase_supply_empty += 1
        else:
            self._phase_supply_empty = 0
        # ---- 已探明面积（兜底判据）----
        known = self.known_cells()
        if known is None:
            return
        if self._phase_known_best is None:
            self._phase_known_best = known
            grown = 0
        elif known > self._phase_known_best:
            grown = known - self._phase_known_best
            self._phase_known_best = known
        else:
            grown = 0
        self._phase_stall = (0 if grown >= self.frame_growth_cells
                             else self._phase_stall + 1)
        if now - self._phase_t < self.frame_hysteresis:
            return
        f = self.unknown_region_field()
        nreg = None if f is None else int(f['n'])
        if self.strategy_phase == 'frame':
            supply_empty = self._phase_supply_empty >= self.frame_supply_empty_ticks
            stalled = (self._phase_stall >= self.frame_stall_ticks
                       and nreg is not None and nreg <= self.frame_regions_max)
            if supply_empty or stalled:
                self.strategy_phase = 'fill'
                self._phase_t = now
                self._phase_switch_known = known
                self._phase_stall = 0
                # 兜底切换（远候选有但推不动）不得因"供给还在"就立刻切回，
                # 否则每拍来回抖；那时只能靠"地图真的长出新区域"来解锁。
                self._phase_forced = bool(stalled and not supply_empty)
                self.stats['phase_to_fill'] = self.stats.get('phase_to_fill', 0) + 1
                if supply_empty:
                    self.stats['phase_to_fill_supply'] = (
                        self.stats.get('phase_to_fill_supply', 0) + 1)
                else:
                    self.stats['phase_to_fill_stall'] = (
                        self.stats.get('phase_to_fill_stall', 0) + 1)
                self.get_logger().info(
                    'P4 阶段切换：框架 → 补齐（%s；远候选供给=%d，'
                    '已探明 %d 格停滞 %d 拍，剩余未知分量 %s）'
                    % ('远候选耗尽' if supply_empty else '远候选推不动',
                       self._far_supply, known, self._phase_stall, nreg))
        else:
            # 回切条件取决于是谁触发的切换：
            #  · 供给耗尽（远候选真空了）→ 远候选恢复即回，说明找到了新远区
            #  · 停滞逼的（远候选一直有但推不动）→ 必须"已探明跳增"才回，
            #    否则每拍来回抖（实测过：远候选没变，切了立刻切回）
            if self._phase_forced:
                base = getattr(self, '_phase_switch_known', None)
                recover = (base is not None
                           and known - base >= self.frame_regrow_cells)
            else:
                recover = self._far_supply > 0
            if recover:
                self.strategy_phase = 'frame'
                self._phase_t = now
                self._phase_stall = 0
                self._phase_supply_empty = 0
                self._phase_forced = False
                self.stats['phase_to_frame'] = self.stats.get('phase_to_frame', 0) + 1
                self.get_logger().info(
                    'P4 阶段切回：补齐 → 框架（远候选供给=%d 个，已探明 %d 格）'
                    % (self._far_supply, known))

    def relay_point(self, gx, gy):
        """沿"本目标已算出的那条路径"取一个中继点（P5-iii）。

        依据（2026-11-11 实测）：>6 m 的派发取消率 69%，且取消前日志里
        「卡住」16 次、「blocked」9 次、「迁移」9 次 —— 失败点在**途中**，不在选点。
        `path_and_width` 本来就已经 BFS 出了整条路径，取路径上 far_relay_m 弧长处
        继续走，比"随机挪 2 m"或"直接取消重选"都更接近"先把这段走通"。

        ★ 2026-11-13 修复：路径来源改为 `_dispatch_path`（在 _tick_v1 派发那一刻
        就随 passing 一起钉住），不再读 `_last_path_w`。旧实现里后者被每拍 top-N
        的 path_and_width 反复覆盖，留下的必然是"最后一个被检查的候选"路径，
        与实派目标几乎必然不同 ⇒ 坐标校验每次都判 miss（实测 far_relay_ok = 0、
        miss = 3，中继降级从未真正生效）。
        """
        if not self.far_relay_on or self.pose is None:
            return None
        path = self._dispatch_path
        if not path or len(path) < 2:
            self.stats['far_relay_miss'] = self.stats.get('far_relay_miss', 0) + 1
            return None
        if self._dispatch_goal != (round(gx, 2), round(gy, 2)):
            self.stats['far_relay_miss'] = self.stats.get('far_relay_miss', 0) + 1
            return None
        acc = 0.0
        prev = None
        for (px, py) in path:
            if prev is not None:
                acc += math.hypot(px - prev[0], py - prev[1])
            prev = (px, py)
            if acc < self.far_relay_m:
                continue
            # 离目标太近就不算"中继"了（与原目标无实质区别）
            if math.hypot(px - gx, py - gy) < self.far_relay_min_goal:
                break
            # 中继点必须比当前位姿更靠近目标，否则等于原地打转
            if math.hypot(px - gx, py - gy) >= math.hypot(gx - self.pose[0],
                                                          gy - self.pose[1]):
                continue
            if self._veto_ok(px, py):
                self.stats['far_relay_ok'] = self.stats.get('far_relay_ok', 0) + 1
                return px, py
        self.stats['far_relay_miss'] = self.stats.get('far_relay_miss', 0) + 1
        return None

    def probe_pool(self, scored, raw_of):
        """候选池快照（P2）：每拍一行，记录排序后前 N 名的全部依据。

        与 probe_candidate 的分工：那个只在**真正派发**时记一条，看不到
        "当时还有哪些候选、为什么没被选、远优先有没有把序列重排成功"；
        这个记录整条序列，是落点倾向改造唯一的归因来源。
        """
        if not self.pool_probe_log or self.pool_probe_n <= 0 or not scored:
            return
        n = min(self.pool_probe_n, len(scored))
        field = self.unknown_region_field()
        rows = []
        for rank in range(n):
            key_s, negd, x, y = scored[rank]
            dist = -negd
            rid = self.unknown_region_at(x, y)
            span = self.region_span(rid) if rid > 0 else None
            reg_m2 = 0.0
            if rid > 0 and field is not None:
                reg_m2 = round(float(field['sizes'][rid - 1])
                               * field['res'] * field['res'], 2)
                self.stats['ureg_ok'] = self.stats.get('ureg_ok', 0) + 1
            else:
                self.stats['ureg_miss'] = self.stats.get('ureg_miss', 0) + 1
            rows.append({
                'rank': rank + 1, 'x': round(x, 2), 'y': round(y, 2),
                'dist': round(dist, 2),
                'u_eff': round(float(raw_of.get((round(x, 2), round(y, 2)), 0.0)), 1),
                'key': round(float(key_s), 2),
                'reg': rid, 'reg_m2': reg_m2,
                'reg_near': None if span is None else round(span[0], 2),
                'reg_cen': None if span is None else round(span[1], 2),
                'reg_far': None if span is None else round(span[2], 2),
                # P1 增补：未知厚度是连接分量退化后的**主**区域特征（见 unknown_region_field）
                'depth': (None if self.unknown_depth_at(x, y) is None
                          else round(self.unknown_depth_at(x, y), 2)),
            })
        self._pool_tick += 1
        row = {'t': round(time.time(), 3), 'tick': self._pool_tick,
               'robot': (None if self.pose is None
                         else [round(self.pose[0], 3), round(self.pose[1], 3)]),
               'n_pool': len(self.cands), 'n_scored': len(scored),
               'n_regions': (None if field is None else field['n']),
               'far_edge_m': self.unknown_edge_far(),
               # P4：当前阶段。A/B 归因必须能分开"框架阶段拍"与"补齐阶段拍"，
               # 否则"rank1 不是最远"的拍会被误判成排序失效（其实是补齐阶段）。
               'phase': self.strategy_phase,
               'known': self.known_cells(),
               'rows': rows}
        try:
            os.makedirs(os.path.dirname(self.pool_probe_log) or '.', exist_ok=True)
            with open(self.pool_probe_log, 'a', encoding='utf-8') as f:
                f.write(json.dumps(row, ensure_ascii=False) + '\n')
            self.stats['pool_probe'] = self.stats.get('pool_probe', 0) + 1
        except Exception:                      # noqa: BLE001
            pass

    # ---- 工具 ----
    def unknown_cells(self, x, y):
        m = self.map
        if m is None:
            return 0
        info = m.info
        r = int(self.radius / info.resolution)
        cx = int((x - info.origin.position.x) / info.resolution)
        cy = int((y - info.origin.position.y) / info.resolution)
        n = 0
        for j in range(max(0, cy - r), min(info.height, cy + r + 1)):
            base = j * info.width
            for i in range(max(0, cx - r), min(info.width, cx + r + 1)):
                if m.data[base + i] < 0:
                    n += 1
        return n

    def blacklisted(self, x, y, now):
        self.blacklist = [b for b in self.blacklist if b[2] > now]
        if len(self.blacklist) > 40:                 # 限容量，最旧的先丢
            self.blacklist = self.blacklist[-40:]
        return any(math.hypot(x - b[0], y - b[1]) < self.bl_r for b in self.blacklist)

    # ================= 候选后验门（2026-10-27）=================
    def cost_at(self, x, y):
        """当前全局代价地图在 (x,y) 的代价；越界/未就绪返回 None。"""
        cm = self.costmap
        if cm is None:
            return None
        info = cm.info
        res = info.resolution
        if res <= 0:
            return None
        i = int((x - info.origin.position.x) / res)
        j = int((y - info.origin.position.y) / res)
        if not (0 <= i < info.width and 0 <= j < info.height):
            return None
        return cm.data[j * info.width + i]

    def _map_known_free_ratio(self, x, y):
        """(x,y) 单格在 /map 上的状态：'free' / 'occ' / 'unk'。"""
        m = self.map
        if m is None:
            return None
        info = m.info
        i = int((x - info.origin.position.x) / info.resolution)
        j = int((y - info.origin.position.y) / info.resolution)
        if not (0 <= i < info.width and 0 <= j < info.height):
            return None
        v = m.data[j * info.width + i]
        if v < 0:
            return 'unk'
        return 'free' if v < 50 else 'occ'

    def cost_gate_reject(self, x, y, now, count=True):
        """候选后验：用**当前**全局代价地图复核落点。返回 None=通过，否则返回原因串。

        三项判据（任一不过就拒）：
          1) 落点格代价 < cost_gate_hard（默认 99，即致命/内切一律不可派发）；
          2) cost_gate_disc 半径圆盘内没有致命格（车体+余量，默认 0.35 m）；
          3) 圆盘内 /map 已知空闲比例 >= cost_gate_free_ratio（默认 0.8），
             挡"孤岛自由格"——落点本身空闲、四周全是未知/占据。
        代价地图未就绪时不阻塞（与 reachable() 同口径）；cost_gate 默认关。
        """
        if not self.cost_gate:
            return None
        cm = self.costmap
        if cm is None:
            return None
        if count:
            self.stats['cost_checked'] = self.stats.get('cost_checked', 0) + 1
        v0 = self.cost_at(x, y)
        if v0 is None:
            return 'out_of_costmap'
        if v0 >= self.cost_gate_hard:
            return 'goal_cost=%d' % v0
        res = cm.info.resolution
        n = max(1, int(self.cost_gate_disc / res))
        lethal = 0
        free = occ = 0
        for dj in range(-n, n + 1):
            for di in range(-n, n + 1):
                if di * di + dj * dj > n * n:
                    continue
                px, py = x + di * res, y + dj * res
                v = self.cost_at(px, py)
                if v is not None and v >= self.cost_gate_hard:
                    lethal += 1
                st = self._map_known_free_ratio(px, py)
                if st == 'free':
                    free += 1
                elif st == 'occ':
                    occ += 1
        if lethal > 0:
            return 'lethal_in_disc=%d' % lethal
        # 注意：**未知格不算否决**。探索候选天生贴着未知边界，把未知计入分母会把
        # 正常候选全毙掉（实测 666/744 次否决都来自这一条，属于判据写错）。
        # 这里只要求"已知部分里空闲占比达标"，即盘内不得有已知占据。
        if free + occ > 0 and (free / float(free + occ)) < self.cost_gate_free_ratio:
            return 'occ_ratio=%.2f' % (occ / float(free + occ))
        return None

    def cost_repair_point(self, x, y, u_orig, now):
        """后验修复：在原候选附近随机采样，返回**最近的合格点位**；找不到返回 None。

        判据（全部通过才算合格）：
          * cost_gate_reject 通过（落点代价、盘内致命格、盘内已知占据占比）；
          * 附近的未知格数 >= max(repair_min_unknown, keep_unknown × 原候选未知数)
            —— 否则修复点只是把车送进已探索区，失去探索意义；
          * 与原候选的最短距离（在 radius 内随机取点，取最近者）。
        """
        if not (self.repair_on and self.cost_gate):
            return None
        if self.costmap is None:
            return None
        need = max(self.repair_min_unknown, int(round(self.repair_keep_unknown * u_orig)))
        cand = []
        for _ in range(max(1, self.repair_samples)):
            ang = random.uniform(0.0, 2.0 * math.pi)
            rad = self.repair_radius * math.sqrt(random.random())
            nx = x + rad * math.cos(ang)
            ny = y + rad * math.sin(ang)
            if self.cost_gate_reject(nx, ny, now, count=False) is not None:
                continue
            if self.unknown_cells(nx, ny) < need:
                continue
            cand.append((math.hypot(nx - x, ny - y), nx, ny))
        if not cand:
            return None
        cand.sort()
        if not self.repair_verify:
            return cand[0][1], cand[0][2]
        # 按距离从近到远逐个做"综合质量"验证，取第一个通过者
        if getattr(self, '_repair_tick_n', 0) >= self.repair_tick_cap:
            self.stats['repair_tick_capped'] = self.stats.get('repair_tick_capped', 0) + 1
            return cand[0][1], cand[0][2]
        for (_d, nx, ny) in cand[:max(1, self.repair_verify_tries)]:
            self._repair_tick_n = getattr(self, '_repair_tick_n', 0) + 1
            # ① nav2 可通行先验：BFS 路径可达 + 沿途最小净宽
            try:
                ok, narrow, min_w, _unk = self.path_and_width(nx, ny)
            except Exception:                   # noqa: BLE001
                ok, narrow, min_w = False, None, None
            if not ok or narrow is not None:
                self.stats['repair_plan_fail'] = self.stats.get('repair_plan_fail', 0) + 1
                continue
            # ② 一般候选判据（与候选闸门同一套区域复杂度）
            try:
                _reason, _f = self.candidate_gate(nx, ny)
            except Exception:                   # noqa: BLE001
                _reason, _f = None, None
            if _reason:
                self.stats['repair_gate_fail'] = self.stats.get('repair_gate_fail', 0) + 1
                continue
            self.stats['repair_verified'] = self.stats.get('repair_verified', 0) + 1
            return nx, ny
        if self.repair_fallback:
            self.stats['repair_fallback'] = self.stats.get('repair_fallback', 0) + 1
            return cand[0][1], cand[0][2]
        return None

    def pull_back(self, x, y):
        if self.pose is None or self.pullback <= 0:
            return self.snap_known_free(x, y)
        dx, dy = self.pose[0] - x, self.pose[1] - y
        d = math.hypot(dx, dy)
        if d < 1e-6:
            return self.snap_known_free(x, y)
        k = min(self.pullback, d * 0.5) / d
        return self.snap_known_free(x + dx * k, y + dy * k)

    def snap_known_free(self, x, y, max_r_m=0.35):
        """D9：回拉点若落进未知/占据格，吸附到最近"已知自由"格（螺旋搜索 ≤0.35 m）。

        原因：BFS 把未知当不可通行，回拉点落在未知里会让候选直接被判"不可达"
        （实测 rejected_path 131–494/轮）。找不到就原样返回，不改变语义。
        """
        m = self.map
        if m is None:
            return x, y
        info = m.info
        res = info.resolution
        if res <= 0:
            return x, y
        w, h = info.width, info.height
        ox, oy = info.origin.position.x, info.origin.position.y
        ci = int((x - ox) / res)
        cj = int((y - oy) / res)

        def known_free(i, j):
            if not (0 <= i < w and 0 <= j < h):
                return False
            v = m.data[j * w + i]
            return 0 <= v < 50

        if known_free(ci, cj):
            return x, y
        rmax = max(1, int(max_r_m / res))
        for r in range(1, rmax + 1):
            best = None
            for dj in range(-r, r + 1):
                for di in range(-r, r + 1):
                    if max(abs(di), abs(dj)) != r:
                        continue
                    if known_free(ci + di, cj + dj):
                        d2 = di * di + dj * dj
                        if best is None or d2 < best[0]:
                            best = (d2, ci + di, cj + dj)
            if best is not None:
                return (ox + (best[1] + 0.5) * res, oy + (best[2] + 0.5) * res)
        return x, y

    def reachable_async(self, x, y):
        """异步可达性校验：返回 future 或 None（不可用/已有在途请求）"""
        if self.pending is not None:
            return None
        if getattr(self, 'cli', None) is None:      # 服务客户端从未创建（历史遗留），直接放弃
            return
        if not self.cli.service_is_ready():
            if not self.cli.wait_for_service(timeout_sec=0.2):
                return None
        req = ComputePathToPose.Request()
        req.goal = PoseStamped()
        req.goal.header.frame_id = self.frame
        req.goal.header.stamp = self.get_clock().now().to_msg()
        req.goal.pose.position.x, req.goal.pose.position.y = x, y
        req.goal.pose.orientation.w = 1.0
        req.use_start = False
        fut = self.cli.call_async(req)
        self.pending = (fut, x, y)
        return fut

    # ---- 主循环 ----
    def _update_stuck(self, now):
        """S3：有速度指令但位移几乎为 0 → 记为受阻区（60 s 衰减）"""
        if self.pose is None:
            return
        moving_cmd = abs(self.cmd[0]) > 0.05 or abs(self.cmd[1]) > 0.05
        if not moving_cmd:
            self._stuck_ref = None
            return
        if self._stuck_ref is None:
            self._stuck_ref = (now, self.pose[0], self.pose[1])
            return
        t0, x0, y0 = self._stuck_ref
        if now - t0 >= 2.0:
            if math.hypot(self.pose[0] - x0, self.pose[1] - y0) < 0.01:
                self.stuck_zones.append((self.pose[0], self.pose[1], now + self.bl_sec))
                self.get_logger().warn(
                    f'受阻区记录：({self.pose[0]:.2f},{self.pose[1]:.2f}) 持续 {now-t0:.1f}s 无位移')
            self._stuck_ref = (now, self.pose[0], self.pose[1])
        self.stuck_zones = [z for z in self.stuck_zones if z[2] > now]

    # ---------------- P9-L1：「确定过不去」判定 ----------------
    def _ff_state(self):
        """从 manager 的 nav_state JSON 里取 (front_min_range, nav, mode)。"""
        o = getattr(self, '_nav_payload', None) or {}
        front = o.get('front_min_range')
        try:
            front = float(front) if front is not None else None
        except (TypeError, ValueError):
            front = None
        nav = str(o.get('navigation_state') or '').lower()
        mode = str(o.get('mode') or '').lower()
        return front, nav, mode

    def _update_failfast(self, now):
        """滑窗判「确定过不去」；确认后取消目标 + 拉黑该点 + 标记本轮禁入区。

        判据（离线标定，见 harness/analyze_failfast.py 与 docs/P9）：
          1) 窗口内位姿包围盒对角线 <= ff_drift（同一小范围）
          2) 净空证据：front_min_range < ff_front  或  nav 处于 blocked_*
          3) 非"等"状态：mode/nav 不在 waiting/arrived/canceled 一类
        连续满足 >= ff_window 秒算一次命中；同一 2 m 内 ff_ttl 秒内有 ff_confirm 次命中
        才真正动手（避免把正常探索的短暂停顿当成过不去）。
        """
        if not self.failfast_enabled or self.pose is None:
            return
        self._ff_hist.append((now, self.pose[0], self.pose[1]))
        while self._ff_hist and now - self._ff_hist[0][0] > self.ff_window * 1.5:
            self._ff_hist.popleft()
        win = [h for h in self._ff_hist if now - h[0] <= self.ff_window]
        if len(win) < 5 or (win[-1][0] - win[0][0]) < self.ff_window * 0.8:
            return
        xs = [w[1] for w in win]
        ys = [w[2] for w in win]
        drift = math.hypot(max(xs) - min(xs), max(ys) - min(ys))
        if drift > self.ff_drift:
            self._ff_stuck_since = None
            return
        front, nav, mode = self._ff_state()
        blocked = ('blocked_' in nav) or ('blocked_' in mode)
        # L1-b（2026-10-26 补）：车端自己进入 blocked_waiting_clearance 超过
        # ff_blocked_sec（默认 15 s）也算"确定过不去"——实测 76 s / 125 s 那两次长停滞
        # 就属于这一类（front 未进 0.60 m，旧判据漏检）。
        if blocked:
            if self._ff_blocked_since is None:
                self._ff_blocked_since = now
            if now - self._ff_blocked_since >= self.ff_blocked_sec:
                clear = True
            else:
                clear = (front is not None and front < self.ff_front)
        else:
            self._ff_blocked_since = None
            clear = front is not None and front < self.ff_front
        waiting = any(w in nav for w in FF_WAIT_WORDS) or any(w in mode for w in FF_WAIT_WORDS)
        if not clear or waiting:
            self._ff_stuck_since = None
            return
        if self._ff_stuck_since is None:
            self._ff_stuck_since = now
            return
        # 已连续满足 ff_window 秒 → 记一次命中（10 s 内不重复记账）
        if now - self._ff_stuck_since < self.ff_window:
            return
        if self._ff_hits and now - self._ff_hits[-1][0] < 10.0:
            return
        x, y = self.pose[0], self.pose[1]
        self._ff_hits.append((now, x, y))
        self.stats['failfast_hit'] = self.stats.get('failfast_hit', 0) + 1
        near = [h for h in self._ff_hits
                if now - h[0] <= self.ff_ttl
                and math.hypot(h[1] - x, h[2] - y) <= self.ff_zone_radius]
        self.get_logger().warn(
            'L1 判定：在 (%.2f,%.2f) 已 %.0f s 同一小范围（漂移 %.2f m、front=%s、nav=%s），'
            '同区命中 %d/%d 次'
            % (x, y, now - self._ff_stuck_since, drift,
               ('%.2f' % front) if front is not None else 'n/a', nav or mode or 'n/a',
               len(near), self.ff_confirm))
        if len(near) < self.ff_confirm:
            return
        if self._ff_actions >= self.ff_max_actions:
            return
        if now - self._ff_last_action < 15.0:
            return
        # ---- L2 动作：取消 → 拉黑 → 立即允许重派（同拍换目标）----
        span = near[-1][0] - near[0][0]
        hard = (len(near) >= self.ff_confirm + 1) or (span >= self.ff_escalate_sec)
        self._ff_actions += 1
        self._ff_last_action = now
        self.stats['failfast_action'] = self.stats.get('failfast_action', 0) + 1
        self.blacklist.append((x, y, now + self.ff_ttl))
        self.stuck_zones.append((x, y, now + self.ff_ttl))
        if hard:
            self._ff_hard.append((x, y, now + self.ff_ttl))
            cells = self._ff_flood(x, y, now)
            self.stats['failfast_zone_cells'] = len(self._ff_cells)
            self.get_logger().warn(
                'L2 升级：把这一整块自由连通域（%d 格，半径 %.1f m）记为本轮禁入区' % (cells, self.ff_comp_radius))
            self.stats['failfast_hardzone'] = self.stats.get('failfast_hardzone', 0) + 1
        cancelled = self._do_veto_cancel()
        self.last_pub = 0.0          # 关键：允许下一拍立刻派别的目标（等于"报告失败并换目标"）
        self.get_logger().warn(
            '✗ L2 判失败：位置 (%.2f,%.2f) 判定过不去（同区命中 %d 次、跨度 %.0f s）→ '
            '取消目标=%s、拉黑 %.0f s%s；第 %d 次'
            % (x, y, len(near), span, '是' if cancelled else '否(无活跃目标)',
               self.ff_ttl, '、并升级为本轮禁入区' if hard else '', self._ff_actions))
        self._ff_hits = [h for h in self._ff_hits if now - h[0] <= self.ff_ttl]

    def _ff_flood(self, x, y, now):
        """从 (x,y) 出发在 /map 的自由格上做 flood fill，把这一整块"死角"记成本轮禁入区。

        只填自由格（/map < 50），半径上限 ff_comp_radius（默认 6 m），
        这样"同一死角换到另一侧前沿"也会被挡住。
        """
        occ = self.map
        if occ is None:
            return 0
        ores = occ.info.resolution
        ow, oh = occ.info.width, occ.info.height
        oox, ooy = occ.info.origin.position.x, occ.info.origin.position.y
        data = occ.data
        ci = int((x - oox) / ores)
        cj = int((y - ooy) / ores)
        if not (0 <= ci < ow and 0 <= cj < oh):
            return 0
        rmax = int(self.ff_comp_radius / ores)
        rad2 = rmax * rmax
        seen = set()
        dq = deque([(ci, cj)])
        n = 0
        until = now + self.ff_ttl
        while dq and n < 20000:
            i, j = dq.popleft()
            if (i, j) in seen:
                continue
            if (i - ci) ** 2 + (j - cj) ** 2 > rad2:
                continue
            if not (0 <= i < ow and 0 <= j < oh):
                continue
            v = data[j * ow + i]
            if v >= 50 or v < 0:          # 障碍/未知：不扩
                continue
            seen.add((i, j))
            self._ff_cells[(i, j)] = until
            n += 1
            dq.extend(((i + 1, j), (i - 1, j), (i, j + 1), (i, j - 1)))
        return n

    def failfast_blocked(self, x, y, now):
        """候选是否落在"本轮禁入区"内（L2 升级后的硬过滤）。"""
        if not self.failfast_enabled:
            return False
        self._ff_hard = [z for z in self._ff_hard if z[2] > now]
        for zx, zy, _ in self._ff_hard:
            if math.hypot(x - zx, y - zy) <= self.ff_hard_radius:
                return True
        # 连通域（死角）判定：落点所在栅格若被登记过就直接拒绝
        if self._ff_cells:
            if len(self._ff_cells) > 60000:
                self._ff_cells = {k: v for k, v in self._ff_cells.items() if v > now}
            occ = self.map
            if occ is not None:
                ores = occ.info.resolution
                oox, ooy = occ.info.origin.position.x, occ.info.origin.position.y
                ci = int((x - oox) / ores)
                cj = int((y - ooy) / ores)
                until = self._ff_cells.get((ci, cj))
                if until is not None and until > now:
                    return True
        return False

    def zone_penalty(self, x, y, now):
        """"禁入/降权"区域罚分（v1 与 v2/v3 共用）。

        包含：受阻区、碰撞区（D7：近半径等效硬拒）、区域级被拒历史（D13）。
        一律用**罚分**而非硬 skip —— 全都落在禁区时仍能派出最不坏的那个。
        """
        pen = 0.0
        for zx, zy, _ in self.stuck_zones:
            if math.hypot(x - zx, y - zy) < 1.5:
                pen += 400.0
                break
        self.contact_zones = [z for z in self.contact_zones if z[2] > now]
        for zx, zy, _ in self.contact_zones:
            d = math.hypot(x - zx, y - zy)
            if d < self.contact_hard_radius:
                pen += self.contact_hard_penalty
                break
            if d < self.contact_zone_radius:
                pen += self.contact_zone_penalty
                break
        pen += self.region_penalty_of(x, y)
        return pen

    def _stuck_penalty(self, x, y, now):
        return self.zone_penalty(x, y, now)

    def grid(self):
        """把 /map 转成打分内核要的 dict（只做一次浅转换，避免每候选重复取属性）。"""
        m = self.map
        if m is None:
            return None
        info = m.info
        return {'res': info.resolution, 'w': info.width, 'h': info.height,
                'ox': info.origin.position.x, 'oy': info.origin.position.y,
                'data': m.data}

    def penalty(self, x, y):
        """所有"别去那儿"的来源合并成一个罚分（罚分制，不硬拒，避免整片被吃）。"""
        now = time.monotonic()
        pen = 0.0
        self.blacklist = [b for b in self.blacklist if b[2] > now]
        for bx, by, _ in self.blacklist:
            if math.hypot(x - bx, y - by) < self.bl_r:
                pen += 250.0
                self.stats['penalized_black'] = self.stats.get('penalized_black', 0) + 1
                self._note_uniq('penalized_black', x, y)
                break
        pen += self.zone_penalty(x, y, now)
        # 反复拉锯：同一个位置附近被派发过很多次却没推进 → 降权
        self.pub_history = [h for h in self.pub_history if now - h[2] < self.retry_window]
        n = sum(1 for hx, hy, _ in self.pub_history
                if math.hypot(x - hx, y - hy) < self.retry_radius)
        pen += self.retry_penalty * n
        return pen

    def tick(self):
        # 2026-11-14（S5 Step 0）：纯观测的耗时探针。
        # 只测时间与计数，**不改变任何分支/阈值/时序**（决策逻辑逐位不变）。
        _t0 = time.perf_counter()
        self._tick_paw_calls = 0
        self._tick_uniq = set()
        self._last_risk_info = None      # P13-1：避免上一拍的风险分项误贴到本拍
        self.write_timeline()
        # P13-6：判决表周期重发（丢包/merge 后启动自愈），放在早退之前，
        # 保证"候选全空 => _tick_v1 提前 return"时判决仍能持续下发。
        self.publish_verdict_snapshot()
        try:
            if self.scoring == 'v3':
                return self._tick_v3()
            if self.scoring == 'v2':
                return self._tick_v2()
            return self._tick_v1()
        finally:
            # 早退路径也从这里出去，所以 finally 是唯一不漏记的位置。
            _ms = (time.perf_counter() - _t0) * 1000.0
            self._tick_ms_prev = _ms
            self._tick_paw_prev = self._tick_paw_calls
            self._tick_ms_sum += _ms
            self._tick_ms_n += 1
            if _ms > self._tick_ms_max:
                self._tick_ms_max = _ms
            if _ms > self.tick_budget_ms:
                self._tick_ms_over_budget += 1
                # 节流告警：≥10 次才吭声，避免刷屏拖慢本就吃紧的这一拍
                if self._tick_ms_over_budget % 10 == 1:
                    self.get_logger().warn(
                        'tick budget exceeded: %.1f ms > %.1f ms '
                        '(%d times so far, path_and_width calls=%d)'
                        % (_ms, self.tick_budget_ms,
                           self._tick_ms_over_budget, self._tick_paw_calls))

    def _tick_v1(self):
        now = time.monotonic()
        self._repair_tick_n = 0          # 每拍修复验证预算（防止一拍内跑太多 BFS）
        self._update_stuck(now)
        self._update_failfast(now)
        # P4：阶段状态机放在**打分循环之后**（2026-11-13）。
        # 供给驱动判据需要"本拍候选池里的远候选数"，放前面只能用到上一拍的值，
        # 会白宕一拍。定时器/位姿/候选的可用性检查仍在前面，避免无效计算。
        if self.map is None or self.pose is None or not self.cands:
            return
        if self.mgr_busy and now - self.last_pub < self.repub:
            return
        cands = [c for c in self.cands if now - c[2] < self.cand_max_age]
        if not cands:
            return
        scored = []
        raw_of, risk_of = {}, {}     # P13-1：(x,y) → 折现前得分 / 落点风险分项
        for x, y, _ in cands:
            if self.failfast_blocked(x, y, now):
                self.stats['failfast_reject'] = self.stats.get('failfast_reject', 0) + 1
                self._note_uniq('failfast_reject', x, y)
                continue
            u = self.unknown_cells(x, y)
            if self.blacklisted(x, y, now):
                self.stats['penalized_black'] = self.stats.get('penalized_black', 0) + 1
                u -= 250
            if u < self.min_unknown:
                self.stats['rejected_size'] += 1
                continue
            u_eff = u - self._stuck_penalty(x, y, now)
            # 转角惩罚（软约束）：朝后方的候选只降分，不再被拒
            if self.turn_pen_k > 0.0:
                u_eff -= self.turn_pen_k * (self._turn_to(x, y) / math.pi)
            # 区域新度：2 m 半径未知格加分；已探明区（已知空闲占比高）重罚
            if self.novelty_w > 0.0 or self.repeat_pen > 0.0:
                _unk2, _ff2 = self._area_stats(x, y, self.novelty_r)
                if _unk2 is not None and self.novelty_w > 0.0:
                    u_eff += self.novelty_w * _unk2
                if _ff2 is not None and self.repeat_pen > 0.0 and _ff2 >= self.repeat_ff:
                    u_eff -= self.repeat_pen
                    self.stats['repeat_pen'] = self.stats.get('repeat_pen', 0) + 1
            # P13-1：距离折现（这里只算 O(1) 的一项；开销大的落点特征放到
            # 下面已缩到 max_cand 个候选之后再算，不拖慢 1 Hz 主循环）
            _dist = math.hypot(x - self.pose[0], y - self.pose[1])
            # P4（用户 Q4 答案"改为越远越优先"）：框架阶段不再对距离折现。
            # 否则一个上升型的距离偏好会被 1/(1+(d/4.5)^2) 抵掉一半，
            # 等于没改。补齐阶段保持原样，保证可回退。
            _frame = self._frame_mode()
            if _frame and self.frame_depth_min > 0.0:
                _dep = self.unknown_depth_at(x, y)
                if _dep is not None and _dep < self.frame_depth_min:
                    self.stats['frame_depth_reject'] = \
                        self.stats.get('frame_depth_reject', 0) + 1
                    continue
            _p = 1.0 if _frame else self.risk_discount(_dist)
            raw_of[(round(x, 2), round(y, 2))] = u_eff
            scored.append((u_eff * _p, -_dist, x, y))
        # P4（2026-11-13）：本拍"远候选供给" —— 通过 min_unknown 且距离超过
        # far_admit_dist 的候选个数。阶段机靠它判定"远区是否还有货"。
        self._far_supply = sum(1 for (_, _nd, _x, _y) in scored
                               if -_nd > self.far_admit_dist)
        self.stats['far_supply_ticks'] = self.stats.get('far_supply_ticks', 0) + 1
        if self._far_supply <= 0:
            self.stats['far_supply_empty_ticks'] = (
                self.stats.get('far_supply_empty_ticks', 0) + 1)
        if self.stats.get('far_supply_log_tick') is None:
            self.stats['far_supply_log_tick'] = 0
        if self.stats['far_supply_log_tick'] % 30 == 0:
            self.get_logger().info(
                'P4 供给观测：远候选=%d 个，已探明=%s 格，阶段=%s'
                % (self._far_supply, self.known_cells(), self.strategy_phase))
        self.stats['far_supply_log_tick'] += 1
        # P4：拿到本拍供给后再推进阶段机
        self._update_strategy_phase(now)
        scored = self._sort_candidates(scored)
        # P2（2026-11-11）：候选池快照 —— 记录排序后前 N 名的完整依据。
        # 只观测、不影响决策；没配 pool_probe_log 时是纯空操作。
        if self.pool_probe_log:
            self.probe_pool(scored, raw_of)
        # V1：对前 max_cand 个候选先算区域特征 → 闸门硬拒 + occ/esc 罚分重排
        top, feats = [], {}
        for u, negd, x, y in scored[:self.max_cand]:
            gx0, gy0 = self.pull_back(x, y)
            reason, f = self.candidate_gate(gx0, gy0)
            if reason:
                self.stats['gate_reject'] = self.stats.get('gate_reject', 0) + 1
                self._note_uniq('gate_reject', gx0, gy0)
                self.blacklist.append((gx0, gy0, now + self.narrow_penalty_sec))
                self.note_refusal(gx0, gy0)
                self.get_logger().info(
                    '候选闸门否决（%s）目标 (%.2f,%.2f)' % (reason, gx0, gy0))
                continue
            pen = self.gate_adjusted_penalty(f) + self.tail_penalty(gx0, gy0, f)
            if pen > 0:
                self.stats['gate_penalized'] = self.stats.get('gate_penalized', 0) + 1
            # P13-1：落点侧风险（转角/可脱困/死口袋/拥挤）—— 只降分，不拒绝候选
            risk_pen, risk_info = self.risk_aux(gx0, gy0, dist=-negd)
            if risk_pen > 0.0:
                self.stats['risk_penalized'] = self.stats.get('risk_penalized', 0) + 1
            top.append((u - pen - risk_pen, negd, x, y))
            feats[(round(x, 2), round(y, 2))] = f
            risk_of[(round(x, 2), round(y, 2))] = risk_info
        top = self._sort_candidates(top)
        # P4（用户 Q5）：框架阶段强制关掉"近处优先"—— 它会在 ±10% 分差带里
        # 把近的候选提到前面，与"先远"直接打架。
        if not self._frame_mode():
            top = self.near_first_reorder(top)
        fallback = None
        passing = []
        for u, negd, x, y in top:
            gx, gy = self.pull_back(x, y)
            cost_why = self.cost_gate_reject(gx, gy, now)
            if cost_why:
                # 先尝试"修复"：就近随机采样到最近的合格点（保留供给，不掐断）
                rep = self.cost_repair_point(gx, gy, self.unknown_cells(gx, gy), now)
                if rep is not None:
                    self.stats['repair_cost'] = self.stats.get('repair_cost', 0) + 1
                    self._note_uniq('repair_cost', rep[0], rep[1])
                    self.blacklist.append((gx, gy, now + self.narrow_penalty_sec))
                    self.get_logger().info(
                        '候选后验修复（%s）(%.2f,%.2f) → (%.2f,%.2f) 距离 %.2f m'
                        % (cost_why, gx, gy, rep[0], rep[1],
                           math.hypot(rep[0] - gx, rep[1] - gy)))
                    gx, gy = rep
                else:
                    self.stats['reject_cost'] = self.stats.get('reject_cost', 0) + 1
                    self._note_uniq('reject_cost', gx, gy)
                    self.blacklist.append((gx, gy, now + self.narrow_penalty_sec))
                    self.note_refusal(gx, gy)
                    self.get_logger().info(
                        '候选后验否决（%s）目标 (%.2f,%.2f)' % (cost_why, gx, gy))
                    continue
            ok, narrow, min_w, unk = self.path_and_width(gx, gy)
            if not ok:
                self.blacklist.append((gx, gy, now + self.bl_sec))
                self.stats['rejected_path'] += 1
                self._note_uniq('rejected_path', gx, gy)
                self.note_refusal(gx, gy)
                continue
            if narrow is not None:
                if self._last_path_reject == 'noexit':
                    self.stats['reject_noexit'] = self.stats.get('reject_noexit', 0) + 1
                    self._note_uniq('reject_noexit', gx, gy)
                else:
                    self.stats['rejected_narrow'] += 1
                    self._note_uniq('rejected_narrow', gx, gy)
                self.blacklist.append((gx, gy, now + self.narrow_penalty_sec))
                self.note_refusal(gx, gy)
                if (min_w is not None and min_w >= self.corridor_hard
                        and unk <= self.corridor_unknown_max and fallback is None):
                    fallback = (gx, gy)
                self.get_logger().info(
                    '前向净空预检否决：实测 %.2fm < 下限 %.2fm @(%.2f,%.2f)，目标 (%.2f,%.2f)'
                    % (min_w if min_w is not None else -1.0, self.narrow_floor,
                       narrow[0], narrow[1], gx, gy))
                continue
            # 可达但不可返回：目标附近没有掉头空间 → 派过去就出不来
            oneway, turn = self.return_infeasible(gx, gy)
            if oneway:
                self.stats['rejected_oneway'] = self.stats.get('rejected_oneway', 0) + 1
                self._note_uniq('rejected_oneway', gx, gy)
                self.blacklist.append((gx, gy, now + self.narrow_penalty_sec))
                self.note_refusal(gx, gy)
                self.get_logger().info(
                    '可达但不可返回否决：目标 (%.2f,%.2f) 附近掉头空间仅 %.2f m < %.2f m'
                    % (gx, gy, turn, self.return_turn_width))
                continue
            # ===== P5(ii)（2026-11-11）远目标准入 =====
            # 依据：实测 >6 m 的派发取消率 69%、3~4.5 m 只有 0%，且 >6 m 取消前
            # 日志里「卡住」16 次 /「blocked」9 次 —— 远目标失败在途中而非选点。
            # 框架阶段特意要派远点，所以这里只对远目标把净宽门槛从 narrow_floor
            # (0.58) 抬到 corridor_hard (0.92)：能过就派，过不了就**顺位到次远**
            # （top 在框架阶段本来就是距离降序，continue 天然实现"降级到次远"）。
            if (self.far_admit_on and self._frame_mode()
                    and -negd > self.far_admit_dist
                    and min_w is not None
                    and min_w < (self.far_admit_width or self.pass_width)):
                self.stats['far_admit_reject'] = \
                    self.stats.get('far_admit_reject', 0) + 1
                self._note_uniq('far_admit_reject', gx, gy)
                self.get_logger().info(
                    'P5 远目标准入否决：%.2f m 外的目标 (%.2f,%.2f) 实测净宽 %.2fm'
                    ' < %.2fm，降级到次远'
                    % (-negd, gx, gy, min_w,
                       self.far_admit_width or self.pass_width))
                continue
            # P13-1：不再"第一个通过硬门就派发" —— 硬门的通过顺序与风险无关，
            # 那样加风险项等于没加。这里收集前 risk_eval_n 个合格者，
            # 叠加沿路风险（窄段/未知占比）后取最优。
            route_pen, route_info = self.risk_route(min_w, unk)
            _key = (round(x, 2), round(y, 2))
            _raw = raw_of.get(_key, u)      # 折现前的收益，保持日志口径不变
            info = dict(risk_of.get(_key) or {})
            info.update(route_info)
            info['risk_dist'] = round(-negd, 2)
            info['risk_route'] = round(route_pen, 1)
            info['risk_discount_loss'] = round(
                _raw * (1.0 - self.risk_discount(-negd)), 1)
            info['risk_total'] = round(
                float(info.get('risk_aux', 0.0)) + route_pen
                + float(info['risk_discount_loss']), 1)
            info['risk_source'] = 'frontier'
            # P5(iii) 修复（2026-11-13）：把**这个候选自己的**路径随 passing 一起带下去。
            # 旧实现让 relay_point 去读 self._last_path_w，而它被每拍 top-N 的
            # path_and_width 反复覆盖 —— 最后留下的必然是**最后一个被检查**的
            # 候选路径，与实派的 passing[0] 几乎必然不是同一个目标，
            # 于是坐标校验每次都将 relay 判为 miss（实测 far_relay_ok = 0）。
            passing.append((u - route_pen, gx, gy, _raw, min_w, info,
                            self._last_path_w))
            self.stats['risk_eval'] = self.stats.get('risk_eval', 0) + 1
            # risk 关闭时只收 1 个：必须*逐位*等价旧行为（旧逻辑是"near_first
            # 排序后第一个通过硬门的候选"，而不是"前 6 个里未知格最多的"）。
            if len(passing) >= (self.risk_eval_n if self.risk_enabled else 1):
                break
        if passing:
            # P4：框架阶段的 passing 已经是距离降序（top 就是按距离排的，按顺序
            # 追加），再按 score 排会把"先远"打回去。补齐阶段保持原样。
            if not self._frame_mode():
                passing.sort(key=lambda q: q[0], reverse=True)
            _sc, gx, gy, u, min_w, info, _path = passing[0]
            self.stats['risk_selected'] = self.stats.get('risk_selected', 0) + 1
            self._last_risk_info = info
            # P5(iii) 修复：把本目标的路径钉在"已派发"槽位上，_last_path_* 继续
            # 留给后续调用的临时值，两者互不干扰。
            self._dispatch_path = _path
            self._dispatch_goal = (round(gx, 2), round(gy, 2))
            self.probe_candidate(gx, gy, None, min_w, u)
            self.publish_goal(gx, gy, None, u)
            return
        if fallback is not None:
            self.stats['narrow_fallback'] += 1
            self.get_logger().warn(
                '候选全部需要穿窄缝，回退派发最优点 (%.2f,%.2f)；统计 %s'
                % (fallback[0], fallback[1], self.stats))
            self.publish_goal(fallback[0], fallback[1], None, 0)
            return
        # ===== P4 安全阀（2026-11-13）：框架阶段连续"全灭"就强制切补齐 =====
        # 依据：供给驱动版实测把车锁死在框架阶段（phase_to_fill=0），而框架阶段
        # 按距离降序、不做折现，最远点常落在未知边缘（净空实测 0.00m）——
        # 结果 44 次发布只换来 2 次实派、选点等待 80.5%，整轮近乎空转
        # （p14v2_sm3）。这里加一道与判据无关的兜底：只要本拍所有候选都被
        # 硬门否掉（passing 空且 fallback 空），就记一次；连续够多拍说明
        # "框架阶段选不出可用点"，立即切补齐（补齐阶段有 risk_discount 保护，
        # 会自然把近处可用点排上来）。
        if self._frame_mode():
            self._frame_all_denied = getattr(self, '_frame_all_denied', 0) + 1
            if self._frame_all_denied >= self.frame_deny_limit:
                self.strategy_phase = 'fill'
                self._phase_t = now
                self._phase_forced = True
                self._phase_switch_known = self.known_cells()
                self._phase_stall = 0
                self._frame_all_denied = 0
                self.stats['phase_to_fill_deny'] = (
                    self.stats.get('phase_to_fill_deny', 0) + 1)
                self.get_logger().warn(
                    'P4 安全阀：框架阶段连续 %d 拍无候选通过硬门 → 强制切补齐'
                    % self.frame_deny_limit)
        else:
            self._frame_all_denied = 0
        # P13-2A：原始 RRT 候选也走同一套风险评分。
        # 它排在保底观察点之前：raw 是真正的前沿收益点，观察点只是"站得住"。
        raw = self.pick_raw_goal(now)
        if raw is not None:
            gx, gy, min_w, u, info = raw
            self.stats['raw_publish'] = self.stats.get('raw_publish', 0) + 1
            self._last_risk_info = info
            self.get_logger().warn(
                '原始 RRT 候选经风险评分派发：(%.2f,%.2f) 风险=%.1f '
                '（距离 %.2f m、可脱困=%d 方向、路径宽=%s、块=%s）；raw_seen=%d'
                % (gx, gy, float(info.get('risk_total', 0.0)),
                   float(info.get('risk_dist', 0.0)),
                   int(info.get('risk_esc_dirs', -1)),
                   info.get('risk_min_w_path'), info.get('risk_comp_r2'),
                   self.stats.get('raw_seen', 0)))
            self.probe_candidate(gx, gy, None, min_w, u)
            self.publish_goal(gx, gy, None, u)
            return
        obs = self.pick_safe_observation([(x, y) for _, _, x, y in scored])
        if obs is not None:
            self.stats['fallback_obs'] = self.stats.get('fallback_obs', 0) + 1
            self.get_logger().warn(
                '本拍无可派候选 → 派保底观察点 (%.2f,%.2f)（第 %d 次）；统计 %s'
                % (obs[0], obs[1], self._fb_count, self.stats))
            self.publish_goal(obs[0], obs[1], None, 0)
            return
        # 最后一道：前沿全都派不出去（比如车正卡在"进得去出不来"的角落），
        # 与其什么都不派、让车在那儿待着，不如派一个本地脱困目标把车挪出来。
        esc = self.pick_escape_goal()
        if esc is not None:
            self.publish_goal(esc[0], esc[1], None, 0)
            return
        self.get_logger().warn(f'本轮候选全部被拒：{self.stats}')

    def _tick_v3(self):
        now = time.monotonic()
        self._update_failfast(now)
        self._update_stuck(now)
        if self.map is None or self.pose is None or not self.cands:
            return
        if self.mgr_busy and now - self.last_pub < self.repub:
            return
        cands = [(x, y) for x, y, t in self.cands if now - t < self.cand_max_age]
        if not cands:
            return
        g = self.grid()
        if g is None:
            return
        # 先按"机头朝向"过一遍：manager 自己会拒绝 >80° 的转向目标（日志实测因此空转 5~10 s），
        # 这里提前筛掉/降权，省掉那次拒绝与随后的原地旋转。
        turn_limit = math.radians(self.turn_limit_deg)
        filtered = []
        dropped_turn = 0
        for x, y in cands:
            dx, dy = x - self.pose[0], y - self.pose[1]
            n = math.hypot(dx, dy) or 1.0
            if turn_angle_to((dx / n, dy / n), self.yaw) > turn_limit:
                dropped_turn += 1
                continue
            filtered.append((x, y))
        if dropped_turn:
            self.stats['turn_dropped'] = self.stats.get('turn_dropped', 0) + dropped_turn
        if not filtered:
            if self.turn_hard_skip:
                # D12：本拍不派 —— manager 的 80° 门会先原地转再拒，实测白烧 5~10 s。
                # 空一拍让 RRT 重新采样（republish 1.5 s 会很快给新候选）。
                self.stats['turn_skip_all'] = self.stats.get('turn_skip_all', 0) + 1
                if now - getattr(self, '_last_turn_skip_log', 0.0) > 10.0:
                    self._last_turn_skip_log = now
                    self.get_logger().info(
                        '本拍全部候选都在机头 %.0f° 之外（%d 个）→ 跳过派发，等 RRT 重新采样'
                        % (self.turn_limit_deg, dropped_turn))
                return
            self.stats['turn_fallback'] = self.stats.get('turn_fallback', 0) + 1
            self.get_logger().info(
                f'[v3] 全部候选都在机头 {self.turn_limit_deg:.0f}° 之外（{dropped_turn} 个），'
                f'回退派发最优候选')
            filtered = list(cands)
        try:
            ranked = rank_candidates_v3(g, filtered, self.cfg3, penalty_fn=self.penalty,
                                        pose=self.pose, prefilter_n=self.prefilter_n)
        except Exception as exc:                          # noqa: BLE001
            self.get_logger().error(f'v3 打分异常，回退 v1：{type(exc).__name__}: {exc}')
            self.scoring = 'v1'
            return self._tick_v1()
        keep = [r for r in ranked
                if r['unknown'] >= self.min_unknown or r.get('ahead', 0) >= self.min_ahead]
        self.stats['rejected_size'] += len(ranked) - len(keep)
        for r_drop in ranked:
            if r_drop not in keep:
                self._note_uniq('rejected_size', r_drop['x'], r_drop['y'])
        if not keep:
            self.get_logger().warn(
                f'[v3] 无候选过规模门槛（min_unknown={self.min_unknown}）；统计 {self.stats}')
            return
        if self.verbose_rank:
            self.get_logger().info('[v3] 候选前 3：' + ' | '.join(
                '(%.2f,%.2f) score=%.1f ahead=%d near=%.2f pen=%.0f'
                % (r['x'], r['y'], r['score'], r['ahead'], r['near_ratio'], r['penalty'])
                for r in keep[:3]))
        fallback = None
        gated = []
        for r in keep[:self.max_cand]:
            gx0, gy0 = self.pull_back(r['x'], r['y'])
            reason, f = self.candidate_gate(gx0, gy0)
            if reason:
                self.stats['gate_reject'] = self.stats.get('gate_reject', 0) + 1
                self._note_uniq('gate_reject', gx0, gy0)
                self.blacklist.append((gx0, gy0, now + self.narrow_penalty_sec))
                self.note_refusal(gx0, gy0)
                self.get_logger().info(
                    '候选闸门否决（%s）目标 (%.2f,%.2f)' % (reason, gx0, gy0))
                continue
            pen = self.gate_adjusted_penalty(f) + self.tail_penalty(gx0, gy0, f)
            if pen > 0:
                self.stats['gate_penalized'] = self.stats.get('gate_penalized', 0) + 1
                r = dict(r); r['score'] = r.get('score', 0.0) - pen
            gated.append(r)
        gated.sort(key=lambda q: q.get('score', 0.0), reverse=True)
        for r in gated:
            gx, gy = self.pull_back(r['x'], r['y'])
            cost_why = self.cost_gate_reject(gx, gy, now)
            if cost_why:
                # 先尝试"修复"：就近随机采样到最近的合格点（保留供给，不掐断）
                rep = self.cost_repair_point(gx, gy, self.unknown_cells(gx, gy), now)
                if rep is not None:
                    self.stats['repair_cost'] = self.stats.get('repair_cost', 0) + 1
                    self._note_uniq('repair_cost', rep[0], rep[1])
                    self.blacklist.append((gx, gy, now + self.narrow_penalty_sec))
                    self.get_logger().info(
                        '候选后验修复（%s）(%.2f,%.2f) → (%.2f,%.2f) 距离 %.2f m'
                        % (cost_why, gx, gy, rep[0], rep[1],
                           math.hypot(rep[0] - gx, rep[1] - gy)))
                    gx, gy = rep
                else:
                    self.stats['reject_cost'] = self.stats.get('reject_cost', 0) + 1
                    self._note_uniq('reject_cost', gx, gy)
                    self.blacklist.append((gx, gy, now + self.narrow_penalty_sec))
                    self.note_refusal(gx, gy)
                    self.get_logger().info(
                        '候选后验否决（%s）目标 (%.2f,%.2f)' % (cost_why, gx, gy))
                    continue
            ok, narrow, min_w, unk = self.path_and_width(gx, gy)
            if not ok:
                self.blacklist.append((gx, gy, now + self.bl_sec))
                self.stats['rejected_path'] += 1
                self._note_uniq('rejected_path', gx, gy)
                self.note_refusal(gx, gy)
                continue
            if narrow is not None:
                if self._last_path_reject == 'noexit':
                    self.stats['reject_noexit'] = self.stats.get('reject_noexit', 0) + 1
                    self._note_uniq('reject_noexit', gx, gy)
                else:
                    self.stats['rejected_narrow'] += 1
                    self._note_uniq('rejected_narrow', gx, gy)
                self.blacklist.append((gx, gy, now + self.narrow_penalty_sec))
                self.note_refusal(gx, gy)
                # 软回退只允许"确实够宽、而且宽度不是靠未知格撑出来的"候选。
                # 2026-10-23：原来无条件派发最优窄候选，车开进 0.9 m 门洞后被车端
                # 前向安全闸（0.45 m）判死、原地静止 40~90 s，就是这条路径造成的。
                if (min_w is not None and min_w >= self.corridor_hard
                        and unk <= self.corridor_unknown_max and fallback is None):
                    fallback = (gx, gy, r, min_w, unk)
                continue
            try:
                r['min_w'] = min_w
            except Exception:                     # noqa: BLE001
                pass
            self.probe_candidate(gx, gy, r, min_w, r.get('unknown'))
            self.publish_goal(gx, gy, r)
            return
        if fallback is not None:
            self.stats['narrow_fallback'] += 1
            self.get_logger().warn(
                '[v3] 候选全部需穿窄缝，回退派发实测最宽者 (%.2f,%.2f) 净宽 %.2f m 未知占比 %.0f%%'
                % (fallback[0], fallback[1], fallback[3], 100 * fallback[4]))
            self.publish_goal(fallback[0], fallback[1], fallback[2])
            return
        # 全部低于硬下限：宁可原地等新前沿，也不把车塞进过不去的口子
        self.stats['narrow_blocked_all'] = self.stats.get('narrow_blocked_all', 0) + 1
        if now - getattr(self, '_last_narrow_warn', 0.0) > 10.0:
            self._last_narrow_warn = now
            self.get_logger().warn(
                '[v3] 本轮候选全部低于物理下限 %.2f m（不做软回退，等新前沿）；统计 %s'
                % (self.narrow_floor, self.stats))

    def _tick_v2(self):
        now = time.monotonic()
        self._update_failfast(now)
        self._update_stuck(now)
        if self.map is None or self.pose is None or not self.cands:
            return
        if self.mgr_busy and now - self.last_pub < self.repub:
            return                      # 目标执行中才限速；空闲时立刻补一个新候选（S2）
        cands = [(x, y) for x, y, t in self.cands if now - t < self.cand_max_age]
        if not cands:
            return
        g = self.grid()
        if g is None:
            return
        try:
            ranked = rank_candidates(g, cands, self.cfg,
                                     penalty_fn=self.penalty, pose=self.pose,
                                     prefilter_n=self.prefilter_n)
        except Exception as exc:                          # noqa: BLE001
            self.get_logger().error(f'打分异常，回退旧逻辑：{type(exc).__name__}: {exc}')
            ranked = []
        # 规模门槛：未知格太少（碎角/坑）直接不要
        keep = [r for r in ranked
                if r['unknown'] >= self.min_unknown or r.get('ahead', 0) >= self.min_ahead]
        self.stats['rejected_size'] += len(ranked) - len(keep)
        for r_drop in ranked:
            if r_drop not in keep:
                self._note_uniq('rejected_size', r_drop['x'], r_drop['y'])
        if not keep:
            self.get_logger().warn(
                f'无候选过规模门槛（min_unknown={self.min_unknown}）；统计 {self.stats}')
            return
        if self.verbose_rank:
            top = keep[:3]
            self.get_logger().info('候选打分前 3：' + ' | '.join(
                '(%.2f,%.2f) score=%.1f u=%d blk=%d w=%d pen=%.0f'
                % (r['x'], r['y'], r['score'], r['unknown'], r['block'],
                   r['width'], r['penalty']) for r in top))
        fallback = None
        gated = []
        for r in keep[:self.max_cand]:
            gx0, gy0 = self.pull_back(r['x'], r['y'])
            reason, f = self.candidate_gate(gx0, gy0)
            if reason:
                self.stats['gate_reject'] = self.stats.get('gate_reject', 0) + 1
                self._note_uniq('gate_reject', gx0, gy0)
                self.blacklist.append((gx0, gy0, now + self.narrow_penalty_sec))
                self.note_refusal(gx0, gy0)
                self.get_logger().info(
                    '候选闸门否决（%s）目标 (%.2f,%.2f)' % (reason, gx0, gy0))
                continue
            pen = self.gate_adjusted_penalty(f) + self.tail_penalty(gx0, gy0, f)
            if pen > 0:
                self.stats['gate_penalized'] = self.stats.get('gate_penalized', 0) + 1
                r = dict(r); r['score'] = r.get('score', 0.0) - pen
            gated.append(r)
        gated.sort(key=lambda q: q.get('score', 0.0), reverse=True)
        for r in gated:
            gx, gy = self.pull_back(r['x'], r['y'])
            cost_why = self.cost_gate_reject(gx, gy, now)
            if cost_why:
                # 先尝试"修复"：就近随机采样到最近的合格点（保留供给，不掐断）
                rep = self.cost_repair_point(gx, gy, self.unknown_cells(gx, gy), now)
                if rep is not None:
                    self.stats['repair_cost'] = self.stats.get('repair_cost', 0) + 1
                    self._note_uniq('repair_cost', rep[0], rep[1])
                    self.blacklist.append((gx, gy, now + self.narrow_penalty_sec))
                    self.get_logger().info(
                        '候选后验修复（%s）(%.2f,%.2f) → (%.2f,%.2f) 距离 %.2f m'
                        % (cost_why, gx, gy, rep[0], rep[1],
                           math.hypot(rep[0] - gx, rep[1] - gy)))
                    gx, gy = rep
                else:
                    self.stats['reject_cost'] = self.stats.get('reject_cost', 0) + 1
                    self._note_uniq('reject_cost', gx, gy)
                    self.blacklist.append((gx, gy, now + self.narrow_penalty_sec))
                    self.note_refusal(gx, gy)
                    self.get_logger().info(
                        '候选后验否决（%s）目标 (%.2f,%.2f)' % (cost_why, gx, gy))
                    continue
            ok, narrow, min_w, unk = self.path_and_width(gx, gy)
            if not ok:
                self.blacklist.append((gx, gy, now + self.bl_sec))
                self.stats['rejected_path'] += 1
                self._note_uniq('rejected_path', gx, gy)
                self.note_refusal(gx, gy)
                continue
            if narrow is not None:
                if self._last_path_reject == 'noexit':
                    self.stats['reject_noexit'] = self.stats.get('reject_noexit', 0) + 1
                    self._note_uniq('reject_noexit', gx, gy)
                else:
                    self.stats['rejected_narrow'] += 1
                    self._note_uniq('rejected_narrow', gx, gy)
                self.blacklist.append((gx, gy, now + self.narrow_penalty_sec))
                self.note_refusal(gx, gy)
                if fallback is None:
                    fallback = (gx, gy, r)
                self.get_logger().info(
                    '前向净空预检否决：实测 %.2fm < 下限 %.2fm @(%.2f,%.2f)，目标 (%.2f,%.2f)'
                    % (min_w if min_w is not None else -1.0, self.narrow_floor,
                       narrow[0], narrow[1], gx, gy))
                continue
            try:
                r['min_w'] = min_w
            except Exception:                     # noqa: BLE001
                pass
            self.probe_candidate(gx, gy, r, min_w, r.get('unknown'))
            self.publish_goal(gx, gy, r)
            return
        if fallback is not None:
            self.stats['narrow_fallback'] += 1
            self.get_logger().warn(
                '候选全部需要穿窄缝，回退派发最优点 (%.2f,%.2f)；统计 %s'
                % (fallback[0], fallback[1], self.stats))
            self.publish_goal(fallback[0], fallback[1], fallback[2])
            return
        self.get_logger().warn(f'本轮候选全部被拒：{self.stats}')

    def publish_goal(self, gx, gy, r, u=None):
        now = time.monotonic()
        # 2026-11-13：视觉就绪门。视觉启用但还没输出有效障碍时，不派发目标
        # （只在"尚未派过任何目标"时生效，避免跑到中途因视觉掉线而停摆）。
        if self.stats.get('published', 0) == 0 and not self.vision_ready():
            if not getattr(self, '_vision_gate_blocked_logged', False):
                self._vision_gate_blocked_logged = True
                self.get_logger().warn(
                    '视觉尚未就绪（~%.0f s / %d 格），暂不派发首个探索目标'
                    % (now - self._vision_gate_start, self._vision_cells))
            return
        # P5(iii) 修复：_dispatch_* 只对"刚在 passing 分支里钉住的那个目标"有效。
        # 其余派发路径（fallback / raw / migrate / inplace）没有对应路径，
        # 这里统一清空，避免 relay_point 拿到上一次目标的陈旧路径。
        if self._dispatch_goal != (round(gx, 2), round(gy, 2)):
            self._dispatch_path = None
            self._dispatch_goal = None
        if (self.last_goal is not None and self.last_pub
                and now - self.last_pub < 5.0
                and math.hypot(gx - self.last_goal[0], gy - self.last_goal[1]) < 0.30):
            return                              # 5 s 内同一目标不重复发（避免目标churn）
        msg = PoseStamped()
        msg.header.frame_id = self.frame
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.pose.position.x, msg.pose.position.y = gx, gy
        msg.pose.orientation.w = 1.0
        self.pub.publish(msg)
        self.last_pub = time.monotonic()
        self.last_goal = (gx, gy)
        self.pub_history.append((gx, gy, self.last_pub))
        if self._first_pub_t is None:
            self._first_pub_t = self.last_pub
        self.stats['published'] += 1
        try:
            self.get_logger().info(
                '仲裁通过：候选(%s) 未知=%s 块=%s 宽=%s penalty=%s → 目标 (%.2f,%.2f)；统计 %s'
                % (('%.2f,%.2f' % (r['x'], r['y'])) if r else '?',
                   (r['unknown'] if r else u) if (r or u is not None) else '?',
                   r['block'] if r else '?',
                   ('%.2f' % r['min_w']) if (r and 'min_w' in r) else (r['width'] if r else '?'),
                   ('%.0f' % r['penalty']) if r else '?',
                   gx, gy, self.stats))
        except Exception:
            pass

    def on_path_result(self, fut, gx, gy, u):
        self.pending = None
        now = time.monotonic()
        ok = False
        try:
            res = fut.result()
            ok = bool(res and res.path and len(res.path.poses) > 0)
        except Exception:
            ok = False
        if not ok:
            self.blacklist.append((gx, gy, now + self.bl_sec))
            self.stats['rejected_path'] += 1
            return
        msg = PoseStamped()
        msg.header.frame_id = self.frame
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.pose.position.x, msg.pose.position.y = gx, gy
        msg.pose.orientation.w = 1.0
        self.pub.publish(msg)
        self.last_pub = now
        self.last_goal = (gx, gy)
        self.stats['published'] += 1
        self.get_logger().info(f'仲裁通过：未知格 {u}，目标 ({gx:.2f},{gy:.2f})；统计 {self.stats}')


def main():
    rclpy.init()
    node = Arbiter()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
